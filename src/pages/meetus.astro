---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/astro/Navbar.astro";
import Footer from "../components/astro/Footer.astro";
import MeetUs from "../components/astro/MeetUs.astro";
---

<Layout
  title="Book a Meeting | SWOTBee HubSpot Consulting"
  description="Schedule a meeting with our HubSpot consulting team. Pick a time that works for you."
>
  <Navbar />

  <section class="bg-gradient-to-b from-v6-bg to-white px-4 sm:px-6 lg:px-8 pt-16 sm:pt-20 pb-8">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-3xl sm:text-4xl font-bold text-v6-dark mb-4">Book a Meeting</h1>
      <p class="text-base sm:text-lg text-v6-text-muted max-w-xl mx-auto leading-relaxed">
        Pick a time that works for you. We'll discuss your HubSpot goals and how we can help.
      </p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <MeetUs />
  </section>

  <Footer />
</Layout>
