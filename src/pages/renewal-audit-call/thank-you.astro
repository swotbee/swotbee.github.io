---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/astro/Navbar.astro";
import Footer from "../../components/astro/Footer.astro";
---

<Layout
  title="Your Renewal Audit Call Is Booked"
  description="Your free renewal audit call is booked. Here is what happens next."
  robots="noindex, follow"
>
  <Navbar />

  <main class="min-h-[70vh] bg-gradient-to-b from-v6-bg to-white px-4 py-14 sm:px-6 sm:py-18 lg:px-8">
    <div class="mx-auto max-w-2xl text-center" role="status">
      <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-full bg-v6-teal/15">
        <svg viewBox="0 0 24 24" class="h-9 w-9 text-v6-teal" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
      </div>
      <h1 class="text-3xl font-bold leading-tight text-v6-dark sm:text-4xl">Your renewal audit call is booked.</h1>
      <p id="booking-time" class="mt-3 text-lg text-v6-text-muted">Your calendar invitation and confirmation email are on their way.</p>

      <section class="mt-10 rounded-2xl border border-v6-border bg-white p-6 text-left sm:p-8">
        <h2 class="text-xl font-bold text-v6-dark">What happens next</h2>
        <ol class="mt-5 space-y-5">
          <li class="flex gap-3.5">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-v6-copper text-sm font-bold text-white">1</span>
            <p class="pt-0.5 text-v6-text-muted">Check your email for the calendar invitation. It includes the time, meeting link, and options to reschedule if needed.</p>
          </li>
          <li class="flex gap-3.5">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-v6-copper text-sm font-bold text-white">2</span>
            <p class="pt-0.5 text-v6-text-muted">No preparation is required. Bring your renewal questions and we’ll review your leakage estimate, what it can tell you, and what to investigate next.</p>
          </li>
          <li class="flex gap-3.5">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-v6-copper text-sm font-bold text-white">3</span>
            <p class="pt-0.5 text-v6-text-muted">After the call, you decide whether a deeper audit of your HubSpot data is worthwhile. There is no pressure either way.</p>
          </li>
        </ol>
      </section>

      <section class="mt-8 text-left">
        <h2 class="text-lg font-bold text-v6-dark">While you wait</h2>
        <p class="mt-1 text-v6-text-muted">Get a directional view of where renewal-process leakage may be hiding.</p>
        <a href="/renewal-leakage-tool/" class="mt-4 inline-flex items-center rounded-xl border border-v6-copper px-5 py-3 font-semibold text-v6-copper transition-colors hover:bg-v6-copper-50">Explore the renewal leakage tool <span aria-hidden="true" class="ml-2">→</span></a>
      </section>
    </div>
  </main>

  <Footer />

  <script is:inline>
    const time = new URLSearchParams(window.location.search).get("startTime");
    const timeEl = document.getElementById("booking-time");
    if (time && timeEl) {
      const bookingTime = new Date(time);
      if (!Number.isNaN(bookingTime.valueOf())) {
        timeEl.textContent = `We’ll see you ${bookingTime.toLocaleString(undefined, { dateStyle: "full", timeStyle: "short" })}. A calendar invitation and confirmation email are on their way.`;
      }
    }
    if (window.gtag) window.gtag("event", "booking_thank_you_view", { event_type: "renewal_audit_call" });
  </script>
</Layout>
