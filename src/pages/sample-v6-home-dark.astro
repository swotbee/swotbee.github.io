---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="V6 Homepage — Dark Mode (Copper CTA)">
  <style is:global>
    body { font-family: 'Hanken Grotesk Variable', 'Helvetica Neue', sans-serif !important; margin: 0; background: #0d1b26 !important; }
  </style>

  <!-- NAVBAR — dark -->
  <nav style="background: #0a1520; border-bottom: 1px solid #1a2d3d; position: sticky; top: 0; z-index: 50;">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; display: flex; align-items: center; justify-content: space-between; height: 64px;">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <svg viewBox="0 0 120 120" width="32" height="32" xmlns="http://www.w3.org/2000/svg">
          <path d="M60,10 L103,35 L60,60 L17,35 Z" fill="#C47A2A" />
          <path d="M103,35 L103,85 L60,60 Z" fill="#5AAB9D" />
          <path d="M103,85 L60,110 L17,85 L60,60 Z" fill="#1A7AB5" />
          <path d="M17,85 L17,35 L60,60 Z" fill="#E0B820" />
        </svg>
        <span style="color: #e8ecf0; font-size: 1.15rem; font-weight: 700;">SWOT<span style="color: #5AAB9D;">bee</span></span>
      </div>
      <div style="display: flex; gap: 2rem; align-items: center;">
        <a href="#" style="color: #7a9bb0; font-size: 0.9rem; text-decoration: none;">Home</a>
        <a href="#" style="color: #7a9bb0; font-size: 0.9rem; text-decoration: none;">Services</a>
        <a href="#" style="color: #7a9bb0; font-size: 0.9rem; text-decoration: none;">About</a>
        <a href="#" style="color: #7a9bb0; font-size: 0.9rem; text-decoration: none;">Blog</a>
        <a href="#" style="background: #C47A2A; color: white; padding: 0.5rem 1.25rem; border-radius: 8px; font-size: 0.85rem; font-weight: 600; text-decoration: none;">Get Started</a>
      </div>
    </div>
  </nav>

  <!-- HERO — dark -->
  <section style="background: linear-gradient(180deg, #0d1b26 0%, #0f2535 100%); padding: 5rem 1.5rem 4rem;">
    <div style="max-width: 800px; margin: 0 auto; text-align: center;">
      <h1 style="font-size: 2.8rem; font-weight: 700; color: #e8ecf0; line-height: 1.15; margin-bottom: 1.25rem;">
        Stop losing revenue to <span style="color: #E8A850;">missed renewals</span>
      </h1>
      <p style="font-size: 1.15rem; color: #7a9bb0; max-width: 600px; margin: 0 auto 2rem; line-height: 1.6;">
        Deals that renew themselves. Line items that filter automatically. Revenue you can finally see.
      </p>
      <div style="display: flex; gap: 1rem; justify-content: center; margin-bottom: 1rem;">
        <a href="#" style="background: #C47A2A; color: white; padding: 0.85rem 2rem; border-radius: 10px; font-size: 1rem; font-weight: 600; text-decoration: none;">See It In Action</a>
        <a href="#" style="border: 1.5px solid #2a4055; color: #a3c4d8; padding: 0.85rem 2rem; border-radius: 10px; font-size: 1rem; font-weight: 500; text-decoration: none;">Learn more →</a>
      </div>
      <p style="color: #4a6a80; font-size: 0.8rem;">Works with your existing HubSpot. No migration needed.</p>
    </div>
  </section>

  <!-- TRUST BADGES — dark -->
  <section style="background: #0f1e2a; padding: 1.5rem; border-bottom: 1px solid #1a2d3d;">
    <div style="max-width: 900px; margin: 0 auto; display: flex; justify-content: center; gap: 3rem; flex-wrap: wrap;">
      {[
        { icon: '✓', label: 'HubSpot Partner', sub: 'Solutions Provider', bg: '#122e28', color: '#5AAB9D' },
        { icon: '★', label: '150+ Clients', sub: 'Across Industries', bg: '#2a1f10', color: '#E8A850' },
        { icon: '⊕', label: '10+ Years', sub: 'Global Experience', bg: '#0f2538', color: '#3d9ad0' },
      ].map(b => (
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <div style={`width: 36px; height: 36px; border-radius: 50%; background: ${b.bg}; display: flex; align-items: center; justify-content: center; color: ${b.color}; font-size: 1rem;`}>{b.icon}</div>
          <div>
            <div style="font-size: 0.8rem; font-weight: 600; color: #c8d8e8;">{b.label}</div>
            <div style="font-size: 0.65rem; color: #5a7a90;">{b.sub}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- FEATURES — dark -->
  <section style="background: #0d1b26; padding: 4rem 1.5rem;">
    <div style="max-width: 900px; margin: 0 auto;">
      <h2 style="font-size: 1.8rem; font-weight: 700; color: #e8ecf0; margin-bottom: 0.5rem;">Why Our Clients Rely on Us</h2>
      <p style="color: #7a9bb0; margin-bottom: 2.5rem; max-width: 600px;">Personalized workflows, automations, and messaging aligned with your goals.</p>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
        {[
          { icon: '📊', title: 'Proven ROI', desc: 'Data-backed decisions and optimized workflows tailored to your goals.' },
          { icon: '⚙️', title: 'Seamless Systems', desc: 'CRM, marketing, and analytics connected into one system.' },
          { icon: '💡', title: 'Innovation', desc: 'Cutting-edge tools and automation to streamline growth.' },
          { icon: '🤝', title: 'Transparent Partnership', desc: 'Clear communication, aligned objectives, shared roadmaps.' },
        ].map(f => (
          <div style="display: flex; gap: 1rem; align-items: start;">
            <div style="width: 40px; height: 40px; border-radius: 10px; background: #0f2538; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1.2rem;">{f.icon}</div>
            <div>
              <h3 style="font-size: 1rem; font-weight: 600; color: #c8d8e8; margin-bottom: 0.25rem;">{f.title}</h3>
              <p style="font-size: 0.85rem; color: #7a9bb0; line-height: 1.5;">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- STATS — dark -->
  <section style="background: #122838; padding: 2.5rem 1.5rem; border-top: 1px solid #1a3548; border-bottom: 1px solid #1a3548;">
    <div style="max-width: 900px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; text-align: center;">
      {[{ v: '150+', l: 'Clients' }, { v: '300+', l: 'Projects' }, { v: '10+', l: 'Years' }, { v: '98%', l: 'Satisfaction' }].map(s => (
        <div>
          <div style="font-size: 2rem; font-weight: 700; color: #E8A850;">{s.v}</div>
          <div style="font-size: 0.8rem; color: #5a7a90;">{s.l}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- SERVICES — dark -->
  <section style="background: #0f1e2a; padding: 4rem 1.5rem;">
    <div style="max-width: 1000px; margin: 0 auto;">
      <h2 style="font-size: 1.8rem; font-weight: 700; color: #e8ecf0; margin-bottom: 2.5rem; text-align: center;">Our Services</h2>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;">
        {[
          { title: 'HubSpot Onboarding', desc: 'Custom CRM configuration and data migration from day one.', color: '#1A7AB5' },
          { title: 'Marketing Automation', desc: 'Automated campaigns, lead scoring, and email sequences.', color: '#5AAB9D' },
          { title: 'Renewal Automation', desc: 'Deals that renew themselves with line item filtering.', color: '#C47A2A' },
        ].map(s => (
          <div style="background: #152535; border: 1px solid #1a3548; border-radius: 12px; overflow: hidden;">
            <div style={`height: 4px; background: ${s.color};`}></div>
            <div style="padding: 1.5rem;">
              <h3 style="font-size: 1.05rem; font-weight: 600; color: #c8d8e8; margin-bottom: 0.5rem;">{s.title}</h3>
              <p style="font-size: 0.85rem; color: #7a9bb0; line-height: 1.5; margin-bottom: 1rem;">{s.desc}</p>
              <a href="#" style={`color: ${s.color}; font-size: 0.85rem; font-weight: 600; text-decoration: none;`}>Learn more →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA — dark mode uses copper gradient -->
  <section style="background: linear-gradient(135deg, #C47A2A, #A86520); padding: 4rem 1.5rem;">
    <div style="max-width: 700px; margin: 0 auto; text-align: center;">
      <h2 style="font-size: 2rem; font-weight: 700; color: white; margin-bottom: 1rem;">Ready to grow your revenue?</h2>
      <p style="color: #fde8cc; font-size: 1.05rem; margin-bottom: 2rem;">Book a free consultation and see how renewal automation works.</p>
      <a href="#" style="background: white; color: #A86520; padding: 0.85rem 2rem; border-radius: 10px; font-size: 1rem; font-weight: 600; text-decoration: none;">Claim Your Free Consultation</a>
    </div>
  </section>

  <!-- FOOTER — dark -->
  <footer style="background: #0a1520; color: #c8d8e8; padding: 3rem 1.5rem 2rem;">
    <div style="max-width: 1000px; margin: 0 auto; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 2rem; margin-bottom: 2rem;">
      <div>
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
          <svg viewBox="0 0 120 120" width="24" height="24" xmlns="http://www.w3.org/2000/svg"><path d="M60,10 L103,35 L60,60 L17,35 Z" fill="#C47A2A" /><path d="M103,35 L103,85 L60,60 Z" fill="#5AAB9D" /><path d="M103,85 L60,110 L17,85 L60,60 Z" fill="#1A7AB5" /><path d="M17,85 L17,35 L60,60 Z" fill="#E0B820" /></svg>
          <span style="font-weight: 700;">SWOTbee</span>
        </div>
        <p style="font-size: 0.8rem; color: #5a7a90; max-width: 280px; line-height: 1.6;">Expert HubSpot consulting to streamline your experience.</p>
      </div>
      <div>
        <p style="font-size: 0.8rem; font-weight: 600; margin-bottom: 0.75rem;">Company</p>
        {['About', 'Services', 'Blog', 'Contact'].map(l => (<a href="#" style="display: block; color: #5a7a90; font-size: 0.8rem; text-decoration: none; padding: 0.2rem 0;">{l}</a>))}
      </div>
      <div>
        <p style="font-size: 0.8rem; font-weight: 600; margin-bottom: 0.75rem;">Services</p>
        {['Onboarding', 'Marketing', 'Sales', 'Integrations'].map(l => (<a href="#" style="display: block; color: #5a7a90; font-size: 0.8rem; text-decoration: none; padding: 0.2rem 0;">{l}</a>))}
      </div>
      <div>
        <p style="font-size: 0.8rem; font-weight: 600; margin-bottom: 0.75rem;">Legal</p>
        {['Privacy', 'Terms', 'Cookies', 'FAQs'].map(l => (<a href="#" style="display: block; color: #5a7a90; font-size: 0.8rem; text-decoration: none; padding: 0.2rem 0;">{l}</a>))}
      </div>
    </div>
    <div style="border-top: 1px solid #1a2d3d; padding-top: 1rem; text-align: center;">
      <p style="font-size: 0.75rem; color: #4a6a80;">© 2026 SWOTbee. All rights reserved.</p>
    </div>
  </footer>
</BaseLayout>
