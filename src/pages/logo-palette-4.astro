---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/astro/Navbar.astro';
---

<BaseLayout title="Logo — Palette 4: Premium Consulting">
  <Navbar />
  <div style="background: #f8f7f4; min-height: 100vh; padding: 3rem 1rem;">
    <div style="max-width: 900px; margin: 0 auto;">
      <h1 style="font-size: 1.5rem; font-weight: 700; color: #1e1b4b; margin-bottom: 0.5rem; text-align: center;">Palette 4: Premium Consulting</h1>
      <p style="text-align: center; color: #4a4a68; margin-bottom: 0.5rem; font-size: 0.85rem;">Deep Indigo · Warm Coral · Sage Teal · Pearl · Muted Navy</p>
      <div style="display: flex; justify-content: center; gap: 0.5rem; margin-bottom: 2.5rem;">
        <div style="width: 40px; height: 40px; border-radius: 8px; background: #1e1b4b;" title="#1e1b4b"></div>
        <div style="width: 40px; height: 40px; border-radius: 8px; background: #f97066;" title="#f97066"></div>
        <div style="width: 40px; height: 40px; border-radius: 8px; background: #5eaaad;" title="#5eaaad"></div>
        <div style="width: 40px; height: 40px; border-radius: 8px; background: #f8f7f4; border: 1px solid #e5e7eb;" title="#f8f7f4"></div>
        <div style="width: 40px; height: 40px; border-radius: 8px; background: #4a4a68;" title="#4a4a68"></div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 3rem;">
        <!-- Dark bg -->
        <div style="background: #1e1b4b; border-radius: 14px; padding: 2.5rem; display: flex; align-items: center; justify-content: center; gap: 1rem;">
          <svg viewBox="0 0 120 120" width="80" height="80" xmlns="http://www.w3.org/2000/svg">
            <!-- Top-left: Warm Coral -->
            <path d="M58,2 L58,58 L2,58 L2,20 Z" fill="#f97066" />
            <!-- Top-right: Sage Teal -->
            <path d="M62,2 L118,20 L118,58 L62,58 Z" fill="#5eaaad" />
            <!-- Bottom-left: Pearl/warm white -->
            <path d="M2,62 L58,62 L58,118 L2,100 Z" fill="#f8f7f4" />
            <!-- Bottom-right: Muted Navy -->
            <path d="M62,62 L118,62 L118,100 L62,118 Z" fill="#4a4a68" />
          </svg>
          <div>
            <div style="color: #ffffff; font-size: 1.3rem; font-weight: 700; font-family: sans-serif;">SWOT<span style="color: #5eaaad;">bee</span></div>
          </div>
        </div>

        <!-- Light bg -->
        <div style="background: #ffffff; border: 1px solid #e5e7eb; border-radius: 14px; padding: 2.5rem; display: flex; align-items: center; justify-content: center; gap: 1rem;">
          <svg viewBox="0 0 120 120" width="80" height="80" xmlns="http://www.w3.org/2000/svg">
            <path d="M58,2 L58,58 L2,58 L2,20 Z" fill="#f97066" />
            <path d="M62,2 L118,20 L118,58 L62,58 Z" fill="#5eaaad" />
            <path d="M2,62 L58,62 L58,118 L2,100 Z" fill="#1e1b4b" />
            <path d="M62,62 L118,62 L118,100 L62,118 Z" fill="#4a4a68" />
          </svg>
          <div>
            <div style="color: #1e1b4b; font-size: 1.3rem; font-weight: 700; font-family: sans-serif;">SWOT<span style="color: #5eaaad;">bee</span></div>
          </div>
        </div>
      </div>

      <!-- Sizes -->
      <div style="background: #1e1b4b; border-radius: 12px; padding: 2rem; display: flex; align-items: end; justify-content: center; gap: 2.5rem; margin-bottom: 2rem;">
        {[16, 32, 48, 80, 120].map(size => (
          <div style="text-align: center;">
            <svg viewBox="0 0 120 120" width={size} height={size} xmlns="http://www.w3.org/2000/svg">
              <path d="M58,2 L58,58 L2,58 L2,20 Z" fill="#f97066" />
              <path d="M62,2 L118,20 L118,58 L62,58 Z" fill="#5eaaad" />
              <path d="M2,62 L58,62 L58,118 L2,100 Z" fill="#f8f7f4" />
              <path d="M62,62 L118,62 L118,100 L62,118 Z" fill="#4a4a68" />
            </svg>
            <p style="color: #4a4a68; font-size: 0.6rem; margin-top: 0.5rem;">{size}px</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
