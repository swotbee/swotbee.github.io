---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/astro/Navbar.astro";
import Footer from "../components/astro/Footer.astro";
import ContactUs from "../components/astro/ContactUs.astro";
import ClientLogoStrip from "../components/astro/ClientLogoStrip.astro";
---

<Layout
  title="Contact SWOTBee | Book a Free Consultation"
  description="Book a free 30-minute discovery call. No commitment, no sales pitch — just an honest conversation about how we can help your HubSpot succeed."
>
  <Navbar />

  <section class="bg-gradient-to-b from-v6-bg to-white px-4 sm:px-6 lg:px-8 pt-16 sm:pt-20 pb-8">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-3xl sm:text-4xl font-bold text-v6-dark mb-4">Let's Talk</h1>
      <p class="text-base sm:text-lg text-v6-text-muted max-w-xl mx-auto leading-relaxed">
        Book a free 30-minute discovery call. No commitment, no sales pitch — just an honest conversation about whether we can help.
      </p>
    </div>
  </section>

  <ClientLogoStrip caption="Trusted by revenue and operations teams at" />

  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 pt-12">
    <ContactUs />
  </section>

  <Footer />
</Layout>
