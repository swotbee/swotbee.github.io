---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/astro/Navbar.astro';
import Footer from '../../components/astro/Footer.astro';
// Landing page for Ad Group 3 (competitor/marketplace searchers), per
// marketing/ads/14-landing-pages-build-plan.md Page A.
// Persona: RevOps leader / ops admin in evaluation mode, already using or
// comparing a deal-cloning app. The page CONCEDES cloning (the corpus shows
// those apps are genuinely liked for it) and widens the frame to the renewal
// system. Reviewer quotes below are verbatim from the harvested review corpus.
// NeuronWriter research completed 2026-09-10. The SERP is mixed with
// searches about renewing HubSpot's own subscription, so this page targets
// product-evaluation intent and excludes account-renewal terms.

const rows = [
  { cap: 'Low incremental software cost', native: 'yes', clone: 'partial', us: 'no', note: 'native Contracts require Revenue Hub Professional or Enterprise; cloning apps are usually lower-cost add-ons; SWOTBee is a scoped service' },
  { cap: 'Create a renewal deal and quote', native: 'yes', clone: 'partial', us: 'yes', note: 'native renewal quotes can use a new or existing deal; cloning apps copy a deal but do not always create it on schedule' },
  { cap: 'Carry current contract line items into the renewal quote', native: 'yes', clone: 'partial', us: 'yes', note: 'native inheritance works when the renewal quote starts from a Contract; marketplace app behavior varies' },
  { cap: 'Create the renewal motion automatically on schedule', native: 'yes', clone: 'no', us: 'yes' },
  { cap: 'Maintain the next contract after acceptance', native: 'yes', clone: 'no', us: 'yes', note: 'an accepted native renewal quote creates the next associated Contract' },
  { cap: 'Apply custom price escalations and uplift rules', native: 'partial', clone: 'no', us: 'yes', note: 'native templates and approvals help, but custom commercial rules still need design and testing' },
  { cap: 'Renewal pipeline with dates, owners, and alerts', native: 'yes', clone: 'no', us: 'yes' },
  { cap: 'NRR/GRR and renewal-accuracy reporting', native: 'partial', clone: 'no', us: 'yes', note: 'HubSpot provides recurring-revenue inputs, but NRR and GRR still require a defined reporting model' },
];
const mark = (v: string) => v === 'yes' ? '✓' : v === 'partial' ? '~' : '✗';
const markClass = (v: string) => v === 'yes' ? 'text-v6-teal font-bold' : v === 'partial' ? 'text-v6-amber font-bold' : 'text-gray-400 font-bold';

const faqs = [
  { q: 'Does HubSpot now support native contract renewals?', a: 'Yes. Revenue Hub Professional and Enterprise include a Contracts object. An accepted Revenue Hub quote can create a Contract, a workflow can create a renewal quote from that Contract, and acceptance creates the next associated Contract.' },
  { q: 'When are HubSpot native Contracts enough?', a: 'Native Contracts are a strong fit when agreements originate from Revenue Hub quotes and follow a standard line-item, term, and approval path. Test legacy imports, evergreen agreements, co-terming, custom uplifts, and external billing handoffs before choosing a native-only design.' },
  { q: 'Is a cloning app enough for my renewals?', a: 'A cloning app can be enough for low-volume, flat-priced renewals when someone reliably starts each copy. It does not by itself create a governed renewal calendar, approval process, forecast, or retention reporting model.' },
  { q: 'Why is a dedicated renewal pipeline important in HubSpot?', a: 'Renewals mixed into a new-business pipeline distort win rates and hide the contracts at risk. A dedicated renewal pipeline gives every commercial renewal an owner, stage, amount, and close date, whether the source is a native Contract or a legacy deal.' },
  { q: 'Can HubSpot workflows automate renewal reminders?', a: 'Yes. Contract and deal workflows can create tasks, alerts, renewal deals, and, for eligible Revenue Hub portals, renewal quotes. Generic deal-cloning workflows need extra care because line-item copying and self-triggering renewal chains have different constraints from the native Contract path.' },
  { q: 'Do I have to replace my cloning app?', a: 'No. Keep it if it solves a real legacy-deal use case. The decision is whether native Contracts, the app, or a hybrid process covers your sources of truth, pricing rules, dates, approvals, and reporting.' },
  { q: 'What does this cost?', a: 'Every business is different, so we scope after a free 30-minute call about how your renewals run today. No long-term contracts; we earn your trust month by month.' },
  { q: 'What happens on the free call?', a: '30 minutes, no prep. We map how renewals run today, where manual work and leakage hide, and what to fix first. You leave with the picture whether or not you work with us.' },
];

const guides = [
  { href: '/posts/hubspot-deal-cloning-apps-compared/', label: 'CloneNer vs Deal Duplicator vs Clone a Deal: cloning apps compared' },
  { href: '/posts/hubspot-clone-deal-complete-guide/', label: 'How to clone a deal in HubSpot: the complete guide' },
  { href: '/posts/hubspot-clone-deal-line-items/', label: 'Cloning deals with line items: the complete fix' },
  { href: '/posts/hubspot-renewal-workflow-infinite-loop-fix/', label: 'The workflow infinite-loop problem that breaks renewal chains' },
  { href: '/posts/hubspot-renewal-pipeline-complete-guide/', label: 'Building a renewal pipeline in HubSpot: the complete guide' },
  { href: '/posts/hubspot-contracts-renewal-quotes/', label: 'HubSpot Contracts and renewal quotes: complete setup guide' },
  { href: '/posts/hubspot-renewal-quote-price-increase/', label: 'Renewal quotes and price increases in HubSpot' },
  // Added 2026-09-03. This page was crawled on 2026-08-10 and linked to none of the
  // contract cluster published on 2026-09-01, nine pages of which Search Console still
  // reported as "URL is unknown to Google" the next day. See
  // marketing/seo/console-analysis/2026-09-02/INDEXING-FINDINGS.md. An already-crawled
  // page linking in is the cheapest way to get them walked.
  { href: '/posts/contract-management-software-compared/', label: 'Contract management software: 14 tools compared on real prices' },
  { href: '/posts/hubspot-contract-management/', label: 'HubSpot contract management: renewals, reminders, reporting' },
];

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
---
<BaseLayout
  title="HubSpot Native Renewals vs Renewal Apps: 2026 Comparison"
  description="Compare HubSpot native Contracts, deal-cloning apps, and a managed renewal system across line items, automation, pricing, pipelines, and reporting."
>
  <Navbar />

  <!-- HERO: continuity with the pinned ad headline "Cloning Is Just Step One" -->
  <section class="bg-gradient-to-b from-v6-bg to-white px-4 sm:px-6 lg:px-8 pt-16 pb-12">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-v6-copper mb-3">HubSpot Native Renewals And Apps</p>
      <h1 class="text-3xl sm:text-5xl font-bold text-v6-dark leading-tight mb-5 text-balance">
        HubSpot Native Renewals vs <span class="text-v6-copper">Renewal Apps</span>
      </h1>
      <p class="text-lg sm:text-xl text-v6-text-muted mb-4 leading-relaxed">
        HubSpot renewal apps are no longer the only alternative to manual deal cloning. HubSpot now has a native Contracts and renewal-quotes path in Revenue Hub Professional and Enterprise, while apps still help with legacy records and custom requirements.
      </p>
      <p class="text-base text-v6-text-muted mb-6">Here is the honest comparison, including where native HubSpot is enough, where an app remains useful, and where commercial rules or mixed data sources need a designed renewal process.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="#comparison" class="bg-v6-copper text-white px-8 py-3.5 rounded-xl text-base font-semibold hover:bg-v6-copper-600 transition-colors">See The Comparison ↓</a>
        <a href="/renewal-audit-call/" data-ga-cta="compare_hero_book_review" class="border border-gray-300 text-v6-dark px-8 py-3.5 rounded-xl text-base font-medium hover:bg-gray-50 transition-colors">Book a Renewal Alignment Call →</a>
      </div>
    </div>
  </section>

  <!-- HONESTY SECTION: concede what cloning apps do well -->
  <section class="bg-white px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-4 text-center">First, Credit Where It's Due</h2>
      <p class="text-base text-v6-text-muted text-center max-w-2xl mx-auto mb-8 leading-relaxed">
        Marketplace cloning apps earn their reviews. Users call them clean, simple, and time-saving, and they are right. If duplication is your whole problem, install one and be happy.
      </p>
      <div class="grid sm:grid-cols-2 gap-4 mb-6">
        <blockquote class="bg-v6-bg border border-v6-border rounded-xl p-5 text-sm text-v6-dark leading-relaxed">"Quick, seamless duplication of assets within HubSpot."<span class="block mt-2 text-xs text-gray-500">HubSpot Marketplace review of a cloning app</span></blockquote>
        <blockquote class="bg-v6-bg border border-v6-border rounded-xl p-5 text-sm text-v6-dark leading-relaxed">"Saves us so much time and frustration related to manual data entry."<span class="block mt-2 text-xs text-gray-500">HubSpot Marketplace review of a cloning app</span></blockquote>
      </div>
      <p class="text-base text-v6-text-muted text-center max-w-2xl mx-auto leading-relaxed">
        But read the critical reviews and the community threads, and a pattern shows: <em>"out of order line items after copy"</em>, <em>"double-check all duplicated properties"</em>, and workflows that clone deals hitting <em>"infinite loop"</em> protection. Cloning gets you a copy. Renewals need a system.
      </p>
    </div>
  </section>

  <!-- COMPARISON TABLE -->
  <section id="comparison" class="bg-v6-bg px-4 sm:px-6 lg:px-8 py-14 border-y border-v6-border">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-3 text-center">HubSpot Native Contracts vs Renewal Apps vs A Managed System</h2>
      <p class="text-base text-v6-text-muted text-center mb-8 max-w-2xl mx-auto">What each covers, capability by capability. "~" means it works with caveats reviewers themselves report.</p>
      <div class="overflow-x-auto rounded-2xl border border-v6-border bg-white">
        <table class="w-full text-sm text-left">
          <thead>
            <tr class="border-b border-v6-border bg-v6-bg">
              <th class="px-5 py-4 font-semibold text-v6-dark">Capability</th>
              <th class="px-5 py-4 font-semibold text-v6-dark text-center">HubSpot native Contracts</th>
              <th class="px-5 py-4 font-semibold text-v6-dark text-center">Deal cloning apps</th>
              <th class="px-5 py-4 font-semibold text-v6-dark text-center">SWOTBee Renewal Operations</th>
            </tr>
          </thead>
          <tbody>
            {rows.map(r => (
              <tr class="border-b border-v6-border last:border-0">
                <td class="px-5 py-4 text-v6-dark">{r.cap}{r.note && <span class="block text-xs text-gray-500 mt-1">{r.note}</span>}</td>
                <td class={`px-5 py-4 text-center text-lg ${markClass(r.native)}`}>{mark(r.native)}</td>
                <td class={`px-5 py-4 text-center text-lg ${markClass(r.clone)}`}>{mark(r.clone)}</td>
                <td class={`px-5 py-4 text-center text-lg ${markClass(r.us)}`}>{mark(r.us)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-gray-500 text-center mt-4">Native Contracts refers to the documented Revenue Hub Professional and Enterprise path. Deal-cloning app capabilities vary. Validate all three options against a pilot contract before rollout.</p>
      <div class="text-center mt-8">
        <a href="/resources/renewal-leakage-estimate/" data-ga-cta="compare_midpage_leakage_estimate" class="inline-block border border-v6-copper text-v6-copper px-7 py-3 rounded-xl text-base font-semibold hover:bg-v6-copper-50 transition-colors">Curious what the right column is worth? Get a 1-page leakage estimate (no call) →</a>
      </div>
    </div>
  </section>

  <!-- WHAT THE RENEWAL LAYER ADDS -->
  <section class="bg-white px-4 sm:px-6 lg:px-8 py-14">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-3 text-center">What The Renewal Layer Adds</h2>
      <p class="text-base text-v6-text-muted text-center mb-10 max-w-2xl mx-auto">Keep your cloning app if you like it. These are the parts a copy button cannot reach.</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-v6-bg rounded-xl p-6 border border-v6-border">
          <div class="text-2xl mb-3">📅</div>
          <h3 class="text-base font-semibold text-v6-dark mb-2">Deals that create themselves</h3>
          <p class="text-sm text-v6-text-muted leading-relaxed">Renewal deals appear on schedule, in a renewal pipeline, with an owner and alerts. Nobody has to remember to click.</p>
        </div>
        <div class="bg-v6-bg rounded-xl p-6 border border-v6-border">
          <div class="text-2xl mb-3">🧾</div>
          <h3 class="text-base font-semibold text-v6-dark mb-2">Escalations applied, not forgotten</h3>
          <p class="text-sm text-v6-text-muted leading-relaxed">Uplift and escalation math runs automatically, so contract price increases stop slipping through as flat renewals.</p>
        </div>
        <div class="bg-v6-bg rounded-xl p-6 border border-v6-border">
          <div class="text-2xl mb-3">🔗</div>
          <h3 class="text-base font-semibold text-v6-dark mb-2">Multi-year chains that hold</h3>
          <p class="text-sm text-v6-text-muted leading-relaxed">Workflow-cloned chains hit HubSpot's loop protection, often silently, around year 3. Ours are built to survive it.</p>
        </div>
        <div class="bg-v6-bg rounded-xl p-6 border border-v6-border">
          <div class="text-2xl mb-3">📊</div>
          <h3 class="text-base font-semibold text-v6-dark mb-2">ARR you can trust</h3>
          <p class="text-sm text-v6-text-muted leading-relaxed">Renewal and expansion revenue are separated, with NRR and GRR dashboards built from your HubSpot data so leadership can forecast with a documented model.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SEO SUPPORT: how to evaluate renewal apps (covers the questions searchers ask) -->
  <section class="bg-v6-bg px-4 sm:px-6 lg:px-8 py-14 border-y border-v6-border">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-4 text-center">How To Choose A HubSpot Renewal App</h2>
      <p class="text-base text-v6-text-muted mb-6 leading-relaxed">Whether you use native Contracts, a marketplace app, or a managed build, evaluate the option against how renewals actually run in your CRM. Use these four questions:</p>
      <ol class="list-decimal list-inside flex flex-col gap-4 text-base text-v6-dark">
        <li><strong>Does it create the renewal, or just copy a deal?</strong><span class="block text-sm text-v6-text-muted mt-1 ml-5">Automation means the renewal deal appears in the renewal pipeline on schedule, without a human remembering to click. A copy button is a convenience; a workflow that triggers from the contract date is a system.</span></li>
        <li><strong>What happens to line items and pricing?</strong><span class="block text-sm text-v6-text-muted mt-1 ml-5">Line items should carry over in order, with escalation clauses and uplifts applied to the new pricing, not pasted flat from last year.</span></li>
        <li><strong>Does it survive year 3?</strong><span class="block text-sm text-v6-text-muted mt-1 ml-5">Multi-year renewal chains are where workflow-based cloning breaks, because HubSpot's loop protection stops a workflow from re-triggering on its own output. Ask the vendor directly how their integration handles it.</span></li>
        <li><strong>Can leadership see renewal revenue?</strong><span class="block text-sm text-v6-text-muted mt-1 ml-5">Renewal rate, NRR/GRR, and expansion-vs-renewal splits should land in HubSpot dashboards. If the app only moves deals, your forecast is still a spreadsheet.</span></li>
      </ol>
      <div class="mt-8 bg-white border border-v6-border rounded-2xl p-6 text-center">
        <p class="text-base font-semibold text-v6-dark mb-2">Want to score your current setup against these four questions?</p>
        <p class="text-sm text-v6-text-muted mb-4">Use the 1-page leakage estimate first. It is the launch-ready path for turning these questions into a concrete number without booking a call.</p>
        <a href="/resources/renewal-leakage-estimate/" data-ga-cta="compare_footer_leakage_estimate" class="inline-block bg-v6-copper text-white px-7 py-3 rounded-xl text-base font-semibold hover:bg-v6-copper-600 transition-colors">Get Your 1-Page Leakage Estimate →</a>
      </div>
    </div>
  </section>

  <!-- RELATED GUIDES (self-serve path for research-mode visitors; placed before the proof/CTA closing sequence) -->
  <section class="bg-white px-4 sm:px-6 lg:px-8 py-14">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-xl sm:text-2xl font-bold text-v6-dark mb-3 text-center">Still In Research Mode? The Deep-Dive Guides</h2>
      <p class="text-sm text-v6-text-muted text-center mb-6 max-w-xl mx-auto">Everything on this page, in step-by-step detail. Free, no email required. The renewal audit is for when you want your specific setup diagnosed instead.</p>
      <ul class="grid sm:grid-cols-2 gap-3">
        {guides.map(g => (
          <li><a href={g.href} class="block bg-v6-bg border border-v6-border rounded-xl px-4 py-3 text-sm font-medium text-v6-dark hover:border-v6-copper transition-colors">{g.label} →</a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PROOF BAND -->
  <section class="bg-v6-dark px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-4xl mx-auto grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
      <div><p class="text-3xl font-bold text-white">~50%</p><p class="text-sm text-gray-300 mt-1">lift in renewal accuracy</p></div>
      <div><p class="text-3xl font-bold text-white">90%</p><p class="text-sm text-gray-300 mt-1">less quote-creation effort</p></div>
      <div><p class="text-3xl font-bold text-white">2 wks</p><p class="text-sm text-gray-300 mt-1">to first results</p></div>
      <div><p class="text-3xl font-bold text-white">0</p><p class="text-sm text-gray-300 mt-1">long-term contracts required</p></div>
    </div>
    <blockquote class="max-w-2xl mx-auto text-center mt-8 text-base text-gray-200 leading-relaxed">"Renewal accuracy up about 50%. The team shifted from admin work to growth."<span class="block mt-2 text-sm text-gray-400">VP Sales, Energy & Utilities company (80+ employees, HubSpot Enterprise)</span></blockquote>
    <blockquote class="max-w-2xl mx-auto text-center mt-5 text-base text-gray-200 leading-relaxed">"Quote response 65% faster, and distributor satisfaction up 30%."<span class="block mt-2 text-sm text-gray-400">Sales Operations Manager, Manufacturing</span></blockquote>
    <p class="text-xs text-gray-400 text-center mt-5 max-w-xl mx-auto">Outcomes from client engagements, shared with permission and anonymized. Your results depend on your data and process. You own everything we build, in your portal: if we part ways, it keeps working.</p>
  </section>

  <!-- FAQ -->
  <section class="bg-white px-4 sm:px-6 lg:px-8 py-14">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-8 text-center">Frequently Asked Questions</h2>
      <div class="flex flex-col gap-3">
        {faqs.map(f => (
          <details class="group bg-v6-bg border border-v6-border rounded-xl px-5 py-4">
            <summary class="cursor-pointer text-base font-semibold text-v6-dark list-none flex justify-between items-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-v6-copper rounded-lg">
              {f.q}<span aria-hidden="true" class="text-v6-copper group-open:rotate-45 transition-transform text-xl leading-none">+</span>
            </summary>
            <p class="text-sm text-v6-text-muted leading-relaxed mt-3">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <script is:inline type="application/ld+json" set:html={faqSchema} />

  <!-- RISK REVERSAL CTA -->
  <section class="bg-gradient-to-br from-v6-copper to-v6-copper-600 px-4 sm:px-6 lg:px-8 py-16">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">Not Sure Which You Need? Let's Look At Your Renewals.</h2>
      <p class="text-base text-white/90 mb-7 leading-relaxed">A free 30-minute call about how renewals run in your HubSpot today. No prep, no obligation, and the findings are yours to keep whatever you decide. If a cloning app really is all you need, the review will say so in writing.</p>
      <a href="/renewal-audit-call/" data-ga-cta="compare_final_book_review" class="inline-block bg-white text-v6-copper px-8 py-3.5 rounded-xl text-base font-semibold hover:bg-gray-100 transition-colors">Book a Renewal Alignment Call →</a>
      <p class="text-sm text-white/80 mt-4">No long-term contracts. We earn your trust month by month.</p>
    </div>
  </section>

  <Footer />
</BaseLayout>
