---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/astro/Navbar.astro";
import Footer from "../components/astro/Footer.astro";
import NewsletterForm from "../components/astro/NewsletterForm.astro";
---

<Layout
  title="Subscribe | HubSpot Tips & RevOps Insights"
  description="Subscribe to SWOTBee's newsletter for HubSpot tips, revenue operations strategies, and growth insights for mid-sized companies."
>
  <Navbar />

  <section class="bg-gradient-to-b from-v6-bg to-white px-4 sm:px-6 lg:px-8 pt-16 sm:pt-20 pb-8">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-3xl sm:text-4xl font-bold text-v6-dark mb-4">Subscribe to Our Newsletter</h1>
      <p class="text-base sm:text-lg text-v6-text-muted max-w-xl mx-auto leading-relaxed">
        HubSpot tips, RevOps strategies, and growth insights, delivered to your inbox.
      </p>
    </div>
  </section>

  <section class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <NewsletterForm variant="light" />
  </section>

  <Footer />
</Layout>
