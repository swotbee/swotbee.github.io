---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import Footer from "../components/astro/Footernew.astro";
import Values from "../components/astro/Valuesnew.astro";
import Team from "../components/astro/Teamnew.astro";
import Mission from "../components/astro/Missionnew.astro";
import Logos from "../components/astro/Logosnew.astro";

import Navbar from "../components/astro/Navbarnew.astro";
---

<Layout
  title="About SWOTBee | Your HubSpot & Shopify Integration Partner"
  description="Meet the team behind SWOTBee's HubSpot and Shopify consulting services. Learn about our mission, values, and commitment to helping businesses optimize their CRM and e-commerce operations."
>
  <Navbar />
  <section class="bg-coral-glow-50 mx-auto px-4 py-12">
    <Team />
    <Mission />
    <Values />
    <Logos />
  </section>
  <Footer />
</Layout>
