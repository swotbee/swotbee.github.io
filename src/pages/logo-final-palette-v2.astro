---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/astro/Navbar.astro';

// 4 shade mix palettes from the same 4 color families
const palettes = [
  {
    name: 'V2: Deep & Rich',
    desc: 'Darker shades — Dark Amber, Deep Teal, Deep Blue, Gold',
    colors: ['#c48800', '#3d8a7a', '#0a3d6b', '#d4a80c'],
    shadeNames: ['Dark Amber', 'Deep Teal', 'Deep Blue', 'Gold'],
  },
  {
    name: 'V3: Light & Airy',
    desc: 'Lighter shades — Light Yellow, Light Teal, Light Blue, Pale Amber',
    colors: ['#fdd96b', '#b5ddd4', '#a7d8e8', '#f5c842'],
    shadeNames: ['Light Yellow', 'Light Teal', 'Light Blue', 'Pale Amber'],
  },
  {
    name: 'V4: Mixed Contrast',
    desc: 'Dark + light alternating — Deep Blue, Light Teal, Dark Amber, Light Blue',
    colors: ['#0a3d6b', '#b5ddd4', '#c48800', '#a7d8e8'],
    shadeNames: ['Deep Blue', 'Light Teal', 'Dark Amber', 'Light Blue'],
  },
  {
    name: 'V5: Mid-tones',
    desc: 'All mid-range shades — Mid Blue, Teal, Amber, Warm Yellow',
    colors: ['#1a7ab5', '#5aab9d', '#d4960a', '#e0b820'],
    shadeNames: ['Mid Blue', 'Mid Teal', 'Mid Amber', 'Warm Yellow'],
  },
];
---

<BaseLayout title="Logo — Final Palette Shade Mixes">
  <Navbar />
  <div style="background: #f5f3ef; min-height: 100vh; padding: 3rem 1rem;">
    <div style="max-width: 1100px; margin: 0 auto;">

      <h1 style="font-size: 1.8rem; font-weight: 700; color: #1a2530; margin-bottom: 0.5rem; text-align: center;">Shade Mix Variations</h1>
      <p style="text-align: center; color: #6b7a8a; margin-bottom: 2.5rem; font-size: 0.9rem;">Same 4 color families (Amber, Teal, Blue, Yellow) — different shade combos</p>

      {palettes.map((pal, pi) => (
        <div style="margin-bottom: 3.5rem;">
          <h2 style="font-size: 1.15rem; font-weight: 600; color: #1a2530; margin-bottom: 0.25rem; text-align: center;">{pal.name}</h2>
          <p style="text-align: center; color: #6b7a8a; margin-bottom: 0.75rem; font-size: 0.8rem;">{pal.desc}</p>

          <!-- Swatches -->
          <div style="display: flex; justify-content: center; gap: 0.75rem; margin-bottom: 1.5rem;">
            {pal.colors.map((c, i) => (
              <div style="text-align: center;">
                <div style={`width: 44px; height: 44px; border-radius: 8px; background: ${c}; ${c === '#fdd96b' || c === '#b5ddd4' || c === '#a7d8e8' || c === '#f5c842' ? 'border: 1px solid #ccc;' : ''}`}></div>
                <span style="font-size: 0.55rem; color: #6b7a8a;">{pal.shadeNames[i]}<br/>{c}</span>
              </div>
            ))}
          </div>

          <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem;">

            <!-- Split Hex -->
            <div style="text-align: center;">
              <p style="font-size: 0.75rem; color: #6b7a8a; margin-bottom: 0.4rem; font-weight: 600;">Split Hex</p>
              <div style="background: #1a2530; border-radius: 10px; padding: 1.25rem; margin-bottom: 0.5rem; display: flex; align-items: center; justify-content: center;">
                <svg viewBox="0 0 120 120" width="85" height="85" xmlns="http://www.w3.org/2000/svg">
                  <path d="M60,10 L103,35 L60,60 L17,35 Z" fill={pal.colors[0]} />
                  <path d="M103,35 L103,85 L60,60 Z" fill={pal.colors[1]} />
                  <path d="M103,85 L60,110 L17,85 L60,60 Z" fill={pal.colors[2]} />
                  <path d="M17,85 L17,35 L60,60 Z" fill={pal.colors[3]} />
                  <polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke={pal.colors[0]} stroke-width="1" opacity="0.3" />
                </svg>
              </div>
              <div style="background: #ffffff; border: 1px solid #e5e2da; border-radius: 10px; padding: 1.25rem; display: flex; align-items: center; justify-content: center;">
                <svg viewBox="0 0 120 120" width="85" height="85" xmlns="http://www.w3.org/2000/svg">
                  <path d="M60,10 L103,35 L60,60 L17,35 Z" fill={pal.colors[0]} />
                  <path d="M103,35 L103,85 L60,60 Z" fill={pal.colors[1]} />
                  <path d="M103,85 L60,110 L17,85 L60,60 Z" fill={pal.colors[2]} />
                  <path d="M17,85 L17,35 L60,60 Z" fill={pal.colors[3]} />
                  <polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke="#ddd" stroke-width="0.75" />
                </svg>
              </div>
            </div>

            <!-- 6 Slices -->
            <div style="text-align: center;">
              <p style="font-size: 0.75rem; color: #6b7a8a; margin-bottom: 0.4rem; font-weight: 600;">6 Slices</p>
              <div style="background: #1a2530; border-radius: 10px; padding: 1.25rem; margin-bottom: 0.5rem; display: flex; align-items: center; justify-content: center;">
                <svg viewBox="0 0 120 120" width="85" height="85" xmlns="http://www.w3.org/2000/svg">
                  <path d="M60,60 L60,10 L103,35 Z" fill={pal.colors[0]} />
                  <path d="M60,60 L103,35 L103,85 Z" fill={pal.colors[1]} />
                  <path d="M60,60 L103,85 L60,110 Z" fill={pal.colors[2]} />
                  <path d="M60,60 L60,110 L17,85 Z" fill={pal.colors[3]} />
                  <path d="M60,60 L17,85 L17,35 Z" fill={pal.colors[1]} opacity="0.6" />
                  <path d="M60,60 L17,35 L60,10 Z" fill={pal.colors[0]} opacity="0.6" />
                  <polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke={pal.colors[0]} stroke-width="1" opacity="0.3" />
                </svg>
              </div>
              <div style="background: #ffffff; border: 1px solid #e5e2da; border-radius: 10px; padding: 1.25rem; display: flex; align-items: center; justify-content: center;">
                <svg viewBox="0 0 120 120" width="85" height="85" xmlns="http://www.w3.org/2000/svg">
                  <path d="M60,60 L60,10 L103,35 Z" fill={pal.colors[0]} />
                  <path d="M60,60 L103,35 L103,85 Z" fill={pal.colors[1]} />
                  <path d="M60,60 L103,85 L60,110 Z" fill={pal.colors[2]} />
                  <path d="M60,60 L60,110 L17,85 Z" fill={pal.colors[3]} />
                  <path d="M60,60 L17,85 L17,35 Z" fill={pal.colors[1]} opacity="0.6" />
                  <path d="M60,60 L17,35 L60,10 Z" fill={pal.colors[0]} opacity="0.6" />
                  <polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke="#ddd" stroke-width="0.75" />
                </svg>
              </div>
            </div>

            <!-- Cluster -->
            <div style="text-align: center;">
              <p style="font-size: 0.75rem; color: #6b7a8a; margin-bottom: 0.4rem; font-weight: 600;">Cluster</p>
              <div style="background: #1a2530; border-radius: 10px; padding: 1.25rem; margin-bottom: 0.5rem; display: flex; align-items: center; justify-content: center;">
                <svg viewBox="0 0 120 110" width="85" height="78" xmlns="http://www.w3.org/2000/svg">
                  <polygon points="38,8 54,18 54,36 38,46 22,36 22,18" fill={pal.colors[0]} />
                  <polygon points="72,8 88,18 88,36 72,46 56,36 56,18" fill={pal.colors[2]} />
                  <polygon points="21,40 37,50 37,68 21,78 5,68 5,50" fill={pal.colors[3]} />
                  <polygon points="55,40 71,50 71,68 55,78 39,68 39,50" fill={pal.colors[1]} />
                  <polygon points="89,40 105,50 105,68 89,78 73,68 73,50" fill={pal.colors[0]} opacity="0.5" />
                  <polygon points="38,72 54,82 54,100 38,110 22,100 22,82" fill={pal.colors[2]} opacity="0.5" />
                  <polygon points="72,72 88,82 88,100 72,110 56,100 56,82" fill={pal.colors[3]} opacity="0.5" />
                </svg>
              </div>
              <div style="background: #ffffff; border: 1px solid #e5e2da; border-radius: 10px; padding: 1.25rem; display: flex; align-items: center; justify-content: center;">
                <svg viewBox="0 0 120 110" width="85" height="78" xmlns="http://www.w3.org/2000/svg">
                  <polygon points="38,8 54,18 54,36 38,46 22,36 22,18" fill={pal.colors[0]} />
                  <polygon points="72,8 88,18 88,36 72,46 56,36 56,18" fill={pal.colors[2]} />
                  <polygon points="21,40 37,50 37,68 21,78 5,68 5,50" fill={pal.colors[3]} />
                  <polygon points="55,40 71,50 71,68 55,78 39,68 39,50" fill={pal.colors[1]} />
                  <polygon points="89,40 105,50 105,68 89,78 73,68 73,50" fill={pal.colors[0]} opacity="0.4" />
                  <polygon points="38,72 54,82 54,100 38,110 22,100 22,82" fill={pal.colors[2]} opacity="0.4" />
                  <polygon points="72,72 88,82 88,100 72,110 56,100 56,82" fill={pal.colors[3]} opacity="0.4" />
                </svg>
              </div>
            </div>

            <!-- Quadrant -->
            <div style="text-align: center;">
              <p style="font-size: 0.75rem; color: #6b7a8a; margin-bottom: 0.4rem; font-weight: 600;">Quadrant</p>
              <div style="background: #1a2530; border-radius: 10px; padding: 1.25rem; margin-bottom: 0.5rem; display: flex; align-items: center; justify-content: center;">
                <svg viewBox="0 0 120 120" width="85" height="85" xmlns="http://www.w3.org/2000/svg">
                  <path d="M58,2 L58,58 L2,58 L2,20 Z" fill={pal.colors[0]} />
                  <path d="M62,2 L118,20 L118,58 L62,58 Z" fill={pal.colors[1]} />
                  <path d="M2,62 L58,62 L58,118 L2,100 Z" fill={pal.colors[3]} />
                  <path d="M62,62 L118,62 L118,100 L62,118 Z" fill={pal.colors[2]} />
                </svg>
              </div>
              <div style="background: #ffffff; border: 1px solid #e5e2da; border-radius: 10px; padding: 1.25rem; display: flex; align-items: center; justify-content: center;">
                <svg viewBox="0 0 120 120" width="85" height="85" xmlns="http://www.w3.org/2000/svg">
                  <path d="M58,2 L58,58 L2,58 L2,20 Z" fill={pal.colors[0]} />
                  <path d="M62,2 L118,20 L118,58 L62,58 Z" fill={pal.colors[1]} />
                  <path d="M2,62 L58,62 L58,118 L2,100 Z" fill={pal.colors[3]} />
                  <path d="M62,62 L118,62 L118,100 L62,118 Z" fill={pal.colors[2]} />
                </svg>
              </div>
            </div>
          </div>

          <!-- Lockups for this palette -->
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 1rem;">
            <div style="background: #1a2530; border-radius: 10px; padding: 1rem; display: flex; align-items: center; gap: 0.75rem;">
              <svg viewBox="0 0 120 120" width="40" height="40" xmlns="http://www.w3.org/2000/svg">
                <path d="M60,10 L103,35 L60,60 L17,35 Z" fill={pal.colors[0]} /><path d="M103,35 L103,85 L60,60 Z" fill={pal.colors[1]} /><path d="M103,85 L60,110 L17,85 L60,60 Z" fill={pal.colors[2]} /><path d="M17,85 L17,35 L60,60 Z" fill={pal.colors[3]} /><polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke={pal.colors[0]} stroke-width="1" opacity="0.3" />
              </svg>
              <div>
                <div style="color: #ffffff; font-size: 0.95rem; font-weight: 700; font-family: sans-serif;">SWOT<span style={`color: ${pal.colors[1]};`}>bee</span></div>
                <div style="color: #6b7a8a; font-size: 0.6rem;">{pal.name}</div>
              </div>
            </div>
            <div style="background: #ffffff; border: 1px solid #e5e2da; border-radius: 10px; padding: 1rem; display: flex; align-items: center; gap: 0.75rem;">
              <svg viewBox="0 0 120 120" width="40" height="40" xmlns="http://www.w3.org/2000/svg">
                <path d="M60,10 L103,35 L60,60 L17,35 Z" fill={pal.colors[0]} /><path d="M103,35 L103,85 L60,60 Z" fill={pal.colors[1]} /><path d="M103,85 L60,110 L17,85 L60,60 Z" fill={pal.colors[2]} /><path d="M17,85 L17,35 L60,60 Z" fill={pal.colors[3]} /><polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke="#ddd" stroke-width="0.75" />
              </svg>
              <div>
                <div style={`color: #1a2530; font-size: 0.95rem; font-weight: 700; font-family: sans-serif;`}>SWOT<span style={`color: ${pal.colors[2]};`}>bee</span></div>
                <div style="color: #6b7a8a; font-size: 0.6rem;">{pal.name}</div>
              </div>
            </div>
          </div>
        </div>
      ))}

    </div>
  </div>
</BaseLayout>
