---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/astro/Navbar.astro";
import Footer from "../components/astro/Footer.astro";
import Team from "../components/astro/Team.astro";
import Mission from "../components/astro/Mission.astro";
import Values from "../components/astro/Values.astro";
import Logos from "../components/astro/Logos.astro";
---

<Layout
  title="About SWOTBee | HubSpot Consulting for Energy, Manufacturing & SaaS"
  description="We empower mid-sized companies to turn HubSpot into a revenue engine. Meet the team, learn our mission, and see why clients trust us."
>
  <Navbar />

  <!-- Hero -->
  <section class="bg-gradient-to-b from-v6-bg to-white px-4 sm:px-6 lg:px-8 pt-16 sm:pt-20 pb-8">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-3xl sm:text-4xl font-bold text-v6-dark mb-4">About SWOTBee</h1>
      <p class="text-base sm:text-lg text-v6-text-muted max-w-xl mx-auto leading-relaxed">
        We empower mid-sized companies in Energy, Utilities, SaaS, Construction, and Manufacturing to turn HubSpot into a revenue engine — driving high adoption and predictable growth.
      </p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <Team />
    <Mission />
    <Values />
    <Logos />
  </section>

  <Footer />
</Layout>
