---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/astro/Navbar.astro';
---

<BaseLayout title="Logo — Palette 2: Modern SaaS">
  <Navbar />
  <div style="background: #f0f4f8; min-height: 100vh; padding: 3rem 1rem;">
    <div style="max-width: 900px; margin: 0 auto;">
      <h1 style="font-size: 1.5rem; font-weight: 700; color: #0a1628; margin-bottom: 0.5rem; text-align: center;">Palette 2: Modern SaaS</h1>
      <p style="text-align: center; color: #64748b; margin-bottom: 0.5rem; font-size: 0.85rem;">Ink Black · Electric Blue · Amber Gold · Ice White · Cool Gray</p>
      <div style="display: flex; justify-content: center; gap: 0.5rem; margin-bottom: 2.5rem;">
        <div style="width: 40px; height: 40px; border-radius: 8px; background: #0a1628;" title="#0a1628"></div>
        <div style="width: 40px; height: 40px; border-radius: 8px; background: #0099ff;" title="#0099ff"></div>
        <div style="width: 40px; height: 40px; border-radius: 8px; background: #efbb03;" title="#efbb03"></div>
        <div style="width: 40px; height: 40px; border-radius: 8px; background: #f0f4f8; border: 1px solid #cbd5e1;" title="#f0f4f8"></div>
        <div style="width: 40px; height: 40px; border-radius: 8px; background: #64748b;" title="#64748b"></div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 3rem;">
        <!-- Dark bg -->
        <div style="background: #0a1628; border-radius: 14px; padding: 2.5rem; display: flex; align-items: center; justify-content: center; gap: 1rem;">
          <svg viewBox="0 0 120 120" width="80" height="80" xmlns="http://www.w3.org/2000/svg">
            <!-- Top-left: Electric Blue -->
            <path d="M58,2 L58,58 L2,58 L2,20 Z" fill="#0099ff" />
            <!-- Top-right: Amber Gold -->
            <path d="M62,2 L118,20 L118,58 L62,58 Z" fill="#efbb03" />
            <!-- Bottom-left: Cool Gray -->
            <path d="M2,62 L58,62 L58,118 L2,100 Z" fill="#64748b" />
            <!-- Bottom-right: Ice lighter blue -->
            <path d="M62,62 L118,62 L118,100 L62,118 Z" fill="#00b5de" />
          </svg>
          <div>
            <div style="color: #ffffff; font-size: 1.3rem; font-weight: 700; font-family: sans-serif;">SWOT<span style="color: #0099ff;">bee</span></div>
          </div>
        </div>

        <!-- Light bg -->
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 2.5rem; display: flex; align-items: center; justify-content: center; gap: 1rem;">
          <svg viewBox="0 0 120 120" width="80" height="80" xmlns="http://www.w3.org/2000/svg">
            <path d="M58,2 L58,58 L2,58 L2,20 Z" fill="#0099ff" />
            <path d="M62,2 L118,20 L118,58 L62,58 Z" fill="#efbb03" />
            <path d="M2,62 L58,62 L58,118 L2,100 Z" fill="#0a1628" />
            <path d="M62,62 L118,62 L118,100 L62,118 Z" fill="#00b5de" />
          </svg>
          <div>
            <div style="color: #0a1628; font-size: 1.3rem; font-weight: 700; font-family: sans-serif;">SWOT<span style="color: #0099ff;">bee</span></div>
          </div>
        </div>
      </div>

      <!-- Sizes -->
      <div style="background: #0a1628; border-radius: 12px; padding: 2rem; display: flex; align-items: end; justify-content: center; gap: 2.5rem; margin-bottom: 2rem;">
        {[16, 32, 48, 80, 120].map(size => (
          <div style="text-align: center;">
            <svg viewBox="0 0 120 120" width={size} height={size} xmlns="http://www.w3.org/2000/svg">
              <path d="M58,2 L58,58 L2,58 L2,20 Z" fill="#0099ff" />
              <path d="M62,2 L118,20 L118,58 L62,58 Z" fill="#efbb03" />
              <path d="M2,62 L58,62 L58,118 L2,100 Z" fill="#64748b" />
              <path d="M62,62 L118,62 L118,100 L62,118 Z" fill="#00b5de" />
            </svg>
            <p style="color: #64748b; font-size: 0.6rem; margin-top: 0.5rem;">{size}px</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
