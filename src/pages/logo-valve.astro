---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/astro/Navbar.astro';
---

<BaseLayout robots="noindex, follow" title="Logo Preview — Tesla Valve">
  <Navbar />
  <div style="background: #f8fafb; min-height: 100vh; padding: 3rem 1rem;">
    <div style="max-width: 1100px; margin: 0 auto;">

      <h1 style="font-size: 1.8rem; font-weight: 700; color: #1b2a37; margin-bottom: 0.5rem; text-align: center;">Tesla Valve + Revenue Flow</h1>
      <p style="text-align: center; color: #5b87ae; margin-bottom: 2.5rem; font-size: 0.9rem;">Revenue flows forward through renewals. The valve geometry prevents it from leaking back.</p>


      <!-- ============ FULL-WIDTH CONCEPT ILLUSTRATIONS ============ -->

      <h2 style="font-size: 1.1rem; font-weight: 600; color: #1b2a37; margin-bottom: 1rem;">Concept: Forward Revenue Flow (unimpeded)</h2>

      <!-- Forward flow — dark -->
      <div style="background: #1b2a37; border-radius: 14px; padding: 2.5rem 2rem; margin-bottom: 1.5rem;">
        <svg viewBox="0 0 800 160" width="100%" xmlns="http://www.w3.org/2000/svg">

          <!-- Main channel (the straight-through path) -->
          <path d="M40,80 L760,80" fill="none" stroke="#253d52" stroke-width="28" stroke-linecap="round" />
          <path d="M40,80 L760,80" fill="none" stroke="#1e3244" stroke-width="22" stroke-linecap="round" />

          <!-- U-bend diversions (alternating top/bottom, matching Tesla valve shape) -->
          <!-- Bend 1: top -->
          <path d="M160,80 C160,30 240,30 240,80" fill="none" stroke="#253d52" stroke-width="22" stroke-linecap="round" />
          <path d="M160,80 C160,36 240,36 240,80" fill="none" stroke="#1e3244" stroke-width="16" stroke-linecap="round" />

          <!-- Bend 2: bottom -->
          <path d="M310,80 C310,130 390,130 390,80" fill="none" stroke="#253d52" stroke-width="22" stroke-linecap="round" />
          <path d="M310,80 C310,124 390,124 390,80" fill="none" stroke="#1e3244" stroke-width="16" stroke-linecap="round" />

          <!-- Bend 3: top -->
          <path d="M460,80 C460,30 540,30 540,80" fill="none" stroke="#253d52" stroke-width="22" stroke-linecap="round" />
          <path d="M460,80 C460,36 540,36 540,80" fill="none" stroke="#1e3244" stroke-width="16" stroke-linecap="round" />

          <!-- Bend 4: bottom -->
          <path d="M610,80 C610,130 690,130 690,80" fill="none" stroke="#253d52" stroke-width="22" stroke-linecap="round" />
          <path d="M610,80 C610,124 690,124 690,80" fill="none" stroke="#1e3244" stroke-width="16" stroke-linecap="round" />

          <!-- Forward flow arrows (teal — revenue flowing smoothly) -->
          <polygon points="120,72 135,80 120,88" fill="#70c1b3" opacity="0.8" />
          <polygon points="270,72 285,80 270,88" fill="#70c1b3" opacity="0.8" />
          <polygon points="420,72 435,80 420,88" fill="#70c1b3" opacity="0.8" />
          <polygon points="570,72 585,80 570,88" fill="#70c1b3" opacity="0.8" />
          <polygon points="720,72 735,80 720,88" fill="#70c1b3" opacity="0.8" />

          <!-- Revenue labels -->
          <text x="50" y="82" fill="#70c1b3" font-size="13" font-weight="700" font-family="sans-serif" dominant-baseline="middle">$1.2M</text>
          <text x="740" y="82" fill="#F5C400" font-size="14" font-weight="700" font-family="sans-serif" dominant-baseline="middle">$2.4M</text>

          <!-- Bolt at first junction -->
          <circle cx="160" cy="80" r="10" fill="#F5C400" />
          <path d="M159,74 L156.5,81 L159,80 L158,86 L162,79 L159,80 Z" fill="#1b2a37" />

          <!-- Label -->
          <text x="400" y="152" text-anchor="middle" fill="#70c1b3" font-size="10" opacity="0.6" font-family="sans-serif">→ revenue flows forward through automated renewals →</text>
        </svg>
      </div>

      <h2 style="font-size: 1.1rem; font-weight: 600; color: #1b2a37; margin-bottom: 1rem;">Concept: Reverse Flow Blocked (revenue leak stopped)</h2>

      <!-- Reverse flow blocked — dark -->
      <div style="background: #1b2a37; border-radius: 14px; padding: 2.5rem 2rem; margin-bottom: 2.5rem;">
        <svg viewBox="0 0 800 160" width="100%" xmlns="http://www.w3.org/2000/svg">

          <!-- Main channel -->
          <path d="M40,80 L760,80" fill="none" stroke="#253d52" stroke-width="28" stroke-linecap="round" />
          <path d="M40,80 L760,80" fill="none" stroke="#1e3244" stroke-width="22" stroke-linecap="round" />

          <!-- U-bend diversions -->
          <path d="M160,80 C160,30 240,30 240,80" fill="none" stroke="#253d52" stroke-width="22" stroke-linecap="round" />
          <path d="M160,80 C160,36 240,36 240,80" fill="none" stroke="#1e3244" stroke-width="16" stroke-linecap="round" />

          <path d="M310,80 C310,130 390,130 390,80" fill="none" stroke="#253d52" stroke-width="22" stroke-linecap="round" />
          <path d="M310,80 C310,124 390,124 390,80" fill="none" stroke="#1e3244" stroke-width="16" stroke-linecap="round" />

          <path d="M460,80 C460,30 540,30 540,80" fill="none" stroke="#253d52" stroke-width="22" stroke-linecap="round" />
          <path d="M460,80 C460,36 540,36 540,80" fill="none" stroke="#1e3244" stroke-width="16" stroke-linecap="round" />

          <path d="M610,80 C610,130 690,130 690,80" fill="none" stroke="#253d52" stroke-width="22" stroke-linecap="round" />
          <path d="M610,80 C610,124 690,124 690,80" fill="none" stroke="#1e3244" stroke-width="16" stroke-linecap="round" />

          <!-- Reverse flow arrows (red — revenue trying to leak back, getting caught in bends) -->
          <polygon points="680,72 665,80 680,88" fill="#ff5c35" opacity="0.6" />

          <!-- Revenue getting caught in U-bends (red arrows curving into bends) -->
          <path d="M650,80 C650,118 600,118 600,88" fill="none" stroke="#ff5c35" stroke-width="2" stroke-dasharray="4 3" opacity="0.5" />
          <polygon points="598,92 600,84 605,92" fill="#ff5c35" opacity="0.5" />

          <path d="M500,80 C500,42 460,42 460,72" fill="none" stroke="#ff5c35" stroke-width="2" stroke-dasharray="4 3" opacity="0.4" />
          <polygon points="458,76 460,68 465,76" fill="#ff5c35" opacity="0.4" />

          <path d="M350,80 C350,118 310,118 310,88" fill="none" stroke="#ff5c35" stroke-width="2" stroke-dasharray="4 3" opacity="0.3" />
          <polygon points="308,92 310,84 315,92" fill="#ff5c35" opacity="0.3" />

          <!-- Red X at the exit (blocked) -->
          <text x="60" y="85" fill="#ff5c35" font-size="16" font-weight="700" font-family="sans-serif" dominant-baseline="middle" opacity="0.7">✗</text>

          <!-- Leak drops that almost escape but are caught -->
          <circle cx="80" cy="80" r="3" fill="#ff5c35" opacity="0.15" />

          <!-- Label -->
          <text x="400" y="152" text-anchor="middle" fill="#ff5c35" font-size="10" opacity="0.6" font-family="sans-serif">← revenue churn gets caught in valve bends — can't leak out ←</text>
        </svg>
      </div>


      <!-- ============ LOGO MARKS ============ -->
      <h2 style="font-size: 1.3rem; font-weight: 600; color: #1b2a37; margin-bottom: 1.5rem; text-align: center;">Logo Marks — Tesla Valve Simplified</h2>

      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-bottom: 3rem;">

        <!-- ===== T1: Single bend (minimal) ===== -->
        <div style="text-align: center;">
          <p style="font-size: 0.8rem; color: #5b87ae; margin-bottom: 0.75rem; font-weight: 600;">T1: Single Bend</p>

          <div style="background: #1b2a37; border-radius: 12px; padding: 2rem; margin-bottom: 0.75rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 80 80" width="90" height="90" xmlns="http://www.w3.org/2000/svg">
              <!-- Main channel -->
              <path d="M8,40 L72,40" fill="none" stroke="#253d52" stroke-width="14" stroke-linecap="round" />
              <path d="M8,40 L72,40" fill="none" stroke="#1e3244" stroke-width="10" stroke-linecap="round" />

              <!-- Single U-bend (top) -->
              <path d="M28,40 C28,12 56,12 56,40" fill="none" stroke="#253d52" stroke-width="12" stroke-linecap="round" />
              <path d="M28,40 C28,16 56,16 56,40" fill="none" stroke="#1e3244" stroke-width="8" stroke-linecap="round" />

              <!-- Forward arrow -->
              <polygon points="64,35 72,40 64,45" fill="#70c1b3" />

              <!-- Bolt at junction -->
              <circle cx="28" cy="40" r="8" fill="#F5C400" />
              <path d="M27.5,35 L25.5,41 L27.5,40 L26.5,45 L30,39 L27.5,40 Z" fill="#1b2a37" />

              <!-- Small red drop blocked -->
              <circle cx="14" cy="48" r="2" fill="#ff5c35" opacity="0.5" />
              <circle cx="10" cy="54" r="1.5" fill="#ff5c35" opacity="0.3" />
            </svg>
          </div>

          <div style="background: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 2rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 80 80" width="90" height="90" xmlns="http://www.w3.org/2000/svg">
              <path d="M8,40 L72,40" fill="none" stroke="#e0e8ef" stroke-width="14" stroke-linecap="round" />
              <path d="M8,40 L72,40" fill="none" stroke="#f0f4f7" stroke-width="10" stroke-linecap="round" />
              <path d="M28,40 C28,12 56,12 56,40" fill="none" stroke="#e0e8ef" stroke-width="12" stroke-linecap="round" />
              <path d="M28,40 C28,16 56,16 56,40" fill="none" stroke="#f0f4f7" stroke-width="8" stroke-linecap="round" />
              <polygon points="64,35 72,40 64,45" fill="#70c1b3" />
              <circle cx="28" cy="40" r="8" fill="#b8930a" />
              <path d="M27.5,35 L25.5,41 L27.5,40 L26.5,45 L30,39 L27.5,40 Z" fill="#ffffff" />
              <circle cx="14" cy="48" r="2" fill="#ff5c35" opacity="0.5" />
              <circle cx="10" cy="54" r="1.5" fill="#ff5c35" opacity="0.3" />
            </svg>
          </div>
        </div>


        <!-- ===== T2: Double bend (classic Tesla) ===== -->
        <div style="text-align: center;">
          <p style="font-size: 0.8rem; color: #5b87ae; margin-bottom: 0.75rem; font-weight: 600;">T2: Double Bend</p>

          <div style="background: #1b2a37; border-radius: 12px; padding: 2rem; margin-bottom: 0.75rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 80 80" width="90" height="90" xmlns="http://www.w3.org/2000/svg">
              <!-- Main channel -->
              <path d="M6,40 L74,40" fill="none" stroke="#253d52" stroke-width="12" stroke-linecap="round" />
              <path d="M6,40 L74,40" fill="none" stroke="#1e3244" stroke-width="8" stroke-linecap="round" />

              <!-- Bend 1: top -->
              <path d="M20,40 C20,16 42,16 42,40" fill="none" stroke="#253d52" stroke-width="10" stroke-linecap="round" />
              <path d="M20,40 C20,20 42,20 42,40" fill="none" stroke="#1e3244" stroke-width="6" stroke-linecap="round" />

              <!-- Bend 2: bottom -->
              <path d="M42,40 C42,64 64,64 64,40" fill="none" stroke="#253d52" stroke-width="10" stroke-linecap="round" />
              <path d="M42,40 C42,60 64,60 64,40" fill="none" stroke="#1e3244" stroke-width="6" stroke-linecap="round" />

              <!-- Forward arrow -->
              <polygon points="68,35 76,40 68,45" fill="#70c1b3" />

              <!-- Bolt -->
              <circle cx="20" cy="40" r="7" fill="#F5C400" />
              <path d="M19.5,35.5 L17.5,41 L19.5,40 L18.5,45 L22,39 L19.5,40 Z" fill="#1b2a37" />

              <!-- Revenue label -->
              <text x="40" y="40" text-anchor="middle" fill="#70c1b3" font-size="8" font-weight="700" font-family="sans-serif" dominant-baseline="middle" opacity="0.25">$</text>

              <!-- Blocked leak -->
              <circle cx="10" cy="48" r="2" fill="#ff5c35" opacity="0.5" />
              <circle cx="7" cy="55" r="1.5" fill="#ff5c35" opacity="0.3" />
            </svg>
          </div>

          <div style="background: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 2rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 80 80" width="90" height="90" xmlns="http://www.w3.org/2000/svg">
              <path d="M6,40 L74,40" fill="none" stroke="#e0e8ef" stroke-width="12" stroke-linecap="round" />
              <path d="M6,40 L74,40" fill="none" stroke="#f0f4f7" stroke-width="8" stroke-linecap="round" />
              <path d="M20,40 C20,16 42,16 42,40" fill="none" stroke="#e0e8ef" stroke-width="10" stroke-linecap="round" />
              <path d="M20,40 C20,20 42,20 42,40" fill="none" stroke="#f0f4f7" stroke-width="6" stroke-linecap="round" />
              <path d="M42,40 C42,64 64,64 64,40" fill="none" stroke="#e0e8ef" stroke-width="10" stroke-linecap="round" />
              <path d="M42,40 C42,60 64,60 64,40" fill="none" stroke="#f0f4f7" stroke-width="6" stroke-linecap="round" />
              <polygon points="68,35 76,40 68,45" fill="#70c1b3" />
              <circle cx="20" cy="40" r="7" fill="#b8930a" />
              <path d="M19.5,35.5 L17.5,41 L19.5,40 L18.5,45 L22,39 L19.5,40 Z" fill="#ffffff" />
              <circle cx="10" cy="48" r="2" fill="#ff5c35" opacity="0.5" />
              <circle cx="7" cy="55" r="1.5" fill="#ff5c35" opacity="0.3" />
            </svg>
          </div>
        </div>


        <!-- ===== T3: Dollar flowing through valve ===== -->
        <div style="text-align: center;">
          <p style="font-size: 0.8rem; color: #5b87ae; margin-bottom: 0.75rem; font-weight: 600;">T3: $ Flow Through</p>

          <div style="background: #1b2a37; border-radius: 12px; padding: 2rem; margin-bottom: 0.75rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 80 80" width="90" height="90" xmlns="http://www.w3.org/2000/svg">
              <!-- Main channel -->
              <path d="M6,40 L74,40" fill="none" stroke="#253d52" stroke-width="14" stroke-linecap="round" />
              <path d="M6,40 L74,40" fill="none" stroke="#1e3244" stroke-width="10" stroke-linecap="round" />

              <!-- Bend top -->
              <path d="M22,40 C22,14 50,14 50,40" fill="none" stroke="#253d52" stroke-width="12" stroke-linecap="round" />
              <path d="M22,40 C22,18 50,18 50,40" fill="none" stroke="#1e3244" stroke-width="8" stroke-linecap="round" />

              <!-- Small $ entering -->
              <text x="12" y="43" fill="#70c1b3" font-size="9" font-weight="700" font-family="sans-serif" opacity="0.6">$</text>

              <!-- Bigger $ exiting (revenue grew) -->
              <text x="60" y="44" fill="#F5C400" font-size="12" font-weight="700" font-family="sans-serif">$</text>

              <!-- Forward arrow -->
              <polygon points="68,35 76,40 68,45" fill="#70c1b3" />

              <!-- Bolt at entry -->
              <circle cx="22" cy="40" r="7" fill="#F5C400" />
              <path d="M21.5,35.5 L19.5,41 L21.5,40 L20.5,45 L24,39 L21.5,40 Z" fill="#1b2a37" />

              <!-- Red drop blocked at reverse exit -->
              <circle cx="8" cy="50" r="2.5" fill="#ff5c35" opacity="0.5" />
              <text x="8" y="53" text-anchor="middle" fill="#ff5c35" font-size="5" opacity="0.4" font-family="sans-serif">✗</text>
            </svg>
          </div>

          <div style="background: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 2rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 80 80" width="90" height="90" xmlns="http://www.w3.org/2000/svg">
              <path d="M6,40 L74,40" fill="none" stroke="#e0e8ef" stroke-width="14" stroke-linecap="round" />
              <path d="M6,40 L74,40" fill="none" stroke="#f0f4f7" stroke-width="10" stroke-linecap="round" />
              <path d="M22,40 C22,14 50,14 50,40" fill="none" stroke="#e0e8ef" stroke-width="12" stroke-linecap="round" />
              <path d="M22,40 C22,18 50,18 50,40" fill="none" stroke="#f0f4f7" stroke-width="8" stroke-linecap="round" />
              <text x="12" y="43" fill="#49ab9b" font-size="9" font-weight="700" font-family="sans-serif" opacity="0.5">$</text>
              <text x="60" y="44" fill="#b8930a" font-size="12" font-weight="700" font-family="sans-serif">$</text>
              <polygon points="68,35 76,40 68,45" fill="#70c1b3" />
              <circle cx="22" cy="40" r="7" fill="#b8930a" />
              <path d="M21.5,35.5 L19.5,41 L21.5,40 L20.5,45 L24,39 L21.5,40 Z" fill="#ffffff" />
              <circle cx="8" cy="50" r="2.5" fill="#ff5c35" opacity="0.5" />
            </svg>
          </div>
        </div>


        <!-- ===== T4: Valve as shield shape ===== -->
        <div style="text-align: center;">
          <p style="font-size: 0.8rem; color: #5b87ae; margin-bottom: 0.75rem; font-weight: 600;">T4: Compact Mark</p>

          <div style="background: #1b2a37; border-radius: 12px; padding: 2rem; margin-bottom: 0.75rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 80 80" width="90" height="90" xmlns="http://www.w3.org/2000/svg">
              <!-- Compact: main channel shorter, bend prominent -->
              <path d="M10,44 L70,44" fill="none" stroke="#253d52" stroke-width="12" stroke-linecap="round" />
              <path d="M10,44 L70,44" fill="none" stroke="#1e3244" stroke-width="8" stroke-linecap="round" />

              <!-- Single prominent U-bend -->
              <path d="M26,44 C26,14 58,14 58,44" fill="none" stroke="#253d52" stroke-width="12" stroke-linecap="round" />
              <path d="M26,44 C26,18 58,18 58,44" fill="none" stroke="#1e3244" stroke-width="8" stroke-linecap="round" />

              <!-- Forward teal arrow inside channel -->
              <polygon points="62,39 70,44 62,49" fill="#70c1b3" />

              <!-- Bolt at top of the bend arc (the automation at the peak) -->
              <circle cx="42" cy="14" r="9" fill="#F5C400" />
              <path d="M41.5,8.5 L39,15 L41.5,14 L40.5,20 L44,13 L41.5,14 Z" fill="#1b2a37" />

              <!-- Red leak drops blocked at left -->
              <circle cx="14" cy="54" r="2.5" fill="#ff5c35" opacity="0.6" />
              <circle cx="10" cy="60" r="1.5" fill="#ff5c35" opacity="0.35" />

              <!-- Small $ inside channel -->
              <text x="42" y="47" text-anchor="middle" fill="#70c1b3" font-size="7" font-weight="700" font-family="sans-serif" opacity="0.3">$</text>
            </svg>
          </div>

          <div style="background: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 2rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 80 80" width="90" height="90" xmlns="http://www.w3.org/2000/svg">
              <path d="M10,44 L70,44" fill="none" stroke="#e0e8ef" stroke-width="12" stroke-linecap="round" />
              <path d="M10,44 L70,44" fill="none" stroke="#f0f4f7" stroke-width="8" stroke-linecap="round" />
              <path d="M26,44 C26,14 58,14 58,44" fill="none" stroke="#e0e8ef" stroke-width="12" stroke-linecap="round" />
              <path d="M26,44 C26,18 58,18 58,44" fill="none" stroke="#f0f4f7" stroke-width="8" stroke-linecap="round" />
              <polygon points="62,39 70,44 62,49" fill="#70c1b3" />
              <circle cx="42" cy="14" r="9" fill="#b8930a" />
              <path d="M41.5,8.5 L39,15 L41.5,14 L40.5,20 L44,13 L41.5,14 Z" fill="#ffffff" />
              <circle cx="14" cy="54" r="2.5" fill="#ff5c35" opacity="0.6" />
              <circle cx="10" cy="60" r="1.5" fill="#ff5c35" opacity="0.35" />
            </svg>
          </div>
        </div>

      </div>


      <!-- ============ SIZE TESTS ============ -->
      <h2 style="font-size: 1.1rem; font-weight: 600; color: #1b2a37; margin-bottom: 1rem; text-align: center;">Size Test — All 4 at 16 / 32 / 48 / 80px</h2>

      <div style="background: #1b2a37; border-radius: 12px; padding: 2rem; display: flex; align-items: end; justify-content: center; gap: 2.5rem; flex-wrap: wrap; margin-bottom: 2rem;">
        {[16, 32, 48, 80].map(size => (
          <div style="text-align: center;">
            <div style="display: flex; gap: 1.2rem; align-items: end;">
              {/* T1 */}
              <svg viewBox="0 0 80 80" width={size} height={size} xmlns="http://www.w3.org/2000/svg">
                <path d="M8,40 L72,40" fill="none" stroke="#253d52" stroke-width="14" stroke-linecap="round" />
                <path d="M8,40 L72,40" fill="none" stroke="#1e3244" stroke-width="10" stroke-linecap="round" />
                <path d="M28,40 C28,12 56,12 56,40" fill="none" stroke="#253d52" stroke-width="12" stroke-linecap="round" />
                <path d="M28,40 C28,16 56,16 56,40" fill="none" stroke="#1e3244" stroke-width="8" stroke-linecap="round" />
                <polygon points="64,35 72,40 64,45" fill="#70c1b3" />
                <circle cx="28" cy="40" r="8" fill="#F5C400" />
                <path d="M27.5,35 L25.5,41 L27.5,40 L26.5,45 L30,39 L27.5,40 Z" fill="#1b2a37" />
              </svg>
              {/* T2 */}
              <svg viewBox="0 0 80 80" width={size} height={size} xmlns="http://www.w3.org/2000/svg">
                <path d="M6,40 L74,40" fill="none" stroke="#253d52" stroke-width="12" stroke-linecap="round" />
                <path d="M6,40 L74,40" fill="none" stroke="#1e3244" stroke-width="8" stroke-linecap="round" />
                <path d="M20,40 C20,16 42,16 42,40" fill="none" stroke="#253d52" stroke-width="10" stroke-linecap="round" />
                <path d="M20,40 C20,20 42,20 42,40" fill="none" stroke="#1e3244" stroke-width="6" stroke-linecap="round" />
                <path d="M42,40 C42,64 64,64 64,40" fill="none" stroke="#253d52" stroke-width="10" stroke-linecap="round" />
                <path d="M42,40 C42,60 64,60 64,40" fill="none" stroke="#1e3244" stroke-width="6" stroke-linecap="round" />
                <polygon points="68,35 76,40 68,45" fill="#70c1b3" />
                <circle cx="20" cy="40" r="7" fill="#F5C400" />
