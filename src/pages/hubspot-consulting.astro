---
import BaseLayout from "../layouts/BaseLayout.astro";
import LogoHoneycomb from "../components/astro/LogoHoneycomb.astro";
import Footer from "../components/astro/Footer.astro";
import StructuredData from "../components/astro/StructuredData.astro";

// Client approval for a named case study is pending. Keep the source document,
// client identity, branding and attributed quotations out of this page and its assets.
// Anonymous evidence below is limited to the service examples supplied for this page.
// All artwork is conceptual illustration, not client screenshots or measured results.
const title = "HubSpot Consulting | Implementation, Integration & Revenue Operations";
const description = "Make HubSpot fit your business. Consulting across CRM, sales, quoting, renewals, integrations, service, reporting, forecasting, AI and licensing.";
const consultationUrl = "/contactus/";

// Current client-logo family from ClientLogoStrip. Keep the restricted client
// excluded until its logo is specifically cleared. Homepage quotes are verbatim
// and remain separate from the anonymous project evidence.
const clientLogos = [
  { name: "Zenergy", src: "/logos/clients/zenergy.png", width: 351, height: 90, dark: false, style: "h-6 sm:h-7" },
  { name: "Knape & Vogt", src: "/logos/clients/knape-vogt.png", width: 446, height: 313, dark: false, style: "h-12 sm:h-14" },
  { name: "Embrio", src: "/logos/clients/embryo.png", width: 297, height: 62, dark: true, style: "h-5 sm:h-6" },
  { name: "Jirav", src: "/logos/clients/jirav.png", width: 862, height: 794, dark: false, style: "h-12 sm:h-14" },
  { name: "GWC Data.AI", src: "/logos/clients/gwcdata.png", width: 700, height: 188, dark: false, style: "h-8 sm:h-9" },
];
const testimonials = [
  {
    quote: "Siva quickly grasped our complex workflows and immediately began identifying optimization opportunities. What sets him apart is how he functions as a true extension of our team, handling both technical implementation and strategic guidance.",
    name: "Samantha Ross", company: "Postgrad", image: "/assets/testimonials/profile1.webp", logo: "/logos/clients/postgrad.png",
  },
  {
    quote: "Sharmi helped our team do the foundational work that launched our ABM strategy. She took unstructured goals and, by applying her customer-focused insight and technical know-how, turned them into specific solutions that optimized our entire enrichment project in HubSpot.",
    name: "Shreyas Mecheri", company: "Jirav", image: "/assets/testimonials/profile2.jpg", logo: "/logos/clients/jirav.png",
  },
];
const familiar = [
  { thought: "We have HubSpot, but the team still works in spreadsheets.", href: "#offer-customer", label: "CRM & data" },
  { thought: "Sales and finance keep coming back with different numbers.", href: "#offer-integrations", label: "Connected systems" },
  { thought: "Every quote or renewal needs someone to chase it through.", href: "#offer-quoting", label: "Quoting & contracts" },
  { thought: "We spend more time preparing sales reports and forecasts than discussing them.", href: "#offer-reporting", label: "Reporting & forecasting" },
];
const workingTogether = [
  { question: "Will our team actually use it?", answer: "We test agreed business scenarios and tailor walkthroughs to daily users, administrators and leadership." },
  { question: "Can we see it before it goes live?", answer: "Yes. We agree how to test and demonstrate the work. A suitable Enterprise sandbox can support the changes it covers." },
  { question: "What happens when you hand it over?", answer: "Written documentation, videos where useful and agreed support give your team a way to use and maintain the work." },
];

const outcomes: { image: string; alt: string; name: string; heading: string; description: string; evidence?: string }[] = [
  { image: "customer", alt: "Illustration of a customer profile gathered with company, location, document and service information.", name: "CRM architecture, data migration & optimisation", heading: "See the whole customer relationship.", description: "Clean records and a CRM structure that connects customers, locations, deals and service activity.", evidence: "18,900+ company records audited; custom data models and associations designed." },
  { image: "sales", alt: "Illustration of a sales professional with a prioritised opportunity and a clear customer profile.", name: "Sales automation & lead management", heading: "Focus on the right opportunities.", description: "Meaningful qualification and lead scoring, clear handoffs and less admin around approvals and deal values.", evidence: "Lead scoring rebuilt using evidence from 323 closed-won deals." },
  { image: "renewals", alt: "Illustration of a calendar, organised contracts and a reminder bell.", name: "Contract operations & renewal management", heading: "See renewals before they become urgent.", description: "Connect contract terms, values, dates and owners. Bring historical agreements into HubSpot and automate renewal creation.", evidence: "$2M+ in ARR identified outside CRM revenue visibility." },
  { image: "quoting", alt: "Illustration of a prepared quote, two office buildings and an approval seal.", name: "Complex quoting, CPQ & commercial controls", heading: "Send a quote you're confident in.", description: "Keep locations, pricing, approvals and contract-value calculations together through quoting and signature.", evidence: "Experience includes multi-building quoting and branded PandaDoc templates." },
  { image: "integrations", alt: "Illustration of two business workspaces fitting together, with matching records and a validation check.", name: "ERP, finance & operational integrations", heading: "Give the next team what they need.", description: "Reliable mappings, validation and handoffs between HubSpot, finance and delivery tools, including NetSuite and Monday.com.", evidence: "HubSpot-side NetSuite readiness: deals passing checks increased from 41 to 256." },
  { image: "service", alt: "Illustration of a service professional coordinating a customer request and a field visit.", name: "Service Hub & customer operations", heading: "Help customers without the chasing.", description: "Requests arrive with context and clear ownership. Routing, reminders, escalation and closure keep service and field teams coordinated.", evidence: "Ticket workflows redesigned; HubSpot-to-Monday.com site-visit sync implemented." },
  { image: "reporting", alt: "Conceptual illustration of an executive dashboard and a prepared report, without client data.", name: "Reporting & management visibility", heading: "Walk into the review with a clear picture.", description: "Consistent definitions, historical comparisons and data checks make management reporting repeatable.", evidence: "Executive service reporting covering backlog, demand, throughput, response times and workload." },
  { image: "forecasting", alt: "Conceptual illustration of three possible forecast paths, a tiny paper plane and a calendar.", name: "Forecasting, scenario planning & pipeline management", heading: "Know what could change the forecast.", description: "Assess pipeline coverage, compare scenarios and track forecast movement and accuracy. Give revenue risks a place in the discussion." },
  { image: "ai", alt: "Conceptual illustration of a customer-summary card with a review check and a small paper sparkle.", name: "AI strategy, implementation & adoption", heading: "Give AI a useful job to do.", description: "Choose worthwhile tasks, prepare CRM data and knowledge sources, then connect AI to the workflow. Define human review, ownership and measures of usefulness." },
  { image: "licensing", alt: "Conceptual illustration of three colourful seats finding their place on a subscription sheet.", name: "HubSpot pricing, licensing & usage advisory", heading: "Choose what your team actually needs.", description: "Match subscriptions, seats and usage credits to your plans. Understand cost implications and underused capabilities before buying, expanding or renewing." },
];
const capabilityGroups = [
  { id: "data", name: "Data & connected systems", offers: ["customer", "integrations"] },
  { id: "commercial", name: "Sales & commercial operations", offers: ["sales", "quoting", "renewals"] },
  { id: "customer-operations", name: "Customer service", offers: ["service"] },
  { id: "visibility", name: "Management visibility", offers: ["reporting", "forecasting"] },
  { id: "platform", name: "AI & platform investment", offers: ["ai", "licensing"] },
].map(group => ({ ...group, items: group.offers.map(key => outcomes.find(item => item.image === key)!) }));
const process = [
  { title: "Meet the people doing the work", description: "Understand the process with stakeholders and daily users.", result: "A shared view of the process" },
  { title: "Check our understanding", description: "Share what we've learned with your executive team and confirm the priority.", result: "A priority everyone understands" },
  { title: "Lay out your options", description: "Explain solution options, dependencies and our recommendations so you can decide.", result: "Options you can compare" },
  { title: "Agree the result and scope", description: "Define costs, responsibilities and what will show the work is complete.", result: "Clear completion criteria" },
];
const delivery = [
  { title: "Plan", description: "Agree what should improve and how we'll know." },
  { title: "Do", description: "Build and test around your team's work." },
  { title: "Study", description: "See it in action and check results together." },
  { title: "Act", description: "Agree what to keep, change or try next." },
];
const simpleArtwork = new Set(["forecasting", "ai", "licensing"]);
const imageUrl = (name: string, width: number) => `/assets/consulting/${name}-${simpleArtwork.has(name) ? "simple-v1" : "balanced"}-${width}.png`;
const reports = [
  { href: "/hubspot-sales-pipeline-reporting/", title: "Sales & pipeline" },
  { href: "/hubspot-revenue-forecast-goal-roi-reporting/", title: "Revenue & forecast" },
  { href: "/hubspot-service-hub-performance-report/", title: "Service performance" },
  { href: "/hubspot-aeo-reporting-export/", title: "AEO reporting" },
];
const faqs = [
  { q: "Will you change the setup we already have?", a: "We will not modify existing work unless explicitly requested. We review what you have, explain our recommendations and agree the changes with you before implementation." },
  { q: "Can we start with one problem rather than a full implementation?", a: "Yes. A quoting bottleneck, a renewal workflow or an unreliable report can be a sensible starting point. We check its dependencies and agree a focused scope before recommending wider changes." },
  { q: "Our data is messy. How do you handle migration?", a: "We map fields and relationships, identify duplicates and agree which records need attention. A test migration and validation checks come before the live cutover, so your team can review the results." },
  { q: "What if standard HubSpot features aren't enough?", a: "We assess native configuration, existing integrations and custom development. We explain the licence requirements, maintenance needs and trade-offs before agreeing the approach." },
  { q: "Can you help us decide what to buy, including AI?", a: "Yes. We assess the work you need to support, the capabilities already available and the seats or usage credits involved. For AI, we also define the information it needs, who reviews or takes over, and how to assess quality, usefulness and usage cost." },
  { q: "Who will we work with, and how will we know what's happening?", a: "Sharmila or Siva remains your main contact, with specialists matched to the agreed scope. Weekly updates cover progress, blockers and delays. We agree working hours with at least four hours of working-day overlap, and eight hours for European clients, with demonstrations at agreed milestones." },
  { q: "Will you work with our team and other vendors?", a: "Yes. We work alongside commercial, service and integration teams, with clear responsibilities for data ownership, implementation and validation." },
  { q: "We've had a sync break before. How will we know if it happens again?", a: "We agree validation checks, failure alerts and who responds when something goes wrong. Monitoring and maintenance needs form part of the integration scope; ongoing support can be included in a retainer." },
  { q: "Can you report on history we haven't recorded?", a: "We check what history is available in HubSpot and your other systems. We make gaps clear and introduce tracking for future comparisons where an earlier state cannot be reconstructed." },
  { q: "How long will it take, and what will it cost?", a: "That depends on the data, systems and teams involved. We offer project-based, retainer and hourly consulting. After a free 30-minute conversation, we agree deliverables, dependencies, milestones and costs before implementation." },
];
const primaryButton = "inline-flex min-h-12 items-center justify-center rounded-xl bg-v6-copper-800 px-6 py-3 text-base font-bold text-white shadow-lg shadow-v6-copper/15 transition-colors hover:bg-v6-copper-900 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2";
---

<BaseLayout title={title} description={description} keywords="HubSpot consulting, HubSpot implementation, CRM architecture, HubSpot integrations, revenue operations, HubSpot quoting, Service Hub consulting">
  <StructuredData type="service" data={{ name: "HubSpot Implementation, Integration & Revenue Operations", description, serviceType: "HubSpot Consulting", url: "https://swotbee.com/hubspot-consulting/" }} />
  <StructuredData type="faq" data={{ faqs }} />
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:p-4 focus:text-v6-dark focus:outline focus:outline-2 focus:outline-v6-copper">Skip to content</a>
  <header class="border-b border-v6-border bg-white">
    <div class="mx-auto flex min-h-18 max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
      <a href="/" aria-label="SWOTbee home" class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-md focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">
        <LogoHoneycomb width={32} height={30} />
        <span class="text-lg font-bold text-v6-dark">SWOT<span class="text-v6-teal-700">bee</span></span>
      </a>
      <nav aria-label="Page navigation" class="hidden items-center gap-6 text-sm font-semibold text-v6-text-muted lg:flex">
        <a href="#capabilities" class="nav-link">What we help with</a>
        <a href="#clients" class="nav-link">Client stories</a>
        <a href="#approach" class="nav-link">How we work</a>
        <a href="#questions" class="nav-link">FAQs</a>
      </nav>
      <a href={consultationUrl} class="inline-flex min-h-11 items-center justify-center rounded-lg border border-v6-copper-800 px-3 py-2 text-sm font-semibold text-v6-copper-800 transition-colors hover:bg-v6-copper-50 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2 sm:px-4">Let's talk HubSpot</a>
    </div>
  </header>

  <main id="main-content">
    <section class="relative isolate overflow-hidden bg-white px-4 py-14 sm:px-6 sm:py-20 lg:px-8" aria-labelledby="consulting-heading">
      <div class="mx-auto grid max-w-[100rem] items-center gap-10 lg:grid-cols-[1fr_1.25fr] lg:gap-12">
        <div>
          <div class="flex flex-wrap items-center gap-3">
            <p class="eyebrow inline-flex rounded-full bg-v6-copper-50 px-4 py-2">HubSpot consulting</p>
            <p class="rounded-full bg-v6-teal-50 px-4 py-2 text-xs font-bold text-v6-teal-700">HubSpot Solutions Partner</p>
          </div>
          <h1 id="consulting-heading" class="mt-6 max-w-2xl text-balance text-4xl leading-[1.08] tracking-tight text-v6-dark sm:text-6xl" style="font-family: 'Rokkitt Variable', 'Vollkorn', serif; font-weight: 800;">Make HubSpot work for <span class="text-v6-copper-800">the way your business runs.</span></h1>
          <p class="mt-5 text-lg font-semibold text-v6-dark">Consulting, implementation & revenue operations</p>
          <p class="mt-4 max-w-xl text-lg leading-relaxed text-v6-text-muted">Make the investment count with reliable data, connected teams and useful automation. Bring AI, forecasting and platform decisions into the same conversation.</p>
          <a href={consultationUrl} class:list={[primaryButton, "mt-7 w-full sm:w-auto"]}>Book a free consultation <span class="ml-2" aria-hidden="true">→</span></a>
          <p class="mt-3 text-sm text-v6-text-muted">30 minutes. Bring the process you want to improve.</p>
        </div>
        <figure class="mx-auto w-full max-w-3xl lg:max-w-none" data-hero-illustration>
          <img src={imageUrl("hero", 1536)} srcset={`${imageUrl("hero", 600)} 600w, ${imageUrl("hero", 1200)} 1200w, ${imageUrl("hero", 1536)} 1536w`} sizes="(min-width: 1664px) 862px, (min-width: 1024px) calc(55.56vw - 62px), (min-width: 816px) 768px, (min-width: 640px) calc(100vw - 48px), calc(100vw - 32px)" width="1536" height="1024" alt="Illustration of two professionals collaborating around a shared business workspace with customer information, documents and a calendar." fetchpriority="high" decoding="async" class="w-full rounded-3xl border border-[#e0e3dc] bg-[#f1f0e8] shadow-xl shadow-v6-dark/10" />
          <figcaption class="mt-4 text-center text-sm font-semibold text-v6-text-muted">People, processes and information working together.</figcaption>
        </figure>
      </div>
    </section>

    <section class="border-y border-v6-border bg-white px-4 py-8 sm:px-6" aria-labelledby="client-logos-heading" data-client-logos data-proof-type="clients">
      <div class="mx-auto max-w-6xl">
        <h2 id="client-logos-heading" class="text-center text-xs font-semibold uppercase tracking-[0.14em] text-v6-text-muted">Teams we've worked with</h2>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-x-10 gap-y-6 sm:gap-x-14">
          {clientLogos.map(logo => <span class:list={["inline-flex items-center justify-center", logo.dark && "rounded-lg bg-v6-dark px-4 py-3"]}><img src={logo.src} alt={logo.name} width={logo.width} height={logo.height} loading="lazy" decoding="async" class={`${logo.style} w-auto max-w-36 object-contain`} /></span>)}
        </div>
      </div>
    </section>

    <section id="sound-familiar" class="section-shell bg-white" aria-labelledby="familiar-heading">
      <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <div><p class="eyebrow">Sound familiar?</p><h2 id="familiar-heading" class="section-heading">HubSpot is in place.<br />The workarounds are still there.</h2><p class="mt-4 max-w-md leading-relaxed text-v6-text-muted">Bring the part that's slowing you down. We'll help you work out where to start.</p></div>
        <ul class="grid gap-x-8 sm:grid-cols-2">
          {familiar.map(item => <li class="border-b border-v6-border py-5"><p class="text-lg font-semibold leading-relaxed text-v6-dark">“{item.thought}”</p><a href={item.href} class="mt-2 inline-flex min-h-11 items-center gap-2 rounded text-sm font-semibold text-v6-copper-800 underline-offset-4 hover:underline focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">{item.label}<span aria-hidden="true">→</span></a></li>)}
        </ul>
      </div>
    </section>

    <section id="capabilities" class="section-shell border-y border-v6-border bg-v6-bg" aria-labelledby="outcomes-heading">
      <div class="mx-auto max-w-6xl">
        <div class="mb-8 max-w-2xl"><p class="eyebrow">Ten core capabilities</p><h2 id="outcomes-heading" class="section-heading">Make the everyday work easier.</h2><p class="mt-4 text-lg leading-relaxed text-v6-text-muted">Start with one process, or bring several teams together. Choose the mix that supports your priority.</p></div>
        <nav class="mb-12 flex flex-wrap gap-2" aria-label="Explore consulting capabilities">
          {capabilityGroups.map(group => <a href={`#capability-${group.id}`} class="inline-flex min-h-11 items-center rounded-lg border border-v6-border bg-white px-3 py-2 text-sm font-semibold text-v6-dark hover:border-v6-copper focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">{group.name}</a>)}
        </nav>
        <div class="space-y-12 sm:space-y-16">
          {capabilityGroups.map(group => (
            <div id={`capability-${group.id}`} class="scroll-mt-8" data-capability-group={group.id}>
              <h3 class="mb-6 text-2xl font-bold text-v6-dark">{group.name}</h3>
              <div class:list={["grid gap-6", group.items.length > 1 && "md:grid-cols-2", group.items.length === 3 && "lg:grid-cols-3"]}>
                {group.items.map(item => (
                  <article id={`offer-${item.image}`} data-offer={item.image} class:list={["scroll-mt-8 overflow-hidden rounded-2xl border border-v6-border bg-white", group.items.length === 1 ? "grid items-center md:grid-cols-2" : "flex flex-col"]}>
                    <figure class="overflow-hidden border-b border-[#e0e3dc] bg-[#f1f0e8]">
                      <img src={imageUrl(item.image, 1200)} srcset={`${imageUrl(item.image, 600)} 600w, ${imageUrl(item.image, 1200)} 1200w`} sizes={group.items.length === 3 ? "(min-width: 1200px) 366px, (min-width: 768px) 45vw, calc(100vw - 32px)" : "(min-width: 1200px) 564px, (min-width: 768px) 45vw, calc(100vw - 32px)"} width="1200" height="800" alt={item.alt} loading="lazy" decoding="async" class="w-full" />
                    </figure>
                    <div class="flex flex-1 flex-col justify-center p-6 sm:p-8">
                      <p class="eyebrow">{item.heading}</p><h4 class="mt-3 text-balance text-2xl font-bold leading-tight text-v6-dark">{item.name}</h4>
                      <p class="mt-4 leading-relaxed text-v6-text-muted">{item.description}</p>
                      {item.evidence && <p class="mt-5 border-l-2 border-v6-copper-200 pl-4 text-sm leading-relaxed text-v6-text-muted">{item.evidence}</p>}
                      {item.image === "reporting" && <div class="mt-5 flex flex-wrap gap-2" aria-label="Explore reporting offers">{reports.map(report => <a href={report.href} class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-v6-border bg-white px-3 py-2 text-sm font-semibold text-v6-dark transition-colors hover:border-v6-copper hover:bg-v6-copper-50 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">{report.title}<span aria-hidden="true">→</span></a>)}</div>}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          ))}
        </div>
        <p class="mt-8 text-sm text-v6-text-muted">Project figures describe separate pieces of one engagement, shared without client-identifying details. Illustrations are conceptual.</p>
      </div>
    </section>

    <section id="clients" class="section-shell bg-white" aria-labelledby="clients-heading">
      <div class="mx-auto max-w-6xl">
        <div class="mb-9 max-w-2xl"><p class="eyebrow">In our clients' words</p><h2 id="clients-heading" class="section-heading">People who understand the work.</h2></div>
        <div class="grid gap-6 md:grid-cols-2">
          {testimonials.map(t => (
            <figure class="flex flex-col rounded-2xl border border-v6-border bg-v6-bg-warm p-6 sm:p-8" data-client-testimonial={t.company}>
              <div class="mb-5 flex h-12 items-center"><img src={t.logo} alt={`${t.company} logo`} width={t.company === "Postgrad" ? 146 : 80} height={t.company === "Postgrad" ? 30 : 74} loading="lazy" decoding="async" class:list={["object-contain object-left", t.company === "Postgrad" ? "h-auto w-36" : "h-12 w-auto"]} /></div>
              <blockquote class="flex-1 text-lg leading-relaxed text-v6-dark"><p>“{t.quote}”</p></blockquote>
              <figcaption class="mt-6 flex items-center gap-3 border-t border-v6-border pt-5">
                <img src={t.image} alt="" width="48" height="48" loading="lazy" decoding="async" class="h-12 w-12 shrink-0 rounded-full object-cover" />
                <div><p class="font-semibold text-v6-dark">{t.name}</p><p class="text-sm text-v6-text-muted">{t.company}</p></div>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section id="approach" class="section-shell border-t border-v6-border bg-v6-bg" aria-labelledby="approach-heading">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl"><p class="eyebrow">How we work</p><h2 id="approach-heading" class="section-heading">Agree the first useful improvement.</h2><p class="mt-4 text-xl font-medium leading-relaxed text-v6-dark sm:text-2xl">Understand the work. Agree the priority. Define the result.</p></div>
        <div class="mt-10 flex items-center gap-3"><span class="h-2.5 w-2.5 rounded-full bg-v6-copper" aria-hidden="true"></span><p class="text-base font-bold uppercase tracking-wider text-v6-copper-800">Before we build</p></div>
        <ol class="mt-6 grid gap-6 md:grid-cols-2">{process.map((step, i) => (
          <li class="flex flex-col rounded-2xl border border-v6-border bg-white p-6 sm:p-8">
            <span class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-v6-copper-50 text-xl font-bold text-v6-copper-800">{String(i+1).padStart(2, "0")}</span>
            <h3 class="text-2xl font-bold leading-snug text-v6-dark sm:text-3xl">{step.title}</h3>
            <p class="mt-4 flex-1 text-xl font-medium leading-relaxed text-v6-dark">{step.description}</p>
            <p class="mt-6 border-t border-v6-border pt-5 leading-relaxed"><span class="block text-base font-medium text-v6-text-muted">You'll leave this step with</span><strong class="mt-2 block text-xl font-bold text-v6-dark">{step.result}</strong></p>
          </li>
        ))}</ol>
        <div class="mt-12 rounded-2xl border border-v6-teal-100 bg-[#f8f5f0] p-6 sm:p-8">
          <p class="text-base font-bold uppercase tracking-wider text-v6-teal-700">As the work takes shape</p>
          <h3 class="mt-3 text-3xl font-bold leading-snug text-v6-dark">Build it. See it in action. Improve it together.</h3>
          <div class="mt-8 grid items-center gap-8 lg:grid-cols-2" data-pdsa-cycle>
            <figure class="mx-auto w-full max-w-xl">
              <img src="/assets/consulting/pdsa-cycle-1200.png" srcset="/assets/consulting/pdsa-cycle-600.png 600w, /assets/consulting/pdsa-cycle-1200.png 1200w" sizes="(min-width: 1024px) 500px, (min-width: 640px) 576px, calc(100vw - 80px)" width="1200" height="1200" loading="lazy" decoding="async" alt="A continuous clockwise cycle: Plan, Do, Study, Act, then back to Plan. Your team's priorities remain at the centre." class="w-full rounded-2xl" />
              <figcaption class="mt-4 text-center text-lg font-semibold text-v6-dark">Plan → Do → Study → Act → Plan</figcaption>
            </figure>
            <div>
              <p class="mb-6 text-xl font-bold text-v6-dark">Your team's priorities guide every cycle.</p>
              <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-1">{delivery.map(step => <li class="border-l-4 border-v6-teal-200 pl-5"><h4 class="text-2xl font-bold text-v6-dark">{step.title}</h4><p class="mt-2 text-xl font-medium leading-relaxed text-v6-dark">{step.description}</p></li>)}</ol>
            </div>
          </div>
          <div class="mt-8 border-t border-v6-teal-200 pt-6">
            <p class="text-lg font-semibold text-v6-dark">When agreed completion criteria are met</p>
            <p class="mt-4 flex flex-col gap-3 text-xl font-bold text-v6-dark sm:flex-row sm:items-center sm:gap-4"><span class="rounded-xl border border-v6-border bg-white px-5 py-4">Ready for everyday use</span><span aria-hidden="true" class="hidden sm:inline">→</span><span class="rounded-xl border border-v6-border bg-white px-5 py-4">Handover and agreed support</span></p>
            <p class="mt-6 text-lg font-medium leading-relaxed text-v6-dark"><strong class="font-bold">Your feedback shapes the next cycle.</strong> Changes affecting scope, cost or timing are agreed before proceeding.</p>
          </div>
        </div>
        <div class="mt-10 border-t border-v6-border pt-9">
          <p class="eyebrow">Ready for everyday use</p><h3 class="mt-3 text-3xl font-bold text-v6-dark">A handover your team can work with.</h3>
          <div class="mt-7 grid gap-6 lg:grid-cols-3">{workingTogether.map(item => <div class="rounded-xl border border-v6-border bg-white p-6"><h4 class="text-2xl font-bold leading-snug text-v6-dark">{item.question}</h4><p class="mt-4 text-xl font-medium leading-relaxed text-v6-dark">{item.answer}</p></div>)}</div>
        </div>
      </div>
    </section>

    <section id="questions" class="section-shell border-t border-v6-border bg-v6-bg" aria-labelledby="questions-heading">
      <div class="mx-auto max-w-3xl"><p class="eyebrow">A few practical questions</p><h2 id="questions-heading" class="section-heading">Before we talk.</h2>
        <div class="mt-8 space-y-3">{faqs.map((faq) => (
          <details class="group rounded-xl border border-v6-border bg-white"><summary class="flex min-h-14 cursor-pointer items-center justify-between gap-4 rounded-xl px-5 py-4 text-base font-semibold text-v6-dark hover:bg-v6-copper-50 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2"><span>{faq.q}</span><svg aria-hidden="true" class="h-5 w-5 shrink-0 text-v6-copper-800 transition-transform group-open:rotate-180 motion-reduce:transition-none" viewBox="0 0 24 24" fill="none"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></summary><p class="px-5 pb-5 leading-relaxed text-v6-text-muted">{faq.a}</p></details>
        ))}</div>
      </div>
    </section>

    <section id="consultation" class="bg-gradient-to-br from-v6-copper to-v6-copper-600 py-16 sm:py-20 px-4 sm:px-6 lg:px-8" aria-labelledby="consultation-heading">
      <div class="reveal max-w-2xl mx-auto text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/70 mb-3">Start with a conversation</p>
        <h2 id="consultation-heading" class="text-2xl sm:text-3xl font-bold text-white mb-4">What would make the biggest difference first?</h2>
        <p class="text-v6-copper-50 text-base sm:text-lg mb-4">Bring one process you'd like to improve. In 30 minutes, we'll discuss what matters, what already works and the next step worth scoping.</p>
        <a href={consultationUrl} class="bg-white text-v6-copper px-8 py-3.5 rounded-xl text-base font-semibold hover:bg-gray-50 transition-colors inline-block min-h-12 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-v6-copper">Book a free 30-minute consultation <span aria-hidden="true">→</span></a>
        <p class="mt-4 text-xs text-v6-copper-50">No fee. No HubSpot access required. We agree scope and costs before any project begins.</p>
        <p class="mt-5"><a href="mailto:info@swotbee.com" class="text-white/90 text-sm font-medium underline underline-offset-4 hover:text-white transition-colors inline-flex min-h-11 items-center rounded focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-v6-copper">Prefer email? Tell us what you'd like to improve <span class="ml-1" aria-hidden="true">→</span></a></p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  @reference "../styles/global.css";
  .section-shell { @apply px-4 py-16 sm:px-6 sm:py-20 lg:px-8; }
  .eyebrow { @apply text-xs font-bold uppercase tracking-[0.14em] text-v6-copper-800; }
  .section-heading { @apply mt-3 text-balance text-3xl font-bold leading-tight text-v6-dark sm:text-4xl; }
  .nav-link { @apply inline-flex min-h-11 items-center rounded-md hover:text-v6-dark focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2; }
  section[id] { scroll-margin-top: 2rem; }
  summary::-webkit-details-marker { display: none; }
</style>
