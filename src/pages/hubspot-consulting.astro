---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/astro/Navbar.astro";
import Footer from "../components/astro/Footer.astro";
import StructuredData from "../components/astro/StructuredData.astro";
import ClientTestimonials from "../components/astro/ClientTestimonials.astro";
import ConsultingHeroStory from "../components/astro/ConsultingHeroStory.astro";

// Client approval for a named case study is pending. Keep the source document,
// client identity, branding and attributed quotations out of this page and its assets.
// Anonymous evidence below is limited to the service examples supplied for this page.
// All artwork is conceptual illustration, not client screenshots or measured results.
const title = "HubSpot Consulting | Implementation, Integration & Revenue Operations";
const description = "Make HubSpot fit your business. Consulting across CRM, sales, quoting, renewals, integrations, service, reporting, forecasting, AI and licensing.";
const consultationUrl = "/contactus/";

// Current client-logo family from ClientLogoStrip. Keep the restricted client
// excluded until its logo is specifically cleared. Homepage quotes are verbatim
// and remain separate from the anonymous project evidence.
const clientLogos = [
  { name: "Zenergy", src: "/logos/clients/zenergy.png", width: 351, height: 90, dark: false, style: "h-6 sm:h-7" },
  { name: "Knape & Vogt", src: "/logos/clients/knape-vogt.png", width: 446, height: 313, dark: false, style: "h-12 sm:h-14" },
  { name: "Embrio", src: "/logos/clients/embryo.png", width: 297, height: 62, dark: true, style: "h-5 sm:h-6" },
  { name: "Jirav", src: "/logos/clients/jirav.png", width: 862, height: 794, dark: false, style: "h-12 sm:h-14" },
  { name: "GWC Data.AI", src: "/logos/clients/gwcdata.png", width: 700, height: 188, dark: false, style: "h-8 sm:h-9" },
];
const familiar = [
  { thought: "Your team still relies on spreadsheets alongside HubSpot.", href: "#capability-customer", label: "Explore CRM & data" },
  { thought: "Sales and finance work with different numbers.", href: "#capability-integrations", label: "Explore connected systems" },
  { thought: "Quotes or renewals need someone to chase the next step.", href: "#capability-quoting", label: "Explore quoting & renewals" },
  { thought: "Reports take too long to prepare or are difficult to trust.", href: "#capability-reporting", label: "Explore reporting & forecasting" },
];

const outcomes: { image: string; alt: string; name: string; heading: string; description: string; evidence?: string }[] = [
  { image: "customer", alt: "Two colleagues review a customer profile connected to company, location, deal and service records.", name: "Get a complete view of every customer", heading: "See the whole customer relationship.", description: "Clean records and a CRM structure that connects customers, locations, deals and service activity.", evidence: "18,900+ company records audited; custom data models and associations designed." },
  { image: "sales", alt: "Two colleagues review a prioritised opportunity and its follow-up workflow.", name: "Stop good leads from falling through the cracks", heading: "Focus on the right opportunities.", description: "Meaningful qualification and lead scoring, clear handoffs and less admin around approvals and deal values.", evidence: "Lead scoring rebuilt using evidence from 323 closed-won deals." },
  { image: "renewals", alt: "Two colleagues review a contract, its owner and an upcoming renewal reminder.", name: "Know what is renewing before it is too late", heading: "See renewals before they become urgent.", description: "Connect contract terms, values, dates and owners. Bring historical agreements into HubSpot and automate renewal creation.", evidence: "$2M+ in ARR identified outside CRM revenue visibility." },
  { image: "quoting", alt: "Two colleagues review a quote with pricing, two locations and an approval check.", name: "Send accurate quotes without the back-and-forth", heading: "Send a quote you're confident in.", description: "Keep locations, pricing, approvals and contract-value calculations together through quoting and signature.", evidence: "Experience includes multi-building quoting and branded PandaDoc templates." },
  { image: "integrations", alt: "Two colleagues review a validated handoff between a customer record and a finance document.", name: "Connect HubSpot with your finance and operations systems", heading: "Give the next team what they need.", description: "Reliable mappings, validation and handoffs between HubSpot, finance and delivery tools, including NetSuite and Monday.com.", evidence: "HubSpot-side NetSuite readiness: deals passing checks increased from 41 to 256." },
  { image: "service", alt: "Two colleagues coordinate a customer request, its owner and a field visit.", name: "Keep customer requests from getting lost", heading: "Help customers without the chasing.", description: "Requests arrive with context and clear ownership. Routing, reminders, escalation and closure keep service and field teams coordinated.", evidence: "Ticket workflows redesigned; HubSpot-to-Monday.com site-visit sync implemented." },
  { image: "reporting", alt: "Two colleagues review a conceptual dashboard and a matching report.", name: "Get reports your leadership team can trust", heading: "Walk into the review with a clear picture.", description: "Consistent definitions, historical comparisons and data checks make management reporting repeatable.", evidence: "Executive service reporting covering backlog, demand, throughput, response times and workload." },
  { image: "forecasting", alt: "Two colleagues consider three possible forecast paths leading to a future review.", name: "Know what could change your forecast", heading: "Know what could change the forecast.", description: "Assess pipeline coverage, compare scenarios and track forecast movement and accuracy. Give revenue risks a place in the discussion." },
  { image: "ai", alt: "Two colleagues review a suggested customer summary and its place in a workflow.", name: "Decide where AI is worth using", heading: "Test, Evaluate, Apply", description: "Choose worthwhile tasks, prepare CRM data and knowledge sources, then connect AI to the workflow. Define human review, ownership and measures of usefulness." },
  { image: "licensing", alt: "Two colleagues review subscription choices alongside seats, usage and cost.", name: "Know whether you are paying for the right HubSpot setup", heading: "Choose what your team actually needs.", description: "Match subscriptions, seats and usage credits to your plans. Understand cost implications and underused capabilities before buying, expanding or renewing." },
];
const imageUrl = (name: string, width: number) => `/assets/consulting/character-scenes/${name}-${width}.webp`;
const faqs = [
  { q: "Will you change the setup we already have?", a: "We will not modify existing work unless explicitly requested. We review what you have, explain our recommendations and agree the changes with you before implementation." },
  { q: "Can we start with one problem rather than a full implementation?", a: "Yes. A quoting bottleneck, a renewal workflow or an unreliable report can be a sensible starting point. We check its dependencies and agree a focused scope before recommending wider changes." },
  { q: "Our data is messy. How do you handle migration?", a: "We map fields and relationships, identify duplicates and agree which records need attention. A test migration and validation checks come before the live cutover, so your team can review the results." },
  { q: "What if standard HubSpot features aren't enough?", a: "We assess native configuration, existing integrations and custom development. We explain the licence requirements, maintenance needs and trade-offs before agreeing the approach." },
  { q: "Can you help us decide what to buy, including AI?", a: "Yes. We assess the work you need to support, the capabilities already available and the seats or usage credits involved. For AI, we also define the information it needs, who reviews or takes over, and how to assess quality, usefulness and usage cost." },
  { q: "Who will we work with, and how will we know what's happening?", a: "Sharmila or Siva remains your main contact, with specialists matched to the agreed scope. Weekly updates cover progress, blockers and delays. We agree working hours with at least four hours of working-day overlap, and eight hours for European clients, with demonstrations at agreed milestones." },
  { q: "Will you work with our team and other vendors?", a: "Yes. We work alongside commercial, service and integration teams, with clear responsibilities for data ownership, implementation and validation." },
  { q: "We've had a sync break before. How will we know if it happens again?", a: "We agree validation checks, failure alerts and who responds when something goes wrong. Monitoring and maintenance needs form part of the integration scope; ongoing support can be included in a retainer." },
  { q: "Can you report on history we haven't recorded?", a: "We check what history is available in HubSpot and your other systems. We make gaps clear and introduce tracking for future comparisons where an earlier state cannot be reconstructed." },
  { q: "How long will it take, and what will it cost?", a: "That depends on the data, systems and teams involved. We offer project-based, retainer and hourly consulting. After a free 30-minute conversation, we agree deliverables, dependencies, milestones and costs before implementation." },
];
const previewFaqs = faqs.filter((_, index) => [0, 1, 3, 6, 9].includes(index));
const primaryButton = "inline-flex min-h-12 items-center justify-center rounded-xl bg-v6-copper-800 px-6 py-3 text-base font-bold text-white shadow-lg shadow-v6-copper/15 transition-colors hover:bg-v6-copper-900 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2";
---

<BaseLayout title={title} description={description} keywords="HubSpot consulting, HubSpot implementation, CRM architecture, HubSpot integrations, revenue operations, HubSpot quoting, Service Hub consulting">
  <StructuredData type="service" data={{ name: "HubSpot Implementation, Integration & Revenue Operations", description, serviceType: "HubSpot Consulting", url: "https://swotbee.com/hubspot-consulting/" }} />
  <StructuredData type="faq" data={{ faqs: previewFaqs }} />
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:p-4 focus:text-v6-dark focus:outline focus:outline-2 focus:outline-v6-copper">Skip to content</a>
  <Navbar />

  <main id="main-content">
    <section class="relative isolate overflow-hidden bg-white px-4 py-14 sm:px-6 sm:py-20 lg:px-8" aria-labelledby="consulting-heading">
      <div class="mx-auto grid max-w-[100rem] items-center gap-10 lg:grid-cols-[0.92fr_1.42fr] lg:gap-12">
        <div>
          <div class="flex flex-wrap items-center gap-3">
            <p class="eyebrow inline-flex rounded-full bg-v6-copper-50 px-4 py-2">HubSpot consulting</p>
            <p class="rounded-full bg-v6-teal-50 px-4 py-2 text-xs font-bold text-v6-teal-700">HubSpot Solutions Partner</p>
          </div>
          <h1 id="consulting-heading" class="mt-6 max-w-2xl text-balance text-4xl leading-[1.08] tracking-tight text-v6-dark sm:text-6xl" style="font-family: 'Rokkitt Variable', 'Vollkorn', serif; font-weight: 800;">Make HubSpot fit <span class="text-v6-copper-800">the way your business works.</span></h1>
          <p class="mt-5 text-lg font-semibold text-v6-dark">For teams already using HubSpot</p>
          <p class="mt-4 max-w-xl text-lg leading-relaxed text-v6-text-muted">Improve reporting, reduce manual work, and connect the information your sales, finance, and operations teams rely on.</p>
          <a href={consultationUrl} class:list={[primaryButton, "mt-7 w-full sm:w-auto"]}>Request a free consultation <span class="ml-2" aria-hidden="true">→</span></a>
          <p class="mt-3 text-sm text-v6-text-muted">Send a request for a free 30-minute conversation. Bring one process you want to improve.</p>
        </div>
        <ConsultingHeroStory />
      </div>
    </section>

    <section class="border-y border-v6-border bg-white px-4 py-8 sm:px-6" aria-labelledby="client-logos-heading" data-client-logos data-proof-type="clients">
      <div class="mx-auto max-w-6xl">
        <h2 id="client-logos-heading" class="text-center text-xs font-semibold uppercase tracking-[0.14em] text-v6-text-muted">Teams we've worked with</h2>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-x-10 gap-y-6 sm:gap-x-14">
          {clientLogos.map(logo => <span class:list={["inline-flex items-center justify-center", logo.dark && "rounded-lg bg-v6-dark px-4 py-3"]}><img src={logo.src} alt={logo.name} width={logo.width} height={logo.height} loading="lazy" decoding="async" class={`${logo.style} w-auto max-w-36 object-contain`} /></span>)}
        </div>
      </div>
    </section>

    <section id="sound-familiar" class="section-shell bg-white" aria-labelledby="familiar-heading">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-4xl">
          <p class="eyebrow">Sound familiar?</p>
          <h2 id="familiar-heading" class="section-heading">Your business has moved forward. Has your HubSpot setup kept up?</h2>
          <p class="mt-4 max-w-3xl text-lg leading-relaxed text-v6-text-muted">As teams, processes, and systems change, workarounds can become part of everyday work.</p>
        </div>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {familiar.map(item => <li class="problem-card relative flex flex-col rounded-xl border border-v6-border bg-v6-bg p-4 sm:p-6" data-motion-card><p class="flex-1 text-lg font-semibold leading-relaxed text-v6-dark">{item.thought}</p><a href={item.href} class="mt-1 inline-flex min-h-11 w-fit items-center gap-2 rounded text-sm font-bold text-v6-teal-700 underline decoration-v6-teal-200 underline-offset-4 hover:text-v6-teal-900 focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-v6-copper">{item.label}<span class="service-arrow" aria-hidden="true"><svg class="icon-circle" viewBox="0 0 28 28"><circle cx="14" cy="14" r="11"/><path d="M8 14h11m-4-4 4 4-4 4"/></svg></span></a></li>)}
        </ul>
        <p class="mt-6 max-w-4xl text-base font-medium leading-relaxed text-v6-dark">We help you understand where the process breaks down and agree on a practical place to start.</p>
      </div>
    </section>

    <ClientTestimonials eyebrow="Client experiences" heading="What clients say about working with us" description="From understanding complex workflows to putting solutions into practice, here is how clients describe their experience with SwotBee." />

    <section id="capabilities" class="section-shell border-t border-v6-border bg-white" aria-labelledby="outcomes-heading" data-service-carousel>
      <div class="mx-auto max-w-6xl">
        <div class="mb-10 max-w-3xl"><p class="eyebrow">How we can help</p><h2 id="outcomes-heading" class="section-heading">Start with the work you want to improve.</h2><p class="mt-4 text-lg leading-relaxed text-v6-text-muted">Bring one issue or a process that spans several teams. Explore the areas where we can help.</p></div>
        <div class="service-scroll-track" data-service-track><div class="service-scroll-stage hidden items-start gap-8 lg:grid lg:grid-cols-[1.2fr_0.8fr] lg:items-stretch lg:gap-12">
          <div class="order-2 min-w-0 scroll-mt-24 lg:order-1" id="service-artwork">
            {outcomes.map((item, index) => (
              <article id={`service-detail-${item.image}`} data-service-panel={index} class="overflow-hidden rounded-2xl border border-v6-border bg-v6-bg">
                <img src={imageUrl(item.image, 1200)} srcset={`${imageUrl(item.image, 600)} 600w, ${imageUrl(item.image, 1200)} 1200w`} sizes="(min-width: 1024px) 650px, calc(100vw - 32px)" width="1200" height="800" alt={item.alt} loading="lazy" decoding="async" class="w-full" />
                <div class="p-6 sm:p-8"><p class="eyebrow">{item.heading}</p><h3 class="mt-3 text-balance text-2xl font-bold leading-tight text-v6-dark">{item.name}</h3><p class="mt-4 leading-relaxed text-v6-text-muted">{item.description}</p>{item.evidence && <p class="mt-5 border-l-2 border-v6-copper-200 pl-4 text-sm leading-relaxed text-v6-text-muted">{item.evidence}</p>}<a href={consultationUrl} class:list={[primaryButton, "mt-6 w-full sm:w-auto"]}>Request a free consultation <span class="ml-2" aria-hidden="true">→</span></a><p class="mt-3 text-sm text-v6-text-muted">Tell us what you want to improve in a free 30-minute conversation.</p></div>
              </article>
            ))}
          </div>
          <div class="order-1 min-w-0 lg:order-2 lg:flex lg:flex-col"><div role="group" aria-label="Consulting services" class="border-t border-v6-border lg:flex lg:flex-1 lg:flex-col">{outcomes.map((item, index) => <button id={`capability-${item.image}`} type="button" data-service-select={index} data-service-name={item.name} aria-pressed={index === 0 ? "true" : "false"} aria-controls={`service-detail-${item.image}`} disabled class="service-choice relative flex min-h-14 w-full scroll-mt-24 items-center border-b border-v6-border px-5 py-4 text-left lg:flex-1"><span class="service-progress" aria-hidden="true"><span data-service-progress></span></span><span class="relative text-base font-bold leading-snug text-v6-dark">{item.name}</span></button>)}</div>
            <div data-service-controls hidden class="service-controls mt-5 flex flex-wrap items-center justify-between gap-3"><div class="flex items-center gap-3"><p data-service-count class="text-sm text-v6-text-muted">1 of 10</p><a href="#approach" aria-label="Skip to how we work" class="inline-flex min-h-11 items-center text-sm font-semibold text-v6-teal-700 underline underline-offset-4 focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-v6-copper">Skip</a></div><div class="flex items-center gap-2"><button type="button" data-service-previous aria-label="Previous service" class="service-control h-11 w-11 rounded-full border border-v6-border text-v6-dark">←</button><button type="button" data-service-toggle class="service-control min-h-11 rounded-full border border-v6-border px-4 text-sm font-semibold text-v6-dark">Play slideshow</button><button type="button" data-service-next aria-label="Next service" class="service-control h-11 w-11 rounded-full border border-v6-border text-v6-dark">→</button></div></div><p data-service-announcement class="sr-only" aria-live="polite" aria-atomic="true"></p>
          </div>
        </div>
        </div>
        <div class="space-y-3 lg:hidden" data-mobile-services>
          {outcomes.map(item => (
            <details id={`mobile-capability-${item.image}`} data-mobile-service class="mobile-service scroll-mt-24 overflow-hidden rounded-xl border border-v6-border bg-v6-bg">
              <summary class="flex min-h-16 cursor-pointer items-center justify-between gap-4 px-5 py-4 text-base font-bold text-v6-dark focus:outline focus:outline-2 focus:outline-offset-[-3px] focus:outline-v6-copper"><span>{item.name}</span><svg class="mobile-service-chevron h-5 w-5 shrink-0 text-v6-teal-700" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
              <div class="border-t border-v6-border bg-white"><img src={imageUrl(item.image, 600)} srcset={`${imageUrl(item.image, 600)} 600w, ${imageUrl(item.image, 1200)} 1200w`} sizes="(min-width: 640px) 90vw, calc(100vw - 32px)" width="1200" height="800" alt={item.alt} loading="lazy" decoding="async" class="w-full" /><div class="bg-v6-bg p-5 sm:p-6"><p class="eyebrow">{item.heading}</p><h3 class="mt-3 text-xl font-bold leading-snug text-v6-dark">{item.name}</h3><p class="mt-4 leading-relaxed text-v6-text-muted">{item.description}</p>{item.evidence && <p class="mt-5 border-l-2 border-v6-copper-200 pl-4 text-sm leading-relaxed text-v6-text-muted">{item.evidence}</p>}<a href={consultationUrl} class:list={[primaryButton, "mt-6 w-full sm:w-auto"]}>Request a free consultation <span class="ml-2" aria-hidden="true">→</span></a><p class="mt-3 text-sm text-v6-text-muted">Tell us what you want to improve in a free 30-minute conversation.</p></div></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="approach" class="section-shell border-t border-v6-border bg-white" aria-labelledby="approach-heading">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-4xl"><p class="eyebrow">How we work</p><h2 id="approach-heading" class="section-heading">Understand the work. Agree the scope. Improve it together.</h2></div>
        <ol class="motion-process mt-8 grid gap-4 md:grid-cols-3">
          <li class="process-card relative rounded-xl border border-v6-border bg-v6-bg p-5 sm:p-6"><span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-v6-teal-100 text-sm font-bold text-v6-teal-900" aria-hidden="true">01</span><h3 class="mt-4 text-xl font-bold leading-snug text-v6-dark">Understand your situation</h3><p class="mt-3 leading-relaxed text-v6-text-muted">We speak with the people doing the work, review the existing process, and check our understanding with your team.</p></li>
          <li class="process-card relative rounded-xl border border-v6-border bg-v6-bg p-5 sm:p-6"><span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-v6-teal-100 text-sm font-bold text-v6-teal-900" aria-hidden="true">02</span><h3 class="mt-4 text-xl font-bold leading-snug text-v6-dark">Agree on a practical plan</h3><p class="mt-3 leading-relaxed text-v6-text-muted">We explain the options and dependencies, then agree on the scope, responsibilities, cost, and how we will know the work is complete.</p></li>
          <li class="process-card relative rounded-xl border border-v6-border bg-v6-bg p-5 sm:p-6"><span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-v6-teal-100 text-sm font-bold text-v6-teal-900" aria-hidden="true">03</span><h3 class="mt-4 text-xl font-bold leading-snug text-v6-dark">Implement and hand over</h3><p class="mt-3 leading-relaxed text-v6-text-muted">We make the agreed changes, test them with your team, and provide documentation and walkthroughs for the people who will use and maintain them.</p></li>
        </ol>
        <div class="mt-6 rounded-xl border border-v6-border p-5 sm:p-6"><h3 class="text-xl font-bold text-v6-dark">Start with the level of help you need</h3><p class="mt-2 max-w-4xl leading-relaxed text-v6-text-muted">We offer project-based, hourly, and ongoing consulting. We agree the scope, responsibilities, and cost before work begins.</p><p class="mt-3 text-sm leading-relaxed text-v6-text-muted"><strong class="text-v6-dark">Your main contact:</strong> Sharmila or Siva, with specialists matched to the agreed scope.</p></div>
      </div>
    </section>

    <section id="questions" class="section-shell border-t border-v6-border bg-v6-bg" aria-labelledby="questions-heading">
      <div class="mx-auto max-w-3xl"><p class="eyebrow">A few practical questions</p><h2 id="questions-heading" class="section-heading">Before we talk.</h2>
        <div class="mt-8 space-y-3">{previewFaqs.map((faq) => (
          <details class="faq-item group rounded-xl border border-v6-border bg-white"><summary class="flex min-h-14 cursor-pointer items-center justify-between gap-4 rounded-xl px-5 py-4 text-base font-semibold text-v6-dark hover:bg-v6-copper-50 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2"><span>{faq.q}</span><svg aria-hidden="true" class="faq-chevron h-5 w-5 shrink-0 text-v6-copper-800" viewBox="0 0 24 24" fill="none"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></summary><p class="faq-answer px-5 pb-6 pt-4 leading-relaxed text-v6-text-muted">{faq.a}</p></details>
        ))}</div>
      </div>
    </section>

    <section id="consultation" class="bg-gradient-to-br from-v6-copper to-v6-copper-600 py-16 sm:py-20 px-4 sm:px-6 lg:px-8" aria-labelledby="consultation-heading">
      <div class="reveal max-w-2xl mx-auto text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/70 mb-3">Start with a conversation</p>
        <h2 id="consultation-heading" class="text-2xl sm:text-3xl font-bold text-white mb-4">What would make the biggest difference first?</h2>
        <p class="text-v6-copper-50 text-base sm:text-lg mb-4">Bring one process you'd like to improve. In 30 minutes, we'll discuss what matters, what already works and the next step worth scoping.</p>
        <a href={consultationUrl} class="bg-white text-v6-copper px-8 py-3.5 rounded-xl text-base font-semibold hover:bg-gray-50 transition-colors inline-block min-h-12 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-v6-copper">Request a free 30-minute consultation <span aria-hidden="true">→</span></a>
        <p class="mt-4 text-xs text-v6-copper-50">Send a request using our contact form. No fee or HubSpot access is required for the initial conversation. We agree scope and costs before any project begins.</p>
        <p class="mt-5"><a href="mailto:info@swotbee.com" class="text-white/90 text-sm font-medium underline underline-offset-4 hover:text-white transition-colors inline-flex min-h-11 items-center rounded focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-v6-copper">Prefer email? Tell us what you'd like to improve <span class="ml-1" aria-hidden="true">→</span></a></p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  const legacyCapabilityHashes: Record<string, string> = {
    '#capability-data': '#capability-customer',
    '#capability-commercial': '#capability-sales',
    '#capability-customer-operations': '#capability-service',
    '#capability-visibility': '#capability-reporting',
    '#capability-platform': '#capability-ai',
  };
  const normalizeCapabilityHash = () => {
    const hash = location.hash;
    const target = legacyCapabilityHashes[hash] || (hash.startsWith('#offer-') ? hash.replace('#offer-', '#capability-') : null);
    if (target && document.getElementById(target.slice(1))) history.replaceState(null, '', target);
  };
  normalizeCapabilityHash();
  window.addEventListener('hashchange', normalizeCapabilityHash);
  function openLinkedCapability() {
    if (!location.hash) return;
    const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
    const parent = target?.closest('details');
    if (parent) parent.open = true;
