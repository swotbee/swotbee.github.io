---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/astro/Navbar.astro';
---

<BaseLayout title="Logo — Industrial 2: Blue & Yellow">
  <Navbar />
  <div style="background: #f0ede6; min-height: 100vh; padding: 3rem 1rem;">
    <div style="max-width: 1000px; margin: 0 auto;">
      <h1 style="font-size: 1.5rem; font-weight: 700; color: #3d5245; margin-bottom: 0.5rem; text-align: center;">Industrial 2: Blue & Yellow</h1>
      <p style="text-align: center; color: #6b8291; margin-bottom: 0.5rem; font-size: 0.85rem;">Caution Blue · Solar Yellow · Medium Blue · Deep Gray · Light Blue</p>
      <div style="display: flex; justify-content: center; gap: 0.5rem; margin-bottom: 2.5rem;">
        <div style="text-align:center;"><div style="width: 44px; height: 44px; border-radius: 8px; background: #0060a8;"></div><span style="font-size:0.55rem;color:#6b8291;">Primary</span></div>
        <div style="text-align:center;"><div style="width: 44px; height: 44px; border-radius: 8px; background: #e8c716;"></div><span style="font-size:0.55rem;color:#6b8291;">Accent</span></div>
        <div style="text-align:center;"><div style="width: 44px; height: 44px; border-radius: 8px; background: #4a7c8f;"></div><span style="font-size:0.55rem;color:#6b8291;">Mid</span></div>
        <div style="text-align:center;"><div style="width: 44px; height: 44px; border-radius: 8px; background: #3d5245;"></div><span style="font-size:0.55rem;color:#6b8291;">Dark</span></div>
        <div style="text-align:center;"><div style="width: 44px; height: 44px; border-radius: 8px; background: #a7c7d8;"></div><span style="font-size:0.55rem;color:#6b8291;">Light</span></div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 3rem;">
        <div style="text-align: center;">
          <p style="font-size: 0.8rem; color: #6b8291; margin-bottom: 0.5rem; font-weight: 600;">Split Hexagon</p>
          <div style="background: #3d5245; border-radius: 12px; padding: 2rem; margin-bottom: 0.75rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 120 120" width="110" height="110" xmlns="http://www.w3.org/2000/svg">
              <path d="M60,10 L103,35 L60,60 L17,35 Z" fill="#0060a8" />
              <path d="M103,35 L103,85 L60,60 Z" fill="#e8c716" />
              <path d="M103,85 L60,110 L17,85 L60,60 Z" fill="#3d5245" stroke="#4a7c8f" stroke-width="0.5" />
              <path d="M17,85 L17,35 L60,60 Z" fill="#a7c7d8" />
              <polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke="#4a7c8f" stroke-width="1.5" opacity="0.5" />
            </svg>
          </div>
          <div style="background: #ffffff; border: 1px solid #d4c5a9; border-radius: 12px; padding: 2rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 120 120" width="110" height="110" xmlns="http://www.w3.org/2000/svg">
              <path d="M60,10 L103,35 L60,60 L17,35 Z" fill="#0060a8" />
              <path d="M103,35 L103,85 L60,60 Z" fill="#e8c716" />
              <path d="M103,85 L60,110 L17,85 L60,60 Z" fill="#3d5245" />
              <path d="M17,85 L17,35 L60,60 Z" fill="#a7c7d8" />
              <polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke="#d4c5a9" stroke-width="1" />
            </svg>
          </div>
        </div>

        <div style="text-align: center;">
          <p style="font-size: 0.8rem; color: #6b8291; margin-bottom: 0.5rem; font-weight: 600;">Honeycomb Cluster</p>
          <div style="background: #3d5245; border-radius: 12px; padding: 2rem; margin-bottom: 0.75rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 120 110" width="110" height="100" xmlns="http://www.w3.org/2000/svg">
              <polygon points="38,8 54,18 54,36 38,46 22,36 22,18" fill="#0060a8" />
              <polygon points="72,8 88,18 88,36 72,46 56,36 56,18" fill="#e8c716" />
              <polygon points="21,40 37,50 37,68 21,78 5,68 5,50" fill="#a7c7d8" />
              <polygon points="55,40 71,50 71,68 55,78 39,68 39,50" fill="#4a7c8f" />
              <polygon points="89,40 105,50 105,68 89,78 73,68 73,50" fill="#3d5245" stroke="#4a7c8f" stroke-width="1" />
              <polygon points="38,72 54,82 54,100 38,110 22,100 22,82" fill="#f0e68c" />
              <polygon points="72,72 88,82 88,100 72,110 56,100 56,82" fill="#6b8291" />
            </svg>
          </div>
          <div style="background: #ffffff; border: 1px solid #d4c5a9; border-radius: 12px; padding: 2rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 120 110" width="110" height="100" xmlns="http://www.w3.org/2000/svg">
              <polygon points="38,8 54,18 54,36 38,46 22,36 22,18" fill="#0060a8" />
              <polygon points="72,8 88,18 88,36 72,46 56,36 56,18" fill="#e8c716" />
              <polygon points="21,40 37,50 37,68 21,78 5,68 5,50" fill="#a7c7d8" />
              <polygon points="55,40 71,50 71,68 55,78 39,68 39,50" fill="#4a7c8f" />
              <polygon points="89,40 105,50 105,68 89,78 73,68 73,50" fill="#3d5245" />
              <polygon points="38,72 54,82 54,100 38,110 22,100 22,82" fill="#f0e68c" stroke="#d4c5a9" stroke-width="0.5" />
              <polygon points="72,72 88,82 88,100 72,110 56,100 56,82" fill="#6b8291" />
            </svg>
          </div>
        </div>

        <div style="text-align: center;">
          <p style="font-size: 0.8rem; color: #6b8291; margin-bottom: 0.5rem; font-weight: 600;">Quadrant</p>
          <div style="background: #3d5245; border-radius: 12px; padding: 2rem; margin-bottom: 0.75rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 120 120" width="110" height="110" xmlns="http://www.w3.org/2000/svg">
              <path d="M58,2 L58,58 L2,58 L2,20 Z" fill="#0060a8" />
              <path d="M62,2 L118,20 L118,58 L62,58 Z" fill="#e8c716" />
              <path d="M2,62 L58,62 L58,118 L2,100 Z" fill="#a7c7d8" />
              <path d="M62,62 L118,62 L118,100 L62,118 Z" fill="#4a7c8f" />
            </svg>
          </div>
          <div style="background: #ffffff; border: 1px solid #d4c5a9; border-radius: 12px; padding: 2rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 120 120" width="110" height="110" xmlns="http://www.w3.org/2000/svg">
              <path d="M58,2 L58,58 L2,58 L2,20 Z" fill="#0060a8" />
              <path d="M62,2 L118,20 L118,58 L62,58 Z" fill="#e8c716" />
              <path d="M2,62 L58,62 L58,118 L2,100 Z" fill="#3d5245" />
              <path d="M62,62 L118,62 L118,100 L62,118 Z" fill="#4a7c8f" />
            </svg>
          </div>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div style="background: #3d5245; border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; gap: 1rem;">
          <svg viewBox="0 0 120 120" width="48" height="48" xmlns="http://www.w3.org/2000/svg"><path d="M60,10 L103,35 L60,60 L17,35 Z" fill="#0060a8" /><path d="M103,35 L103,85 L60,60 Z" fill="#e8c716" /><path d="M103,85 L60,110 L17,85 L60,60 Z" fill="#3d5245" stroke="#4a7c8f" stroke-width="0.5" /><path d="M17,85 L17,35 L60,60 Z" fill="#a7c7d8" /><polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke="#4a7c8f" stroke-width="1.5" opacity="0.5" /></svg>
          <div><div style="color: #ffffff; font-size: 1.1rem; font-weight: 700; font-family: sans-serif;">SWOT<span style="color: #a7c7d8;">bee</span></div></div>
        </div>
        <div style="background: #ffffff; border: 1px solid #d4c5a9; border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; gap: 1rem;">
          <svg viewBox="0 0 120 120" width="48" height="48" xmlns="http://www.w3.org/2000/svg"><path d="M60,10 L103,35 L60,60 L17,35 Z" fill="#0060a8" /><path d="M103,35 L103,85 L60,60 Z" fill="#e8c716" /><path d="M103,85 L60,110 L17,85 L60,60 Z" fill="#3d5245" /><path d="M17,85 L17,35 L60,60 Z" fill="#a7c7d8" /><polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke="#d4c5a9" stroke-width="1" /></svg>
          <div><div style="color: #3d5245; font-size: 1.1rem; font-weight: 700; font-family: sans-serif;">SWOT<span style="color: #0060a8;">bee</span></div></div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
