---
import RenewalGuide from "../../components/astro/RenewalGuide.astro";
const props = {
  title: "How to renew multi-year contracts in HubSpot without the year-3 break",
  description: "Multi-year renewal chains silently stop at year 3 on HubSpot's re-enrollment limit. Here is the manual workaround, and the durable fix.",
