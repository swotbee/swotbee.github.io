  steps: [
    { n: 1, t: "Add the chain fields", time: "10 min", body: "Add a <strong>Renewal Year</strong> number that increments each cycle, a <strong>Deal Generation</strong> number, and an <strong>Original Deal ID</strong> text property so each renewal links back to its source." },
