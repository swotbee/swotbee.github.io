---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/astro/Navbar.astro';
---

<BaseLayout robots="noindex, follow" title="Logo — Final Palette">
  <Navbar />
  <div style="background: #f5f3ef; min-height: 100vh; padding: 3rem 1rem;">
    <div style="max-width: 1100px; margin: 0 auto;">

      <h1 style="font-size: 1.8rem; font-weight: 700; color: #1a2530; margin-bottom: 0.5rem; text-align: center;">Final Palette — Honeycomb Variations</h1>
      <p style="text-align: center; color: #6b7a8a; margin-bottom: 1rem; font-size: 0.9rem;">Honey Amber · Teal · Caution Blue · Solar Yellow — with harmonizing shades</p>

      <!-- Base 4 colors -->
      <div style="display: flex; justify-content: center; gap: 1rem; margin-bottom: 1rem;">
        <div style="text-align:center;">
          <div style="width: 56px; height: 56px; border-radius: 10px; background: #f0a500;"></div>
          <span style="font-size: 0.65rem; color: #6b7a8a;">Honey Amber<br/>#F0A500</span>
        </div>
        <div style="text-align:center;">
          <div style="width: 56px; height: 56px; border-radius: 10px; background: #70c1b3;"></div>
          <span style="font-size: 0.65rem; color: #6b7a8a;">Teal<br/>#70C1B3</span>
        </div>
        <div style="text-align:center;">
          <div style="width: 56px; height: 56px; border-radius: 10px; background: #0060a8;"></div>
          <span style="font-size: 0.65rem; color: #6b7a8a;">Caution Blue<br/>#0060A8</span>
        </div>
        <div style="text-align:center;">
          <div style="width: 56px; height: 56px; border-radius: 10px; background: #e8c716;"></div>
          <span style="font-size: 0.65rem; color: #6b7a8a;">Solar Yellow<br/>#E8C716</span>
        </div>
      </div>

      <!-- Extended shades -->
      <div style="display: flex; justify-content: center; gap: 0.5rem; margin-bottom: 2.5rem; flex-wrap: wrap;">
        <div style="text-align:center;">
          <div style="width: 36px; height: 36px; border-radius: 6px; background: #0a3d6b;"></div>
          <span style="font-size: 0.5rem; color: #6b7a8a;">Deep Blue</span>
        </div>
        <div style="text-align:center;">
          <div style="width: 36px; height: 36px; border-radius: 6px; background: #1a7ab5;"></div>
          <span style="font-size: 0.5rem; color: #6b7a8a;">Mid Blue</span>
        </div>
        <div style="text-align:center;">
          <div style="width: 36px; height: 36px; border-radius: 6px; background: #a7d8e8;"></div>
          <span style="font-size: 0.5rem; color: #6b7a8a;">Light Blue</span>
        </div>
        <div style="text-align:center;">
          <div style="width: 36px; height: 36px; border-radius: 6px; background: #3d8a7a;"></div>
          <span style="font-size: 0.5rem; color: #6b7a8a;">Deep Teal</span>
        </div>
        <div style="text-align:center;">
          <div style="width: 36px; height: 36px; border-radius: 6px; background: #b5ddd4;"></div>
          <span style="font-size: 0.5rem; color: #6b7a8a;">Light Teal</span>
        </div>
        <div style="text-align:center;">
          <div style="width: 36px; height: 36px; border-radius: 6px; background: #c48800;"></div>
          <span style="font-size: 0.5rem; color: #6b7a8a;">Dark Amber</span>
        </div>
        <div style="text-align:center;">
          <div style="width: 36px; height: 36px; border-radius: 6px; background: #fdd96b;"></div>
          <span style="font-size: 0.5rem; color: #6b7a8a;">Light Yellow</span>
        </div>
        <div style="text-align:center;">
          <div style="width: 36px; height: 36px; border-radius: 6px; background: #1a2530;"></div>
          <span style="font-size: 0.5rem; color: #6b7a8a;">Near Black</span>
        </div>
        <div style="text-align:center;">
          <div style="width: 36px; height: 36px; border-radius: 6px; background: #f5f3ef; border: 1px solid #ddd;"></div>
          <span style="font-size: 0.5rem; color: #6b7a8a;">Warm White</span>
        </div>
      </div>


      <!-- ============ HONEYCOMB VARIATIONS ============ -->
      <h2 style="font-size: 1.2rem; font-weight: 600; color: #1a2530; margin-bottom: 1.5rem; text-align: center;">Honeycomb Logos — 4 Base Colors</h2>

      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-bottom: 3rem;">

        <!-- H1: Split hex — 4 colors -->
        <div style="text-align: center;">
          <p style="font-size: 0.8rem; color: #6b7a8a; margin-bottom: 0.5rem; font-weight: 600;">Split Hex (4 color)</p>
          <div style="background: #1a2530; border-radius: 12px; padding: 1.5rem; margin-bottom: 0.75rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 120 120" width="100" height="100" xmlns="http://www.w3.org/2000/svg">
              <path d="M60,10 L103,35 L60,60 L17,35 Z" fill="#f0a500" />
              <path d="M103,35 L103,85 L60,60 Z" fill="#70c1b3" />
              <path d="M103,85 L60,110 L17,85 L60,60 Z" fill="#0060a8" />
              <path d="M17,85 L17,35 L60,60 Z" fill="#e8c716" />
              <polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke="#f0a500" stroke-width="1" opacity="0.3" />
            </svg>
          </div>
          <div style="background: #ffffff; border: 1px solid #e5e2da; border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 120 120" width="100" height="100" xmlns="http://www.w3.org/2000/svg">
              <path d="M60,10 L103,35 L60,60 L17,35 Z" fill="#f0a500" />
              <path d="M103,35 L103,85 L60,60 Z" fill="#70c1b3" />
              <path d="M103,85 L60,110 L17,85 L60,60 Z" fill="#0060a8" />
              <path d="M17,85 L17,35 L60,60 Z" fill="#e8c716" />
              <polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke="#ddd" stroke-width="0.75" />
            </svg>
          </div>
        </div>

        <!-- H2: Split hex — with shades -->
        <div style="text-align: center;">
          <p style="font-size: 0.8rem; color: #6b7a8a; margin-bottom: 0.5rem; font-weight: 600;">Split Hex (shades)</p>
          <div style="background: #1a2530; border-radius: 12px; padding: 1.5rem; margin-bottom: 0.75rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 120 120" width="100" height="100" xmlns="http://www.w3.org/2000/svg">
              <path d="M60,10 L103,35 L60,60 L17,35 Z" fill="#0060a8" />
              <path d="M103,35 L103,85 L60,60 Z" fill="#f0a500" />
              <path d="M103,85 L60,110 L17,85 L60,60 Z" fill="#3d8a7a" />
              <path d="M17,85 L17,35 L60,60 Z" fill="#70c1b3" />
              <polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke="#70c1b3" stroke-width="1" opacity="0.3" />
            </svg>
          </div>
          <div style="background: #ffffff; border: 1px solid #e5e2da; border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 120 120" width="100" height="100" xmlns="http://www.w3.org/2000/svg">
              <path d="M60,10 L103,35 L60,60 L17,35 Z" fill="#0060a8" />
              <path d="M103,35 L103,85 L60,60 Z" fill="#f0a500" />
              <path d="M103,85 L60,110 L17,85 L60,60 Z" fill="#3d8a7a" />
              <path d="M17,85 L17,35 L60,60 Z" fill="#70c1b3" />
              <polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke="#ddd" stroke-width="0.75" />
            </svg>
          </div>
        </div>

        <!-- H3: 6-slice hex -->
        <div style="text-align: center;">
          <p style="font-size: 0.8rem; color: #6b7a8a; margin-bottom: 0.5rem; font-weight: 600;">6 Slices</p>
          <div style="background: #1a2530; border-radius: 12px; padding: 1.5rem; margin-bottom: 0.75rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 120 120" width="100" height="100" xmlns="http://www.w3.org/2000/svg">
              <path d="M60,60 L60,10 L103,35 Z" fill="#f0a500" />
              <path d="M60,60 L103,35 L103,85 Z" fill="#70c1b3" />
              <path d="M60,60 L103,85 L60,110 Z" fill="#0060a8" />
              <path d="M60,60 L60,110 L17,85 Z" fill="#1a7ab5" />
              <path d="M60,60 L17,85 L17,35 Z" fill="#e8c716" />
              <path d="M60,60 L17,35 L60,10 Z" fill="#c48800" />
              <polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke="#f0a500" stroke-width="1" opacity="0.3" />
            </svg>
          </div>
          <div style="background: #ffffff; border: 1px solid #e5e2da; border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 120 120" width="100" height="100" xmlns="http://www.w3.org/2000/svg">
              <path d="M60,60 L60,10 L103,35 Z" fill="#f0a500" />
              <path d="M60,60 L103,35 L103,85 Z" fill="#70c1b3" />
              <path d="M60,60 L103,85 L60,110 Z" fill="#0060a8" />
              <path d="M60,60 L60,110 L17,85 Z" fill="#1a7ab5" />
              <path d="M60,60 L17,85 L17,35 Z" fill="#e8c716" />
              <path d="M60,60 L17,35 L60,10 Z" fill="#c48800" />
              <polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke="#ddd" stroke-width="0.75" />
            </svg>
          </div>
        </div>

        <!-- H4: Cluster -->
        <div style="text-align: center;">
          <p style="font-size: 0.8rem; color: #6b7a8a; margin-bottom: 0.5rem; font-weight: 600;">Cluster</p>
          <div style="background: #1a2530; border-radius: 12px; padding: 1.5rem; margin-bottom: 0.75rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 120 110" width="100" height="92" xmlns="http://www.w3.org/2000/svg">
              <polygon points="38,8 54,18 54,36 38,46 22,36 22,18" fill="#f0a500" />
              <polygon points="72,8 88,18 88,36 72,46 56,36 56,18" fill="#0060a8" />
              <polygon points="21,40 37,50 37,68 21,78 5,68 5,50" fill="#e8c716" />
              <polygon points="55,40 71,50 71,68 55,78 39,68 39,50" fill="#70c1b3" />
              <polygon points="89,40 105,50 105,68 89,78 73,68 73,50" fill="#3d8a7a" />
              <polygon points="38,72 54,82 54,100 38,110 22,100 22,82" fill="#c48800" />
              <polygon points="72,72 88,82 88,100 72,110 56,100 56,82" fill="#1a7ab5" />
            </svg>
          </div>
          <div style="background: #ffffff; border: 1px solid #e5e2da; border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 120 110" width="100" height="92" xmlns="http://www.w3.org/2000/svg">
              <polygon points="38,8 54,18 54,36 38,46 22,36 22,18" fill="#f0a500" />
              <polygon points="72,8 88,18 88,36 72,46 56,36 56,18" fill="#0060a8" />
              <polygon points="21,40 37,50 37,68 21,78 5,68 5,50" fill="#e8c716" />
              <polygon points="55,40 71,50 71,68 55,78 39,68 39,50" fill="#70c1b3" />
              <polygon points="89,40 105,50 105,68 89,78 73,68 73,50" fill="#1a2530" />
              <polygon points="38,72 54,82 54,100 38,110 22,100 22,82" fill="#c48800" />
              <polygon points="72,72 88,82 88,100 72,110 56,100 56,82" fill="#1a7ab5" />
            </svg>
          </div>
        </div>
      </div>


      <!-- Quadrant versions -->
      <h2 style="font-size: 1.2rem; font-weight: 600; color: #1a2530; margin-bottom: 1.5rem; text-align: center;">Quadrant Logos</h2>

      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-bottom: 3rem;">
        <!-- Q1: base 4 -->
        <div style="text-align: center;">
          <p style="font-size: 0.8rem; color: #6b7a8a; margin-bottom: 0.5rem; font-weight: 600;">Base 4</p>
          <div style="background: #1a2530; border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 120 120" width="90" height="90" xmlns="http://www.w3.org/2000/svg">
              <path d="M58,2 L58,58 L2,58 L2,20 Z" fill="#f0a500" />
              <path d="M62,2 L118,20 L118,58 L62,58 Z" fill="#70c1b3" />
              <path d="M2,62 L58,62 L58,118 L2,100 Z" fill="#e8c716" />
              <path d="M62,62 L118,62 L118,100 L62,118 Z" fill="#0060a8" />
            </svg>
          </div>
        </div>
        <!-- Q2: warm arrangement -->
        <div style="text-align: center;">
          <p style="font-size: 0.8rem; color: #6b7a8a; margin-bottom: 0.5rem; font-weight: 600;">Warm Top</p>
          <div style="background: #1a2530; border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 120 120" width="90" height="90" xmlns="http://www.w3.org/2000/svg">
              <path d="M58,2 L58,58 L2,58 L2,20 Z" fill="#e8c716" />
              <path d="M62,2 L118,20 L118,58 L62,58 Z" fill="#f0a500" />
              <path d="M2,62 L58,62 L58,118 L2,100 Z" fill="#0060a8" />
              <path d="M62,62 L118,62 L118,100 L62,118 Z" fill="#70c1b3" />
            </svg>
          </div>
        </div>
        <!-- Q3: cool arrangement -->
        <div style="text-align: center;">
          <p style="font-size: 0.8rem; color: #6b7a8a; margin-bottom: 0.5rem; font-weight: 600;">Cool Top</p>
          <div style="background: #1a2530; border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 120 120" width="90" height="90" xmlns="http://www.w3.org/2000/svg">
              <path d="M58,2 L58,58 L2,58 L2,20 Z" fill="#0060a8" />
              <path d="M62,2 L118,20 L118,58 L62,58 Z" fill="#70c1b3" />
              <path d="M2,62 L58,62 L58,118 L2,100 Z" fill="#f0a500" />
              <path d="M62,62 L118,62 L118,100 L62,118 Z" fill="#e8c716" />
            </svg>
          </div>
        </div>
        <!-- Q4: diagonal contrast -->
        <div style="text-align: center;">
          <p style="font-size: 0.8rem; color: #6b7a8a; margin-bottom: 0.5rem; font-weight: 600;">Diagonal</p>
          <div style="background: #1a2530; border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 120 120" width="90" height="90" xmlns="http://www.w3.org/2000/svg">
              <path d="M58,2 L58,58 L2,58 L2,20 Z" fill="#0060a8" />
              <path d="M62,2 L118,20 L118,58 L62,58 Z" fill="#f0a500" />
              <path d="M2,62 L58,62 L58,118 L2,100 Z" fill="#e8c716" />
              <path d="M62,62 L118,62 L118,100 L62,118 Z" fill="#70c1b3" />
            </svg>
          </div>
        </div>
      </div>


      <!-- Size test -->
      <h2 style="font-size: 1.1rem; font-weight: 600; color: #1a2530; margin-bottom: 1rem; text-align: center;">Size Test</h2>

      <div style="background: #1a2530; border-radius: 12px; padding: 2rem; display: flex; align-items: end; justify-content: center; gap: 2.5rem; flex-wrap: wrap; margin-bottom: 2rem;">
        {[16, 32, 48, 80, 120].map(size => (
          <div style="text-align: center;">
            <div style="display: flex; gap: 1rem; align-items: end;">
              {/* Hex */}
              <svg viewBox="0 0 120 120" width={size} height={size} xmlns="http://www.w3.org/2000/svg">
                <path d="M60,10 L103,35 L60,60 L17,35 Z" fill="#f0a500" />
                <path d="M103,35 L103,85 L60,60 Z" fill="#70c1b3" />
                <path d="M103,85 L60,110 L17,85 L60,60 Z" fill="#0060a8" />
                <path d="M17,85 L17,35 L60,60 Z" fill="#e8c716" />
                <polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke="#f0a500" stroke-width="1" opacity="0.3" />
              </svg>
              {/* Quad */}
              <svg viewBox="0 0 120 120" width={size} height={size} xmlns="http://www.w3.org/2000/svg">
                <path d="M58,2 L58,58 L2,58 L2,20 Z" fill="#f0a500" />
                <path d="M62,2 L118,20 L118,58 L62,58 Z" fill="#70c1b3" />
                <path d="M2,62 L58,62 L58,118 L2,100 Z" fill="#e8c716" />
                <path d="M62,62 L118,62 L118,100 L62,118 Z" fill="#0060a8" />
              </svg>
              {/* Cluster */}
              <svg viewBox="0 0 120 110" width={size * 1.09} height={size} xmlns="http://www.w3.org/2000/svg">
                <polygon points="38,8 54,18 54,36 38,46 22,36 22,18" fill="#f0a500" />
                <polygon points="72,8 88,18 88,36 72,46 56,36 56,18" fill="#0060a8" />
                <polygon points="21,40 37,50 37,68 21,78 5,68 5,50" fill="#e8c716" />
                <polygon points="55,40 71,50 71,68 55,78 39,68 39,50" fill="#70c1b3" />
                <polygon points="89,40 105,50 105,68 89,78 73,68 73,50" fill="#3d8a7a" />
                <polygon points="38,72 54,82 54,100 38,110 22,100 22,82" fill="#c48800" />
                <polygon points="72,72 88,82 88,100 72,110 56,100 56,82" fill="#1a7ab5" />
              </svg>
            </div>
            <p style="color: #6b7a8a; font-size: 0.6rem; margin-top: 0.5rem;">{size}px</p>
          </div>
        ))}
      </div>


      <!-- Lockups -->
      <h2 style="font-size: 1.1rem; font-weight: 600; color: #1a2530; margin-bottom: 1rem; text-align: center;">Logo + Text Lockup</h2>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <!-- Hex dark -->
        <div style="background: #1a2530; border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; gap: 1rem;">
          <svg viewBox="0 0 120 120" width="48" height="48" xmlns="http://www.w3.org/2000/svg">
            <path d="M60,10 L103,35 L60,60 L17,35 Z" fill="#f0a500" /><path d="M103,35 L103,85 L60,60 Z" fill="#70c1b3" /><path d="M103,85 L60,110 L17,85 L60,60 Z" fill="#0060a8" /><path d="M17,85 L17,35 L60,60 Z" fill="#e8c716" /><polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke="#f0a500" stroke-width="1" opacity="0.3" />
          </svg>
          <div>
            <div style="color: #ffffff; font-size: 1.1rem; font-weight: 700; font-family: sans-serif;">SWOT<span style="color: #70c1b3;">bee</span></div>
          </div>
        </div>
        <!-- Hex light -->
        <div style="background: #ffffff; border: 1px solid #e5e2da; border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; gap: 1rem;">
          <svg viewBox="0 0 120 120" width="48" height="48" xmlns="http://www.w3.org/2000/svg">
            <path d="M60,10 L103,35 L60,60 L17,35 Z" fill="#f0a500" /><path d="M103,35 L103,85 L60,60 Z" fill="#70c1b3" /><path d="M103,85 L60,110 L17,85 L60,60 Z" fill="#0060a8" /><path d="M17,85 L17,35 L60,60 Z" fill="#e8c716" /><polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke="#ddd" stroke-width="0.75" />
          </svg>
          <div>
            <div style="color: #1a2530; font-size: 1.1rem; font-weight: 700; font-family: sans-serif;">SWOT<span style="color: #0060a8;">bee</span></div>
          </div>
        </div>
        <!-- Quad dark -->
        <div style="background: #1a2530; border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; gap: 1rem;">
          <svg viewBox="0 0 120 120" width="48" height="48" xmlns="http://www.w3.org/2000/svg">
            <path d="M58,2 L58,58 L2,58 L2,20 Z" fill="#f0a500" /><path d="M62,2 L118,20 L118,58 L62,58 Z" fill="#70c1b3" /><path d="M2,62 L58,62 L58,118 L2,100 Z" fill="#e8c716" /><path d="M62,62 L118,62 L118,100 L62,118 Z" fill="#0060a8" />
          </svg>
          <div>
            <div style="color: #ffffff; font-size: 1.1rem; font-weight: 700; font-family: sans-serif;">SWOT<span style="color: #f0a500;">bee</span></div>
          </div>
        </div>
        <!-- Quad light -->
        <div style="background: #ffffff; border: 1px solid #e5e2da; border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; gap: 1rem;">
          <svg viewBox="0 0 120 120" width="48" height="48" xmlns="http://www.w3.org/2000/svg">
            <path d="M58,2 L58,58 L2,58 L2,20 Z" fill="#f0a500" /><path d="M62,2 L118,20 L118,58 L62,58 Z" fill="#70c1b3" /><path d="M2,62 L58,62 L58,118 L2,100 Z" fill="#e8c716" /><path d="M62,62 L118,62 L118,100 L62,118 Z" fill="#0060a8" />
          </svg>
          <div>
            <div style="color: #1a2530; font-size: 1.1rem; font-weight: 700; font-family: sans-serif;">SWOT<span style="color: #0060a8;">bee</span></div>
          </div>
        </div>
        <!-- Cluster dark -->
        <div style="background: #1a2530; border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; gap: 1rem;">
