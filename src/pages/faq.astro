---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/astro/Navbar.astro";
import Footer from "../components/astro/Footer.astro";

const faqs = [
  {
    question: "What does SWOTBee do?",
    answer: "We're a HubSpot Solutions Partner that helps mid-sized companies (50–100 employees) in Energy, Utilities, Manufacturing, Construction, and SaaS turn HubSpot into a revenue engine. We handle onboarding, marketing automation, sales/RevOps optimization, and third-party integrations.",
  },
  {
    question: "How much do your services cost?",
    answer: "Every business is different, so we tailor our approach to your needs. We offer project-based, retainer, and hourly consulting models. Book a free 30-minute discovery call and we'll give you an honest recommendation based on your situation.",
  },
  {
    question: "How long does a typical project take?",
    answer: "Most engagements span 3–6 months depending on complexity. We start delivering results in the first 2 weeks with quick wins, then build toward the bigger goals. Onboarding projects are typically 2–4 months.",
  },
  {
    question: "Are we locked into a long-term contract?",
    answer: "We offer flexible engagement models. Project-based work has a defined scope and timeline. Retainer engagements are month-to-month — you can cancel with 30-day notice. We earn your trust every month.",
  },
  {
    question: "What HubSpot tiers do you work with?",
    answer: "All of them — Starter, Professional, and Enterprise across Sales, Marketing, and Service Hubs. Most of our clients are on Professional or Enterprise.",
  },
  {
    question: "What industries do you specialize in?",
    answer: "We specialize in Energy & Utilities, Manufacturing, Construction, and SaaS/Technology. We understand the compliance requirements, operational workflows, and integration needs specific to these sectors.",
  },
  {
    question: "Can you integrate HubSpot with our other tools?",
    answer: "Yes. We've integrated HubSpot with NetSuite, Xero, DocuSign, Zoom, Monday.com, Shopify, Salesforce, Zapier, Slack, QuickBooks, Stripe, and custom APIs.",
  },
  {
    question: "Do you work alongside our existing team?",
    answer: "Absolutely — we work as an extension of your team. Our goal is to make your people more effective by building the automations, dashboards, and processes they need. We provide hands-on training and documentation so your team owns everything we build.",
  },
  {
    question: "What makes you different from other HubSpot partners?",
    answer: "Four things: (1) We adapt HubSpot to your workflow, not the other way around. (2) We deliver results from day one with high-impact quick wins. (3) We obsess over data quality — clean data, accurate forecasts, zero missed renewals. (4) We build industry-specific tools that fill gaps HubSpot doesn't cover.",
  },
  {
    question: "How do I get started?",
    answer: "Book a free 30-minute discovery call. No commitment, no sales pitch — just an honest conversation about whether we can help. We'll understand your situation and recommend the best next step.",
  },
];
---

<Layout
  title="Frequently Asked Questions | SWOTBee HubSpot Consulting"
  description="Find answers to common questions about our HubSpot consulting services, pricing, timelines, and engagement models."
>
  <Navbar />

  <section class="bg-gradient-to-b from-v6-bg to-white px-4 sm:px-6 lg:px-8 pt-16 sm:pt-20 pb-8">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-3xl sm:text-4xl font-bold text-v6-dark mb-4">Frequently Asked Questions</h1>
      <p class="text-base sm:text-lg text-v6-text-muted max-w-xl mx-auto leading-relaxed">
        Answers to the most common questions about working with SWOTBee.
      </p>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="space-y-4">
      {faqs.map(faq => (
        <details class="bg-white rounded-xl border border-v6-border group">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-4 text-base font-semibold text-v6-dark">
            {faq.question}
            <svg class="w-5 h-5 text-v6-text-muted flex-shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="px-6 pb-5 text-sm text-v6-text-muted leading-relaxed">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>

    <div class="mt-10 bg-v6-bg rounded-xl p-6 border border-v6-border text-center">
      <p class="text-sm text-v6-text-muted mb-3">
        Have a different question? We'd love to hear from you.
      </p>
      <a href="/contactus/" class="bg-v6-copper text-white px-6 py-2.5 rounded-lg text-sm font-semibold hover:bg-v6-copper-600 transition-colors inline-block">
        Contact Us
      </a>
    </div>
  </section>

  <Footer />
</Layout>
