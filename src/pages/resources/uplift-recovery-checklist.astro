---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/astro/Navbar.astro';
import Footer from '../../components/astro/Footer.astro';
import ClientLogoStrip from '../../components/astro/ClientLogoStrip.astro';
import MagnetObjections from '../../components/astro/MagnetObjections.astro';
// Lead magnet 2. Submits client-side to the HubSpot Forms API (portal 243398671), same
// pattern as renewal-leakage-estimate.astro. Form "SwotBee - Uplift Recovery Checklist"
// (id 58333f13-64ed-4bb9-a57d-6795cd9b0afd) created via the Marketing Forms API on
// 2026-07-14, see marketing/automation/n8n-kit-lead-magnet/README.md.
---
<BaseLayout
  title="Find Unbilled Price Increases in 60 Minutes"
  description="A free checklist to find the escalation uplifts you already earned but never invoiced. Most contract businesses find real money."
  robots="noindex, follow"
>
  <script is:inline src="https://www.google.com/recaptcha/api.js?render=6Ld3OHYtAAAAADJ8LKDmjsk4qrg2Ih9-FxxV2PSR"></script>
  <Navbar />
  <section class="bg-gradient-to-b from-v6-bg to-white px-4 sm:px-6 lg:px-8 pt-14 pb-10">
    <div class="max-w-2xl mx-auto text-center">
      <h1 class="text-3xl sm:text-4xl font-bold text-v6-dark leading-tight mb-4">
        Your contracts include price increases.<br /><span class="text-v6-copper">Did your invoices?</span>
      </h1>
      <p class="text-lg text-v6-text-muted mb-2">Escalation clauses only pay when someone remembers to apply them, at the right moment, every year. This 60-minute checklist finds what slipped: it is money you already earned.</p>
    </div>
  </section>

  <section class="bg-white px-4 sm:px-6 lg:px-8 pb-4">
    <div class="max-w-2xl mx-auto grid sm:grid-cols-3 gap-4 text-center">
      <div class="bg-v6-bg rounded-xl p-4"><div class="font-bold text-v6-teal text-lg">Step 1</div><div class="text-sm text-v6-text-muted">List every escalation clause</div></div>
      <div class="bg-v6-bg rounded-xl p-4"><div class="font-bold text-v6-teal text-lg">Step 2</div><div class="text-sm text-v6-text-muted">Compare contracted vs invoiced</div></div>
      <div class="bg-v6-bg rounded-xl p-4"><div class="font-bold text-v6-teal text-lg">Step 3</div><div class="text-sm text-v6-text-muted">Total, recover, prevent</div></div>
    </div>
  </section>

  <ClientLogoStrip caption="Trusted by revenue and operations teams at" />

  <section class="bg-white px-4 sm:px-6 lg:px-8 pb-16 pt-8">
    <div class="max-w-xl mx-auto bg-v6-bg border border-v6-border rounded-2xl p-8">
      <form id="uplift-form" class="flex flex-col gap-4" novalidate>
        <input type="hidden" name="funnel_stage_entry" value="uplift_checklist" />
        <input type="hidden" name="page_variant" value="v1-uplift-checklist" />
        <input type="hidden" name="utm_source" /><input type="hidden" name="utm_medium" /><input type="hidden" name="utm_campaign" /><input type="hidden" name="utm_content" /><input type="hidden" name="utm_term" />
        <label class="text-sm font-semibold text-v6-dark">Work email
          <input required type="email" name="email" placeholder="you@company.com" class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-3" />
        </label>
        <label class="text-sm font-semibold text-v6-dark">Do your contracts include escalation or annual-increase clauses?
          <select required name="escalations" class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-3 bg-white">
            <option value="">Select...</option><option>Yes, most</option><option>Some</option><option>No</option><option>Not sure</option>
          </select>
        </label>
        <label class="text-sm font-semibold text-v6-dark">Contracts renewing per year
          <select required name="contracts_per_year" class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-3 bg-white">
            <option value="">Select...</option><option><25</option><option>25-100</option><option>100-300</option><option>300+</option>
          </select>
        </label>
        <label class="text-sm font-semibold text-v6-dark">How did you first hear about us? <span class="font-normal text-gray-500">(optional)</span>
          <select name="self_reported_attribution" class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-3 bg-white">
            <option value="">Select...</option><option>Google search</option><option>LinkedIn</option><option>Referral</option><option>Cold email</option><option>Other</option>
          </select>
        </label>
        <button type="submit" class="bg-v6-copper text-white font-semibold rounded-xl px-6 py-3 hover:bg-v6-copper-600 transition-colors">Send me the checklist</button>
        <p class="text-xs text-gray-500 text-center">One email with the checklist PDF. That is it.</p>
        <p id="uplift-form-error" class="hidden text-sm text-red-600 text-center">Something went wrong sending the form. Please try again, or email us at info@swotbee.com and we will send the checklist directly.</p>
      </form>
      <div id="uplift-form-success" class="hidden text-center py-6">
        <p class="text-2xl mb-3">✅</p>
        <p class="text-lg font-semibold text-v6-dark mb-2">Got it. Your checklist is on its way.</p>
        <p class="text-sm text-v6-text-muted">One email with the checklist PDF. That is it.</p>
      </div>
    </div>
    <MagnetObjections items={[
      { q: "Is it really free?", a: "Yes. One email with the checklist. No card, no sales pitch." },
      { q: "How long does it take?", a: "About an hour to run it across your contracts." },
      { q: "Will you spam me?", a: "No. A short, useful renewal sequence. Unsubscribe anytime." },
    ]} />
    <p class="text-center text-sm text-v6-text-muted mt-8 max-w-xl mx-auto">Why this happens: applying uplifts in HubSpot means re-reading contracts at renewal time; there is no native rule for it. Multi-year contracts miss most often, at year 2 and 3.</p>
  </section>
  <Footer />

  <script>
    // Submits through the n8n reCAPTCHA-verify proxy to the HubSpot Forms API (same portal
    // as the ContactUs embed and renewal-leakage-estimate.astro).
    const PORTAL_ID = "243398671";
    const FORM_GUID = "58333f13-64ed-4bb9-a57d-6795cd9b0afd";
    const RECAPTCHA_SITE_KEY = "6Ld3OHYtAAAAADJ8LKDmjsk4qrg2Ih9-FxxV2PSR";
    const RECAPTCHA_ACTION = "uplift_form";
    const N8N_WEBHOOK_URL = "https://auto.zippylens.com/webhook/swotbee-form-submit";

    declare const grecaptcha: {
      ready: (cb: () => void) => void;
      execute: (siteKey: string, opts: { action: string }) => Promise<string>;
    };

    function getRecaptchaToken(): Promise<string> {
      return new Promise((resolve, reject) => {
        if (typeof grecaptcha === "undefined" || !grecaptcha.ready) {
          reject(new Error("recaptcha_unavailable"));
          return;
        }
        let settled = false;
        const timer = setTimeout(() => {
          settled = true;
          reject(new Error("recaptcha_unavailable"));
        }, 5000);
        grecaptcha.ready(() => {
          grecaptcha
            .execute(RECAPTCHA_SITE_KEY, { action: RECAPTCHA_ACTION })
            .then((token) => {
              if (settled) return;
              clearTimeout(timer);
              resolve(token);
            })
            .catch(() => {
              if (settled) return;
              clearTimeout(timer);
              reject(new Error("recaptcha_unavailable"));
            });
        });
      });
    }

    const form = document.getElementById("uplift-form") as HTMLFormElement | null;
    const success = document.getElementById("uplift-form-success");
    const errorMsg = document.getElementById("uplift-form-error");
    const defaultErrorText = errorMsg?.textContent ?? "";

    function gaEvent(name: string, params?: Record<string, unknown>) {
      const w = window as typeof window & { gtag?: (...args: unknown[]) => void };
      if (w.gtag) w.gtag("event", name, params || {});
    }
    let formStartFired = false;
    form?.addEventListener(
      "focusin",
      () => {
        if (!formStartFired) {
          formStartFired = true;
          gaEvent("form_start", { form_name: "uplift_recovery_checklist" });
        }
      },
      { once: true }
    );

    const params = new URLSearchParams(window.location.search);
    ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"].forEach((k) => {
      const input = form?.querySelector<HTMLInputElement>(`input[name="${k}"]`);
      if (input) input.value = params.get(k) ?? "";
    });

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      errorMsg?.classList.add("hidden");

      const data = new FormData(form);
      const fields = [...data.entries()].map(([name, value]) => ({
        objectTypeId: "0-1",
        name,
        value: String(value),
      }));

      try {
        const recaptchaToken = await getRecaptchaToken();
        const res = await fetch(N8N_WEBHOOK_URL, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            recaptchaToken,
            expectedAction: RECAPTCHA_ACTION,
            portalId: PORTAL_ID,
            formGuid: FORM_GUID,
            fields,
            context: { pageUri: window.location.href, pageName: document.title },
          }),
        });
        if (!res.ok) throw new Error(`proxy responded ${res.status}`);
        form.classList.add("hidden");
        success?.classList.remove("hidden");
        gaEvent("form_submit", { form_name: "uplift_recovery_checklist" });
      } catch (err) {
        if (errorMsg) {
          errorMsg.textContent =
            err instanceof Error && err.message === "recaptcha_unavailable"
              ? "Verification didn't load, this can happen with strict ad or privacy blockers. Please disable blocking for this site and try again, or email us at info@swotbee.com and we will send the checklist directly."
              : defaultErrorText;
        }
        errorMsg?.classList.remove("hidden");
        gaEvent("form_error", { form_name: "uplift_recovery_checklist" });
      }
    });
  </script>
</BaseLayout>
