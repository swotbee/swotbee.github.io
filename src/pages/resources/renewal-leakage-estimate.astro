---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/astro/Navbar.astro';
import Footer from '../../components/astro/Footer.astro';
// Lead magnet 1. Submits client-side to the HubSpot Forms API (portal 243398671, same
// portal as the ContactUs embed). ONE REMAINING SETUP STEP: create a form in HubSpot
// (Marketing > Forms) with fields matching the input names below, then paste its GUID
// into FORM_GUID in the script at the bottom of this file.
// The two 1-to-5 questions are the W5.4 calibration Likert items (see
// marketing/user-survey/05-ssr-synthetic-validation-plan.md): they accumulate the human
// sample that calibrates the synthetic panel. Do not remove or reword them casually;
// comparability across channels is the point.
---
<BaseLayout
  title="Free 1-Page Renewal Leakage Estimate | SWOTBee"
  description="Answer 5 questions, get a personalized 1-page estimate of what manual renewals cost you per year. No call needed."
  robots="noindex, follow"
>
  <Navbar />
  <section class="bg-gradient-to-b from-v6-bg to-white px-4 sm:px-6 lg:px-8 pt-14 pb-10">
    <div class="max-w-2xl mx-auto text-center">
      <h1 class="text-3xl sm:text-4xl font-bold text-v6-dark leading-tight mb-4">
        What are manual renewals <span class="text-v6-copper">costing you per year?</span>
      </h1>
      <p class="text-lg text-v6-text-muted mb-2">Answer 5 questions. Get a personalized 1-page estimate by email: slipped renewals, unbilled uplifts, and ops hours. No call needed.</p>
      <p class="text-sm text-gray-500">Directional, not a quote. Built from your inputs, not benchmarks alone.</p>
    </div>
  </section>

  <section class="bg-white px-4 sm:px-6 lg:px-8 pb-16">
    <div class="max-w-xl mx-auto bg-v6-bg border border-v6-border rounded-2xl p-8">
      <form id="leakage-form" class="flex flex-col gap-4" novalidate>
        <input type="hidden" name="magnet" value="leakage-estimate" />
        <input type="hidden" name="utm_source" /><input type="hidden" name="utm_medium" /><input type="hidden" name="utm_campaign" /><input type="hidden" name="utm_term" />
        <label class="text-sm font-semibold text-v6-dark">Work email
          <input required type="email" name="email" placeholder="you@company.com" class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-3" />
        </label>
        <label class="text-sm font-semibold text-v6-dark">Contracts renewing per year
          <select required name="contracts_per_year" class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-3 bg-white">
            <option value="">Select...</option><option>Fewer than 25</option><option>25 to 100</option><option>100 to 300</option><option>300+</option>
          </select>
        </label>
        <label class="text-sm font-semibold text-v6-dark">Average contract value
          <select required name="avg_value" class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-3 bg-white">
            <option value="">Select...</option><option>Under $5k</option><option>$5k to $25k</option><option>$25k to $100k</option><option>$100k+</option>
          </select>
        </label>
        <label class="text-sm font-semibold text-v6-dark">How renewals are tracked today
          <select required name="tracking" class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-3 bg-white">
            <option value="">Select...</option><option>Spreadsheet</option><option>HubSpot workflows</option><option>A dedicated app</option><option>Memory and calendars</option>
          </select>
        </label>
        <label class="text-sm font-semibold text-v6-dark">Accounting system
          <select name="accounting" class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-3 bg-white">
            <option value="">Select...</option><option>QuickBooks</option><option>Xero</option><option>Sage</option><option>NetSuite</option><option>Other</option>
          </select>
        </label>
        <label class="text-sm font-semibold text-v6-dark">PSA, if you run one <span class="font-normal text-gray-500">(MSPs: this calibrates your estimate)</span>
          <select name="psa" class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-3 bg-white">
            <option value="">None / not an MSP</option><option>ConnectWise</option><option>Autotask</option><option>HaloPSA</option><option>Other PSA</option>
          </select>
        </label>
        <fieldset class="mt-1">
          <legend class="text-sm font-semibold text-v6-dark mb-2">How painful is managing renewals today?</legend>
          <div class="flex items-center justify-between gap-1">
            <span class="text-xs text-gray-500">Runs fine</span>
            {[1,2,3,4,5].map(n => (
              <label class="flex flex-col items-center text-xs text-v6-text-muted cursor-pointer px-1">
                <input required type="radio" name="pain_severity" value={n} class="mb-1 accent-[#C47A2A]" />{n}
              </label>
            ))}
            <span class="text-xs text-gray-500">Constant firefighting</span>
          </div>
        </fieldset>

        <fieldset>
          <legend class="text-sm font-semibold text-v6-dark mb-2">How likely are you to put budget toward fixing renewals in the next 12 months?</legend>
          <div class="flex items-center justify-between gap-1">
            <span class="text-xs text-gray-500">Not a priority</span>
            {[1,2,3,4,5].map(n => (
              <label class="flex flex-col items-center text-xs text-v6-text-muted cursor-pointer px-1">
                <input required type="radio" name="budget_intent" value={n} class="mb-1 accent-[#C47A2A]" />{n}
              </label>
            ))}
            <span class="text-xs text-gray-500">Budgeting this quarter</span>
          </div>
        </fieldset>

        <button type="submit" class="bg-v6-copper text-white font-semibold rounded-xl px-6 py-3 hover:bg-v6-copper-600 transition-colors">Send my 1-page estimate</button>
        <p class="text-xs text-gray-500 text-center">One email with your estimate. No sequences you did not ask for. Works whatever your finance stack.</p>
        <p id="leakage-form-error" class="hidden text-sm text-red-600 text-center">Something went wrong sending the form. Please try again, or email us at info@swotbee.com and we will run the estimate for you.</p>
      </form>
      <div id="leakage-form-success" class="hidden text-center py-6">
        <p class="text-2xl mb-3">✅</p>
        <p class="text-lg font-semibold text-v6-dark mb-2">Got it. Your estimate is on its way.</p>
        <p class="text-sm text-v6-text-muted">One email, usually within a business day: slipped renewals, unbilled uplifts, and ops hours, from your inputs.</p>
      </div>
    </div>
    <p class="text-center text-sm text-v6-text-muted mt-8 max-w-xl mx-auto">Context worth knowing: poor CRM data quality costs companies 12 to 25% of revenue (MIT Sloan), and HubSpot has no native renewal automation (the community thread asking for it has 26,000+ views).</p>
  </section>
  <Footer />

  <script>
    // Submits to the HubSpot Forms API (same portal as the ContactUs embed).
    // TODO (one-time): create the form in HubSpot with matching field names
    // (email, contracts_per_year, avg_value, tracking, accounting, magnet,
    // pain_severity, budget_intent, utm_source, utm_medium, utm_campaign, utm_term)
    // and paste its GUID here.
    const PORTAL_ID = "243398671";
    const FORM_GUID = ""; // <- paste the HubSpot form GUID before launch

    const form = document.getElementById("leakage-form") as HTMLFormElement | null;
    const success = document.getElementById("leakage-form-success");
    const errorMsg = document.getElementById("leakage-form-error");

    // Capture ad attribution from the landing URL into the hidden fields.
    const params = new URLSearchParams(window.location.search);
    ["utm_source", "utm_medium", "utm_campaign", "utm_term"].forEach((k) => {
      const input = form?.querySelector<HTMLInputElement>(`input[name="${k}"]`);
      if (input) input.value = params.get(k) ?? "";
    });

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      errorMsg?.classList.add("hidden");

      const data = new FormData(form);
      const fields = [...data.entries()].map(([name, value]) => ({
        objectTypeId: "0-1",
        name,
        value: String(value),
      }));

      try {
        if (!FORM_GUID) throw new Error("FORM_GUID not configured");
        const res = await fetch(
          `https://api.hsforms.com/submissions/v3/integration/submit/${PORTAL_ID}/${FORM_GUID}`,
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              fields,
              context: { pageUri: window.location.href, pageName: document.title },
            }),
          }
        );
        if (!res.ok) throw new Error(`HubSpot responded ${res.status}`);
        form.classList.add("hidden");
        success?.classList.remove("hidden");
      } catch (_err) {
        errorMsg?.classList.remove("hidden");
      }
    });
  </script>
</BaseLayout>
