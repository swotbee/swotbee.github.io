---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/astro/Navbar.astro';
import Footer from '../../components/astro/Footer.astro';
import ClientLogoStrip from '../../components/astro/ClientLogoStrip.astro';
import MagnetObjections from '../../components/astro/MagnetObjections.astro';
// Lead magnet 1. Submits client-side to the HubSpot Forms API (portal 243398671, same
// portal as the ContactUs embed). Form + properties created via API 2026-07-14, see
// marketing/automation/n8n-kit-lead-magnet/README.md.
// The two 1-to-5 questions are the W5.4 calibration Likert items (see
// marketing/user-survey/05-ssr-synthetic-validation-plan.md): they accumulate the human
// sample that calibrates the synthetic panel. Do not remove or reword them casually;
// comparability across channels is the point.
---
<BaseLayout
  title="Free 1-Page Renewal Leakage Estimate"
  description="Answer 5 questions, get a personalized 1-page estimate of what manual renewals cost you per year. No call needed."
  robots="noindex, follow"
>
  <script is:inline src="https://www.google.com/recaptcha/api.js?render=6Ld3OHYtAAAAADJ8LKDmjsk4qrg2Ih9-FxxV2PSR"></script>
  <Navbar />
  <section class="bg-gradient-to-b from-v6-bg to-white px-4 sm:px-6 lg:px-8 pt-14 pb-10">
    <div class="max-w-2xl mx-auto text-center">
      <h1 class="text-3xl sm:text-4xl font-bold text-v6-dark leading-tight mb-4">
        What are manual renewals <span class="text-v6-copper">costing you per year?</span>
      </h1>
      <p class="text-lg text-v6-text-muted mb-2">Answer 5 questions. Get a personalized 1-page estimate by email: slipped renewals, unbilled uplifts, and ops hours. No call needed.</p>
      <p class="text-sm text-gray-500">Directional, not a quote. Built from your inputs, not benchmarks alone.</p>
    </div>
  </section>

  <ClientLogoStrip caption="Trusted by revenue and operations teams at" />

  <section class="bg-white px-4 sm:px-6 lg:px-8 pb-16">
    <div class="max-w-xl mx-auto bg-v6-bg border border-v6-border rounded-2xl p-8">
      <form id="leakage-form" class="flex flex-col gap-4" novalidate>
        <input type="hidden" name="funnel_stage_entry" value="leakage_estimate" />
        <input type="hidden" name="page_variant" value="v1-leakage-estimate" />
        <input type="hidden" name="ga_client_id" />
        <input type="hidden" name="utm_source" /><input type="hidden" name="utm_medium" /><input type="hidden" name="utm_campaign" /><input type="hidden" name="utm_content" /><input type="hidden" name="utm_term" />
        <label class="text-sm font-semibold text-v6-dark">Work email
          <input required type="email" name="email" placeholder="you@company.com" class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-3" />
        </label>
        <label class="text-sm font-semibold text-v6-dark">Your role
          <select required name="self_reported_role" class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-3 bg-white">
            <option value="">Select...</option><option>Decision maker (VP/Exec/Owner)</option><option>RevOps / Ops practitioner</option><option>Consultant / Agency</option><option>Other</option>
          </select>
        </label>
        <label class="text-sm font-semibold text-v6-dark">Contracts renewing per year
          <select required name="contracts_per_year" class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-3 bg-white">
            <option value="">Select...</option><option><25</option><option>25-100</option><option>100-300</option><option>300+</option>
          </select>
        </label>
        <label class="text-sm font-semibold text-v6-dark">Average contract value
          <select required name="avg_contract_value" class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-3 bg-white">
            <option value="">Select...</option><option>Under $5k</option><option>$5k-25k</option><option>$25k-100k</option><option>$100k+</option>
          </select>
        </label>
        <label class="text-sm font-semibold text-v6-dark">How renewals are tracked today
          <select required name="renewal_tracking_method" class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-3 bg-white">
            <option value="">Select...</option><option>Spreadsheet</option><option>HubSpot workflows</option><option>A dedicated app</option><option>Memory and calendars</option>
          </select>
        </label>
        <label class="text-sm font-semibold text-v6-dark">Accounting system
          <select name="accounting_system" class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-3 bg-white">
            <option value="">Select...</option><option>QuickBooks</option><option>Xero</option><option>Sage</option><option>NetSuite</option><option>Other</option>
          </select>
        </label>
        <label class="text-sm font-semibold text-v6-dark">PSA, if you run one <span class="font-normal text-gray-500">(MSPs: this calibrates your estimate)</span>
          <select name="psa" class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-3 bg-white">
            <option>None / not an MSP</option><option>ConnectWise</option><option>Autotask</option><option>HaloPSA</option><option>Other PSA</option>
          </select>
        </label>
        <label class="text-sm font-semibold text-v6-dark">How did you first hear about us? <span class="font-normal text-gray-500">(optional)</span>
          <select name="self_reported_attribution" class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-3 bg-white">
            <option value="">Select...</option><option>Google search</option><option>LinkedIn</option><option>Referral</option><option>Cold email</option><option>Other</option>
          </select>
        </label>
        <fieldset class="mt-1">
          <legend class="text-sm font-semibold text-v6-dark mb-2">How painful is managing renewals today?</legend>
          <div class="flex items-center justify-between gap-1">
            <span class="text-xs text-gray-500">Runs fine</span>
            {[1,2,3,4,5].map(n => (
              <label class="flex flex-col items-center text-xs text-v6-text-muted cursor-pointer px-1">
                <input required type="radio" name="pain_severity" value={n} class="mb-1 accent-[#C47A2A]" />{n}
              </label>
            ))}
            <span class="text-xs text-gray-500">Constant firefighting</span>
          </div>
        </fieldset>

        <fieldset>
          <legend class="text-sm font-semibold text-v6-dark mb-2">How likely are you to put budget toward fixing renewals in the next 12 months?</legend>
          <div class="flex items-center justify-between gap-1">
            <span class="text-xs text-gray-500">Not a priority</span>
            {[1,2,3,4,5].map(n => (
              <label class="flex flex-col items-center text-xs text-v6-text-muted cursor-pointer px-1">
                <input required type="radio" name="budget_intent" value={n} class="mb-1 accent-[#C47A2A]" />{n}
              </label>
            ))}
            <span class="text-xs text-gray-500">Budgeting this quarter</span>
          </div>
        </fieldset>

        <button type="submit" class="bg-v6-copper text-white font-semibold rounded-xl px-6 py-3 hover:bg-v6-copper-600 transition-colors">Send my 1-page estimate</button>
        <p class="text-xs text-gray-500 text-center">One email with your estimate. No sequences you did not ask for. Works whatever your finance stack.</p>
        <p id="leakage-form-error" class="hidden text-sm text-red-600 text-center">Something went wrong sending the form. Please try again, or email us at info@swotbee.com and we will run the estimate for you.</p>
      </form>
      <div id="leakage-form-success" class="hidden text-center py-6">
        <p class="text-2xl mb-3">✅</p>
        <p class="text-lg font-semibold text-v6-dark mb-2">Got it. Your estimate is on its way.</p>
        <p class="text-sm text-v6-text-muted">One email, usually within a business day: slipped renewals, unbilled uplifts, and ops hours, from your inputs.</p>
      </div>
    </div>
    <MagnetObjections items={[
      { q: "Is it really free?", a: "Yes. One email with your estimate. No card, no sales pitch." },
      { q: "How accurate is it?", a: "It is a directional estimate. The paid audit verifies it against your real HubSpot data." },
      { q: "Will you spam me?", a: "No. A short, useful renewal sequence. Unsubscribe anytime." },
    ]} />
    <p class="text-center text-sm text-v6-text-muted mt-8 max-w-xl mx-auto">Context worth knowing: poor CRM data quality costs companies 12 to 25% of revenue (MIT Sloan), and HubSpot has no native renewal automation (the community thread asking for it has 26,000+ views).</p>
  </section>
  <Footer />

  <script>
    // Submits through the n8n reCAPTCHA-verify proxy to the HubSpot Forms API (same portal
    // as the ContactUs embed). Form "SwotBee - Renewal Leakage Estimate"
    // (id b321d585-8cbc-4a55-bcd4-ec4526194fd1) and its backing contact properties were
    // created via the CRM Properties API + Marketing Forms API on 2026-07-14, see
    // marketing/automation/n8n-kit-lead-magnet/README.md.
    const PORTAL_ID = "243398671";
    const FORM_GUID = "b321d585-8cbc-4a55-bcd4-ec4526194fd1";
    const RECAPTCHA_SITE_KEY = "6Ld3OHYtAAAAADJ8LKDmjsk4qrg2Ih9-FxxV2PSR";
    const RECAPTCHA_ACTION = "leakage_form";
    const N8N_WEBHOOK_URL = "https://auto.zippylens.com/webhook/swotbee-form-submit";

    declare const grecaptcha: {
      ready: (cb: () => void) => void;
      execute: (siteKey: string, opts: { action: string }) => Promise<string>;
    };

    function getRecaptchaToken(): Promise<string> {
      return new Promise((resolve, reject) => {
        if (typeof grecaptcha === "undefined" || !grecaptcha.ready) {
          reject(new Error("recaptcha_unavailable"));
          return;
        }
        let settled = false;
        const timer = setTimeout(() => {
          settled = true;
          reject(new Error("recaptcha_unavailable"));
        }, 5000);
        grecaptcha.ready(() => {
          grecaptcha
            .execute(RECAPTCHA_SITE_KEY, { action: RECAPTCHA_ACTION })
            .then((token) => {
              if (settled) return;
              clearTimeout(timer);
              resolve(token);
            })
            .catch(() => {
              if (settled) return;
              clearTimeout(timer);
              reject(new Error("recaptcha_unavailable"));
            });
        });
      });
    }

    const form = document.getElementById("leakage-form") as HTMLFormElement | null;
    const success = document.getElementById("leakage-form-success");
    const errorMsg = document.getElementById("leakage-form-error");
    const defaultErrorText = errorMsg?.textContent ?? "";

    function gaEvent(name: string, params?: Record<string, unknown>) {
      const w = window as typeof window & { gtag?: (...args: unknown[]) => void };
      if (w.gtag) w.gtag("event", name, params || {});
    }
    let formStartFired = false;
    form?.addEventListener(
      "focusin",
      () => {
        if (!formStartFired) {
          formStartFired = true;
          gaEvent("form_start", { form_name: "leakage_estimate" });
        }
      },
      { once: true }
    );

    // Capture ad attribution from the landing URL into the hidden fields.
    const params = new URLSearchParams(window.location.search);
    ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"].forEach((k) => {
      const input = form?.querySelector<HTMLInputElement>(`input[name="${k}"]`);
      if (input) input.value = params.get(k) ?? "";
    });

    // Capture the GA4 client_id from the _ga cookie so the server-side form_submit hit
    // (fired from n8n after this submission) merges into the same GA4 session instead of
    // creating an orphaned/unlinked event. Cookie format: GA1.1.<clientIdPart1>.<clientIdPart2>.
    (() => {
      const match = document.cookie.match(/_ga=GA\d\.\d\.(\d+\.\d+)/);
      const clientIdInput = form?.querySelector<HTMLInputElement>('input[name="ga_client_id"]');
      if (match && clientIdInput) clientIdInput.value = match[1];
    })();

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      errorMsg?.classList.add("hidden");

      const data = new FormData(form);
      const fields = [...data.entries()].map(([name, value]) => ({
        objectTypeId: "0-1",
        name,
        value: String(value),
      }));

      try {
        if (!FORM_GUID) throw new Error("FORM_GUID not configured");
        const recaptchaToken = await getRecaptchaToken();
        const res = await fetch(N8N_WEBHOOK_URL, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            recaptchaToken,
            expectedAction: RECAPTCHA_ACTION,
            portalId: PORTAL_ID,
            formGuid: FORM_GUID,
            fields,
            context: { pageUri: window.location.href, pageName: document.title },
          }),
        });
        if (!res.ok) throw new Error(`proxy responded ${res.status}`);
        form.classList.add("hidden");
        success?.classList.remove("hidden");
        gaEvent("form_submit", { form_name: "leakage_estimate" });
      } catch (err) {
        if (errorMsg) {
          errorMsg.textContent =
            err instanceof Error && err.message === "recaptcha_unavailable"
              ? "Verification didn't load, this can happen with strict ad or privacy blockers. Please disable blocking for this site and try again, or email us at info@swotbee.com and we will run the estimate for you."
              : defaultErrorText;
        }
        errorMsg?.classList.remove("hidden");
        gaEvent("form_error", { form_name: "leakage_estimate" });
      }
    });
  </script>
</BaseLayout>
