---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/astro/Footer.astro";
import LogoHoneycomb from "../components/astro/LogoHoneycomb.astro";
import ClientLogoStrip from "../components/astro/ClientLogoStrip.astro";
import ReportSignup from "../components/astro/ReportSignup.astro";

const title = "HubSpot Revenue Reporting | Forecast, Goals and ROI";
const description = "Put HubSpot actual revenue, forecast, targets, and ROI into one recurring management report in Excel, PowerPoint, or a live dashboard.";

const dealRows = [
  { deal: "Northstar expansion", owner: "Maya Chen", team: "Enterprise", amount: "$82k", forecast: "Commit", issue: "Legal review due Friday", action: "Confirm signature date" },
  { deal: "Quarry annual plan", owner: "Liam Ross", team: "Mid-Market", amount: "$64k", forecast: "Best case", issue: "Decision date moved by 12 days", action: "Reconfirm close plan" },
  { deal: "Acme regional rollout", owner: "Elena Park", team: "Mid-Market", amount: "$48k", forecast: "Pipeline", issue: "No meeting booked this month", action: "Manager review" },
];

const reportAreas = [
  { title: "Actual revenue and target", description: "Closed-won revenue, the agreed target, progress toward it, and the remaining gap for the same period and currency." },
  { title: "Forecast and movement", description: "The latest team forecast, the previous submission, the change between them, and the deals responsible for that movement." },
  { title: "Pipeline and coverage", description: "Open pipeline, likely revenue, coverage against the remaining target, and the opportunities that could change the outcome." },
  { title: "Team and market results", description: "Revenue and forecast by owner, team, pipeline, region, product, segment, or another supported field used in your review." },
  { title: "Marketing spend and return", description: "Selected spend, attributed revenue, and the approved ROI calculation, with the inputs shown alongside the result." },
  { title: "Risks, decisions, and actions", description: "Deals and missing inputs that need attention, the decision required, and an owner and due date for the next step." },
];

const faqs = [
  { q: "What is included in the HubSpot revenue report?", a: "You choose what belongs in it. A report can include Closed Won revenue, the latest team forecast, forecast changes, revenue targets, the gap to target, open pipeline, selected campaign spend and return, the deals behind the numbers, and agreed actions." },
  { q: "Can I compare actual revenue, forecast, and target in one report?", a: "Yes, when the matching deal, forecast, and goal data is available in your HubSpot account. The report uses the same period, pipelines, teams, and currency across the comparison and shows when an input is missing." },
  { q: "Can I use Excel, PowerPoint, or a live dashboard?", a: "Yes. Excel carries the calculations and deal detail, PowerPoint provides an editable meeting-ready version, and a live dashboard can be shared when the audience needs the latest approved view. All three use the same reporting setup." },
  { q: "Can I create a PowerPoint for Finance, executives, or the board?", a: "Yes. The editable presentation carries the revenue result, target gap, forecast change, main drivers, risks, and decisions into a shorter meeting-ready format. The supporting detail remains in Excel." },
  { q: "Can the report use manual forecast submissions?", a: "For eligible HubSpot accounts, the current Forecasts API provides read-only access to submitted forecasts and their change history. Availability depends on the account's HubSpot subscription, permissions, and forecast setup." },
  { q: "How is marketing ROI calculated?", a: "You first choose the spend, revenue value, attribution approach, currency, and period that should count. SWOTBee calculates return only when those inputs are available and labels the calculation used. It does not substitute a missing value or silently change the revenue definition." },
  { q: "Can SWOTBee create MRR, ARR, NRR, or GRR reports?", a: "Yes, when the required recurring-revenue values and dates are available in HubSpot or the agreed billing source. NRR and GRR belong in a separate retention-revenue report because they need starting revenue, expansion, contraction, and churn—not the forecast and target view shown on this page. SWOTBee cannot reconstruct an earlier revenue state that was never recorded." },
  { q: "Will signing up connect my HubSpot account?", a: "No. This signup records your work email and requested report so we can contact you about access. It does not create an app account or connect to your HubSpot portal." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Layout
  title={title}
  description={description}
  keywords="hubspot revenue reporting, hubspot revenue report, hubspot revenue forecasting reports, hubspot actual revenue vs target, hubspot goal reporting, hubspot executive revenue reporting, hubspot board revenue report, hubspot campaign ROI reporting, export hubspot reports to excel"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <header class="border-b border-v6-border bg-white">
    <div class="mx-auto flex min-h-16 max-w-6xl items-center justify-between gap-6 px-4 py-2 sm:px-6 lg:px-8">
      <a href="/" class="flex min-h-11 shrink-0 items-center gap-2 rounded-md focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2" aria-label="SWOTbee home">
        <LogoHoneycomb width={32} height={30} />
        <span class="text-lg font-bold text-v6-dark">SWOT<span class="text-v6-teal-700">bee</span></span>
      </a>
      <nav class="hidden items-center gap-6 text-sm font-semibold text-v6-text-muted lg:flex" aria-label="Page navigation">
        <a href="#how-it-works" class="rounded-md py-2 hover:text-v6-dark focus:outline-none focus:ring-2 focus:ring-v6-copper">How it works</a>
        <a href="#sample-report" class="rounded-md py-2 hover:text-v6-dark focus:outline-none focus:ring-2 focus:ring-v6-copper">Sample report</a>
        <a href="#report-contents" class="rounded-md py-2 hover:text-v6-dark focus:outline-none focus:ring-2 focus:ring-v6-copper">What's included</a>
        <a href="#questions" class="rounded-md py-2 hover:text-v6-dark focus:outline-none focus:ring-2 focus:ring-v6-copper">FAQs</a>
      </nav>
      <a href="#report-signup" data-ga-cta="revenue_report_header_signup" class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-lg border border-v6-copper px-4 py-2 text-sm font-semibold text-v6-copper transition-colors hover:bg-v6-copper-50 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">
        Build your Revenue Report
      </a>
    </div>
  </header>

  <main>
    <section class="overflow-hidden bg-gradient-to-b from-v6-bg to-white px-4 pb-16 pt-14 sm:px-6 sm:pb-20 sm:pt-20 lg:px-8">
      <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <span class="mb-5 inline-flex rounded-full bg-v6-copper-50 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-v6-copper-700">HubSpot revenue reporting</span>
          <h1 class="max-w-3xl text-balance text-4xl font-bold leading-[1.08] text-v6-dark sm:text-5xl lg:text-[3.45rem]">Your HubSpot revenue report, ready before the review</h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-v6-text-muted">Build a complete HubSpot revenue report in 3 clicks. See what closed, what the team expects to close, how that compares with target, and which marketing spend produced revenue—then use the same numbers in Excel, PowerPoint, or a live dashboard.</p>
          <p class="mt-5 font-semibold text-v6-dark">Run it weekly, monthly, or quarterly. No separate exports. No spreadsheet joins. No rebuilt slide deck.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#report-signup" data-ga-cta="revenue_report_hero_signup" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-v6-copper px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-v6-copper-600 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">Build your Revenue Report</a>
            <a href="#sample-report" data-ga-cta="revenue_report_hero_sample" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-v6-border bg-white px-7 py-3.5 text-base font-semibold text-v6-dark transition-colors hover:border-v6-copper hover:bg-v6-copper-50 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">See a sample revenue report</a>
          </div>
          <p class="mx-auto mt-4 max-w-xl text-center text-sm font-semibold leading-relaxed text-v6-dark">No credit card required. Your first month is on us.</p>
        </div>

        <div class="relative" aria-label="Example quarterly HubSpot revenue report">
          <div class="absolute -inset-6 -z-10 rounded-full bg-v6-teal-100/70 blur-3xl"></div>
          <div class="overflow-hidden rounded-2xl border border-v6-border bg-white shadow-xl shadow-v6-dark/10">
            <div class="flex items-center justify-between gap-4 border-b border-v6-border px-5 py-4">
              <div><p class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-copper">Quarterly revenue report</p><p class="mt-1 font-semibold text-v6-dark">Q3 executive review</p></div>
              <span class="rounded-full bg-v6-blue-50 px-3 py-1 text-xs font-semibold text-v6-blue-800">Example data</span>
            </div>
            <div class="grid grid-cols-2 border-b border-v6-border sm:grid-cols-4">
              <div class="border-b border-r border-v6-border p-4 sm:border-b-0 sm:p-5"><p class="text-xs text-v6-text-muted">Closed revenue</p><p class="mt-1 text-xl font-bold text-v6-dark">$684k</p><p class="mt-1 text-xs font-semibold text-v6-teal-800">68% of target</p></div>
              <div class="border-b border-v6-border p-4 sm:border-b-0 sm:border-r sm:p-5"><p class="text-xs text-v6-text-muted">Latest forecast</p><p class="mt-1 text-xl font-bold text-v6-dark">$910k</p><p class="mt-1 text-xs font-semibold text-v6-copper-800">Down $35k</p></div>
              <div class="border-r border-v6-border p-4 sm:p-5"><p class="text-xs text-v6-text-muted">Quarter target</p><p class="mt-1 text-xl font-bold text-v6-dark">$1.00m</p></div>
              <div class="bg-v6-copper-50 p-4 sm:p-5"><p class="text-xs text-v6-copper-800">Gap to target</p><p class="mt-1 text-xl font-bold text-v6-copper-800">$90k</p></div>
            </div>
            <div class="p-5">
              <div class="rounded-xl bg-v6-bg-warm p-4">
                <p class="text-xs font-semibold uppercase tracking-[0.12em] text-v6-copper-800">Management summary</p>
                <p class="mt-2 text-sm font-semibold leading-relaxed text-v6-dark">The latest forecast is $90k below target. Enterprise is ahead, while Mid-Market accounts for most of the remaining gap.</p>
                <a href="#sample-report" class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-v6-copper-800 underline decoration-v6-copper-300 underline-offset-4 focus:outline-none focus:ring-2 focus:ring-v6-copper">See the deals behind the gap</a>
              </div>
            </div>
            <div class="grid grid-cols-3 gap-px border-t border-v6-border bg-v6-border text-center text-xs font-semibold text-v6-text-muted"><span class="bg-v6-bg px-3 py-3">Excel workbook</span><span class="bg-v6-bg px-3 py-3">PowerPoint deck</span><span class="bg-v6-bg px-3 py-3">Live dashboard</span></div>
          </div>
        </div>
      </div>
    </section>

    <ClientLogoStrip caption="HubSpot and revenue operations work trusted by teams at" />

    <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.88fr_1.12fr] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">One meeting, five places to look</p>
          <h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">Actual, forecast, target, and ROI are in HubSpot. The executive view is not.</h2>
        </div>
        <div class="space-y-5 text-lg leading-relaxed text-v6-text-muted">
          <p>Closed revenue is in Deals. The team’s latest number is in Forecast. Targets are in Goals. Spend and attributed revenue are in Ads or Campaigns. Recurring revenue may use a separate set of fields again.</p>
          <p>By the time those numbers reach Finance, someone has exported separate files, checked the periods and currencies, joined the rows in Excel, found the deals behind the change, and rebuilt the result in PowerPoint.</p>
          <p class="font-semibold text-v6-dark">SWOTBee keeps that reporting setup together, so the next review starts with fresh data—not another reconciliation exercise.</p>
        </div>
      </div>
    </section>

    <section id="how-it-works" class="scroll-mt-8 bg-v6-bg px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">A reusable revenue review</p>
          <h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">Set the revenue review once. Run it again next week, month, or quarter.</h2>
          <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">Set it up for the way your business measures revenue.</p>
        </div>
        <ol class="mt-10 grid gap-6 md:grid-cols-3">
          <li class="rounded-2xl border border-v6-border bg-white p-6 sm:p-7"><span class="flex h-9 w-9 items-center justify-center rounded-full bg-v6-copper-50 text-sm font-bold text-v6-copper-800">1</span><h3 class="mt-5 text-xl font-bold text-v6-dark">Choose the scope</h3><p class="mt-3 leading-relaxed text-v6-text-muted">Pick the period, comparison, currency, pipelines, teams, regions, and campaigns that belong in the report.</p></li>
          <li class="rounded-2xl border border-v6-border bg-white p-6 sm:p-7"><span class="flex h-9 w-9 items-center justify-center rounded-full bg-v6-copper-50 text-sm font-bold text-v6-copper-800">2</span><h3 class="mt-5 text-xl font-bold text-v6-dark">Choose your KPIs</h3><p class="mt-3 leading-relaxed text-v6-text-muted">Choose actual revenue, forecast, target, gap, pipeline, and ROI. Confirm which date and revenue value each number should use.</p></li>
          <li class="rounded-2xl border border-v6-border bg-white p-6 sm:p-7"><span class="flex h-9 w-9 items-center justify-center rounded-full bg-v6-copper-50 text-sm font-bold text-v6-copper-800">3</span><h3 class="mt-5 text-xl font-bold text-v6-dark">Get your report</h3><p class="mt-3 leading-relaxed text-v6-text-muted">Review the result and use it in Excel, PowerPoint, or a live dashboard, with the same numbers in every version.</p></li>
        </ol>
        <p class="mt-8 font-semibold text-v6-dark">No digging through fields. No rebuilding filters. No hours copying and pasting.</p>
        <div class="mt-8"><a href="#report-signup" data-ga-cta="revenue_report_steps_signup" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-v6-copper px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-v6-copper-600 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">Build your Revenue Report</a></div>
      </div>
    </section>

    <section id="report-outputs" class="scroll-mt-8 px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-4xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">One reporting setup</p>
          <h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">One revenue report—ready in Excel, PowerPoint, or a live dashboard.</h2>
          <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">Check the calculations and deals in Excel. Take the decisions into PowerPoint. Share a live view when the audience needs the latest position. All three use the same period and definitions.</p>
        </div>
        <div class="mt-10 grid gap-6 lg:grid-cols-3">
          <article class="overflow-hidden rounded-2xl border border-v6-border bg-white"><div class="border-b border-v6-border p-6 sm:p-8"><p class="text-sm font-semibold uppercase tracking-[0.14em] text-v6-teal-700">Excel workbook</p><h3 class="mt-3 text-2xl font-bold text-v6-dark">Every number, calculation, and deal—organised</h3><p class="mt-4 leading-relaxed text-v6-text-muted">Review actual revenue, forecast movement, targets, ROI inputs, calculations, and the deals behind the result.</p></div><div class="bg-v6-bg p-5 sm:p-7"><div class="overflow-hidden rounded-xl border border-v6-border bg-white text-sm"><div class="flex gap-1 border-b border-v6-border bg-v6-bg p-2"><span class="rounded bg-white px-3 py-2 font-semibold text-v6-dark shadow-sm">Summary</span><span class="px-3 py-2 text-v6-text-muted">Forecast</span><span class="px-3 py-2 text-v6-text-muted">Deals</span></div><div class="grid grid-cols-3 gap-px bg-v6-border text-v6-text-muted"><span class="bg-white p-3 font-semibold">Team</span><span class="bg-white p-3 font-semibold">Forecast</span><span class="bg-white p-3 font-semibold">Gap</span><span class="bg-white p-3">Enterprise</span><span class="bg-white p-3">$524k</span><span class="bg-white p-3 font-semibold text-v6-teal-800">+$24k</span></div></div></div></article>
          <article class="overflow-hidden rounded-2xl border border-v6-border bg-white"><div class="border-b border-v6-border p-6 sm:p-8"><p class="text-sm font-semibold uppercase tracking-[0.14em] text-v6-blue">PowerPoint deck</p><h3 class="mt-3 text-2xl font-bold text-v6-dark">The revenue story, ready for the meeting</h3><p class="mt-4 leading-relaxed text-v6-text-muted">Edit the wording, remove a slide, or add context without rebuilding the charts or changing the underlying figures.</p></div><div class="bg-v6-bg p-5 sm:p-7"><div class="mx-auto max-w-md rounded-xl border border-v6-border bg-white p-5 shadow-sm"><p class="text-xs font-semibold uppercase tracking-wide text-v6-copper">Q3 revenue review</p><p class="mt-2 text-xl font-bold text-v6-dark">Forecast is $90k below target.</p><p class="mt-2 text-sm text-v6-text-muted">Three Mid-Market deals need a decision.</p><div class="mt-5 h-3 overflow-hidden rounded-full bg-v6-bg"><div class="h-full w-[91%] rounded-full bg-v6-copper"></div></div><p class="mt-2 text-xs text-v6-text-muted">91% of target</p></div></div></article>
          <article class="overflow-hidden rounded-2xl border border-v6-border bg-white"><div class="border-b border-v6-border p-6 sm:p-8"><p class="text-sm font-semibold uppercase tracking-[0.14em] text-v6-copper">Live dashboard</p><h3 class="mt-3 text-2xl font-bold text-v6-dark">A current revenue view you can share</h3><p class="mt-4 leading-relaxed text-v6-text-muted">Let leaders see the approved revenue position and open the team or deal detail without waiting for another file.</p></div><div class="bg-v6-bg p-5 sm:p-7"><div class="mx-auto max-w-md overflow-hidden rounded-xl border border-v6-border bg-white shadow-sm"><div class="flex items-center justify-between border-b border-v6-border px-4 py-3"><div><p class="text-xs font-semibold uppercase tracking-wide text-v6-copper">Shared revenue view</p><p class="mt-1 text-sm font-bold text-v6-dark">Current quarter</p></div><span class="rounded-full bg-v6-teal-50 px-2.5 py-1 text-xs font-semibold text-v6-teal-800">Live</span></div><div class="grid grid-cols-2 gap-px bg-v6-border"><div class="bg-white p-4"><p class="text-xs text-v6-text-muted">Forecast</p><p class="mt-1 text-xl font-bold text-v6-dark">$910k</p></div><div class="bg-white p-4"><p class="text-xs text-v6-text-muted">Gap</p><p class="mt-1 text-xl font-bold text-v6-copper-800">$90k</p></div></div><p class="px-4 py-3 text-xs text-v6-text-muted">Updated from the same reporting setup</p></div></div></article>
        </div>
      </div>
    </section>

    <section id="sample-report" class="scroll-mt-8 px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <div class="flex flex-wrap items-center gap-3"><p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">Inside the revenue report</p><span class="rounded-full border border-v6-copper-200 bg-v6-copper-50 px-2.5 py-1 text-xs font-semibold text-v6-copper-800">Example data</span></div>
          <h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">Show where revenue will land—and the deals that could change it</h2>
          <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">Start with actual revenue, the latest forecast, the target, and the gap. Then show what changed and which deals require a decision.</p>
        </div>

        <div class="mt-10 overflow-hidden rounded-2xl border border-v6-border bg-white shadow-lg shadow-v6-dark/5">
          <div class="flex flex-col gap-4 border-b border-v6-border px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-7">
            <div><p class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-text-muted">Revenue, forecast and target</p><h3 class="mt-1 text-xl font-bold text-v6-dark">Q3 executive review</h3><p class="mt-1 text-sm text-v6-text-muted">Updated 19 September 2026</p></div>
            <div class="flex flex-wrap gap-2"><span class="rounded-full bg-v6-copper-50 px-3 py-1.5 text-xs font-semibold text-v6-copper-800">$90k gap</span><span class="rounded-full bg-v6-blue-50 px-3 py-1.5 text-xs font-semibold text-v6-blue-800">Example data</span></div>
          </div>

          <div class="grid gap-px bg-v6-border sm:grid-cols-2 lg:grid-cols-4">
            <div class="bg-white p-5 sm:p-6"><p class="text-sm text-v6-text-muted">Closed revenue</p><div class="mt-2 flex items-end justify-between gap-3"><p class="text-2xl font-bold text-v6-dark">$684k</p><span class="text-sm font-semibold text-v6-teal-800">+$76k</span></div></div>
            <div class="bg-white p-5 sm:p-6"><p class="text-sm text-v6-text-muted">Latest forecast</p><div class="mt-2 flex items-end justify-between gap-3"><p class="text-2xl font-bold text-v6-dark">$910k</p><span class="text-sm font-semibold text-v6-copper-800">-$35k</span></div></div>
            <div class="bg-white p-5 sm:p-6"><p class="text-sm text-v6-text-muted">Quarter target</p><p class="mt-2 text-2xl font-bold text-v6-dark">$1.00m</p></div>
            <div class="bg-v6-copper-50 p-5 sm:p-6"><p class="text-sm text-v6-copper-800">Forecast gap</p><p class="mt-2 text-2xl font-bold text-v6-copper-800">$90k</p></div>
          </div>

          <div class="grid gap-6 border-t border-v6-border p-5 sm:p-7 lg:grid-cols-[0.9fr_1.1fr]">
            <article class="rounded-xl border border-v6-border p-5">
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-copper">Target progress</p>
              <div class="mt-5 space-y-5">
                <div><div class="flex items-center justify-between text-sm"><span class="font-semibold text-v6-dark">Closed</span><span class="text-v6-text-muted">68%</span></div><div class="mt-2 h-3 overflow-hidden rounded-full bg-v6-bg"><div class="h-full w-[68%] rounded-full bg-v6-teal"></div></div></div>
                <div><div class="flex items-center justify-between text-sm"><span class="font-semibold text-v6-dark">Latest forecast</span><span class="text-v6-text-muted">91%</span></div><div class="mt-2 h-3 overflow-hidden rounded-full bg-v6-bg"><div class="h-full w-[91%] rounded-full bg-v6-copper"></div></div></div>
              </div>
              <p class="mt-5 text-sm leading-relaxed text-v6-text-muted">The team needs another $90k in the forecast to reach the quarter target.</p>
            </article>
            <article class="rounded-xl border border-v6-copper-200 bg-v6-copper-50 p-5">
              <div class="flex items-center justify-between gap-4"><p class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-copper-800">Reviewed summary</p><span class="rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-v6-teal-800">Approved</span></div>
              <p class="mt-4 text-lg font-bold leading-relaxed text-v6-dark">Forecast fell by $35k after two Mid-Market deals moved out of the quarter.</p>
              <p class="mt-3 text-sm leading-relaxed text-v6-text-muted">Enterprise remains $24k ahead of target. Three Mid-Market deals worth $194k need a close-date or confidence review.</p>
              <p class="mt-5 rounded-lg bg-white px-3 py-2 text-sm text-v6-text-muted"><strong class="text-v6-dark">Decision:</strong> Confirm which of the three deals remain in this quarter’s forecast.</p>
            </article>
          </div>

          <div class="border-t border-v6-border p-5 sm:p-7">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between sm:gap-4"><h4 class="text-base font-bold text-v6-dark">Deals that could change the forecast</h4><span class="text-xs text-v6-text-muted">The records behind the summary</span></div>
            <div class="mt-4 hidden overflow-x-auto rounded-xl border border-v6-border md:block">
              <table class="w-full min-w-[920px] border-collapse text-left text-sm">
                <thead class="bg-v6-bg text-xs uppercase tracking-wide text-v6-text-muted"><tr><th class="px-4 py-3 font-semibold">Deal</th><th class="px-4 py-3 font-semibold">Owner and team</th><th class="px-4 py-3 font-semibold">Amount</th><th class="px-4 py-3 font-semibold">Forecast</th><th class="px-4 py-3 font-semibold">What changed</th><th class="px-4 py-3 font-semibold">Next action</th></tr></thead>
                <tbody class="divide-y divide-v6-border">
                  {dealRows.map((row) => (
                    <tr><td class="px-4 py-3 font-semibold text-v6-dark">{row.deal}</td><td class="px-4 py-3"><p class="text-v6-dark">{row.owner}</p><p class="mt-0.5 text-xs text-v6-text-muted">{row.team}</p></td><td class="px-4 py-3 font-semibold text-v6-dark">{row.amount}</td><td class="px-4 py-3 text-v6-dark">{row.forecast}</td><td class="px-4 py-3 text-v6-text-muted">{row.issue}</td><td class="px-4 py-3 text-v6-dark">{row.action}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
            <div class="mt-4 space-y-3 md:hidden">
              {dealRows.map((row) => (
                <article class="rounded-xl border border-v6-border p-4"><div class="flex items-start justify-between gap-4"><div><h5 class="font-semibold text-v6-dark">{row.deal}</h5><p class="mt-0.5 text-xs text-v6-text-muted">{row.owner} · {row.team}</p></div><span class="font-bold text-v6-dark">{row.amount}</span></div><p class="mt-3 text-sm text-v6-text-muted"><strong class="text-v6-dark">Forecast:</strong> {row.forecast}</p><p class="mt-2 text-sm text-v6-text-muted"><strong class="text-v6-dark">What changed:</strong> {row.issue}</p><p class="mt-2 text-sm text-v6-text-muted"><strong class="text-v6-dark">Next:</strong> {row.action}</p></article>
              ))}
            </div>
          </div>
          <div class="border-t border-v6-border bg-v6-bg px-5 py-3 text-xs text-v6-text-muted sm:px-7">Data current to 19 September 2026, 09:00 UTC · 126 deals included · 3 deals need review</div>
        </div>
      </div>
    </section>

    <section id="report-contents" class="scroll-mt-8 bg-v6-bg px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">Built around the revenue review</p>
          <h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">Bring the whole revenue position into one report</h2>
          <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">Start with where revenue is likely to land, then show the target, the movement, the contributing deals, and the decisions the team needs to make.</p>
        </div>
        <div class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-v6-border bg-v6-border md:grid-cols-2 lg:grid-cols-3">
          {reportAreas.map((area, index) => (
            <article class="bg-white p-6 sm:p-7"><span class="text-sm font-bold text-v6-copper">{String(index + 1).padStart(2, "0")}</span><h3 class="mt-3 text-xl font-bold text-v6-dark">{area.title}</h3><p class="mt-3 leading-relaxed text-v6-text-muted">{area.description}</p></article>
          ))}
        </div>
        <p class="mt-6 max-w-4xl text-sm leading-relaxed text-v6-text-muted">The exact measures depend on the revenue fields, targets, forecast setup, campaign data, currencies, and permissions available in your HubSpot account. Missing inputs are identified for review rather than quietly treated as zero.</p>
      </div>
    </section>

    <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8" aria-label="Revenue comparisons and history">
      <div class="mx-auto grid max-w-6xl overflow-hidden rounded-2xl border border-v6-border bg-v6-border lg:grid-cols-2">
        <article class="bg-white p-7 sm:p-9">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">Consistent comparisons</p>
          <h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark">Compare this quarter's revenue with:</h2>
          <ul class="mt-6 space-y-2 rounded-xl bg-v6-bg-warm px-5 py-4 text-lg font-semibold text-v6-dark" aria-label="Available comparison periods">
            <li><span class="mr-2 text-v6-copper-800">1.</span>Last quarter</li>
            <li><span class="mr-2 text-v6-copper-800">2.</span>The same quarter last year</li>
            <li><span class="mr-2 text-v6-copper-800">3.</span>Any period you choose</li>
          </ul>
        </article>
        <article class="border-t border-v6-border bg-white p-7 sm:p-9 lg:border-l lg:border-t-0">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">Point-in-time history</p>
          <h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark">Keep the forecast history you will need next quarter.</h2>
          <p class="mt-6 rounded-xl bg-v6-bg-warm px-5 py-4 text-lg font-semibold leading-relaxed text-v6-dark">SWOTBee saves each reporting cutoff, so you can compare the forecast with what actually closed.</p>
        </article>
      </div>
    </section>

    <section class="bg-v6-dark px-4 py-16 text-white sm:px-6 sm:py-20 lg:px-8" aria-labelledby="reporting-benefits-heading">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper-200">Built for the people who get things done</p>
          <h2 id="reporting-benefits-heading" class="mt-3 text-balance text-3xl font-bold sm:text-4xl">Spend less time building the report. Make more of the review.</h2>
        </div>
        <div class="mt-10 grid overflow-hidden rounded-2xl border border-white/10 sm:grid-cols-2">
          <article class="p-7 sm:p-8">
            <p class="text-sm font-bold uppercase tracking-[0.14em] text-v6-copper-200">01 · Time back</p>
            <h3 class="mt-4 text-balance text-2xl font-bold leading-snug">Get hours of copy-and-paste time back. Every week.</h3>
          </article>
          <article class="border-t border-white/10 p-7 sm:border-l sm:border-t-0 sm:p-8">
            <p class="text-sm font-bold uppercase tracking-[0.14em] text-v6-copper-200">02 · A reliable rhythm</p>
            <h3 class="mt-4 text-balance text-2xl font-bold leading-snug">Stop rebuilding the report. We run it for you every week.</h3>
          </article>
          <article class="border-t border-white/10 p-7 sm:p-8">
            <p class="text-sm font-bold uppercase tracking-[0.14em] text-v6-copper-200">03 · Less HubSpot admin</p>
            <h3 class="mt-4 text-balance text-2xl font-bold leading-snug">Get the report without wrestling with HubSpot fields, filters, and settings.</h3>
          </article>
          <article class="border-t border-white/10 p-7 sm:border-l sm:p-8">
            <p class="text-sm font-bold uppercase tracking-[0.14em] text-v6-copper-200">04 · Clearer decisions</p>
            <h3 class="mt-4 text-balance text-2xl font-bold leading-snug">Turn findings into clear decisions and next steps.</h3>
          </article>
        </div>
      </div>
    </section>

    <section id="questions" class="scroll-mt-8 px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-3xl">
        <div><p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">Before you sign up</p><h2 class="mt-3 text-3xl font-bold text-v6-dark sm:text-4xl">Questions about the revenue report</h2></div>
        <div class="mt-10 divide-y divide-v6-border border-y border-v6-border">
          {faqs.map((item) => (
            <details class="group py-5"><summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-5 rounded-md font-semibold text-v6-dark focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2"><span>{item.q}</span><span class="text-xl font-normal text-v6-copper transition-transform group-open:rotate-45" aria-hidden="true">+</span></summary><p class="max-w-2xl pb-1 pr-8 pt-3 leading-relaxed text-v6-text-muted">{item.a}</p></details>
          ))}
        </div>
      </div>
    </section>

    <section id="report-signup" class="scroll-mt-8 bg-gradient-to-br from-v6-copper to-v6-copper-600 px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-2xl text-center text-white">
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-white/70">Make the next revenue review the easy one</p>
        <h2 class="text-balance text-2xl font-bold sm:text-3xl">Request access to your HubSpot revenue report</h2>
        <p class="mx-auto mb-4 mt-4 max-w-2xl text-base leading-relaxed text-v6-copper-50 sm:text-lg">Register your interest in bringing actual revenue, forecast, target, and the gap into one report your team can check, edit, and present.</p>
        <ReportSignup
          offerCode="hubspot_revenue_forecast_goal_roi_reporting"
          reportName="HubSpot revenue, forecast, goal, and ROI report"
          sourcePage="hubspot-revenue-forecast-goal-roi-reporting"
          ctaLabel="revenue_report_signup"
          buttonLabel="Request revenue report access"
        />
        <p class="mt-4 text-xs text-v6-copper-50">No card required. This does not create an app account or connect to your HubSpot portal.</p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
