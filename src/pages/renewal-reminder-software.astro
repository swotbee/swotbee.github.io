---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/astro/Navbar.astro";
import Footer from "../components/astro/Footer.astro";
import ClientLogoStrip from "../components/astro/ClientLogoStrip.astro";
import RenewalRoiCalculator from "../components/astro/RenewalRoiCalculator.astro";
import {
  AdjustmentsHorizontalIcon,
  ArrowPathIcon,
  BellAlertIcon,
  ChartBarIcon,
  ClipboardDocumentListIcon,
  CommandLineIcon,
  DocumentTextIcon,
  UserMinusIcon,
  CalculatorIcon,
  Cog6ToothIcon,
  ArrowTrendingUpIcon,
} from "@heroicons/react/24/outline";

// AGITATION grid, same copy and icon set as the homepage so the two pages agree.
const pains = [
  { title: "Re-keyed line items", desc: "Rebuilding one renewal deal by hand means re-keying every line item, recalculating uplifts, and resetting dates.", icon: CommandLineIcon, color: "text-v6-copper", bg: "bg-v6-copper-50" },
  { title: "Missed escalation clauses", desc: "Escalation clauses that never make it into the renewal are pure margin left unbilled, quarter after quarter.", icon: DocumentTextIcon, color: "text-v6-amber", bg: "bg-v6-amber-50" },
  { title: "Ownerless accounts", desc: "Accounts nobody owns don't get renewed in time. That is revenue lost to churn, quietly.", icon: UserMinusIcon, color: "text-v6-teal", bg: "bg-v6-teal-50" },
  { title: "Sales Reps Stuck In Admin", desc: "Sales reps spend precious selling time on data entry, rebuilding deals, and chasing down renewal details.", icon: ClipboardDocumentListIcon, color: "text-v6-copper", bg: "bg-v6-copper-50" },
  { title: "Last-Minute Fire Drills", desc: "Renewal risks surface too late, turning preventable work into urgent escalation.", icon: BellAlertIcon, color: "text-v6-amber", bg: "bg-v6-amber-50" },
  { title: "Workflows That Quietly Break", desc: "DIY automation looks fine, until renewal loops, exceptions, or contract changes cause it to fail without warning.", icon: ArrowPathIcon, color: "text-v6-teal", bg: "bg-v6-teal-50" },
  { title: "Frantic Forecasts", desc: "Forecasts that go out of sync even as you present them, because deal data is outdated and nobody has a clear picture of upcoming renewals and contract changes.", icon: ChartBarIcon, color: "text-v6-copper", bg: "bg-v6-copper-50" },
  { title: "Rules Trapped In People's Heads", desc: "Every rep follows different rules for discounts, escalations, approvals, or notice periods, because the rules that matter never made it into the system.", icon: AdjustmentsHorizontalIcon, color: "text-v6-amber", bg: "bg-v6-amber-50" },
];

// The three ways teams solve the renewal problem, replacing the old comparison table
// with a scannable card layout.
const options = [
  {
    name: "A spreadsheet",
    icon: CalculatorIcon,
    tone: "border-v6-border",
    badge: "Free",
    badgeCls: "bg-v6-bg-warm text-v6-text-muted",
    covers: ["Track renewal dates by hand", "Monthly review meeting", "No alerts, no owners"],
    when: "Under about 40 agreements with one owner. It genuinely works and costs nothing.",
  },
  {
    name: "A contract lifecycle platform",
    icon: DocumentTextIcon,
    tone: "border-v6-border",
    badge: "$5k to $80k a year",
    badgeCls: "bg-v6-bg-warm text-v6-text-muted",
    covers: ["Contract drafting and approval", "Signature and storage", "Search inside signed agreements"],
    when: "You draft regularly, or you cannot find signed agreements. Full contract lifecycle management software earns its price here.",
  },
  {
    name: "Renewal management in HubSpot",
    icon: Cog6ToothIcon,
    tone: "border-v6-copper ring-2 ring-v6-copper/20",
    badge: "Simple, tailored to you",
    badgeCls: "bg-v6-copper text-white",
    covers: ["Renewal tracking on the notice date", "Alerts with named owners", "The renewal deal, already built"],
    when: "Your renewals live in HubSpot and still arrive late. The alert lands where the work already happens.",
  },
];
// Paid landing page for Google Ads Campaign #1 > ad group 7 (Renewal Reminders).
// Replaces the interim of pointing that ad group at `/`, which was always temporary:
// see marketing/ads/23-keyword-conversion-review.md section 4a.
//
// Why it exists: the Ad Preview tool (22-28 Aug 2026) shows our ad serving at position 2
// on "renewal reminder software" with ContractSafe at 1. Both ads land on a homepage, but
// theirs is a contract management product page and ours is a consulting homepage, so the
// ad-to-page message match is weak. Landing page experience is a component of Ad Rank.
//
// Optimised against the NeuronWriter analysis for "contract renewal management software"
// (top competitor score 84 = Oneflow; ContractSafe's homepage ranks #2 at only 47).
// Research: marketing/seo/semrush/aug31-contract-management/ADS-LANDING-PAGE-RESEARCH.md
//
// DELIVERY MODEL, keep the copy consistent with it:
// Notice-date alerting is delivered as configuration in the client's own HubSpot portal: a
// calculation property (end date minus notice period) plus a date-based workflow. That is
// deliverable by hand today, in a few hours per portal. The rule-engine version inside
// Renewal Deal Builder (notice_period_days on RenewalRule) is planned, see
// LANDING-PAGE-AND-FEATURE.md. Both routes give the client the same outcome, so the copy
// speaks in terms of what gets set up and what it does, not which of the two builds it.
// Do not add product screenshots or self-serve install language until the app rule ships.
const title = "Renewal Reminder Software for HubSpot | Contract Renewal Management";
const description = "Renewal reminder software built into HubSpot. We set up contract renewal management so alerts fire on the notice date, not the contract end date, with the task already assigned.";

const faqs = [
  { q: "What is contract renewal management software?", a: "Any system that holds your contract data as structured fields, tracks renewal dates and notice windows, and alerts an owner before a renewal decision is made by default. Some products are a full contract lifecycle management suite with a document repository. Ours is narrower: renewal tracking and renewal workflow inside the HubSpot you already use." },
  { q: "How is this different from a contract management platform like ContractSafe?", a: "They are a document platform first. They store the agreements themselves, search inside them, and alert on dates. We do not store documents at all. We configure renewal management inside HubSpot so the alert lands on the deal your team already works, and so the renewal deal is created with line items and uplift applied. If your problem is finding signed agreements, buy a contract repository. If your renewals live in HubSpot and still slip, this is the closer fit." },
  { q: "Why do contracts auto-renew without anyone noticing?", a: "Because the alert is set against the wrong date. On a contract with an automatic renewal clause, the deadline is not the contract end date, it is the notice date, which is the end date minus the notice period. Set a reminder 90 days before the end date on a 90-day notice period and it fires on the day the decision was already made for you." },
  { q: "Do I need to replace my contract management system?", a: "No. If you already run a contract management tool for documents, keep it. This adds the renewal layer inside HubSpot, where the commercial work happens. Most mid-market teams find the two do different jobs." },
  { q: "How quickly can this be live?", a: "Fast. The configuration itself is straightforward, and most of the work is simply getting accurate end dates, notice periods and owners onto your records. We shape it around your renewal rules rather than making you fit ours." },
  { q: "What HubSpot tier do I need?", a: "Sales Hub or Service Hub Professional and above, because date-based workflows are what drive the renewal alerts. On Starter we can still set up the property schema and reporting, but the automation will not be available." },
  { q: "What does the contract management process look like end to end?", a: "Five stages: contract creation and drafting, negotiation, signing a contract, then storage, then the contract renewal process. Most end-to-end contract tools concentrate on the first three. Our work sits on the last two, where the money actually leaks, and we wire the contract workflows so the whole management process runs to the same rules whoever is handling it." },
  { q: "What are the best practices for managing renewals?", a: "Store the notice period as a number, calculate the renewal date from it, put one owner on every contract, make each alert a task that escalates, and build the renewal deal before the first alert fires. Run that renewal cycle consistently and poor contract management stops costing you margin. Where a complex contract has unusual contract terms, those sit on the record rather than inside a document nobody reopens." },
  { q: "Do I still need a separate contract management solution?", a: "Only if you need the document side. A full contract automation platform gives you storage, search across contract documents and an intuitive contract management interface, and those management capabilities are worth paying for at volume. Ours is a narrower software solution: it does the renewal layer properly and leaves the rest alone." },
  { q: "What does it cost?", a: "It depends on contract volume and how much of your contract information already exists in HubSpot. The 30-minute call is free and ends with a fixed scope and a number, not a proposal you have to chase." },
];
---
<Layout title={title} description={description}>
  <Navbar />

  <!-- 1. Hero: must match the ad within one screen -->
  <section class="bg-gradient-to-b from-v6-bg to-white px-4 sm:px-6 lg:px-8 pt-14 pb-10">
    <div class="max-w-4xl mx-auto text-center">
      <span class="text-xs font-semibold uppercase tracking-[0.2em] text-v6-copper">Renewal reminder software for HubSpot</span>
      <h1 class="text-3xl sm:text-5xl font-bold text-v6-dark mt-4 mb-5 leading-tight text-balance">
        Your renewal reminders are firing on the wrong date
      </h1>
      <p class="text-lg text-v6-text-muted max-w-2xl mx-auto leading-relaxed mb-4">
        Most contract renewal management software alerts you before the contract end date. On a contract that renews automatically, that is not the deadline. The <strong class="text-v6-dark">notice date</strong> is, and it is the end date minus the notice period.
      </p>
      <p class="text-base text-v6-text-muted max-w-2xl mx-auto leading-relaxed mb-7">
        We fix that inside the HubSpot you already run. Notice dates calculated on every contract, alerts counted back from them, and the task already assigned to a named owner before anyone has to remember.
      </p>
      <a href="/contactus/" class="inline-block bg-v6-copper text-white font-semibold px-7 py-3.5 rounded-lg hover:opacity-90 transition text-lg">Book a free 30-minute call →</a>
      <p class="text-sm text-v6-text-muted mt-3">No demo script. We look at your real contract records and show you what is exposed.</p>
    </div>
  </section>

  <ClientLogoStrip caption="HubSpot Solutions Partner. Renewal operations built for teams at" />

  <!-- 2. The arithmetic -->
  <section class="px-4 sm:px-6 lg:px-8 py-14">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-4">Why contracts auto-renew without anyone noticing</h2>
      <p class="text-v6-text-muted mb-5 leading-relaxed">
        Around 69% of software contracts carry an auto-renewal clause, with notice periods of 30 to 90 days. Once the notice window closes, the contract has renewed. Nobody signs anything and nobody decides anything.
      </p>
      <p class="text-v6-text-muted mb-6 leading-relaxed">
        So the standard setup, an alert 90 days before the contract end date, does this:
      </p>
      <div class="overflow-x-auto mb-6">
        <table class="w-full text-sm bg-white border border-v6-border rounded-lg">
          <thead class="bg-v6-bg-warm">
            <tr>
              <th class="text-left px-3 py-2.5 font-semibold text-v6-dark">Notice period</th>
              <th class="text-left px-3 py-2.5 font-semibold text-v6-dark">Real deadline on a 31 Dec contract</th>
              <th class="text-left px-3 py-2.5 font-semibold text-v6-dark">Your alert fires</th>
              <th class="text-left px-3 py-2.5 font-semibold text-v6-dark">Days you actually have</th>
            </tr>
          </thead>
          <tbody class="text-v6-text-muted">
            <tr class="border-t border-v6-border"><td class="px-3 py-2">30 days</td><td class="px-3 py-2">1 December</td><td class="px-3 py-2">2 October</td><td class="px-3 py-2">60</td></tr>
            <tr class="border-t border-v6-border"><td class="px-3 py-2">60 days</td><td class="px-3 py-2">1 November</td><td class="px-3 py-2">2 October</td><td class="px-3 py-2">30</td></tr>
            <tr class="border-t border-v6-border bg-highlight-50"><td class="px-3 py-2 font-semibold text-v6-dark">90 days</td><td class="px-3 py-2">2 October</td><td class="px-3 py-2">2 October</td><td class="px-3 py-2 font-bold text-highlight">Zero</td></tr>
            <tr class="border-t border-v6-border bg-highlight-50"><td class="px-3 py-2 font-semibold text-v6-dark">120 days</td><td class="px-3 py-2">2 September</td><td class="px-3 py-2">2 October</td><td class="px-3 py-2 font-bold text-highlight">Already gone</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-v6-text-muted leading-relaxed mb-6">
        That is a missed renewal you never saw coming, or an upcoming renewal that repriced itself at last year's number. Poor renewal management rarely looks like a mistake. It looks like an invoice that matches last year.
      </p>
      <div class="rounded-xl bg-v6-dark text-white p-6">
        <p class="font-semibold mb-2">Check one of your own contracts</p>
        <p class="text-white/80 text-sm mb-4">Enter a contract end date and notice period. Free, no sign-up, nothing is sent anywhere.</p>
        <a href="/notice-date-calculator/" class="inline-block bg-v6-copper text-white font-semibold px-5 py-2.5 rounded-lg hover:opacity-90 transition">Open the notice date calculator →</a>
      </div>
    </div>
  </section>


  <!-- 2b. AGITATION: the exceptions that break renewals at volume (from the homepage) -->
  <section class="px-4 sm:px-6 lg:px-8 py-16 bg-v6-bg">
    <div class="max-w-5xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-v6-dark mb-4 text-balance">
          One renewal is easy. Thousands of renewals expose every exception in your business.
        </h2>
        <p class="text-lg text-v6-text-muted leading-relaxed">
          Multi-year contracts. Product bundles. Pricing escalations. Notice periods. Every company has its own renewal rules.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {pains.map((x) => (
          <div class="bg-white border border-v6-border rounded-xl p-5">
            <div class={"w-10 h-10 rounded-lg flex items-center justify-center mb-3 " + x.bg}>
              <x.icon class={"w-5 h-5 " + x.color} aria-hidden="true" />
            </div>
            <h3 class="font-bold text-v6-dark mb-2 text-sm">{x.title}</h3>
            <p class="text-sm text-v6-text-muted leading-relaxed">{x.desc}</p>
          </div>
        ))}
      </div>

      <div class="mt-10 max-w-2xl mx-auto bg-v6-dark rounded-2xl p-8 text-center">
        <p class="text-xs font-semibold uppercase tracking-wider text-v6-copper mb-3">Key Insight</p>
        <p class="text-xl sm:text-2xl font-bold text-white mb-3 leading-snug text-balance">
          The challenge isn't creating a renewal. It's making thousands of revenue decisions consistently.
        </p>
        <p class="text-white/70">Every product. Every contract. Every customer. Every time.</p>
      </div>
    </div>
  </section>

  <!-- 2c. THE MATH: what manual renewals cost (from the homepage) -->
  <section class="px-4 sm:px-6 lg:px-8 py-16">
    <div class="max-w-4xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-v6-copper mb-3 text-center">The Math</p>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-v6-dark mb-8 text-center text-balance">What Manual Renewals Actually Cost</h2>

      <blockquote class="relative max-w-3xl mx-auto rounded-2xl border border-v6-border border-l-4 border-l-v6-copper bg-v6-bg p-6 sm:p-8 mb-7 sm:flex items-center gap-7 text-center sm:text-left shadow-sm">
        <span class="absolute -top-5 left-6 text-6xl leading-none text-v6-copper/30" aria-hidden="true">&ldquo;</span>
        <p class="text-4xl sm:text-5xl font-bold text-v6-copper flex-shrink-0 mb-3 sm:mb-0 whitespace-nowrap">~ 14%</p>
        <div>
          <p class="text-v6-dark leading-relaxed mb-2">
            Companies that automate their renewals capture roughly <strong>14% more of their renewal revenue</strong> than those using spreadsheets.
          </p>
          <p class="text-sm text-v6-text-muted leading-relaxed">
            When maintenance, hardware, and service agreements are managed manually, missed dates and quote errors directly drain your recurring revenue.
          </p>
          <p class="text-xs text-v6-text-muted mt-2">Source: TSIA Industry Benchmark</p>
        </div>
      </blockquote>

      <p class="text-center text-v6-text-muted max-w-2xl mx-auto leading-relaxed">
        Multiply by every renewal, every year, and it adds up to months of ops time and real lost revenue: revenue that is already yours, quietly slipping.
      </p>
    </div>
  </section>

  <!-- 2d. The live leakage estimate. The component renders its own eyebrow and H2. -->
  <RenewalRoiCalculator />

  <!-- 3. What we set up -->
  <section class="px-4 sm:px-6 lg:px-8 py-14 bg-v6-bg">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-3">What we set up in your HubSpot</h2>
      <p class="text-v6-text-muted mb-8 max-w-2xl">Done for you, in your own portal. You own everything we build and there is no platform to log into.</p>
      <div class="grid sm:grid-cols-2 gap-5">
        <div class="bg-white border border-v6-border rounded-xl p-6">
          <h3 class="font-bold text-v6-dark mb-2">Structured contract records</h3>
          <p class="text-sm text-v6-text-muted leading-relaxed">Contract start and end dates, notice period as a number, value, contract type and owner, all as real properties. Structured records, so renewal reminders have something reliable to fire against. Contract details stop living inside PDFs and start being reportable.</p>
        </div>
        <div class="bg-white border border-v6-border rounded-xl p-6">
          <h3 class="font-bold text-v6-dark mb-2">Notice date on every contract</h3>
          <p class="text-sm text-v6-text-muted leading-relaxed">Calculated from the end date and the notice period, and kept current as either changes. Every workflow, task and report then counts back from the date that actually decides the renewal. This is the single change that fixes the timing.</p>
        </div>
        <div class="bg-white border border-v6-border rounded-xl p-6">
          <h3 class="font-bold text-v6-dark mb-2">Renewal alerts with owners</h3>
          <p class="text-sm text-v6-text-muted leading-relaxed">Alerts that create a task, not just a notification, assigned to a named person and escalating to their manager if nothing moves. They stop the moment the renewal closes, so nobody chases a customer who already signed.</p>
        </div>
        <div class="bg-white border border-v6-border rounded-xl p-6">
          <h3 class="font-bold text-v6-dark mb-2">The renewal deal, already built</h3>
          <p class="text-sm text-v6-text-muted leading-relaxed">Most tools remind you and stop. We automate renewals one step further: the renewal deal exists before the first alert fires, with line items carried over and uplift applied, so it is in the forecast rather than on somebody's list.</p>
        </div>
        <div class="bg-white border border-v6-border rounded-xl p-6">
          <h3 class="font-bold text-v6-dark mb-2">Renewal reporting</h3>
          <p class="text-sm text-v6-text-muted leading-relaxed">Contract portfolio by renewal window, contract value by quarter, and which upcoming renewal has no owner. Sorted by notice date, so the report shows what is still winnable.</p>
        </div>
        <div class="bg-white border border-v6-border rounded-xl p-6">
          <h3 class="font-bold text-v6-dark mb-2">Your existing tools, untouched</h3>
          <p class="text-sm text-v6-text-muted leading-relaxed">If you already run a document platform for contracts, keep it. This is the renewal layer, not a replacement for document storage.</p>
        </div>
      </div>
    </div>
  </section>



  <!-- 4b. Comparison and best practices: closes the "which tool" question -->
  <section class="px-4 sm:px-6 lg:px-8 py-14">
    <div class="max-w-4xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-v6-copper mb-3">Choosing</p>
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-3">Which contract management software is right for the renewal problem</h2>
      <p class="text-v6-text-muted mb-8 max-w-2xl leading-relaxed">
        The best contract management software for you depends on where the contract process actually breaks. Three honest options, and the right contract management choice is usually the narrowest one that solves it.
      </p>
      <p class="text-v6-text-muted mb-8 max-w-2xl leading-relaxed text-sm">
        We build the third. We are not a centralized contract repository and not an AI contract intelligence platform: no document storage, no contract drafting, no clause library, no contract execution or e-signature. If finding signed agreements is the problem, one of the first two will serve you better and we will say so on the call.
      </p>

      <div class="grid md:grid-cols-3 gap-5 mb-10">
        {options.map((o) => (
          <div class={"relative bg-white rounded-2xl border p-6 flex flex-col " + o.tone}>
            <span class={"absolute -top-3 left-6 text-xs font-semibold px-3 py-1 rounded-full " + o.badgeCls}>{o.badge}</span>
            <o.icon class="w-8 h-8 text-v6-copper mb-4 mt-2" aria-hidden="true" />
            <h3 class="text-lg font-bold text-v6-dark mb-3">{o.name}</h3>
            <ul class="space-y-2 mb-5">
              {o.covers.map((c) => (
                <li class="flex gap-2 text-sm text-v6-text-muted">
                  <span class="text-v6-teal mt-0.5 flex-shrink-0" aria-hidden="true">&#10003;</span>
                  <span>{c}</span>
                </li>
              ))}
            </ul>
            <p class="text-sm text-v6-text-muted leading-relaxed mt-auto pt-4 border-t border-v6-border">
              <strong class="text-v6-dark">Choose it when:</strong> {o.when}
            </p>
          </div>
        ))}
      </div>

      <h3 class="text-xl font-bold text-v6-dark mb-2">Five things we set up, every time</h3>
      <p class="text-v6-text-muted mb-6">Configuration, not advice. Each one removes a way renewals slip.</p>

      <div class="grid sm:grid-cols-2 gap-4 mb-8">
        <div class="flex gap-3 bg-white border border-v6-border rounded-xl p-4">
          <span class="flex-shrink-0 w-7 h-7 rounded-full bg-v6-copper text-white text-sm font-bold flex items-center justify-center">1</span>
          <div>
            <p class="font-semibold text-v6-dark text-sm mb-1">Notice period as a real field</p>
            <p class="text-sm text-v6-text-muted">A number, not a note. So the renewal deadline is calculated, never guessed.</p>
          </div>
        </div>
        <div class="flex gap-3 bg-white border border-v6-border rounded-xl p-4">
          <span class="flex-shrink-0 w-7 h-7 rounded-full bg-v6-copper text-white text-sm font-bold flex items-center justify-center">2</span>
          <div>
            <p class="font-semibold text-v6-dark text-sm mb-1">Alerts on the notice date</p>
            <p class="text-sm text-v6-text-muted">Not the end date. This is the whole fix.</p>
          </div>
        </div>
        <div class="flex gap-3 bg-white border border-v6-border rounded-xl p-4">
          <span class="flex-shrink-0 w-7 h-7 rounded-full bg-v6-copper text-white text-sm font-bold flex items-center justify-center">3</span>
          <div>
            <p class="font-semibold text-v6-dark text-sm mb-1">One named owner per contract</p>
            <p class="text-sm text-v6-text-muted">Ambiguous ownership loses more renewals than any missing feature.</p>
          </div>
        </div>
        <div class="flex gap-3 bg-white border border-v6-border rounded-xl p-4">
          <span class="flex-shrink-0 w-7 h-7 rounded-full bg-v6-copper text-white text-sm font-bold flex items-center justify-center">4</span>
          <div>
            <p class="font-semibold text-v6-dark text-sm mb-1">Tasks, not notifications</p>
            <p class="text-sm text-v6-text-muted">Pings get dismissed. A task sits in a queue until someone acts, and escalates if nobody does.</p>
          </div>
        </div>
        <div class="flex gap-3 bg-white border border-v6-border rounded-xl p-4 sm:col-span-2">
          <span class="flex-shrink-0 w-7 h-7 rounded-full bg-v6-copper text-white text-sm font-bold flex items-center justify-center">5</span>
          <div>
            <p class="font-semibold text-v6-dark text-sm mb-1">The renewal deal, built before the first alert</p>
            <p class="text-sm text-v6-text-muted">Most contract automation stops at the reminder and leaves the rebuild to your team. Ours does not.</p>
          </div>
        </div>
      </div>

      <div class="rounded-xl bg-v6-bg-warm border border-v6-border p-5">
        <p class="text-v6-dark font-semibold mb-1">The result</p>
        <p class="text-v6-text-muted text-sm leading-relaxed">
