---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/astro/Navbar.astro';
---

<BaseLayout robots="noindex, follow" title="Logo — Palette 9: Dashboard Teal">
  <Navbar />
  <div style="background: #f5f3ef; min-height: 100vh; padding: 3rem 1rem;">
    <div style="max-width: 1000px; margin: 0 auto;">
      <h1 style="font-size: 1.5rem; font-weight: 700; color: #1c1917; margin-bottom: 0.5rem; text-align: center;">Palette 9: Dashboard Teal</h1>
      <p style="text-align: center; color: #78716c; margin-bottom: 0.5rem; font-size: 0.85rem;">Colors extracted from the dashboard screenshot</p>

      <!-- Color swatches with labels -->
      <div style="display: flex; justify-content: center; gap: 0.75rem; margin-bottom: 1rem; flex-wrap: wrap;">
        <div style="text-align: center;">
          <div style="width: 48px; height: 48px; border-radius: 8px; background: #0d9488;"></div>
          <span style="font-size: 0.6rem; color: #78716c;">Primary<br/>#0D9488</span>
        </div>
        <div style="text-align: center;">
          <div style="width: 48px; height: 48px; border-radius: 8px; background: #f59e0b;"></div>
          <span style="font-size: 0.6rem; color: #78716c;">Accent<br/>#F59E0B</span>
        </div>
        <div style="text-align: center;">
          <div style="width: 48px; height: 48px; border-radius: 8px; background: #134e4a;"></div>
          <span style="font-size: 0.6rem; color: #78716c;">Deep<br/>#134E4A</span>
        </div>
        <div style="text-align: center;">
          <div style="width: 48px; height: 48px; border-radius: 8px; background: #ef4444;"></div>
          <span style="font-size: 0.6rem; color: #78716c;">Alert<br/>#EF4444</span>
        </div>
        <div style="text-align: center;">
          <div style="width: 48px; height: 48px; border-radius: 8px; background: #22c55e;"></div>
          <span style="font-size: 0.6rem; color: #78716c;">Success<br/>#22C55E</span>
        </div>
        <div style="text-align: center;">
          <div style="width: 48px; height: 48px; border-radius: 8px; background: #f5f3ef; border: 1px solid #d6d3d1;"></div>
          <span style="font-size: 0.6rem; color: #78716c;">Bg<br/>#F5F3EF</span>
        </div>
        <div style="text-align: center;">
          <div style="width: 48px; height: 48px; border-radius: 8px; background: #1c1917;"></div>
          <span style="font-size: 0.6rem; color: #78716c;">Text<br/>#1C1917</span>
        </div>
        <div style="text-align: center;">
          <div style="width: 48px; height: 48px; border-radius: 8px; background: #78716c;"></div>
          <span style="font-size: 0.6rem; color: #78716c;">Muted<br/>#78716C</span>
        </div>
      </div>

      <!-- Full palette with roles -->
      <div style="background: white; border-radius: 12px; padding: 1.5rem; margin-bottom: 2.5rem; border: 1px solid #e7e5e4;">
        <table style="width: 100%; font-size: 0.85rem; color: #1c1917; border-collapse: collapse;">
          <tr style="border-bottom: 1px solid #e7e5e4;">
            <td style="padding: 0.5rem; font-weight: 600;">Role</td>
            <td style="padding: 0.5rem; font-weight: 600;">Color</td>
            <td style="padding: 0.5rem; font-weight: 600;">Hex</td>
            <td style="padding: 0.5rem; font-weight: 600;">Usage</td>
          </tr>
          <tr style="border-bottom: 1px solid #f5f5f4;">
            <td style="padding: 0.5rem;">Primary</td>
            <td style="padding: 0.5rem;"><span style="display:inline-block;width:16px;height:16px;border-radius:4px;background:#0d9488;vertical-align:middle;margin-right:4px;"></span> Teal</td>
            <td style="padding: 0.5rem; font-family: monospace;">#0D9488</td>
            <td style="padding: 0.5rem; color: #78716c;">Brand, nav, links, pipeline stages</td>
          </tr>
          <tr style="border-bottom: 1px solid #f5f5f4;">
            <td style="padding: 0.5rem;">Secondary</td>
            <td style="padding: 0.5rem;"><span style="display:inline-block;width:16px;height:16px;border-radius:4px;background:#f59e0b;vertical-align:middle;margin-right:4px;"></span> Amber</td>
            <td style="padding: 0.5rem; font-family: monospace;">#F59E0B</td>
            <td style="padding: 0.5rem; color: #78716c;">CTAs, revenue numbers, highlights, warnings</td>
          </tr>
          <tr style="border-bottom: 1px solid #f5f5f4;">
            <td style="padding: 0.5rem;">Dark</td>
            <td style="padding: 0.5rem;"><span style="display:inline-block;width:16px;height:16px;border-radius:4px;background:#134e4a;vertical-align:middle;margin-right:4px;"></span> Deep Teal</td>
            <td style="padding: 0.5rem; font-family: monospace;">#134E4A</td>
            <td style="padding: 0.5rem; color: #78716c;">Dark bg sections, footer, hero overlay</td>
          </tr>
          <tr style="border-bottom: 1px solid #f5f5f4;">
            <td style="padding: 0.5rem;">Alert</td>
            <td style="padding: 0.5rem;"><span style="display:inline-block;width:16px;height:16px;border-radius:4px;background:#ef4444;vertical-align:middle;margin-right:4px;"></span> Red</td>
            <td style="padding: 0.5rem; font-family: monospace;">#EF4444</td>
            <td style="padding: 0.5rem; color: #78716c;">Errors, revenue leak, missed renewals</td>
          </tr>
          <tr style="border-bottom: 1px solid #f5f5f4;">
            <td style="padding: 0.5rem;">Success</td>
            <td style="padding: 0.5rem;"><span style="display:inline-block;width:16px;height:16px;border-radius:4px;background:#22c55e;vertical-align:middle;margin-right:4px;"></span> Green</td>
            <td style="padding: 0.5rem; font-family: monospace;">#22C55E</td>
            <td style="padding: 0.5rem; color: #78716c;">Success states, deployed, deal won</td>
          </tr>
          <tr style="border-bottom: 1px solid #f5f5f4;">
            <td style="padding: 0.5rem;">Background</td>
            <td style="padding: 0.5rem;"><span style="display:inline-block;width:16px;height:16px;border-radius:4px;background:#f5f3ef;border:1px solid #d6d3d1;vertical-align:middle;margin-right:4px;"></span> Warm White</td>
            <td style="padding: 0.5rem; font-family: monospace;">#F5F3EF</td>
            <td style="padding: 0.5rem; color: #78716c;">Page background, light sections</td>
          </tr>
          <tr>
            <td style="padding: 0.5rem;">Text</td>
            <td style="padding: 0.5rem;"><span style="display:inline-block;width:16px;height:16px;border-radius:4px;background:#1c1917;vertical-align:middle;margin-right:4px;"></span> Near Black</td>
            <td style="padding: 0.5rem; font-family: monospace;">#1C1917</td>
            <td style="padding: 0.5rem; color: #78716c;">Headings, primary text</td>
          </tr>
        </table>
      </div>


      <h2 style="font-size: 1.2rem; font-weight: 600; color: #1c1917; margin-bottom: 1.5rem; text-align: center;">Quadrant Logos</h2>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 3rem;">
        <!-- Dark bg -->
        <div style="background: #134e4a; border-radius: 14px; padding: 2.5rem; display: flex; align-items: center; justify-content: center; gap: 1rem;">
          <svg viewBox="0 0 120 120" width="80" height="80" xmlns="http://www.w3.org/2000/svg">
            <path d="M58,2 L58,58 L2,58 L2,20 Z" fill="#0d9488" />
            <path d="M62,2 L118,20 L118,58 L62,58 Z" fill="#f59e0b" />
            <path d="M2,62 L58,62 L58,118 L2,100 Z" fill="#ef4444" />
            <path d="M62,62 L118,62 L118,100 L62,118 Z" fill="#22c55e" />
          </svg>
          <div>
            <div style="color: #ffffff; font-size: 1.3rem; font-weight: 700; font-family: sans-serif;">SWOT<span style="color: #0d9488;">bee</span></div>
          </div>
        </div>

        <!-- Light bg -->
        <div style="background: #ffffff; border: 1px solid #e7e5e4; border-radius: 14px; padding: 2.5rem; display: flex; align-items: center; justify-content: center; gap: 1rem;">
          <svg viewBox="0 0 120 120" width="80" height="80" xmlns="http://www.w3.org/2000/svg">
            <path d="M58,2 L58,58 L2,58 L2,20 Z" fill="#0d9488" />
            <path d="M62,2 L118,20 L118,58 L62,58 Z" fill="#f59e0b" />
            <path d="M2,62 L58,62 L58,118 L2,100 Z" fill="#ef4444" />
            <path d="M62,62 L118,62 L118,100 L62,118 Z" fill="#22c55e" />
          </svg>
          <div>
            <div style="color: #1c1917; font-size: 1.3rem; font-weight: 700; font-family: sans-serif;">SWOT<span style="color: #0d9488;">bee</span></div>
          </div>
        </div>
      </div>


      <h2 style="font-size: 1.2rem; font-weight: 600; color: #1c1917; margin-bottom: 1.5rem; text-align: center;">Honeycomb Logos</h2>

      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-bottom: 3rem;">

        <!-- H1: Split hexagon -->
        <div style="text-align: center;">
          <p style="font-size: 0.85rem; color: #78716c; margin-bottom: 0.75rem; font-weight: 600;">H1: Split Hexagon</p>
          <div style="background: #134e4a; border-radius: 14px; padding: 2rem; margin-bottom: 0.75rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 120 120" width="120" height="120" xmlns="http://www.w3.org/2000/svg">
              <path d="M60,10 L103,35 L60,60 L17,35 Z" fill="#0d9488" />
              <path d="M103,35 L103,85 L60,60 Z" fill="#f59e0b" />
              <path d="M103,85 L60,110 L17,85 L60,60 Z" fill="#134e4a" stroke="#0d9488" stroke-width="0.5" />
              <path d="M17,85 L17,35 L60,60 Z" fill="#ef4444" />
              <polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke="#0d9488" stroke-width="1.5" opacity="0.5" />
            </svg>
          </div>
          <div style="background: #ffffff; border: 1px solid #e7e5e4; border-radius: 14px; padding: 2rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 120 120" width="120" height="120" xmlns="http://www.w3.org/2000/svg">
              <path d="M60,10 L103,35 L60,60 L17,35 Z" fill="#0d9488" />
              <path d="M103,35 L103,85 L60,60 Z" fill="#f59e0b" />
              <path d="M103,85 L60,110 L17,85 L60,60 Z" fill="#1c1917" />
              <path d="M17,85 L17,35 L60,60 Z" fill="#ef4444" />
              <polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke="#d6d3d1" stroke-width="1" />
            </svg>
          </div>
        </div>

        <!-- H2: Honeycomb cluster -->
        <div style="text-align: center;">
          <p style="font-size: 0.85rem; color: #78716c; margin-bottom: 0.75rem; font-weight: 600;">H2: Honeycomb Cluster</p>
          <div style="background: #134e4a; border-radius: 14px; padding: 2rem; margin-bottom: 0.75rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 120 110" width="120" height="110" xmlns="http://www.w3.org/2000/svg">
              <!-- Top row: 2 hexagons -->
              <polygon points="38,8 54,18 54,36 38,46 22,36 22,18" fill="#0d9488" />
              <polygon points="72,8 88,18 88,36 72,46 56,36 56,18" fill="#f59e0b" />
              <!-- Middle row: 3 hexagons -->
              <polygon points="21,40 37,50 37,68 21,78 5,68 5,50" fill="#ef4444" />
              <polygon points="55,40 71,50 71,68 55,78 39,68 39,50" fill="#22c55e" />
              <polygon points="89,40 105,50 105,68 89,78 73,68 73,50" fill="#134e4a" stroke="#0d9488" stroke-width="1" />
              <!-- Bottom row: 2 hexagons -->
              <polygon points="38,72 54,82 54,100 38,110 22,100 22,82" fill="#f5f3ef" />
              <polygon points="72,72 88,82 88,100 72,110 56,100 56,82" fill="#78716c" />
            </svg>
          </div>
          <div style="background: #ffffff; border: 1px solid #e7e5e4; border-radius: 14px; padding: 2rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 120 110" width="120" height="110" xmlns="http://www.w3.org/2000/svg">
              <polygon points="38,8 54,18 54,36 38,46 22,36 22,18" fill="#0d9488" />
              <polygon points="72,8 88,18 88,36 72,46 56,36 56,18" fill="#f59e0b" />
              <polygon points="21,40 37,50 37,68 21,78 5,68 5,50" fill="#ef4444" />
              <polygon points="55,40 71,50 71,68 55,78 39,68 39,50" fill="#22c55e" />
              <polygon points="89,40 105,50 105,68 89,78 73,68 73,50" fill="#1c1917" />
              <polygon points="38,72 54,82 54,100 38,110 22,100 22,82" fill="#f5f3ef" stroke="#d6d3d1" stroke-width="0.5" />
              <polygon points="72,72 88,82 88,100 72,110 56,100 56,82" fill="#78716c" />
            </svg>
          </div>
        </div>

        <!-- H3: 6 Slices with dashboard colors -->
        <div style="text-align: center;">
          <p style="font-size: 0.85rem; color: #78716c; margin-bottom: 0.75rem; font-weight: 600;">H3: 6 Slices</p>
          <div style="background: #134e4a; border-radius: 14px; padding: 2rem; margin-bottom: 0.75rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 120 120" width="120" height="120" xmlns="http://www.w3.org/2000/svg">
              <path d="M60,60 L60,10 L103,35 Z" fill="#0d9488" />
              <path d="M60,60 L103,35 L103,85 Z" fill="#f59e0b" />
              <path d="M60,60 L103,85 L60,110 Z" fill="#22c55e" />
              <path d="M60,60 L60,110 L17,85 Z" fill="#134e4a" stroke="#0d9488" stroke-width="0.5" />
              <path d="M60,60 L17,85 L17,35 Z" fill="#ef4444" />
              <path d="M60,60 L17,35 L60,10 Z" fill="#f5f3ef" />
              <polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke="#0d9488" stroke-width="1.5" opacity="0.4" />
            </svg>
          </div>
          <div style="background: #ffffff; border: 1px solid #e7e5e4; border-radius: 14px; padding: 2rem; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 120 120" width="120" height="120" xmlns="http://www.w3.org/2000/svg">
              <path d="M60,60 L60,10 L103,35 Z" fill="#0d9488" />
              <path d="M60,60 L103,35 L103,85 Z" fill="#f59e0b" />
              <path d="M60,60 L103,85 L60,110 Z" fill="#22c55e" />
              <path d="M60,60 L60,110 L17,85 Z" fill="#1c1917" />
              <path d="M60,60 L17,85 L17,35 Z" fill="#ef4444" />
              <path d="M60,60 L17,35 L60,10 Z" fill="#f5f3ef" stroke="#d6d3d1" stroke-width="0.5" />
              <polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke="#d6d3d1" stroke-width="1" />
            </svg>
          </div>
        </div>
      </div>


      <!-- Size test -->
      <h2 style="font-size: 1.1rem; font-weight: 600; color: #1c1917; margin-bottom: 1rem; text-align: center;">Size Test</h2>

      <div style="background: #134e4a; border-radius: 12px; padding: 2rem; display: flex; align-items: end; justify-content: center; gap: 2.5rem; flex-wrap: wrap; margin-bottom: 2rem;">
        {[16, 32, 48, 80, 120].map(size => (
          <div style="text-align: center;">
            <div style="display: flex; gap: 1rem; align-items: end;">
              {/* Quadrant */}
              <svg viewBox="0 0 120 120" width={size} height={size} xmlns="http://www.w3.org/2000/svg">
                <path d="M58,2 L58,58 L2,58 L2,20 Z" fill="#0d9488" />
                <path d="M62,2 L118,20 L118,58 L62,58 Z" fill="#f59e0b" />
                <path d="M2,62 L58,62 L58,118 L2,100 Z" fill="#ef4444" />
                <path d="M62,62 L118,62 L118,100 L62,118 Z" fill="#22c55e" />
              </svg>
              {/* H1 hex */}
              <svg viewBox="0 0 120 120" width={size} height={size} xmlns="http://www.w3.org/2000/svg">
                <path d="M60,10 L103,35 L60,60 L17,35 Z" fill="#0d9488" />
                <path d="M103,35 L103,85 L60,60 Z" fill="#f59e0b" />
                <path d="M103,85 L60,110 L17,85 L60,60 Z" fill="#134e4a" stroke="#0d9488" stroke-width="0.5" />
                <path d="M17,85 L17,35 L60,60 Z" fill="#ef4444" />
                <polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke="#0d9488" stroke-width="1.5" opacity="0.5" />
              </svg>
              {/* H2 cluster */}
              <svg viewBox="0 0 120 110" width={size * 1.09} height={size} xmlns="http://www.w3.org/2000/svg">
                <polygon points="38,8 54,18 54,36 38,46 22,36 22,18" fill="#0d9488" />
                <polygon points="72,8 88,18 88,36 72,46 56,36 56,18" fill="#f59e0b" />
                <polygon points="21,40 37,50 37,68 21,78 5,68 5,50" fill="#ef4444" />
                <polygon points="55,40 71,50 71,68 55,78 39,68 39,50" fill="#22c55e" />
                <polygon points="89,40 105,50 105,68 89,78 73,68 73,50" fill="#134e4a" stroke="#0d9488" stroke-width="1" />
                <polygon points="38,72 54,82 54,100 38,110 22,100 22,82" fill="#f5f3ef" />
                <polygon points="72,72 88,82 88,100 72,110 56,100 56,82" fill="#78716c" />
              </svg>
            </div>
            <p style="color: #0d9488; font-size: 0.6rem; margin-top: 0.5rem;">{size}px</p>
          </div>
        ))}
      </div>


      <!-- Lockups -->
      <h2 style="font-size: 1.1rem; font-weight: 600; color: #1c1917; margin-bottom: 1rem; text-align: center;">Logo + Text Lockup</h2>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div style="background: #134e4a; border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; gap: 1rem;">
          <svg viewBox="0 0 120 120" width="48" height="48" xmlns="http://www.w3.org/2000/svg">
            <path d="M60,10 L103,35 L60,60 L17,35 Z" fill="#0d9488" />
            <path d="M103,35 L103,85 L60,60 Z" fill="#f59e0b" />
            <path d="M103,85 L60,110 L17,85 L60,60 Z" fill="#134e4a" stroke="#0d9488" stroke-width="0.5" />
            <path d="M17,85 L17,35 L60,60 Z" fill="#ef4444" />
            <polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke="#0d9488" stroke-width="1.5" opacity="0.5" />
          </svg>
          <div>
            <div style="color: #ffffff; font-size: 1.1rem; font-weight: 700; font-family: sans-serif;">SWOT<span style="color: #0d9488;">bee</span></div>
            <div style="color: #0d9488; font-size: 0.65rem; font-family: sans-serif; opacity: 0.7;">Hexagon · Dark</div>
          </div>
        </div>

        <div style="background: #ffffff; border: 1px solid #e7e5e4; border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; gap: 1rem;">
          <svg viewBox="0 0 120 120" width="48" height="48" xmlns="http://www.w3.org/2000/svg">
            <path d="M60,10 L103,35 L60,60 L17,35 Z" fill="#0d9488" />
            <path d="M103,35 L103,85 L60,60 Z" fill="#f59e0b" />
            <path d="M103,85 L60,110 L17,85 L60,60 Z" fill="#1c1917" />
            <path d="M17,85 L17,35 L60,60 Z" fill="#ef4444" />
            <polygon points="60,10 103,35 103,85 60,110 17,85 17,35" fill="none" stroke="#d6d3d1" stroke-width="1" />
          </svg>
          <div>
            <div style="color: #1c1917; font-size: 1.1rem; font-weight: 700; font-family: sans-serif;">SWOT<span style="color: #0d9488;">bee</span></div>
            <div style="color: #78716c; font-size: 0.65rem; font-family: sans-serif;">Hexagon · Light</div>
          </div>
        </div>

        <div style="background: #134e4a; border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; gap: 1rem;">
          <svg viewBox="0 0 120 120" width="48" height="48" xmlns="http://www.w3.org/2000/svg">
            <path d="M58,2 L58,58 L2,58 L2,20 Z" fill="#0d9488" />
            <path d="M62,2 L118,20 L118,58 L62,58 Z" fill="#f59e0b" />
            <path d="M2,62 L58,62 L58,118 L2,100 Z" fill="#ef4444" />
            <path d="M62,62 L118,62 L118,100 L62,118 Z" fill="#22c55e" />
          </svg>
          <div>
            <div style="color: #ffffff; font-size: 1.1rem; font-weight: 700; font-family: sans-serif;">SWOT<span style="color: #0d9488;">bee</span></div>
            <div style="color: #0d9488; font-size: 0.65rem; font-family: sans-serif; opacity: 0.7;">Quadrant · Dark</div>
          </div>
        </div>

        <div style="background: #ffffff; border: 1px solid #e7e5e4; border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; gap: 1rem;">
          <svg viewBox="0 0 120 120" width="48" height="48" xmlns="http://www.w3.org/2000/svg">
            <path d="M58,2 L58,58 L2,58 L2,20 Z" fill="#0d9488" />
            <path d="M62,2 L118,20 L118,58 L62,58 Z" fill="#f59e0b" />
            <path d="M2,62 L58,62 L58,118 L2,100 Z" fill="#ef4444" />
            <path d="M62,62 L118,62 L118,100 L62,118 Z" fill="#22c55e" />
          </svg>
          <div>
            <div style="color: #1c1917; font-size: 1.1rem; font-weight: 700; font-family: sans-serif;">SWOT<span style="color: #0d9488;">bee</span></div>
            <div style="color: #78716c; font-size: 0.65rem; font-family: sans-serif;">Quadrant · Light</div>
          </div>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>
