---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/astro/Navbar.astro';
---

<BaseLayout robots="noindex, follow" title="Design Index — All Previews">
  <Navbar />
  <div style="background: #f8fafb; min-height: 100vh; padding: 3rem 1rem;">
    <div style="max-width: 700px; margin: 0 auto;">

      <h1 style="font-size: 2rem; font-weight: 700; color: #1b2a37; margin-bottom: 0.5rem; text-align: center;">Design Index</h1>
      <p style="text-align: center; color: #5b87ae; margin-bottom: 3rem; font-size: 0.9rem;">All preview pages in one place</p>

      <!-- Brand Assets -->
      <h2 style="font-size: 1.1rem; font-weight: 600; color: #1b2a37; margin-bottom: 1rem; border-bottom: 2px solid #e5e7eb; padding-bottom: 0.5rem;">Brand Assets</h2>
      <ul style="list-style: none; padding: 0; margin-bottom: 2.5rem;">
        <li style="margin-bottom: 0.75rem;">
          <a href="/brand/linkedin-banner/" style="color: #0d9488; font-weight: 600; text-decoration: none; font-size: 1rem;">LinkedIn Banner (1584x396)</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Add ?export to strip chrome, ?guides for safe areas. Export at 2x or it uploads soft.</span>
        </li>
      </ul>

      <!-- Hero Animations -->
      <h2 style="font-size: 1.1rem; font-weight: 600; color: #1b2a37; margin-bottom: 1rem; border-bottom: 2px solid #e5e7eb; padding-bottom: 0.5rem;">Hero Animations</h2>
      <ul style="list-style: none; padding: 0; margin-bottom: 2.5rem;">
        <li style="margin-bottom: 0.75rem;">
          <a href="/hero-preview" style="color: #0d9488; font-weight: 600; text-decoration: none; font-size: 1rem;">Hero Pipeline Animation</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Before/after renewal pipeline — deals flow, confetti, ARR counter</span>
        </li>
      </ul>

      <!-- Logo: Stacked Deals -->
      <h2 style="font-size: 1.1rem; font-weight: 600; color: #1b2a37; margin-bottom: 1rem; border-bottom: 2px solid #e5e7eb; padding-bottom: 0.5rem;">Logo: Stacked Deals</h2>
      <ul style="list-style: none; padding: 0; margin-bottom: 2.5rem;">
        <li style="margin-bottom: 0.75rem;">
          <a href="/logo-preview" style="color: #0d9488; font-weight: 600; text-decoration: none; font-size: 1rem;">Stacked Deal Cards (V1-V4)</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Dollar amount, header bar, stage pill, dollar + arrow</span>
        </li>
      </ul>

      <!-- Logo: Tesla Valve -->
      <h2 style="font-size: 1.1rem; font-weight: 600; color: #1b2a37; margin-bottom: 1rem; border-bottom: 2px solid #e5e7eb; padding-bottom: 0.5rem;">Logo: Tesla Valve</h2>
      <ul style="list-style: none; padding: 0; margin-bottom: 2.5rem;">
        <li style="margin-bottom: 0.75rem;">
          <a href="/logo-valve" style="color: #0d9488; font-weight: 600; text-decoration: none; font-size: 1rem;">Tesla Valve — Linear + Renewal Loop</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Full valve illustration, loop + leak drops, sealed leak, loop + bucket</span>
        </li>
        <li style="margin-bottom: 0.75rem;">
          <a href="/logo-valve-square" style="color: #0d9488; font-weight: 600; text-decoration: none; font-size: 1rem;">Tesla Valve — Square (C/Ↄ bumps)</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Alternating semicircle bumps on all 4 sides of a square</span>
        </li>
      </ul>

      <!-- Logo: Honeycomb -->
      <h2 style="font-size: 1.1rem; font-weight: 600; color: #1b2a37; margin-bottom: 1rem; border-bottom: 2px solid #e5e7eb; padding-bottom: 0.5rem;">Logo: Honeycomb / Hexagon</h2>
      <ul style="list-style: none; padding: 0; margin-bottom: 2.5rem;">
        <li style="margin-bottom: 0.75rem;">
          <a href="/logo-honeycomb" style="color: #0d9488; font-weight: 600; text-decoration: none; font-size: 1rem;">Honeycomb — Original Brand Colors</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Split hex, 4-hex cluster, 6 slices — orange + teal + navy + cream</span>
        </li>
      </ul>

      <!-- Logo: Palette Variations (Quadrant) -->
      <h2 style="font-size: 1.1rem; font-weight: 600; color: #1b2a37; margin-bottom: 1rem; border-bottom: 2px solid #e5e7eb; padding-bottom: 0.5rem;">Logo: Color Palette Explorations</h2>
      <ul style="list-style: none; padding: 0; margin-bottom: 2.5rem;">
        <li style="margin-bottom: 0.75rem;">
          <a href="/logo-palette-1" style="color: #0d9488; font-weight: 600; text-decoration: none; font-size: 1rem;">Palette 1: Trust & Authority</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Navy + Orange + Teal + Cream + Slate</span>
        </li>
        <li style="margin-bottom: 0.75rem;">
          <a href="/logo-palette-2" style="color: #0d9488; font-weight: 600; text-decoration: none; font-size: 1rem;">Palette 2: Modern SaaS</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Ink Black + Electric Blue + Amber Gold + Ice White + Cool Gray</span>
        </li>
        <li style="margin-bottom: 0.75rem;">
          <a href="/logo-palette-3" style="color: #0d9488; font-weight: 600; text-decoration: none; font-size: 1rem;">Palette 3: Revenue Growth</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Charcoal + Orange + Green + Sand + Graphite</span>
        </li>
        <li style="margin-bottom: 0.75rem;">
          <a href="/logo-palette-4" style="color: #0d9488; font-weight: 600; text-decoration: none; font-size: 1rem;">Palette 4: Premium Consulting</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Deep Indigo + Coral + Sage Teal + Pearl + Muted Navy</span>
        </li>
      </ul>

      <!-- Orange + Teal constant palettes -->
      <h2 style="font-size: 1.1rem; font-weight: 600; color: #1b2a37; margin-bottom: 1rem; border-bottom: 2px solid #e5e7eb; padding-bottom: 0.5rem;">Logo: Orange + Teal Constant</h2>
      <ul style="list-style: none; padding: 0; margin-bottom: 2.5rem;">
        <li style="margin-bottom: 0.75rem;">
          <a href="/logo-palette-5" style="color: #0d9488; font-weight: 600; text-decoration: none; font-size: 1rem;">Palette 5: Deep Ocean</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Midnight Blue + Pale Sky + Steel (orange/teal constant)</span>
        </li>
        <li style="margin-bottom: 0.75rem;">
          <a href="/logo-palette-6" style="color: #0d9488; font-weight: 600; text-decoration: none; font-size: 1rem;">Palette 6: Warm Contrast</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Navy + Honey Gold + Warm Gray (orange/teal constant)</span>
        </li>
        <li style="margin-bottom: 0.75rem;">
          <a href="/logo-palette-7" style="color: #0d9488; font-weight: 600; text-decoration: none; font-size: 1rem;">Palette 7: Clean Pro</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Rich Black + Soft Lavender + Neutral Gray (orange/teal constant)</span>
        </li>
        <li style="margin-bottom: 0.75rem;">
          <a href="/logo-palette-8" style="color: #0d9488; font-weight: 600; text-decoration: none; font-size: 1rem;">Palette 8: Earth & Ocean</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Forest Dark + Sandstone + Olive Gray (orange/teal constant)</span>
        </li>
      </ul>

      <!-- Dashboard + Industrial -->
      <h2 style="font-size: 1.1rem; font-weight: 600; color: #1b2a37; margin-bottom: 1rem; border-bottom: 2px solid #e5e7eb; padding-bottom: 0.5rem;">Logo: Dashboard & Industrial Colors</h2>
      <ul style="list-style: none; padding: 0; margin-bottom: 2.5rem;">
        <li style="margin-bottom: 0.75rem;">
          <a href="/logo-palette-9" style="color: #0d9488; font-weight: 600; text-decoration: none; font-size: 1rem;">Palette 9: Dashboard Teal</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Teal + Amber + Red + Green — hex + quadrant + honeycomb cluster</span>
        </li>
        <li style="margin-bottom: 0.75rem;">
          <a href="/logo-industrial-1" style="color: #0d9488; font-weight: 600; text-decoration: none; font-size: 1rem;">Industrial 1: Green & Orange</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Medium Green + Alert Orange + Deep Gray + Buff — hex + cluster + quadrant</span>
        </li>
        <li style="margin-bottom: 0.75rem;">
          <a href="/logo-industrial-2" style="color: #0d9488; font-weight: 600; text-decoration: none; font-size: 1rem;">Industrial 2: Blue & Yellow</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Caution Blue + Solar Yellow + Medium Blue + Deep Gray — hex + cluster + quadrant</span>
        </li>
        <li style="margin-bottom: 0.75rem;">
          <a href="/logo-industrial-3" style="color: #0d9488; font-weight: 600; text-decoration: none; font-size: 1rem;">Industrial 3: Fire & Safety</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Fire Red + Safety Green + Alert Orange + Medium Gray — hex + cluster + quadrant</span>
        </li>
      </ul>

      <!-- Sample Pages -->
      <h2 style="font-size: 1.1rem; font-weight: 600; color: #1b2a37; margin-bottom: 1rem; border-bottom: 2px solid #e5e7eb; padding-bottom: 0.5rem;">Sample Pages</h2>
      <ul style="list-style: none; padding: 0; margin-bottom: 2.5rem;">
        <li style="margin-bottom: 0.75rem;">
          <a href="/sample-v5" style="color: #0d9488; font-weight: 600; text-decoration: none; font-size: 1rem;">V5 Homepage (original amber)</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Mid-tones palette applied to website homepage</span>
        </li>
        <li style="margin-bottom: 0.75rem;">
          <a href="/sample-v5-dashboard" style="color: #0d9488; font-weight: 600; text-decoration: none; font-size: 1rem;">V5 Dashboard (original amber)</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Mid-tones palette applied to Django backend dashboard</span>
        </li>
      </ul>

      <h2 style="font-size: 1.1rem; font-weight: 600; color: #1b2a37; margin-bottom: 1rem; border-bottom: 2px solid #C47A2A; padding-bottom: 0.5rem;">V6: Copper CTA — Light & Dark</h2>
      <ul style="list-style: none; padding: 0; margin-bottom: 2.5rem;">
        <li style="margin-bottom: 0.75rem;">
          <a href="/sample-v6-home-light" style="color: #C47A2A; font-weight: 600; text-decoration: none; font-size: 1rem;">V6 Homepage — Light Mode</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Copper CTA (#C47A2A) on light background</span>
        </li>
        <li style="margin-bottom: 0.75rem;">
          <a href="/sample-v6-home-dark" style="color: #C47A2A; font-weight: 600; text-decoration: none; font-size: 1rem;">V6 Homepage — Dark Mode</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Copper CTA on dark navy background</span>
        </li>
        <li style="margin-bottom: 0.75rem;">
          <a href="/sample-v6-dash-light" style="color: #C47A2A; font-weight: 600; text-decoration: none; font-size: 1rem;">V6 Dashboard — Light Mode</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Django backend with copper accents on light bg</span>
        </li>
        <li style="margin-bottom: 0.75rem;">
          <a href="/sample-v6-dash-dark" style="color: #C47A2A; font-weight: 600; text-decoration: none; font-size: 1rem;">V6 Dashboard — Dark Mode</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Django backend with copper accents on dark bg</span>
        </li>
      </ul>

      <!-- Final palettes -->
      <h2 style="font-size: 1.1rem; font-weight: 600; color: #1b2a37; margin-bottom: 1rem; border-bottom: 2px solid #e5e7eb; padding-bottom: 0.5rem;">Final Palette Explorations</h2>
      <ul style="list-style: none; padding: 0; margin-bottom: 2.5rem;">
        <li style="margin-bottom: 0.75rem;">
          <a href="/logo-final-palette" style="color: #0d9488; font-weight: 600; text-decoration: none; font-size: 1rem;">Final Palette — Base 4 Colors</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Amber + Teal + Blue + Yellow — hex, cluster, quadrant, lockups</span>
        </li>
        <li style="margin-bottom: 0.75rem;">
          <a href="/logo-final-palette-v2" style="color: #0d9488; font-weight: 600; text-decoration: none; font-size: 1rem;">Final Palette — Shade Mixes (V2-V5)</a>
          <span style="color: #78716c; font-size: 0.8rem; display: block;">Deep, light, contrast, mid-tone variations of same families</span>
        </li>
      </ul>

    </div>
  </div>
</BaseLayout>
