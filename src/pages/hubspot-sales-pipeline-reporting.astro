---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/astro/Footer.astro";
import LogoHoneycomb from "../components/astro/LogoHoneycomb.astro";
import ClientLogoStrip from "../components/astro/ClientLogoStrip.astro";
import ReportSignup from "../components/astro/ReportSignup.astro";
import ReportOutputBento from "../components/astro/ReportOutputBento.astro";
import ReportLandingHero from "../components/astro/ReportLandingHero.astro";

const title = "HubSpot Sales & Pipeline Reporting | SWOTBee";
const description =
  "Turn HubSpot sales data into a repeatable management report with pipeline, conversion, win-rate, velocity, forecast, revenue and target KPIs in Excel, PowerPoint, or a live dashboard.";

const attentionRows = [
  {
    deal: "Northstar expansion",
    owner: "Liam Ross",
    region: "EMEA",
    stage: "Decision",
    amount: "$180k",
    age: "38 days",
    reason: "Close date moved twice",
    action: "Confirm executive sponsor call",
  },
  {
    deal: "Quarry Systems rollout",
    owner: "Elena Park",
    region: "EMEA",
    stage: "Proposal",
    amount: "$145k",
    age: "29 days",
    reason: "No activity for 12 days",
    action: "Agree next step with buyer",
  },
  {
    deal: "Acme Platform upgrade",
    owner: "Maya Chen",
    region: "North America",
    stage: "Discovery",
    amount: "$90k",
    age: "21 days",
    reason: "Next step is overdue",
    action: "Update mutual action plan",
  },
];

const reportAreas = [
  {
    title: "Pipeline creation and coverage",
    description:
      "New pipeline, open pipeline, coverage against target, and the teams, regions, products, or sources contributing to the position.",
  },
  {
    title: "Stage conversion",
    description:
      "Conversion between pipeline stages, drop-off points, and the movement that explains where opportunities are progressing or stalling.",
  },
  {
    title: "Win rate and closed won",
    description:
      "Wins, losses, closed-won revenue, average deal size, and performance against the agreed comparison period.",
  },
  {
    title: "Deal velocity and aging",
    description:
      "Sales-cycle length, time in stage, aging bands, stale opportunities, and the deals taking longer than expected.",
  },
  {
    title: "Forecast and target attainment",
    description:
      "Forecast position, committed and likely revenue, target attainment, and the remaining gap for the period.",
  },
  {
    title: "Team and market performance",
    description:
      "Results by owner, team, pipeline, region, product, segment, or another supported dimension used in your sales review.",
  },
];

const faqs = [
  {
    q: "Does HubSpot offer sales reporting?",
    a: "Yes. HubSpot includes sales dashboards, pre-built reports, sales analytics, and custom reporting options depending on your subscription. SWOTBee uses the sales data and definitions available in your HubSpot CRM to produce a repeatable report for management review.",
  },
  {
    q: "Which types of sales reports can I create from HubSpot?",
    a: "Common sales reports cover pipeline, funnel conversion, sales activities, win rate, deal velocity, forecast, target attainment, and team performance. Choose the measures that support the decision your sales managers need to make, rather than adding every available metric.",
  },
  {
    q: "What is the difference between HubSpot sales analytics and the custom report builder?",
    a: "The sales analytics tool provides ready-made views for common sales questions. The custom report builder lets eligible HubSpot accounts combine selected data and fields for a specific reporting need. SWOTBee turns the approved view into a recurring Excel, PowerPoint, and dashboard pack.",
  },
  {
    q: "Can the report include sales activities and rep performance?",
    a: "Yes, when the required activities and ownership data are recorded consistently in HubSpot. The report can connect calls, meetings, emails, deal movement, and outcomes so sales leaders can review activity in context instead of treating volume as performance.",
  },
  {
    q: "What is a HubSpot sales and pipeline report?",
    a: "It is a recurring management report built from selected HubSpot Sales Hub data. It brings pipeline, conversion, win rate, velocity, forecast, closed-won revenue, targets, supporting deals, and commentary into one report for a sales, executive, board, or investor review.",
  },
  {
    q: "Which sales KPIs can I include?",
    a: "Depending on the data available in your HubSpot account, the report can include pipeline created, pipeline coverage, stage conversion, win rate, deal velocity and aging, forecast, closed-won revenue, and target attainment. Results can be broken down by supported fields such as owner, team, pipeline, region, product, source, or segment.",
  },
  {
    q: "Can the report cover more than one sales pipeline?",
    a: "Yes. Pipelines can be reported separately or combined when the underlying stages and definitions are genuinely comparable. The report keeps the included scope visible so unrelated pipelines are not silently mixed.",
  },
  {
    q: "Can I compare this month or quarter with the previous one?",
    a: "Yes, when HubSpot provides comparable period data or SWOTBee has stored the required point-in-time snapshot. The same agreed definition and scope are used on both sides of the comparison.",
  },
  {
    q: "Can I use the report for forecasting?",
    a: "Yes. The report can include the forecast measures, categories, probabilities, targets, and deal evidence supported by your HubSpot setup. The calculation basis and reporting date remain visible.",
  },
  {
    q: "Can I use Excel, PowerPoint, or a live dashboard?",
    a: "Yes. Excel carries the management summary and supporting deal data, PowerPoint provides an editable meeting-ready story, and a live dashboard can be shared when the audience needs a current view. All three use the same reporting setup.",
  },
  {
    q: "Does SWOTBee replace HubSpot reporting?",
    a: "No. HubSpot remains the operational data source. SWOTBee turns selected sales data into a repeatable management pack with consistent definitions, comparisons, evidence, and reusable outputs.",
  },
  {
    q: "Can SWOTBee recover an old pipeline or forecast snapshot?",
    a: "Only when the historical state is available from HubSpot or was previously captured. If it is unavailable, snapshot collection can begin now so future reports have the point-in-time history they need.",
  },
  {
    q: "Will signing up connect my HubSpot account?",
    a: "No. This signup records your work email and requested report so we can contact you about access. It does not create an app account or connect to your HubSpot portal.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Layout
  title={title}
  description={description}
  keywords="hubspot sales reporting, hubspot sales reports, hubspot pipeline reporting, hubspot pipeline report, hubspot sales performance reports, hubspot sales forecasting reports, hubspot sales report templates, hubspot win rate report"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <header class="border-b border-v6-border bg-white">
    <div
      class="mx-auto flex min-h-16 max-w-6xl items-center justify-between gap-6 px-4 py-2 sm:px-6 lg:px-8"
    >
      <a
        href="/"
        class="flex min-h-11 shrink-0 items-center gap-2 rounded-md focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2"
        aria-label="SWOTbee home"
      >
        <LogoHoneycomb width={32} height={30} />
        <span class="text-lg font-bold text-v6-dark"
          >SWOT<span class="text-v6-teal-700">bee</span></span
        >
      </a>
      <nav
        class="hidden items-center gap-6 text-sm font-semibold text-v6-text-muted lg:flex"
        aria-label="Page navigation"
      >
        <a
          href="#how-it-works"
          class="rounded-md py-2 hover:text-v6-dark focus:outline-none focus:ring-2 focus:ring-v6-copper"
          >How it works</a
        >
        <a
          href="#sample-report"
          class="rounded-md py-2 hover:text-v6-dark focus:outline-none focus:ring-2 focus:ring-v6-copper"
          >Sample report</a
        >
        <a
          href="#report-contents"
          class="rounded-md py-2 hover:text-v6-dark focus:outline-none focus:ring-2 focus:ring-v6-copper"
          >What's included</a
        >
        <a
          href="#questions"
          class="rounded-md py-2 hover:text-v6-dark focus:outline-none focus:ring-2 focus:ring-v6-copper"
          >FAQs</a
        >
      </nav>
      <a
        href="#report-signup"
        data-ga-cta="sales_report_header_signup"
        class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-lg border border-v6-copper px-4 py-2 text-sm font-semibold text-v6-copper transition-colors hover:bg-v6-copper-50 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2"
        >Get your first Sales Report</a
      >
    </div>
  </header>

  <main>
    <ReportLandingHero
      eyebrow="HubSpot sales and pipeline reporting"
      titleLead="Turn HubSpot Sales & Pipeline Data"
      titleAccent="into your Report in 3 Clicks"
      description="Bring pipeline, coverage, conversion, win rate, velocity, forecast, closed-won revenue, and targets into one clear report. Run it weekly, monthly, or quarterly."
      ctaLabel="Get your first Sales Report"
      ctaEvent="sales_report_hero_signup"
      reassurance={[
        "Break down by pipeline, region, or team.",
        "No spreadsheet rebuilds.",
        "No slide deck rebuilds.",
      ]}
    />

    <ClientLogoStrip
      caption="HubSpot and revenue operations work trusted by teams at"
    />

    <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div
        class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center"
      >
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper"
          >
            The recurring rebuild
          </p><h2
            class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl"
          >
            Stop piecing together the same sales report every month
          </h2>
        </div>
        <div class="space-y-5 text-lg leading-relaxed text-v6-text-muted">
          <p>
            The deals may already be in HubSpot, but the management report is
            usually spread across several dashboards, exports, spreadsheets, and
            last month's slide deck.
          </p>
          <p>
            Near-identical reports get rebuilt for different pipelines and
            teams. Filters and definitions drift out of sync. Pipeline totals
            need reconciling, forecast figures need checking, and charts need
            updating before anyone can explain what changed.
          </p>
          <p class="font-semibold text-v6-dark">
            SWOTBee keeps the scope, definitions, evidence, and presentation
            together, so the next review starts with the current pipeline
            story—not another blank workbook.
          </p>
        </div>
      </div>
    </section>

    <section
      class="border-y border-v6-border bg-v6-bg px-4 py-16 sm:px-6 sm:py-20 lg:px-8"
      aria-labelledby="sales-reporting-path-heading"
    >
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">
            Use HubSpot. Skip the report rebuild.
          </p>
          <h2 id="sales-reporting-path-heading" class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">
            Turn HubSpot sales data into a report your team can use
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">
            Keep the sales process in HubSpot CRM. Give sales managers one clear view of performance and the deals that need action.
          </p>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          <article class="rounded-2xl border border-v6-border bg-white p-6 sm:p-7">
            <h3 class="text-xl font-bold text-v6-dark">Use the data already there</h3>
            <p class="mt-3 leading-relaxed text-v6-text-muted">Bring sales activities, deal stage, pipeline, conversion rates, and outcomes into the same performance report.</p>
          </article>
          <article class="rounded-2xl border border-v6-border bg-white p-6 sm:p-7">
            <h3 class="text-xl font-bold text-v6-dark">Choose the right report</h3>
            <p class="mt-3 leading-relaxed text-v6-text-muted">Start with pre-built reports or sales analytics. Use the custom report builder when your reporting needs call for a specific view.</p>
          </article>
          <article class="rounded-2xl border border-v6-border bg-white p-6 sm:p-7">
            <h3 class="text-xl font-bold text-v6-dark">Make the next step clear</h3>
            <p class="mt-3 leading-relaxed text-v6-text-muted">See sales performance, rep performance, sales goals, and the supporting deals without creating reports from scratch.</p>
          </article>
        </div>
      </div>
    </section>

    <section
      id="how-it-works"
      class="scroll-mt-8 bg-v6-bg px-4 py-16 sm:px-6 sm:py-20 lg:px-8"
    >
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <p
            class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper"
          >
            A reusable sales-reporting setup
          </p><h2
            class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl"
          >
            Set the report up once. Bring in fresh sales data whenever you need
            it.
          </h2><p class="mt-4 text-lg leading-relaxed text-v6-text-muted">
            Start with a complete sales-management report and make it fit the
            way your business measures the pipeline.
          </p>
        </div>
        <ol class="mt-10 grid gap-6 md:grid-cols-3">
          <li class="rounded-2xl border border-v6-border bg-white p-6 sm:p-7">
            <span
              class="flex h-9 w-9 items-center justify-center rounded-full bg-v6-copper-50 text-sm font-bold text-v6-copper-800"
              >1</span
            ><h3 class="mt-5 text-xl font-bold text-v6-dark">
              Choose the scope
            </h3><p class="mt-3 leading-relaxed text-v6-text-muted">
              Pick the period and the pipelines, teams, regions, products,
              segments, or owners that belong in the report.
            </p>
          </li>
          <li class="rounded-2xl border border-v6-border bg-white p-6 sm:p-7">
            <span
              class="flex h-9 w-9 items-center justify-center rounded-full bg-v6-copper-50 text-sm font-bold text-v6-copper-800"
              >2</span
            ><h3 class="mt-5 text-xl font-bold text-v6-dark">
              Choose your KPIs
            </h3><p class="mt-3 leading-relaxed text-v6-text-muted">
              Select the measures your leadership team uses, along with their
              targets, definitions, and comparison periods.
            </p><p class="mt-4 text-sm font-semibold text-v6-dark">
              Coverage against target · Stage conversion · Forecast by region
            </p>
          </li>
          <li class="rounded-2xl border border-v6-border bg-white p-6 sm:p-7">
            <span
              class="flex h-9 w-9 items-center justify-center rounded-full bg-v6-copper-50 text-sm font-bold text-v6-copper-800"
              >3</span
            ><h3 class="mt-5 text-xl font-bold text-v6-dark">
              Get the report
            </h3><p class="mt-3 leading-relaxed text-v6-text-muted">
              Review the figures, add the context only your team knows, and use
              the report in Excel, PowerPoint, or a live dashboard.
            </p>
          </li>
        </ol>
        <div class="mt-8">
          <a
            href="#report-signup"
            data-ga-cta="sales_report_steps_signup"
            class="inline-flex min-h-12 items-center justify-center rounded-xl bg-v6-copper px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-v6-copper-600 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2"
            >Get your first Sales Report</a>
        </div>
      </div>
    </section>

    <section
      id="report-outputs"
      class="scroll-mt-8 px-4 py-16 sm:px-6 sm:py-20 lg:px-8"
    >
      <div class="mx-auto max-w-6xl">
        <div class="max-w-4xl">
          <p
            class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper"
          >
            One reporting setup
          </p><h2
            class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl"
          >
            One report—ready in Excel, PowerPoint, or a live dashboard.
          </h2><p class="mt-4 text-lg leading-relaxed text-v6-text-muted">
            Present the sales story in PowerPoint. Check the deal detail in
            Excel. Share a live view when people need to explore it themselves.
            Update the report, and all three versions stay aligned.
          </p>
        </div>
        <ReportOutputBento
          datasetName="sales and pipeline"
          workbookDescription="Verify every KPI, definition, target, and deal-level record in a familiar spreadsheet."
          presentationDescription="Present the same approved measures and chart patterns as an executive sales story."
          dashboardDescription="Share a current sales view without rebuilding the report or sending another file."
        />
      </div>
    </section>

    <section
      id="sample-report"
      class="scroll-mt-8 px-4 py-16 sm:px-6 sm:py-20 lg:px-8"
    >
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <div class="flex flex-wrap items-center gap-3">
            <p
              class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper"
            >
              Inside your sales report
            </p><span
              class="rounded-full border border-v6-copper-200 bg-v6-copper-50 px-2.5 py-1 text-xs font-semibold text-v6-copper-800"
              >Sample data</span>
          </div>
          <h2
            class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl"
          >
            Show the headline first. Then let your executives drill down if
            needed.
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">
            The first view shows the current position, the change from the
            previous period, and the gaps that need attention. Below it,
            executives can see the teams, regions, and individual deals driving
            those results.
          </p>
        </div>

        <div
          class="mt-10 overflow-hidden rounded-2xl border border-v6-border bg-white shadow-lg shadow-v6-dark/5"
        >
          <div
            class="flex flex-col gap-4 border-b border-v6-border px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-7"
          >
            <div>
              <p
                class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-text-muted"
              >
                Sales and pipeline report
              </p><h3 class="mt-1 text-xl font-bold text-v6-dark">
                Monthly sales review
              </h3><p class="mt-1 text-sm text-v6-text-muted">
                September 2026, compared with August 2026
              </p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <span
                class="rounded-full bg-v6-copper-50 px-3 py-1.5 text-xs font-semibold text-v6-copper-800"
                >Coverage below target</span
              ><span
                class="rounded-full bg-v6-teal-50 px-3 py-1.5 text-xs font-semibold text-v6-teal-800"
                >Pipeline up 18%</span
              ><span
                class="rounded-full bg-v6-blue-50 px-3 py-1.5 text-xs font-semibold text-v6-blue-800"
                >Sample data</span>
            </div>
          </div>
          <div class="grid gap-px bg-v6-border sm:grid-cols-2 lg:grid-cols-4">
            <div class="bg-white p-5 sm:p-6">
              <p class="text-sm text-v6-text-muted">Pipeline created</p><div
                class="mt-2 flex items-end justify-between gap-3"
              >
                <p class="text-2xl font-bold text-v6-dark">$1.84m</p><span
                  class="text-sm font-semibold text-v6-teal-800">Up 18%</span>
              </div>
            </div>
            <div class="bg-v6-copper-50 p-5 sm:p-6">
              <p class="text-sm text-v6-copper-800">Forward coverage</p><div
                class="mt-2 flex items-end justify-between gap-3"
              >
                <p class="text-2xl font-bold text-v6-copper-800">3.1×</p><span
                  class="text-sm font-semibold text-v6-copper-800"
                  >Target 3.5×</span>
              </div>
            </div>
            <div class="bg-white p-5 sm:p-6">
              <p class="text-sm text-v6-text-muted">Win rate</p><div
                class="mt-2 flex items-end justify-between gap-3"
              >
                <p class="text-2xl font-bold text-v6-dark">24.6%</p><span
                  class="text-sm font-semibold text-v6-copper-800"
                  >Down 2.3 pts</span>
              </div>
            </div>
            <div class="bg-v6-bg-warm p-5 sm:p-6">
              <p class="text-sm text-v6-text-muted">Forecast</p><div
                class="mt-2 flex items-end justify-between gap-3"
              >
                <p class="text-2xl font-bold text-v6-dark">$1.18m</p><span
                  class="text-sm font-semibold text-v6-text-muted"
                  >92% target</span>
              </div>
            </div>
          </div>
          <div
            class="grid gap-6 border-t border-v6-border p-5 sm:p-7 lg:grid-cols-[1.05fr_0.95fr]"
          >
            <article class="rounded-xl border border-v6-border p-5">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <p
                    class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-copper"
                  >
                    Coverage by region
                  </p><h4 class="mt-1 font-bold text-v6-dark">
                    Forward pipeline against the 3.5× target
                  </h4>
                </div><span class="text-xs text-v6-text-muted"
                  >Next quarter</span>
              </div>
              <div
                class="mt-6 space-y-4"
                aria-label="Pipeline coverage by region"
              >
                <div>
                  <div class="flex justify-between text-sm">
                    <span class="font-semibold text-v6-dark">North America</span
                    ><span class="text-v6-teal-800">3.8×</span>
                  </div><div
                    class="mt-2 h-3 overflow-hidden rounded-full bg-v6-bg"
                  >
                    <div class="h-full w-[95%] rounded-full bg-v6-teal"></div>
                  </div>
                </div>
                <div>
                  <div class="flex justify-between text-sm">
                    <span class="font-semibold text-v6-dark">APAC</span><span
                      class="text-v6-text-muted">3.4×</span>
                  </div><div
                    class="mt-2 h-3 overflow-hidden rounded-full bg-v6-bg"
                  >
                    <div class="h-full w-[85%] rounded-full bg-v6-blue-300">
                    </div>
                  </div>
                </div>
                <div>
                  <div class="flex justify-between text-sm">
                    <span class="font-semibold text-v6-dark">EMEA</span><span
                      class="text-v6-copper-800">2.3×</span>
                  </div><div
                    class="mt-2 h-3 overflow-hidden rounded-full bg-v6-bg"
                  >
                    <div class="h-full w-[58%] rounded-full bg-v6-copper"></div>
                  </div>
                </div>
              </div>
            </article>
            <article
              class="rounded-xl border border-v6-copper-200 bg-v6-copper-50 p-5"
            >
              <div class="flex items-center justify-between gap-4">
                <p
                  class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-copper-800"
                >
                  Reviewed summary
                </p><span
                  class="rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-v6-teal-800"
                  >Approved</span>
              </div>
              <p class="mt-4 text-lg font-bold leading-relaxed text-v6-dark">
                Pipeline creation rose 18%, but win rate fell and forward
                coverage remains below target.
              </p>
              <p class="mt-3 text-sm leading-relaxed text-v6-text-muted">
                EMEA is the priority because its 2.3× coverage accounts for most
                of the company-wide gap.
              </p>
              <div class="mt-5 space-y-2 text-sm">
                <p class="rounded-lg bg-white px-3 py-2 text-v6-text-muted">
                  <strong class="text-v6-dark">Evidence:</strong> September pipeline
                  and next-quarter target
                </p><p class="rounded-lg bg-white px-3 py-2 text-v6-text-muted">
                  <strong class="text-v6-dark">Next action:</strong> Review EMEA creation
                  plan and late-stage deals
                </p>
              </div>
            </article>
          </div>
          <div class="border-t border-v6-border p-5 sm:p-7">
            <div
              class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between sm:gap-4"
            >
              <h4 class="text-base font-bold text-v6-dark">
                Deals requiring attention
