      </div>
    </section>

    <section id="report-signup" class="scroll-mt-8 bg-v6-bg px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-3xl rounded-3xl bg-v6-copper px-6 py-10 text-center text-white shadow-lg shadow-v6-copper/20 sm:px-10 sm:py-12">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-white/75">Free beta signup</p>
        <h2 class="mt-3 text-balance text-3xl font-bold sm:text-4xl">Create your free historical pipeline snapshot</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-white/85">Enter your work email to begin report setup. No card is required, and this website step does not connect to HubSpot.</p>
        <ReportSignup offerCode="a3_historical_snapshot" reportName="HubSpot historical pipeline snapshot" sourcePage="hubspot-historical-pipeline-snapshot" ctaLabel="a3_report_signup" />
        <p class="mt-5 text-sm text-white/75">Your email is used for this report request and related service communication.</p>
