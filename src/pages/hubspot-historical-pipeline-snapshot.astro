---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/astro/Footer.astro";
import LogoHoneycomb from "../components/astro/LogoHoneycomb.astro";
import ClientLogoStrip from "../components/astro/ClientLogoStrip.astro";
import ReportSignup from "../components/astro/ReportSignup.astro";
import ReportBenefitCards from "../components/astro/ReportBenefitCards.astro";
import ReportRelatedLinks from "../components/astro/ReportRelatedLinks.astro";
import ReportingDashboardValue from "../components/astro/ReportingDashboardValue.astro";

const title = "HubSpot Historical Pipeline Dashboard";
const description = "Build a historical HubSpot pipeline dashboard in 3 clicks, preserve weekly or monthly snapshots, and reuse them in Excel and PowerPoint.";

const snapshotRows = [
  { deal: "Briar Health expansion", owner: "Priya Shah", stage: "Discovery", amount: "$145k", closeDate: "Oct 18" },
  { deal: "Acme Platform renewal", owner: "Maya Chen", stage: "Contract sent", amount: "$120k", closeDate: "Sep 30" },
  { deal: "Northstar expansion", owner: "Liam Ross", stage: "Decision", amount: "$75k", closeDate: "Oct 7" },
  { deal: "Quarry Systems rollout", owner: "Elena Park", stage: "Solution review", amount: "$90k", closeDate: "Nov 4" },
];

const benefits = [
  { title: "Preserve every reporting cutoff", description: "Save the exact scope, totals, stages, owners, and deal rows used for each weekly or monthly review.", icon: "archive", tone: "copper" },
  { title: "Reopen what was known then", description: "Return to the same saved pipeline state later without newer HubSpot edits rewriting the management record.", icon: "clock", tone: "teal" },
  { title: "Build a historical trend", description: "Use consistent snapshots to compare pipeline value, coverage, stage mix, and deal counts across reporting periods.", icon: "trend", tone: "blue" },
  { title: "Inspect the Excel-ready evidence", description: "Keep the underlying deal rows with each snapshot so reviewers can trace a chart back to the supporting data.", icon: "inspect", tone: "amber" },
  { title: "Prepare QBR and board updates", description: "Choose the saved trends and changes that matter, then turn them into editable presentation charts and talking points.", icon: "present", tone: "copper" },
  { title: "Repeat without reconstruction", description: "Set the pipeline, cutoff, cadence, and output once instead of trying to recreate an old CRM state later.", icon: "refresh", tone: "teal" },
] as const;

const faqs = [
  { q: "How do I create a historical pipeline snapshot in HubSpot?", a: "Choose the pipeline, exact cutoff, and weekly or monthly cadence. SWOTBee saves the scope, totals, stage mix, and deal rows together so the same historical state can be reopened later." },
  { q: "What does the historical dashboard preserve?", a: "Each cutoff preserves pipeline value, deal count, stage, owner, amount, close date, and the exact reporting scope used at that time." },
  { q: "Will it edit our HubSpot records?", a: "No. The reporting connection reads the data needed to create snapshots without changing the underlying deal records." },
  { q: "How is this different from opening a live emailed report later?", a: "A saved snapshot retains the values and deal rows from its named cutoff. Later edits in HubSpot do not rewrite the management record used for that period." },
  { q: "How do I get started?", a: "Sign up to the SWOTBee app, connect the appropriate HubSpot portal, choose the pipeline and snapshot cadence, and create the historical dashboard." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Layout
  title={title}
  description={description}
  keywords="hubspot historical pipeline snapshot, hubspot historical pipeline dashboard, hubspot weekly pipeline snapshot, hubspot snapshot report, hubspot historical pipeline report, hubspot pipeline snapshot, hubspot historical reporting"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <header class="border-b border-v6-border bg-white">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
      <a href="/" class="flex min-h-11 items-center gap-2 rounded-md focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2" aria-label="SWOTbee home">
        <LogoHoneycomb width={32} height={30} />
        <span class="text-lg font-bold text-v6-dark">SWOT<span class="text-v6-teal-700">bee</span></span>
      </a>
      <a href="#report-signup" data-ga-cta="a3_header_signup" class="inline-flex min-h-11 items-center justify-center rounded-lg border border-v6-copper px-4 py-2 text-sm font-semibold text-v6-copper transition-colors hover:bg-v6-copper-50 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">
        Sign up to the app
      </a>
    </div>
  </header>

  <main>
    <section class="overflow-hidden bg-gradient-to-b from-v6-bg to-white px-4 pb-16 pt-14 sm:px-6 sm:pb-20 sm:pt-20 lg:px-8">
      <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[0.92fr_1.08fr]">
        <div>
          <span class="mb-5 inline-flex rounded-full bg-v6-copper-50 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-v6-copper-700">Create it in 3 clicks</span>
          <h1 class="max-w-3xl text-balance text-4xl font-bold leading-[1.08] text-v6-dark sm:text-5xl lg:text-[3.45rem]">Build a Historical HubSpot Pipeline Dashboard in 3 Clicks</h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-v6-text-muted">For RevOps, finance, and sales leaders who need reliable historical evidence. Preserve weekly or monthly snapshots, rebuild trends later, and choose what goes into Excel and PowerPoint.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#sample-report" data-ga-cta="a3_hero_view_sample" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-v6-copper px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-v6-copper-600 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">View the sample dashboard</a>
            <a href="#report-signup" data-ga-cta="a3_hero_signup" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-v6-border bg-white px-7 py-3.5 text-base font-semibold text-v6-dark transition-colors hover:border-v6-copper hover:bg-v6-copper-50 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">Sign up to the app</a>
          </div>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-v6-text-muted">Sign up to the SWOTBee app with your work email. No card is required.</p>
        </div>

        <div class="relative" aria-label="Example historical pipeline dashboard with recurring snapshots and a selected cutoff">
          <div class="absolute -inset-6 -z-10 rounded-full bg-v6-blue-100/70 blur-3xl"></div>
          <div class="overflow-hidden rounded-2xl border border-v6-border bg-white shadow-xl shadow-v6-dark/10">
            <div class="flex items-center justify-between border-b border-v6-border px-5 py-4">
              <div><p class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-blue-800">Historical pipeline dashboard</p><p class="mt-1 font-semibold text-v6-dark">Monthly snapshots</p></div>
              <span class="rounded-full bg-v6-teal-50 px-3 py-1 text-xs font-semibold text-v6-teal-800">4 cutoffs preserved</span>
            </div>
            <div class="grid grid-cols-3 border-b border-v6-border">
              <div class="p-4 sm:p-5"><p class="text-xs text-v6-text-muted">Selected cutoff</p><p class="mt-1 text-base font-bold text-v6-dark sm:text-lg">Sep 4, 5 PM</p></div>
              <div class="border-x border-v6-border bg-v6-blue-50 p-4 sm:p-5"><p class="text-xs text-v6-blue-800">Open pipeline</p><p class="mt-1 text-lg font-bold text-v6-blue-800 sm:text-xl">USD 1.24m</p></div>
              <div class="p-4 sm:p-5"><p class="text-xs text-v6-text-muted">Since June</p><p class="mt-1 text-lg font-bold text-v6-teal-800 sm:text-xl">+18%</p></div>
            </div>
            <div class="p-5">
              <div class="flex items-center justify-between"><p class="text-xs font-semibold text-v6-dark">Pipeline value by saved cutoff</p><span class="text-[10px] font-semibold text-v6-blue-800">Snapshot frozen</span></div>
              <svg viewBox="0 0 360 120" class="mt-3 h-28 w-full" role="img" aria-label="Pipeline value rises across four monthly snapshots">
                <path d="M20 96 H340" stroke="#E2DED7" stroke-width="1" />
                <path d="M20 66 H340" stroke="#E2DED7" stroke-width="1" stroke-dasharray="4 4" />
                <path d="M34 88 L126 72 L220 78 L326 34" fill="none" stroke="#1A7AB5" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M34 88 L126 72 L220 78 L326 34 L326 96 L34 96 Z" fill="#EAF5FB" />
                <circle cx="34" cy="88" r="5" fill="#1A7AB5" /><circle cx="126" cy="72" r="5" fill="#1A7AB5" /><circle cx="220" cy="78" r="5" fill="#1A7AB5" /><circle cx="326" cy="34" r="7" fill="#C47A2A" />
                <text x="34" y="114" text-anchor="middle" font-size="10" fill="#667784">Jun</text><text x="126" y="114" text-anchor="middle" font-size="10" fill="#667784">Jul</text><text x="220" y="114" text-anchor="middle" font-size="10" fill="#667784">Aug</text><text x="326" y="114" text-anchor="middle" font-size="10" fill="#667784">Sep</text>
              </svg>
              <div class="mt-3 flex items-center justify-between rounded-lg border border-v6-copper-200 bg-v6-copper-50 px-3 py-2"><div><p class="text-xs font-semibold text-v6-dark">Sep 4 snapshot</p><p class="text-[11px] text-v6-text-muted">34 deals with original stages, owners, amounts, and close dates</p></div><span class="text-xs font-semibold text-v6-copper-800">Reopen</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <ClientLogoStrip caption="HubSpot and revenue operations work trusted by teams at" />

    <ReportingDashboardValue
      dashboardName="historical pipeline dashboard"
      audienceIntro="This dashboard is for teams that need to preserve, reopen, and explain the exact pipeline evidence used in an earlier management cycle."
      audiences={[
        { role: "Revenue Operations", need: "Keep a dependable weekly or monthly archive and compare later results with the information available at each cutoff." },
        { role: "Finance and Business Operations", need: "Reopen the pipeline evidence behind a forecast, month-end close, or management statement without reconstructing it." },
        { role: "Sales leadership", need: "Use consistent historical trends and the underlying deals in forecast, QBR, and board conversations." },
      ]}
      workflowSteps={[
        { title: "Connect HubSpot", description: "Use a read-only connection to capture the pipeline data already maintained by the team." },
        { title: "Choose the snapshot", description: "Select the pipeline, weekly or monthly cadence, granularity, and exact cutoff time to preserve." },
        { title: "Create and reuse", description: "Generate the historical dashboard, inspect its Excel-ready rows, and select trends for PowerPoint." },
      ]}
      dashboardUse="Track saved pipeline value, deal count, stage mix, coverage, and period trends without replacing earlier cutoffs with current CRM values."
      spreadsheetUse="Open the deal rows behind any saved cutoff, filter the detail, and identify source records that need review in HubSpot."
      presentationUse="Choose the historical comparisons that matter for the forecast, QBR, or board update and apply an approved presentation template."
      storyExample="Pipeline coverage improved across three monthly snapshots, while negotiation value became more concentrated in four late-stage opportunities."
    />

    <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">A dated state you can reopen</p>
          <h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">What is a historical HubSpot pipeline dashboard?</h2>
          <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">A HubSpot pipeline snapshot is a fixed record of one pipeline at an exact cutoff. It preserves the deal count, value, stages, owners, amounts, and close dates that were available at that time.</p>
          <p class="mt-4 leading-relaxed text-v6-text-muted">A weekly pipeline snapshot repeats that record on your review cadence. Each saved state can later become the baseline for a period comparison without pretending that storage alone explains what changed.</p>
        </div>

        <div class="mx-auto mt-16 max-w-3xl border-t border-v6-border pt-16 text-center sm:mt-20 sm:pt-20">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">What this dashboard helps you do</p>
          <h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">Reopen the pipeline as it was then, not as it looks today.</h2>
          <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">Keep the exact date, scope, totals, and underlying deals together so the saved record can be checked later.</p>
        </div>
        <ReportBenefitCards benefits={benefits} />
      </div>
    </section>

    <section id="sample-report" class="scroll-mt-8 bg-v6-bg px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-3xl">
            <div class="flex flex-wrap items-center gap-3"><p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">Dashboard preview</p><span class="rounded-full border border-v6-copper-200 bg-v6-copper-50 px-2.5 py-1 text-xs font-semibold text-v6-copper-800">Example data</span></div>
            <h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">One historical dashboard, from the trend to the deal rows</h2>
            <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">The dashboard combines the historical trend, a selected frozen cutoff, and the exact deal rows preserved for that reporting period.</p>
          </div>
          <a href="#report-signup" data-ga-cta="a3_sample_signup" class="inline-flex min-h-11 items-center justify-center self-start rounded-xl border border-v6-copper px-5 py-3 text-sm font-semibold text-v6-copper transition-colors hover:bg-v6-copper-50 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2 lg:self-auto">Sign up to the app</a>
        </div>

        <div class="mt-10 overflow-hidden rounded-2xl border border-v6-border bg-white shadow-sm">
          <div class="flex flex-col gap-4 border-b border-v6-border px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-7">
            <div><p class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-text-muted">New Business Pipeline</p><h3 class="mt-1 text-xl font-bold text-v6-dark">Historical pipeline snapshot</h3><p class="mt-1 text-sm text-v6-text-muted">Cutoff: Friday Sep 4, 5:00 PM, portal timezone · Calculated 5:07 PM</p></div>
            <div class="flex items-center gap-2"><span class="rounded-full bg-v6-teal-50 px-3 py-1.5 text-xs font-semibold text-v6-teal-800">Snapshot frozen</span><span class="rounded-full bg-v6-blue-50 px-3 py-1.5 text-xs font-semibold text-v6-blue-800">Sample</span></div>
          </div>

          <nav class="flex gap-1 overflow-x-auto border-b border-v6-border bg-v6-bg px-5 py-3 text-sm" aria-label="Historical pipeline dashboard views"><span class="rounded-lg bg-white px-3 py-2 font-semibold text-v6-dark shadow-sm">Historical trend</span><span class="px-3 py-2 text-v6-text-muted">Snapshots</span><span class="px-3 py-2 text-v6-text-muted">Stage mix</span><span class="px-3 py-2 text-v6-text-muted">Saved deal rows</span></nav>

          <div class="grid gap-px bg-v6-border sm:grid-cols-2 lg:grid-cols-4">
            <div class="bg-white p-5 sm:p-6"><p class="text-sm text-v6-text-muted">Open pipeline</p><p class="mt-2 text-2xl font-bold text-v6-dark">$1,240,000</p></div>
            <div class="bg-white p-5 sm:p-6"><p class="text-sm text-v6-text-muted">Open deals</p><p class="mt-2 text-2xl font-bold text-v6-dark">34</p></div>
            <div class="bg-v6-copper-50 p-5 sm:p-6"><p class="text-sm text-v6-copper-800">Exact cutoff</p><p class="mt-2 text-xl font-bold text-v6-copper-800">Sep 4, 5 PM</p></div>
            <div class="bg-v6-teal-50 p-5 sm:p-6"><p class="text-sm text-v6-teal-800">Coverage</p><p class="mt-2 text-2xl font-bold text-v6-teal-800">Complete</p></div>
          </div>

          <div class="grid gap-8 p-5 sm:p-7 lg:grid-cols-[0.62fr_1.38fr]">
            <div>
              <div class="flex items-center justify-between"><h4 class="text-base font-bold text-v6-dark">Historical pipeline trend</h4><span class="text-xs font-semibold text-v6-blue-800">4 saved cutoffs</span></div>
              <svg viewBox="0 0 360 150" class="mt-4 h-36 w-full" role="img" aria-label="Pipeline value across June, July, August, and September snapshots">
                <path d="M22 118 H338" stroke="#E2DED7" stroke-width="1" />
                <path d="M22 78 H338" stroke="#E2DED7" stroke-width="1" stroke-dasharray="4 4" />
                <path d="M36 108 L132 84 L226 92 L324 42" fill="none" stroke="#1A7AB5" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="36" cy="108" r="6" fill="#1A7AB5" /><circle cx="132" cy="84" r="6" fill="#1A7AB5" /><circle cx="226" cy="92" r="6" fill="#1A7AB5" /><circle cx="324" cy="42" r="8" fill="#C47A2A" />
                <text x="36" y="140" text-anchor="middle" font-size="11" fill="#667784">Jun 5</text><text x="132" y="140" text-anchor="middle" font-size="11" fill="#667784">Jul 3</text><text x="226" y="140" text-anchor="middle" font-size="11" fill="#667784">Aug 7</text><text x="324" y="140" text-anchor="middle" font-size="11" fill="#667784">Sep 4</text>
              </svg>
              <div class="mt-4 grid grid-cols-2 gap-3"><div class="rounded-xl bg-v6-blue-50 p-4"><p class="text-xs text-v6-text-muted">Aug 7</p><p class="mt-1 text-lg font-bold text-v6-dark">USD 1.08m</p></div><div class="rounded-xl bg-v6-copper-50 p-4"><p class="text-xs text-v6-text-muted">Sep 4</p><p class="mt-1 text-lg font-bold text-v6-dark">USD 1.24m</p><p class="text-xs font-semibold text-v6-teal-800">+USD 160k</p></div></div>
              <p class="mt-5 rounded-xl bg-v6-bg-warm p-4 text-sm leading-relaxed text-v6-text-muted">Snapshot HS-2026-09-04-1700 preserves the scope and supporting rows. Later HubSpot edits do not rewrite it.</p>
            </div>

            <div>
              <div class="flex items-center justify-between gap-4"><h4 class="text-base font-bold text-v6-dark">Deals in this saved state</h4><span class="text-xs text-v6-text-muted">Example rows</span></div>
              <div class="mt-4 hidden overflow-x-auto rounded-xl border border-v6-border md:block">
                <table class="w-full min-w-[620px] border-collapse text-left text-sm">
                  <thead class="bg-v6-bg text-xs uppercase tracking-wide text-v6-text-muted"><tr><th class="px-4 py-3 font-semibold">Deal and owner</th><th class="px-4 py-3 font-semibold">Stage</th><th class="px-4 py-3 font-semibold">Close date</th><th class="px-4 py-3 text-right font-semibold">Amount</th></tr></thead>
                  <tbody class="divide-y divide-v6-border">
                    {snapshotRows.map((row) => (
                      <tr><td class="px-4 py-3"><p class="font-semibold text-v6-dark">{row.deal}</p><p class="mt-0.5 text-xs text-v6-text-muted">{row.owner}</p></td><td class="px-4 py-3 text-v6-text-muted">{row.stage}</td><td class="px-4 py-3 text-v6-text-muted">{row.closeDate}</td><td class="px-4 py-3 text-right font-semibold text-v6-dark">{row.amount}</td></tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <div class="mt-4 space-y-3 md:hidden">
                {snapshotRows.map((row) => (
                  <article class="rounded-xl border border-v6-border p-4"><div class="flex items-start justify-between gap-4"><div><h5 class="font-semibold text-v6-dark">{row.deal}</h5><p class="mt-0.5 text-xs text-v6-text-muted">Owner: {row.owner}</p></div><span class="text-sm font-bold text-v6-dark">{row.amount}</span></div><p class="mt-3 text-sm text-v6-text-muted">{row.stage} · closes {row.closeDate}</p></article>
                ))}
              </div>
              <div class="mt-5 rounded-xl border border-v6-copper-300 bg-v6-copper-50 p-4"><p class="font-semibold text-v6-dark">Compared with Aug 7</p><p class="mt-1 text-sm text-v6-text-muted">Pipeline increased by USD 160k. Late-stage value increased by USD 95k and is concentrated in four opportunities.</p></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <div class="mx-auto max-w-3xl text-center"><p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">Three-click setup</p><h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">The 3-click dashboard setup</h2><p class="mt-4 text-lg leading-relaxed text-v6-text-muted">Sign up, choose the pipeline, exact cutoff, and delivery cadence, then create the historical dashboard.</p></div>
        <ol class="mt-10 grid gap-6 md:grid-cols-3">
          <li class="rounded-2xl border border-v6-border bg-white p-6"><span class="text-sm font-bold text-v6-copper">01</span><h3 class="mt-3 text-xl font-bold text-v6-dark">Choose a pipeline</h3><p class="mt-2 leading-relaxed text-v6-text-muted">Select the sales pipeline you review. The report should not mix unrelated pipelines without saying so.</p></li>
          <li class="rounded-2xl border border-v6-border bg-white p-6"><span class="text-sm font-bold text-v6-copper">02</span><h3 class="mt-3 text-xl font-bold text-v6-dark">Choose the snapshot cutoff</h3><p class="mt-2 leading-relaxed text-v6-text-muted">Set the day and time in the portal timezone. The exact cutoff remains visible on the saved copy.</p></li>
          <li class="rounded-2xl border border-v6-border bg-white p-6"><span class="text-sm font-bold text-v6-copper">03</span><h3 class="mt-3 text-xl font-bold text-v6-dark">Choose the delivery time</h3><p class="mt-2 leading-relaxed text-v6-text-muted">Receive the dated snapshot before the review and reopen the same preserved state later.</p></li>
        </ol>
      </div>
    </section>

    <section class="bg-v6-bg px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">Native reporting and the proposed report</p>
          <h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">How HubSpot historical pipeline reporting compares with this snapshot test</h2>
          <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">HubSpot Sales Hub includes native historical and change reporting on eligible plans. SWOTBee adds a repeatable saved copy with an explicit cutoff, reusable detail, and management-ready outputs.</p>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          <article class="rounded-2xl border border-v6-border bg-white p-6 sm:p-8">
            <h3 class="text-xl font-bold text-v6-dark">What HubSpot can already report</h3>
            <ul class="mt-4 space-y-3 text-v6-text-muted">
              <li>Deal change history for stage, amount, close-date, and new-deal updates.</li>
              <li>Deal pipeline waterfall categories across a selected time period.</li>
              <li>Historical snapshots and recurring sales report or dashboard emails on eligible plans.</li>
            </ul>
          </article>
          <article class="rounded-2xl border border-v6-border bg-white p-6 sm:p-8">
