    .anim-card, .anim-emoji, .cta-pop, #scroll-progress { transition: none !important; }
  }
</style>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  // .anim is added synchronously by the inline head script (FOUC fix), gated on
  // reduced-motion. Here we only wire the observers.

  // --- Scroll reveals ---
  const revealEls = Array.from(document.querySelectorAll(".reveal, .stagger"));
  if (reduce) {
    revealEls.forEach((el) => el.classList.add("in"));
  } else {
    const inView = (el: Element) => {
      const r = el.getBoundingClientRect();
      return r.top < window.innerHeight * 0.9 && r.bottom > 0;
    };
    revealEls.forEach((el) => {
      if (inView(el)) el.classList.add("in");
    });
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("in");
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -8% 0px" },
    );
    revealEls.forEach((el) => {
      if (!el.classList.contains("in")) io.observe(el);
    });
  }

  // --- Smooth in-page anchor scrolling (reduced-motion aware) ---
  // Makes the "Watch the 2-minute demo" / "Estimate your leakage" CTAs glide to
  // their section instead of hard-jumping, reinforcing the guided path to the CTA.
  document.querySelectorAll('a[href^="#"]').forEach((a) => {
    a.addEventListener("click", (e) => {
      const id = (a as HTMLAnchorElement).getAttribute("href");
      if (!id || id === "#") return;
      const target = document.querySelector(id);
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({
        behavior: reduce ? "auto" : "smooth",
        block: "start",
      });
      history.replaceState(null, "", id);
    });
  });

  // --- Scroll progress bar ---
  const bar = document.getElementById("scroll-progress");
  if (bar && !reduce) {
    const onScroll = () => {
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      const p = max > 0 ? h.scrollTop / max : 0;
      bar.style.transform = `scaleX(${p})`;
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  } else if (bar) {
    bar.style.opacity = "0";
  }

  // --- Idle curiosity cue (one-shot per session) ---
  // If the visitor lingers in the hero without engaging, a curiosity bubble
  // points them at the ROI calculator. Fires once per
  // session, cancels the moment they interact, and never nags twice.
  const stakeCta = document.getElementById("stake-cta");
  if (stakeCta && !sessionStorage.getItem("stakeCueShown")) {
    const IDLE_MS = 6000;
    let timer = 0;
    let fired = false;

    const dismiss = () => stakeCta.classList.remove("cue");
    // Mouse movement is normal reading, so it does NOT reset the timer. Only
    // real engagement (scroll, CTA hover, click) cancels the pending cue.
    const cancel = () => { fired = true; clearTimeout(timer); timer = 0; };
    const fire = () => {
      if (fired) return;
      fired = true;
      sessionStorage.setItem("stakeCueShown", "1");
      stakeCta.classList.add("cue");
      window.setTimeout(dismiss, 9000);
    };

    window.addEventListener("scroll", () => {
      if (stakeCta.classList.contains("cue")) dismiss();
      else cancel();
    }, { passive: true });
    stakeCta.addEventListener("mouseenter", cancel);
    stakeCta.addEventListener("click", () => { cancel(); dismiss(); });

    const statsObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          statValues.forEach(countStat);
          observer.disconnect();
        });
      },
      { threshold: 0.5 },
    );
    statsObserver.observe(statValues[0].closest("section") || statValues[0]);
  }

  // GA4 video event taxonomy for the demo walkthrough (play, 50% watched, complete).
  {
    const demoVideo = document.getElementById("renewal-demo-video");
    if (demoVideo) {
      const gaEvent = (name, params) => {
        if (window.gtag) window.gtag("event", name, params || {});
      };
      let playFired = false;
      let halfFired = false;
      demoVideo.addEventListener("play", () => {
        if (!playFired) {
          playFired = true;
          gaEvent("video_play", { video_name: "renewal_demo" });
        }
      });
      demoVideo.addEventListener("timeupdate", () => {
        if (
          !halfFired &&
          demoVideo.duration &&
          demoVideo.currentTime / demoVideo.duration >= 0.5
        ) {
          halfFired = true;
          gaEvent("video_50", { video_name: "renewal_demo" });
        }
      });
      demoVideo.addEventListener("ended", () => {
        gaEvent("video_complete", { video_name: "renewal_demo" });
      });
    }
  }
</script>
