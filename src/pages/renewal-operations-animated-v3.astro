  /* ===== Reduced motion ===== */
  @media (prefers-reduced-motion: reduce) {
    .anim .reveal, .anim .stagger > * { opacity: 1 !important; transform: none !important; transition: none !important; }
    .bee-bob, .bee-wings, .bee-point, .bolt-pulse { animation: none !important; }
    #bee { transform: none !important; }
    /* Bubble still appears on the idle cue, just without the slide. */
