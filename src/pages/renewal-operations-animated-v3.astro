<style>
  /* ===== Motion is reserved for reading order and the renewal-system flow. ===== */
  .anim .reveal {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.35s ease-out,
      transform 0.35s ease-out;
  }
  .anim .reveal.in {
    opacity: 1;
    transform: none;
  }

  .anim .stagger > * {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.35s ease-out,
      transform 0.35s ease-out;
  }
  .anim .stagger.in > * {
    opacity: 1;
    transform: none;
  }
  h1.stagger.in > *:nth-child(2) { transition-delay: 0.06s; }
  h1.stagger.in > *:nth-child(3) { transition-delay: 0.12s; }
  h1.stagger.in > *:nth-child(4) { transition-delay: 0.18s; }
  .anim .flow-build > * {
    transform: translateY(8px);
  }
  .anim .flow-build.in > * {
    transform: none;
  }
  .anim .flow-build.in > *:nth-child(2) { transition-delay: 0.08s; }
  .anim .flow-build.in > *:nth-child(3) { transition-delay: 0.16s; }
  .anim .flow-build.in > *:nth-child(4) { transition-delay: 0.24s; }
  .anim .flow-build.in > *:nth-child(5) { transition-delay: 0.32s; }
  .anim .flow-build.in > *:nth-child(6) { transition-delay: 0.4s; }
  .anim .flow-build.in > *:nth-child(7) { transition-delay: 0.48s; }

  .anim-card { transition: transform 0.25s ease-out, box-shadow 0.25s ease-out; }
  .anim-card:hover { transform: translateY(-4px); }
  .anim-emoji { transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .anim-card:hover .anim-emoji { transform: translateY(-2px) scale(1.12) rotate(-4deg); }

  /* Capability card icons: a plain inline-block (not a fixed-size flex box like
     .anim-emoji elsewhere), so it must transform-scale from its own glyph
     center, not translate/rotate, or the hover motion visibly shifts it. */
  .cap-icon { display: inline-block; transform-origin: center; transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .anim-card:hover .cap-icon { transform: scale(1.22); }

  /* Curiosity speech bubble: hidden until the idle cue reveals it. */
  .stake-bubble { opacity: 0; transform: translate(-50%, 8px); transition: opacity 0.35s ease-out, transform 0.35s ease-out; pointer-events: none; }
  #stake-cta.cue .stake-bubble { opacity: 1; transform: translate(-50%, 0); }

  .bolt-pulse { animation: boltPulse 2.2s ease-in-out infinite; }
  @keyframes boltPulse { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.25); opacity: 0.65; } }

  /* ===== CTA hover/focus micro-reveal ===== */
  .cta-pop {
