---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/astro/Footer.astro";
import LogoHoneycomb from "../components/astro/LogoHoneycomb.astro";
import ClientLogoStrip from "../components/astro/ClientLogoStrip.astro";
import ReportSignup from "../components/astro/ReportSignup.astro";

// EARLY ACCESS page for an A1 report app that is not built yet.
// Keep the sample label visible until Sharmi validates the report definition and a
// prototype proves it against permitted HubSpot test data.
const title = "HubSpot Pipeline Change Report | Free Beta Signup";
const description = "Compare weekly or monthly HubSpot pipeline cutoffs and see which deals, stages, amounts, close dates, and owners caused the change.";

const movementRows = [
  { deal: "Briar Health expansion", owner: "Priya Shah", change: "Entered pipeline", before: "Not in pipeline", after: "Discovery", contribution: "+$145k", tone: "positive" },
  { deal: "Acme Platform renewal", owner: "Maya Chen", change: "Closed won", before: "Contract sent", after: "Closed won", contribution: "-$120k", tone: "neutral" },
  { deal: "Northstar expansion", owner: "Liam Ross", change: "Closed lost", before: "Decision", after: "Closed lost", contribution: "-$75k", tone: "negative" },
  { deal: "Quarry Systems rollout", owner: "Elena Park", change: "Amount reduced", before: "$90k", after: "$70k", contribution: "-$20k", tone: "negative" },
];

const faqs = [
  {
    q: "How do I report on pipeline changes over time in HubSpot?",
    a: "HubSpot provides Deal change history, Deal pipeline waterfall, historical snapshots, and scheduled live report emails on eligible plans. To explain weekly or month-to-month movement, compare dated cutoffs and trace the difference to deals that entered, left, changed stage, changed amount, or moved close date. The planned SWOTBee report brings that reconciliation into one review artifact.",
  },
  {
    q: "Is the pipeline change report available today?",
    a: "Not yet. This page shows an illustrative sample based on customer-panel research. We are validating the exact report with a HubSpot reporting specialist before building the app. Early-access users will be told clearly when a working test is ready.",
  },
  {
    q: "Will it edit our HubSpot records?",
    a: "The planned report is read-only and should not edit deal data. The exact permissions will be published before anyone connects a portal.",
  },
  {
    q: "Can HubSpot show what my pipeline looked like last week or last month?",
    a: "HubSpot can provide historical reporting and scheduled live reports depending on the subscription and report. The gap we are validating is a prepared snapshot-style comparison that keeps both dated cutoffs visible and names the deals and owners behind the change. The proposed setup allows any two valid cutoffs rather than only Monday to Monday.",
  },
  {
    q: "What does the beta signup cost?",
    a: "The beta signup is free and does not require a card. This website flow collects your work email but does not connect to your HubSpot account. Pricing for any later product has not been decided.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Layout
  title={title}
  description={description}
  keywords="hubspot pipeline change report, hubspot weekly pipeline report, hubspot monthly pipeline report, hubspot pipeline over time, hubspot deal change history"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <header class="border-b border-v6-border bg-white">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
      <a href="/" class="flex min-h-11 items-center gap-2 rounded-md focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2" aria-label="SWOTbee home">
        <LogoHoneycomb width={32} height={30} />
        <span class="text-lg font-bold text-v6-dark">SWOT<span class="text-v6-teal-700">bee</span></span>
      </a>
      <a href="#report-signup" data-ga-cta="a1_header_signup" class="inline-flex min-h-11 items-center justify-center rounded-lg border border-v6-copper px-4 py-2 text-sm font-semibold text-v6-copper transition-colors hover:bg-v6-copper-50 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">
        Sign up free
      </a>
    </div>
  </header>

  <main>
    <section class="overflow-hidden bg-gradient-to-b from-v6-bg to-white px-4 pb-16 pt-14 sm:px-6 sm:pb-20 sm:pt-20 lg:px-8">
      <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[0.92fr_1.08fr]">
        <div>
          <span class="mb-5 inline-flex rounded-full bg-v6-copper-50 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-v6-copper-700">Free beta, report preview</span>
          <h1 class="max-w-3xl text-balance text-4xl font-bold leading-[1.08] text-v6-dark sm:text-5xl lg:text-[3.45rem]">Weekly HubSpot Pipeline Change Report: See Which Deals Moved</h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-v6-text-muted">Compare two dated pipeline cutoffs and see the deals and owners behind changes in value, stage, amount, and close date. Walk into the next review with an explanation, not another live dashboard to investigate.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#sample-report" data-ga-cta="a1_hero_view_sample" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-v6-copper px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-v6-copper-600 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">View the sample report</a>
            <a href="#report-signup" data-ga-cta="a1_hero_signup" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-v6-border bg-white px-7 py-3.5 text-base font-semibold text-v6-dark transition-colors hover:border-v6-copper hover:bg-v6-copper-50 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">Sign up free to generate this report</a>
          </div>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-v6-text-muted">Free beta signup. No card required. We will ask for your work email before report setup. This website flow does not connect to HubSpot.</p>
        </div>

        <div class="relative" aria-label="Illustrative pipeline change report summary">
          <div class="absolute -inset-6 -z-10 rounded-full bg-v6-teal-100/70 blur-3xl"></div>
          <div class="overflow-hidden rounded-2xl border border-v6-border bg-white shadow-xl shadow-v6-dark/10">
            <div class="flex items-center justify-between border-b border-v6-border px-5 py-4">
              <div><p class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-copper">Illustrative sample</p><p class="mt-1 font-semibold text-v6-dark">New Business Pipeline</p></div>
              <span class="rounded-full bg-v6-teal-50 px-3 py-1 text-xs font-semibold text-v6-teal-800">Reconciled</span>
            </div>
            <div class="grid grid-cols-3 border-b border-v6-border">
              <div class="p-4 sm:p-5"><p class="text-xs text-v6-text-muted">Sep 1</p><p class="mt-1 text-lg font-bold text-v6-dark sm:text-xl">$1.24m</p></div>
              <div class="border-x border-v6-border bg-v6-copper-50 p-4 sm:p-5"><p class="text-xs text-v6-copper-800">Net change</p><p class="mt-1 text-lg font-bold text-v6-copper-800 sm:text-xl">-$68k</p></div>
              <div class="p-4 sm:p-5"><p class="text-xs text-v6-text-muted">Sep 8</p><p class="mt-1 text-lg font-bold text-v6-dark sm:text-xl">$1.17m</p></div>
            </div>
            <div class="space-y-3 p-5 text-sm">
              <div class="flex items-center justify-between gap-4"><span class="text-v6-text-muted">Entered pipeline</span><span class="font-semibold text-v6-teal-800">+$145k</span></div>
              <div class="flex items-center justify-between gap-4"><span class="text-v6-text-muted">Amount increases</span><span class="font-semibold text-v6-teal-800">+$40k</span></div>
              <div class="flex items-center justify-between gap-4"><span class="text-v6-text-muted">Won, lost, left, or reduced</span><span class="font-semibold text-v6-copper-800">-$253k</span></div>
              <div class="flex items-center justify-between gap-4 border-t border-v6-border pt-3"><span class="font-semibold text-v6-dark">Residual</span><span class="font-bold text-v6-teal-800">$0</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <ClientLogoStrip caption="HubSpot and revenue operations work trusted by teams at" />

    <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">Pipeline changes over time</p>
          <h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">What is a HubSpot pipeline change report?</h2>
          <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">A HubSpot pipeline change report compares your sales pipeline at two dated cutoffs. It shows how total pipeline value and the number of deals changed, then identifies which deals entered, left, changed stage, changed amount, or moved their close date.</p>
          <p class="mt-4 leading-relaxed text-v6-text-muted">Use the same comparison for a weekly review, a month-to-month pipeline check, or any two dates your team needs. The goal is not another live dashboard. It is a review-ready explanation of what changed and who owns the next action.</p>
        </div>

        <div class="mx-auto mt-16 max-w-3xl border-t border-v6-border pt-16 text-center sm:mt-20 sm:pt-20">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">The review problem</p>
          <h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">The number changed. The meeting still needs an explanation.</h2>
          <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">The current pipeline view tells you where things are now. A useful review starts with what changed between two real cutoffs and which deals caused it.</p>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          <article class="rounded-2xl border border-v6-border bg-white p-6"><span class="flex h-10 w-10 items-center justify-center rounded-full bg-v6-copper-50 text-sm font-bold text-v6-copper-800">1</span><h3 class="mt-4 text-xl font-bold text-v6-dark">The headline moved</h3><p class="mt-2 leading-relaxed text-v6-text-muted">Pipeline is down, but the total does not tell you whether deals were won, lost, pushed, reduced, or moved elsewhere.</p></article>
          <article class="rounded-2xl border border-v6-border bg-white p-6"><span class="flex h-10 w-10 items-center justify-center rounded-full bg-v6-copper-50 text-sm font-bold text-v6-copper-800">2</span><h3 class="mt-4 text-xl font-bold text-v6-dark">The live view moved on</h3><p class="mt-2 leading-relaxed text-v6-text-muted">By the time you investigate, owners have edited amounts, dates, and stages again. The earlier state is no longer visible beside today.</p></article>
          <article class="rounded-2xl border border-v6-border bg-white p-6"><span class="flex h-10 w-10 items-center justify-center rounded-full bg-v6-copper-50 text-sm font-bold text-v6-copper-800">3</span><h3 class="mt-4 text-xl font-bold text-v6-dark">Preparation becomes detective work</h3><p class="mt-2 leading-relaxed text-v6-text-muted">Leaders drill through charts and ask owners one by one instead of starting the review with a deal-level explanation.</p></article>
        </div>
      </div>
    </section>

    <section id="sample-report" class="scroll-mt-8 bg-v6-bg px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-3xl">
            <div class="flex flex-wrap items-center gap-3"><p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">Planned first screen</p><span class="rounded-full border border-v6-copper-200 bg-v6-copper-50 px-2.5 py-1 text-xs font-semibold text-v6-copper-800">Illustrative sample, not live data</span></div>
            <h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">One review artifact, from the movement to the deals</h2>
            <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">The final fields and calculations will be validated with Sharmi before the app is built. This sample shows the job the panel asked the report to complete.</p>
          </div>
          <a href="#report-signup" data-ga-cta="a1_sample_signup" class="inline-flex min-h-11 items-center justify-center self-start rounded-xl border border-v6-copper px-5 py-3 text-sm font-semibold text-v6-copper transition-colors hover:bg-v6-copper-50 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2 lg:self-auto">Sign up for this report</a>
        </div>

        <div class="mt-10 overflow-hidden rounded-2xl border border-v6-border bg-white shadow-sm">
          <div class="flex flex-col gap-4 border-b border-v6-border px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-7">
            <div><p class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-text-muted">New Business Pipeline</p><h3 class="mt-1 text-xl font-bold text-v6-dark">Weekly pipeline change</h3><p class="mt-1 text-sm text-v6-text-muted">Sep 1, 5:00 PM to Sep 8, 5:00 PM, portal timezone</p></div>
            <div class="flex items-center gap-2"><span class="rounded-full bg-v6-teal-50 px-3 py-1.5 text-xs font-semibold text-v6-teal-800">Value reconciled</span><span class="rounded-full bg-v6-blue-50 px-3 py-1.5 text-xs font-semibold text-v6-blue-800">Sample</span></div>
          </div>

          <div class="grid gap-px bg-v6-border sm:grid-cols-2 lg:grid-cols-4">
            <div class="bg-white p-5 sm:p-6"><p class="text-sm text-v6-text-muted">Open pipeline at start</p><p class="mt-2 text-2xl font-bold text-v6-dark">$1,240,000</p></div>
            <div class="bg-white p-5 sm:p-6"><p class="text-sm text-v6-text-muted">Open pipeline at end</p><p class="mt-2 text-2xl font-bold text-v6-dark">$1,172,000</p></div>
            <div class="bg-v6-copper-50 p-5 sm:p-6"><p class="text-sm text-v6-copper-800">Net movement</p><p class="mt-2 text-2xl font-bold text-v6-copper-800">-$68,000</p></div>
            <div class="bg-v6-teal-50 p-5 sm:p-6"><p class="text-sm text-v6-teal-800">Unexplained residual</p><p class="mt-2 text-2xl font-bold text-v6-teal-800">$0</p></div>
          </div>

          <div class="grid gap-8 p-5 sm:p-7 lg:grid-cols-[0.7fr_1.3fr]">
            <div>
              <h4 class="text-base font-bold text-v6-dark">What changed the value</h4>
              <div class="mt-5 space-y-4">
                <div><div class="flex justify-between gap-3 text-sm"><span class="text-v6-text-muted">Entered pipeline</span><span class="font-semibold text-v6-teal-800">+$145k</span></div><div class="mt-2 h-2 rounded-full bg-v6-bg"><div class="h-full w-[70%] rounded-full bg-v6-teal"></div></div></div>
                <div><div class="flex justify-between gap-3 text-sm"><span class="text-v6-text-muted">Amount increases</span><span class="font-semibold text-v6-teal-800">+$40k</span></div><div class="mt-2 h-2 rounded-full bg-v6-bg"><div class="h-full w-[22%] rounded-full bg-v6-teal"></div></div></div>
                <div><div class="flex justify-between gap-3 text-sm"><span class="text-v6-text-muted">Won</span><span class="font-semibold text-v6-text">-$120k</span></div><div class="mt-2 h-2 rounded-full bg-v6-bg"><div class="h-full w-[58%] rounded-full bg-v6-blue-400"></div></div></div>
                <div><div class="flex justify-between gap-3 text-sm"><span class="text-v6-text-muted">Lost, left, or reduced</span><span class="font-semibold text-v6-copper-800">-$133k</span></div><div class="mt-2 h-2 rounded-full bg-v6-bg"><div class="h-full w-[64%] rounded-full bg-v6-copper"></div></div></div>
              </div>
              <p class="mt-5 rounded-xl bg-v6-bg-warm p-4 text-sm leading-relaxed text-v6-text-muted">Stage and close-date changes appear as review flags. They affect the value reconciliation only when a deal also enters, leaves, closes, or changes amount.</p>
            </div>

            <div>
              <div class="flex items-center justify-between gap-4"><h4 class="text-base font-bold text-v6-dark">Deals behind the movement</h4><span class="text-xs text-v6-text-muted">Sorted by review priority</span></div>
              <div class="mt-4 hidden overflow-x-auto rounded-xl border border-v6-border md:block">
                <table class="w-full min-w-[680px] border-collapse text-left text-sm">
                  <thead class="bg-v6-bg text-xs uppercase tracking-wide text-v6-text-muted"><tr><th class="px-4 py-3 font-semibold">Deal and owner</th><th class="px-4 py-3 font-semibold">Change</th><th class="px-4 py-3 font-semibold">Before</th><th class="px-4 py-3 font-semibold">After</th><th class="px-4 py-3 text-right font-semibold">Value effect</th></tr></thead>
                  <tbody class="divide-y divide-v6-border">
                    {movementRows.map((row) => (
                      <tr><td class="px-4 py-3"><p class="font-semibold text-v6-dark">{row.deal}</p><p class="mt-0.5 text-xs text-v6-text-muted">{row.owner}</p></td><td class="px-4 py-3 text-v6-text-muted">{row.change}</td><td class="px-4 py-3 text-v6-text-muted">{row.before}</td><td class="px-4 py-3 text-v6-dark">{row.after}</td><td class:list={["px-4 py-3 text-right font-semibold", row.tone === "positive" && "text-v6-teal-800", row.tone === "negative" && "text-v6-copper-800", row.tone === "neutral" && "text-v6-text"]}>{row.contribution}</td></tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <div class="mt-4 space-y-3 md:hidden">
                {movementRows.map((row) => (
                  <article class="rounded-xl border border-v6-border p-4"><div class="flex items-start justify-between gap-4"><div><h5 class="font-semibold text-v6-dark">{row.deal}</h5><p class="mt-0.5 text-xs text-v6-text-muted">Owner: {row.owner}</p></div><span class:list={["text-sm font-bold", row.tone === "positive" && "text-v6-teal-800", row.tone === "negative" && "text-v6-copper-800", row.tone === "neutral" && "text-v6-text"]}>{row.contribution}</span></div><p class="mt-3 text-sm font-semibold text-v6-text">{row.change}</p><p class="mt-1 text-sm text-v6-text-muted">{row.before} to {row.after}</p></article>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <div class="mx-auto max-w-3xl text-center"><p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">Planned app setup</p><h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">Three choices when report setup becomes available</h2><p class="mt-4 text-lg leading-relaxed text-v6-text-muted">The website signup below does not connect to HubSpot. In the planned app, the setup is one pipeline and two visible cutoffs.</p></div>
        <ol class="mt-10 grid gap-6 md:grid-cols-3">
          <li class="rounded-2xl border border-v6-border bg-white p-6"><span class="text-sm font-bold text-v6-copper">01</span><h3 class="mt-3 text-xl font-bold text-v6-dark">Choose a pipeline</h3><p class="mt-2 leading-relaxed text-v6-text-muted">Select the sales pipeline you review. The report should not mix unrelated pipelines without saying so.</p></li>
          <li class="rounded-2xl border border-v6-border bg-white p-6"><span class="text-sm font-bold text-v6-copper">02</span><h3 class="mt-3 text-xl font-bold text-v6-dark">Choose the earlier cutoff</h3><p class="mt-2 leading-relaxed text-v6-text-muted">Pick the state you want to compare from, with its date, time, and portal timezone visible.</p></li>
          <li class="rounded-2xl border border-v6-border bg-white p-6"><span class="text-sm font-bold text-v6-copper">03</span><h3 class="mt-3 text-xl font-bold text-v6-dark">Choose the later cutoff</h3><p class="mt-2 leading-relaxed text-v6-text-muted">Create the report for the next review, then inspect the named deals behind the net movement.</p></li>
        </ol>
      </div>
    </section>

    <section class="bg-v6-dark px-4 py-16 text-white sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-2 lg:items-center">
        <div><p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper-300">A complement to native reporting</p><h2 class="mt-3 text-balance text-3xl font-bold sm:text-4xl">HubSpot has the data. The planned value is the completed review artifact.</h2></div>
        <div class="space-y-4 text-white/75"><p class="leading-relaxed">HubSpot already offers deal change history, pipeline waterfall reports, historical snapshots, and recurring report emails on eligible plans.</p><p class="leading-relaxed">The question we are validating is narrower: can one automatically prepared, dated report make the movement easier to explain by placing the before and after values, reconciliation, named deals, and owners together?</p></div>
      </div>
    </section>

    <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-3xl">
        <div class="text-center"><p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">Questions before you sign up</p><h2 class="mt-3 text-3xl font-bold text-v6-dark sm:text-4xl">What is decided, and what is still being validated</h2></div>
        <div class="mt-10 divide-y divide-v6-border border-y border-v6-border">
          {faqs.map((item) => (
            <details class="group py-5"><summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-5 rounded-md font-semibold text-v6-dark focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2"><span>{item.q}</span><span class="text-xl font-normal text-v6-copper transition-transform group-open:rotate-45" aria-hidden="true">+</span></summary><p class="max-w-2xl pb-1 pr-8 pt-3 leading-relaxed text-v6-text-muted">{item.a}</p></details>
          ))}
        </div>
      </div>
    </section>

    <section id="report-signup" class="scroll-mt-8 bg-v6-bg px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-3xl rounded-3xl bg-v6-copper px-6 py-10 text-center text-white shadow-lg shadow-v6-copper/20 sm:px-10 sm:py-12">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-white/75">Free beta signup</p>
        <h2 class="mt-3 text-balance text-3xl font-bold sm:text-4xl">Create your free pipeline change report</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-white/85">Enter your work email to begin report setup. No card is required, and this website step does not connect to HubSpot.</p>
        <ReportSignup offerCode="a1_pipeline_change" reportName="HubSpot pipeline change report" sourcePage="hubspot-pipeline-change-report" ctaLabel="a1_report_signup" />
        <p class="mt-5 text-sm text-white/75">Your email is used for this report request and related service communication.</p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
