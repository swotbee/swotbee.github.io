---
import BaseLayout from "../../layouts/BaseLayout.astro";
import character from "../../../public/assets/illustrations/renewals/character-reference.json";
const assetRoot = "/assets/illustrations/renewals";
const poses = [
  { file: "renewal-results", title: "Check with confidence", detail: "Renewal accuracy: calendar, pencil and approved deal cards." },
  { file: "quote-effort", title: "Make work easier", detail: "Less effort: operate the quote mechanism and organize the output." },
  { file: "response-speed", title: "Keep things moving", detail: "Faster response: carry the approved quote beside a stopwatch." },
  { file: "first-results", title: "Show steady progress", detail: "First results: complete milestones on the implementation board." },
];
const coreColors = ["outline", "hair", "skin", "shirt", "blue", "orange"] as const;
---
<BaseLayout title="Nia character reference" description="A working character reference for consistent SWOTbee illustrations." robots="noindex, follow">
  <div class="character-guide">
    <header class="guide-top"><a href="/#customer-results">← View homepage illustrations</a><a href={`${assetRoot}/character-reference.json`} download>Download character specification</a></header>
    <section class="guide-hero">
      <div><p class="eyebrow">WORKING CHARACTER REFERENCE</p><h1>Meet {character.workingName}.</h1><p class="role">{character.role}.</p><p class="intro">A familiar, capable guide who makes complex work feel manageable. Keep her identity consistent while giving each story its own action and props.</p><p class="name-note">Nia is a provisional working name. It can change without changing the character.</p><div class="traits">{character.personality.map(trait => <span>{trait}</span>)}</div></div>
      <aside class="portrait"><img src={`${assetRoot}/nia-portrait-reference.svg`} width="330" height="340" alt="Character reference: a woman with curly dark hair, gold hoop earrings and a mint collared shirt." /><div class="portrait-links"><a href={`${assetRoot}/nia-portrait-reference.svg`} download>Download SVG portrait</a><a href={`${assetRoot}/nia-portrait-reference.png`} download>Download PNG reference</a></div></aside>
    </section>
    <section class="guide-section identity-grid"><div><p class="eyebrow">01 / KEEP HER RECOGNIZABLE</p><h2>One identity across many stories.</h2><ul>{character.identity.map(item => <li>{item}</li>)}</ul></div><div class="note-card"><h3>How she shows up</h3><p>{character.expression}</p><blockquote>“{character.voiceExample}”</blockquote><p>Use attentive gestures, practical action and small moments of satisfaction. The emotion should follow the scene.</p></div></section>
    <section class="guide-section"><p class="eyebrow">02 / APPROVED SCENE REFERENCES</p><h2>Same person. A different action each time.</h2><p class="section-copy">Use these scenes to check her face, hair, proportions, clothing and line treatment. Start a new illustration from the references closest to your intended pose.</p><div class="pose-grid">{poses.map(pose => <article class="pose-card"><img src={`${assetRoot}/${pose.file}-clean-v3.svg`} width="1122" height="1402" alt={pose.detail} loading="lazy" decoding="async" /><h3>{pose.title}</h3><p>{pose.detail}</p><a href={`${assetRoot}/${pose.file}-clean-v3.svg`} download>Download scene SVG →</a></article>)}</div></section>
    <section class="guide-section identity-grid"><div><p class="eyebrow">03 / DRAWING RULES</p><h2>Clean lines. Intentional color.</h2><ul>{character.drawingRules.map(rule => <li>{rule}</li>)}</ul></div><div><h3>Core artwork colors</h3><div class="core-palette">{coreColors.map(key => <div><span class="color-chip" style={`background:${character.palette[key]}`}></span><strong>{key}</strong><code>{character.palette[key]}</code></div>)}</div><details><summary>See the complete material palette</summary><div class="full-palette">{Object.entries(character.palette).map(([key,value]) => <div><span class="mini-chip" style={`background:${value}`}></span><span>{key}</span><code>{value}</code></div>)}</div></details><p class="small">These are illustration material colors. Website controls continue to use the shared site palette.</p></div></section>
    <section class="guide-section"><p class="eyebrow">04 / CREATE THE NEXT SCENE</p><h2>Describe the story before the drawing.</h2><div class="brief-fields">{Object.entries(character.sceneBrief).map(([key,value]) => <div><h3>{key}</h3><p>{value}</p></div>)}</div><label for="character-prompt">Reusable character and scene brief</label><p class="small">Replace the bracketed fields below. Attach the portrait and one full scene when sharing this brief.</p><textarea id="character-prompt" rows="12">{character.prompt}</textarea><div class="copy-row"><button type="button" id="copy-character-prompt" hidden>Copy scene brief</button><p id="copy-character-status" role="status" aria-live="polite">Text stays in this browser tab. Nothing is submitted.</p></div><ol class="workflow">{character.workflow.map(item => <li>{item}</li>)}</ol><p class="boundary-note">{character.limitation}</p></section>
    <div class="guide-bottom"><p>Character reference for consistent website illustrations.</p><a href="/#customer-results">Review the illustrations in context →</a></div>
  </div>
</BaseLayout>
<style>
  .character-guide{max-width:1240px;margin:auto;padding:0 28px 56px;color:var(--color-ink-900);background:white}.guide-top{display:flex;justify-content:space-between;gap:20px;padding:28px 0;border-bottom:1px solid var(--color-ink-200);font-size:14px}.character-guide a{color:var(--color-v6-blue);text-decoration:underline;text-underline-offset:4px;font-weight:600}.guide-hero{display:grid;grid-template-columns:1.25fr 1fr;gap:64px;align-items:center;padding:64px 0}.eyebrow{font-size:12px;letter-spacing:.12em;font-weight:700;color:var(--color-aqua-700);margin:0 0 14px}.guide-hero h1{font-size:clamp(46px,6vw,76px);line-height:1.04;letter-spacing:-.035em;margin:0 0 18px}.role{font-size:26px;line-height:1.25;margin-bottom:20px}.intro,.section-copy{font-size:18px;color:var(--color-ink-600);line-height:1.7;max-width:740px}.name-note,.small{font-size:13px;color:var(--color-ink-600);line-height:1.6;margin-top:14px}.traits{display:flex;gap:8px;flex-wrap:wrap;margin-top:24px}.traits span{padding:7px 12px;border-radius:30px;background:var(--color-aqua-50);color:var(--color-aqua-800);font-size:13px;font-weight:600}.portrait{padding:24px 24px 18px;border:1px solid var(--color-ink-200);border-radius:24px;background:var(--color-aqua-50)}.portrait img{width:100%;height:360px;object-fit:contain}.portrait-links{display:flex;gap:16px;flex-wrap:wrap;font-size:13px;border-top:1px solid var(--color-aqua-200);padding-top:16px}.guide-section{padding:48px 0;border-top:1px solid var(--color-ink-200)}h2{font-size:clamp(28px,3vw,38px);line-height:1.15;letter-spacing:-.02em;margin:0 0 24px}h3{font-size:20px;line-height:1.25;margin:0 0 12px}.identity-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px}ul{list-style:disc;padding-left:20px}li{margin-bottom:14px;line-height:1.65}.note-card{padding:28px;border-radius:18px;background:var(--color-aqua-50);border:1px solid var(--color-aqua-200)}.note-card p{line-height:1.7}.note-card blockquote{font-size:23px;font-weight:600;color:var(--color-aqua-800);padding:22px 0;margin:16px 0}.pose-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin-top:32px}.pose-card{padding:24px;border:1px solid var(--color-ink-200);border-radius:18px}.pose-card img{display:block;width:100%;height:350px;object-fit:contain;margin-bottom:24px}.pose-card p{font-size:15px;line-height:1.6;color:var(--color-ink-600);margin-bottom:16px}.pose-card a{font-size:14px}.core-palette{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.core-palette>div{display:grid;gap:4px;font-size:13px}.color-chip{height:58px;border-radius:8px;border:1px solid #00000010}.core-palette code,.full-palette code{font-size:12px;color:var(--color-ink-600)}details{margin-top:24px;border-top:1px solid var(--color-ink-200);padding-top:12px}summary{cursor:pointer;min-height:44px;font-size:14px;font-weight:600;display:flex;align-items:center;color:var(--color-v6-blue)}.full-palette{display:grid;gap:10px;padding:12px 0}.full-palette>div{display:grid;grid-template-columns:20px 1fr auto;gap:10px;align-items:center;font-size:13px}.mini-chip{width:18px;height:18px;border:1px solid #00000018;border-radius:4px}.brief-fields{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:20px;margin:28px 0}.brief-fields h3{text-transform:capitalize;font-size:17px}.brief-fields p{font-size:14px;line-height:1.6;color:var(--color-ink-600)}label{display:block;font-weight:700;margin-top:32px}textarea{display:block;width:100%;padding:20px;border:1px solid var(--color-v6-blue);border-radius:12px;font-family:inherit;font-size:16px;line-height:1.65;color:var(--color-ink-900);background:white;margin-top:16px;resize:vertical}.copy-row{display:flex;align-items:center;gap:18px;margin:18px 0 30px;flex-wrap:wrap}.copy-row button{min-height:48px;padding:12px 22px;border-radius:8px;color:white;background:var(--color-aqua-700);font-weight:700;cursor:pointer}.copy-row button:hover{background:var(--color-aqua-800)}.copy-row button[hidden]{display:none}.copy-row p{font-size:13px;color:var(--color-ink-600)}.workflow{list-style:decimal;padding-left:24px;max-width:850px}.boundary-note{font-size:14px;line-height:1.6;color:var(--color-ink-600);border-left:3px solid var(--color-aqua-400);padding-left:18px;margin-top:26px}.guide-bottom{display:flex;justify-content:space-between;gap:24px;border-top:1px solid var(--color-ink-200);padding-top:28px;font-size:14px;color:var(--color-ink-600)}a:focus-visible,summary:focus-visible,button:focus-visible,textarea:focus-visible{outline:3px solid var(--color-v6-blue);outline-offset:4px}
  @media(max-width:800px){.guide-hero,.identity-grid{grid-template-columns:1fr;gap:28px}.guide-hero{padding:42px 0}.brief-fields{grid-template-columns:repeat(2,minmax(0,1fr))}.guide-bottom{flex-direction:column}.portrait img{height:320px}.guide-section{padding:36px 0}}
  @media(max-width:500px){.character-guide{padding-inline:18px}.guide-top{flex-direction:column;gap:12px}.pose-grid{grid-template-columns:1fr}.pose-card img{height:300px}.pose-card,.note-card{padding:20px}.brief-fields{grid-template-columns:1fr 1fr;gap:16px}.core-palette{gap:12px}.guide-hero h1{font-size:48px}}
</style>
<script>
  const button=document.querySelector<HTMLButtonElement>('#copy-character-prompt');
  const textarea=document.querySelector<HTMLTextAreaElement>('#character-prompt');
  const status=document.querySelector<HTMLElement>('#copy-character-status');
  if(button&&textarea&&status){button.hidden=false;button.addEventListener('click',async()=>{try{if(navigator.clipboard?.writeText){await navigator.clipboard.writeText(textarea.value);}else{textarea.focus();textarea.select();if(!document.execCommand('copy'))throw new Error('Manual copy needed');}status.textContent='Scene brief copied. Attach the portrait and a full scene when you share it.';}catch{textarea.focus();textarea.select();status.textContent='Copy was unavailable. The brief is selected; copy it manually using your keyboard or browser menu.';}});}
</script>
