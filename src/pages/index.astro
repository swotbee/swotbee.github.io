// Hard metrics from approved case studies / testimonials.
const stats = [
  { value: "98%", label: "lift in renewal accuracy", tone: "text-v6-teal" },
  { value: "90%", label: "less quote-creation effort", tone: "text-v6-copper" },
  // blue-300, not blue: the band sits on bg-v6-dark, where the base blue lands at
  // 2.9:1 and fails WCAG AA. blue-300 is 5.0:1 on the same background.
  {
    value: "65%",
    label: "faster quote response time",
    tone: "text-v6-blue-300",
  },
  { value: "2 wks", label: "to first results", tone: "text-v6-amber" },
];

// TESTIMONIALS
const testimonials = [
  {
    quote:
      "Siva quickly grasped our complex workflows and immediately began identifying optimization opportunities. What sets him apart is how he functions as a true extension of our team, handling both technical implementation and strategic guidance.",
