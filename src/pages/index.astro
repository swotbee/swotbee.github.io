// CASE STUDY (anonymous).
const caseStudy = {
  industry: "Energy & Utilities",
  size: "80+ employees",
  tier: "HubSpot Enterprise",
  before: [
    "Inside sales, equipment, and multi-fuel divisions in separate pipelines with no cross-visibility",
    "Multi-line renewals handled manually and error-prone",
    "Slow, inconsistent custom quoting",
  ],
  after: [
    "Unified pipelines across every division",
    "Automated multi-line renewal workflows that read usage data to recommend plans",
    "Quote templates that cut creation effort dramatically",
  ],
  results: [
    "Renewal accuracy up 98%",
    "Quote creation time down 90%",
    "Team shifted from admin to growth",
  ],
};

// FAQ (approved answers).
const faqs = [
  {
    q: "What is Renewal Builder?",
