      "The right contract context is captured from day one",
    ],
  },
  {
    icon: ArrowPathIcon,
    title: "Renewal Created",
    color: "bg-v6-copper-50 text-v6-copper",
    points: [
      "The next renewal deal creates itself",
      "The right line items and timing carry forward",
    ],
  },
  {
    icon: Cog6ToothIcon,
    title: "Rules Applied",
    color: "bg-v6-copper-50 text-v6-copper",
    points: [
      "Escalations, approvals, and notice periods run consistently",
      "Customer-specific renewal rules are applied automatically",
    ],
  },
  {
    icon: ArrowTrendingUpIcon,
    title: "Risks & Growth Surfaced",
    color: "bg-v6-copper-50 text-v6-copper",
    points: [
      "At-risk and ownerless accounts are visible before the window closes",
      "Expansion candidates surface while there is time to act",
    ],
  },
  {
    icon: CalculatorIcon,
    title: "Confident Forecast",
    color: "bg-v6-copper-50 text-v6-copper",
    completesFlow: true,
    points: [
      "Renewal and expansion revenue are separated",
      "ARR, NRR, and GRR dashboards support a forecast you can trust",
    ],
  },
];

// Hard metrics from approved case studies / testimonials.
const stats = [
  { value: "98%", label: "lift in renewal accuracy", tone: "text-v6-teal" },
  { value: "90%", label: "less quote-creation effort", tone: "text-v6-copper" },
  // blue-300, not blue: the band sits on bg-v6-dark, where the base blue lands at
  // 2.9:1 and fails WCAG AA. blue-300 is 5.0:1 on the same background.
  {
    value: "65%",
    label: "faster quote response time",
    tone: "text-v6-blue-300",
  },
  { value: "2 wks", label: "to first results", tone: "text-v6-amber" },
];

// TESTIMONIALS
const testimonials = [
  {
    quote:
      "Siva quickly grasped our complex workflows and immediately began identifying optimization opportunities. What sets him apart is how he functions as a true extension of our team, handling both technical implementation and strategic guidance.",
    name: "Samantha Ross",
    initials: "RO",
    context: "Postgrad",
    image: "/assets/testimonials/profile1.webp",
  },
  {
    quote:
      "Sharmi helped our team do the foundational work that launched our ABM strategy. She took unstructured goals and, by applying her customer-focused insight and technical know-how, turned them into specific solutions that optimized our entire enrichment project in HubSpot.",
    name: "Shreyas Mecheri",
    initials: "MO",
    context: "Jirav",
    image: "/assets/testimonials/profile2.jpg",
  },
];

// CASE STUDY (anonymous).
const caseStudy = {
  industry: "Energy & Utilities",
  size: "80+ employees",
  tier: "HubSpot Enterprise",
  before: [
    "Inside sales, equipment, and multi-fuel divisions in separate pipelines with no cross-visibility",
    "Multi-line renewals handled manually and error-prone",
    "Slow, inconsistent custom quoting",
  ],
  after: [
    "Unified pipelines across every division",
    "Automated multi-line renewal workflows that read usage data to recommend plans",
    "Quote templates that cut creation effort dramatically",
  ],
  results: [
    "Renewal accuracy up 98%",
    "Quote creation time down 90%",
    "Team shifted from admin to growth",
  ],
};

// FAQ (approved answers).
const faqs = [
  {
    q: "How much does this cost?",
    a: "Every business is different, so we tailor our approach to your needs and goals. We offer project-based, retainer, and hourly consulting models. Book a free 30-minute discovery call and we'll give you an honest recommendation.",
  },
  {
    q: "How long does a typical project take?",
    a: "Most engagements span 3 to 6 months depending on complexity. We start delivering results in the first 2 weeks with quick wins, then build toward the bigger goals.",
  },
  {
    q: "What does the first month look like?",
    a: "Week 1 to 2: discovery and audit, where we map your workflows, data, and pain points. Week 3 to 4: quick wins go live, the high-impact fixes that show immediate results. From there we build toward the strategic roadmap.",
  },
  {
    q: "Do you work alongside our existing team?",
    a: "Absolutely. We work as an extension of your team, building the automations, dashboards, and processes your people need. We provide hands-on training and documentation so your team owns everything we build, long after our engagement ends.",
  },
  {
    q: "What HubSpot tiers do you work with?",
    a: "All of them: Starter, Professional, and Enterprise across Sales, Marketing, and Service Hubs. Most of our clients are on Professional or Enterprise.",
  },
  {
    q: "Can you integrate HubSpot with our other tools?",
    a: "Yes. We've integrated HubSpot with NetSuite, Xero, DocuSign, Zoom, Monday.com, Shopify, Salesforce, Zapier, custom APIs, and more.",
  },
  {
    q: "What if we already built our own renewal workflows?",
    a: "Great! We build on top of what you've created. Our job is to add the parts DIY cannot reach: multi-year chains that survive HubSpot's renewal loops, automatic escalation math, and NRR/GRR analytics. You keep using your workflows; we layer on reliability and analytics. You own everything we build.",
  },
];

// Hero headline split into words for staggered reveal.
const headlineWords = ["Stop", "Losing", "Revenue", "To"];

const toneMap: Record<string, string> = {
  copper: "bg-v6-copper-50 text-v6-copper",
  teal: "bg-v6-teal-50 text-v6-teal",
  blue: "bg-v6-blue-50 text-v6-blue",
  // amber-800, not amber: base amber on amber-50 is 2.4:1 and fails WCAG AA.
  amber: "bg-v6-amber-50 text-v6-amber-800",
};
---

{
  /* No robots override: this is the homepage and must be indexable. It carried
    robots="noindex, follow" for its whole life as /renewal-operations-animated-v3/, which
    is what kept it out of the index and made it a clean measurement surface. Removing that
    line IS the swap. */
}
<Layout title={title} description={description}>
  <StructuredData
    type="service"
    data={{
      name: "Renewal Operations for HubSpot",
      description: description,
      serviceType: "Renewal Operations & Revenue Automation Consulting",
      url: pageUrl,
    }}
  />
  <!-- The page's own FAQ block, exposed for FAQ rich results. Same source array as
       the rendered accordion, so the two can never drift apart. -->
  <StructuredData type="faq" data={{ faqs }} />
  {
    /* A breadcrumb that starts at Home is meaningless when this page IS Home,
       so it is emitted only when the page sits at a sub-path. */
    !isHomepage && (
      <StructuredData
        type="breadcrumb"
        data={{
          breadcrumbs: [
            { name: "Home", url: "https://swotbee.com" },
            { name: "Renewal Operations", url: pageUrl },
          ],
        }}
      />
    )
  }

  <!-- Motion gate: add .anim synchronously BEFORE first paint so scroll-reveal
       elements start hidden and never flash visible-then-hidden (FOUC fix).
       No-JS users never get .anim, so they see all content normally. -->
  <script is:inline>
    (function () {
      try {
        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document.documentElement.classList.add("anim");
        }
      } catch (e) {}
    })();
  </script>

  <!-- Scroll progress bar -->
  <div
    id="scroll-progress"
    class="fixed top-0 left-0 right-0 h-1 z-50 origin-left bg-v6-copper"
    aria-hidden="true"
  >
  </div>

  <Navbar />

  <!-- ============ HERO ============ -->
  <!-- id is load-bearing: the LCP guard in the stylesheet targets #hero to keep
       above-the-fold content painted at first paint. See ".anim #hero" below. -->
  <section
    id="hero"
    class="relative overflow-hidden bg-gradient-to-b from-v6-bg to-white px-4 sm:px-6 lg:px-8 pt-16 sm:pt-20 pb-12 sm:pb-16"
  >
    <div
      class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-10 lg:gap-12 items-center relative"
    >
      <!-- Left: copy -->
      <div class="text-center lg:text-left">
        <!-- Partner status is a confirmed, checkable fact and the strongest
             above-the-fold trust signal this page has. It is deliberately ON. -->
        <div
          class="reveal flex flex-wrap justify-center lg:justify-start gap-3 mb-6"
        >
          <span
            class="bg-v6-teal-50 text-v6-teal text-xs font-semibold px-3 py-1 rounded-full"
            >HubSpot Solutions Partner</span
          >
          <span
            class="bg-v6-copper-50 text-v6-copper text-xs font-semibold px-3 py-1 rounded-full"
            >Renewal Operations</span
          >
        </div>
        <p
          class="reveal text-sm font-semibold tracking-[0.1em] text-v6-copper mb-3"
        >
          For RevOps Teams Drowning In Renewal Admin
        </p>
        <h1
          class="stagger text-3xl sm:text-5xl lg:text-[3.75rem] font-bold text-v6-dark leading-tight mb-5 text-balance"
        >
          {
            headlineWords.map((w) => (
              <>
                <span class="inline-block">{w}</span>{" "}
              </>
            ))
          }
          <span class="inline-block text-v6-copper">Missed Renewals</span>
        </h1>
        <p
          class="reveal text-base sm:text-lg text-v6-text-muted max-w-xl mx-auto lg:mx-0 mb-5 leading-relaxed"
        >
          Your next growth bottleneck is not pipeline generation. It is
          everything that happens after Closed Won.
        </p>
        <p
          class="reveal text-base sm:text-lg text-v6-text-muted max-w-xl mx-auto lg:mx-0 mb-4 leading-relaxed"
        >
          Renewal deals that create themselves, line items carried over exactly,
          escalations applied, and ARR you can finally trust.
        </p>

        <div
          class="reveal flex flex-col sm:flex-row gap-3 justify-center lg:justify-start mt-8 mb-4 items-center"
        >
          <div class="cta-group relative inline-block">
            <!-- CTA points at the on-page YouTube demo section. -->
            <a
              href="#demo"
              class="bg-v6-copper text-white px-8 py-3.5 rounded-xl text-base font-semibold hover:bg-v6-copper-600 transition-colors text-center inline-flex items-center gap-2"
            >
              Watch The 2-Minute Demo
            </a>
            <div
              class="cta-pop absolute bottom-full left-1/2 mb-3 w-60 -translate-x-1/2 rounded-xl bg-v6-dark px-4 py-3 text-left shadow-xl"
            >
              <p class="text-sm font-semibold text-white mb-1">
                See it working, first
              </p>
              <p class="text-sm leading-relaxed text-gray-300">
                A short walkthrough of renewal deals creating themselves inside
                HubSpot, line items intact.
              </p>
              <span
                class="absolute top-full left-1/2 -translate-x-1/2 -mt-px border-x-8 border-t-8 border-x-transparent border-t-v6-dark"
              ></span>
            </div>
          </div>
          <div class="relative inline-block">
            <a
              href="#roi"
              class="border border-gray-300 text-v6-dark px-8 py-3.5 rounded-xl text-base font-medium hover:bg-gray-50 transition-colors text-center inline-flex items-center gap-2"
            >
              Estimate Your Renewal Leakage <ArrowDownIcon aria-hidden="true" className="h-4 w-4" />
            </a>
          </div>
        </div>
      </div>

      <!-- Right: Renewal Command Center dashboard mock (show, don't tell) -->
      <div class="reveal hero-dashboard">
        <div
          class="rounded-2xl border border-v6-border bg-white shadow-xl overflow-hidden"
        >
          <div
            class="flex items-center gap-2 px-4 py-3 border-b border-v6-border bg-v6-bg"
          >
            <span class="w-2.5 h-2.5 rounded-full bg-v6-copper/60"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-v6-amber/60"></span>
            <span class="live-dot w-2.5 h-2.5 rounded-full bg-v6-teal"></span>
            <span class="ml-2 text-xs font-semibold text-v6-text-muted"
              >Renewal Command Center</span
            >
            <span
              class="ml-auto text-[10px] font-semibold uppercase tracking-wider text-v6-teal"
              >Live</span
            >
          </div>
          <div class="p-5">
            <div class="grid grid-cols-3 gap-3 mb-5">
              <div class="hero-metric rounded-lg bg-v6-copper-50 p-3">
                <p
                  class="text-[10px] uppercase tracking-wider text-v6-copper font-semibold"
                >
                  At Risk
                </p>
                <p class="text-xl font-bold text-v6-dark">$1.2M</p>
              </div>
              <div class="hero-metric rounded-lg bg-v6-teal-50 p-3">
                <p
                  class="text-[10px] uppercase tracking-wider text-v6-teal font-semibold"
                >
                  Expansion
                </p>
                <p class="text-xl font-bold text-v6-dark">$840K</p>
              </div>
              <div class="hero-metric rounded-lg bg-v6-blue-50 p-3">
                <p
                  class="text-[10px] uppercase tracking-wider text-v6-blue font-semibold"
                >
                  Due 30d
                </p>
                <p class="text-xl font-bold text-v6-dark">37</p>
              </div>
            </div>
            <div class="space-y-2">
              {
                cockpit.map((row) => (
                  <div class="flex items-center justify-between rounded-lg border border-v6-border px-3 py-2.5">
                    <div class="min-w-0">
                      <p class="text-sm font-semibold text-v6-dark truncate">
                        {row.account}
                      </p>
                      <p class="text-xs text-v6-text-muted truncate">
                        {row.detail}
                      </p>
                    </div>
                    <span
                      class={`text-[11px] font-semibold px-2.5 py-1 rounded-full whitespace-nowrap ${toneMap[row.tone]}`}
                    >
                      {row.status}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
        <!-- Audience line moved into the hero microcopy; caption keeps the honesty note. -->
        <p class="text-center text-xs text-v6-text-muted mt-3">
          Illustrative. Your live HubSpot data, surfaced the moment it matters.
        </p>
      </div>
    </div>
  </section>
  <section>
    <div class="max-w-6xl mx-auto text-center mt-8 sm:mt-12">
      <p
        class="reveal text-base text-v6-text-muted mx-auto lg:mx-0 mb-3 leading-relaxed"
      >
        Built for Energy, MSP, Manufacturing, Construction, and SaaS teams managing
        hundreds to thousands of renewals a year.
      </p>
      <!-- <p class="reveal text-base text-gray-500 leading-relaxed">
          No commitment, no sales pitch. No long-term contracts, ever. We earn
          your trust month by month.
        </p> -->
    </div>
  </section>

  <!-- ============ TRUST BAR ============ -->
  <section class="mt-6 sm:mt-8 bg-v6-bg border-y border-v6-border py-6 px-4">
    <div class="max-w-5xl mx-auto">
      <!-- The 5 approved client logos, same set the service-page template uses.
           Explicit width/height so the row reserves its space before the images
           decode (no layout shift). -->
      <div
        class="reveal flex flex-wrap justify-center items-center gap-x-8 gap-y-3 pt-3"
      >
        <span class="text-xs text-gray-600 font-medium uppercase tracking-wider"
          >Works with</span
        >
        {
          integrations.map((t) => (
            <span class="flex items-center gap-1.5">
              <img
                src={t.img}
                alt={t.name}
                width="120"
                height="32"
                class="flex-none h-8 w-auto max-w-[120px] object-contain grayscale opacity-70 hover:grayscale-0 hover:opacity-100 transition"
                loading="lazy"
                decoding="async"
              />
              {t.label && (
                <span class="text-sm font-semibold text-v6-text-muted">
                  {t.label}
                </span>
              )}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ DEMO VIDEO ============ -->
  <section
    id="demo"
    class="scroll-mt-24 bg-white px-4 sm:px-6 lg:px-8 pt-14 sm:pt-16 pb-12 sm:pb-14"
  >
    <div class="max-w-4xl mx-auto text-center">
      <p
        class="reveal text-sm font-semibold uppercase tracking-[0.2em] text-v6-copper mb-3"
      >
        See It In Action
      </p>
      <h2
        class="reveal text-2xl sm:text-3xl lg:text-4xl font-bold text-v6-dark mb-3 text-balance"
      >
        From Missed Renewals to a Command Center: Watch every renewal fall into
        place.
      </h2>
      <p
