---
// renewal-operations-animated-v3.astro
// Tier-1 sales-asset-audit revision of renewal-operations-animated-v2.astro.
// Copy source: marketing/content/page-copy/renewal-v2-page-revised.md
// (gap audit grounded in 545 corroborated real-world records; SSR/persona
//  comparison data stays internal and is not quoted publicly).
// Changes vs v2:
//  - Hero: benefit-led H1, subhead names the four corroborated USPs (line items
//    carried over, escalations automatic, ARR you can trust, HubSpot-native),
//    demo-first CTA pair, quiet stack-fit microcopy (QuickBooks/Xero/Sage/NetSuite)
//  - New "The Math" section: MIT Sloan 12 to 25% CRM data cost stat + the three
//    named leaks (re-keyed line items, missed escalations, ownerless accounts),
//    bridging pain to the ROI calculator
//  - New "Keep What Works" section answering the top corroborated objection
//    "we already built our own" (year-3 loop failure, escalation math, NRR/GRR)
//  - Capabilities: cards 2/3 headlines simplified; card 5 reframed as
//    "ARR You Can Trust" with explicit NRR/GRR analytics
//  - Stat band callout names the verticals; ROI intro absorbs the pressure-test
//    line; audit checklist reframed around leakage with a dual CTA (audit + demo)
//  - FAQ: new "already built our own workflows" Q&A
// Unproven client numbers ({{N}}/{{X}} in the source doc) stay OFF the page
// pending the WellStat case study; only sourced stats are used.
// All motion stays gated behind prefers-reduced-motion. v1 and v2 left untouched.
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/astro/Navbar.astro";
import Footer from "../components/astro/Footer.astro";
import StructuredData from "../components/astro/StructuredData.astro";
import RenewalServicePaths from "../components/astro/RenewalServicePaths.astro";
import RenewalDemoModal from "../components/react/RenewalDemoModal.jsx";
import {
  AdjustmentsHorizontalIcon,
  ArrowDownIcon,
  ArrowPathIcon,
  ArrowRightIcon,
  ArrowTrendingUpIcon,
  BellAlertIcon,
  CalculatorIcon,
  ChartBarIcon,
  CheckIcon,
  ClipboardDocumentListIcon,
  Cog6ToothIcon,
  CommandLineIcon,
  DocumentTextIcon,
  UserMinusIcon,
} from "@heroicons/react/24/outline";

// SERP budget: BaseLayout appends " | SWOTBee" to every title, so the string below
// must stay under ~50 chars to keep the rendered title inside Google's ~60-char cut.
// Description stays under ~155 for the same reason.
const title = "HubSpot Renewal Management App";
const description =
  "Renewal Builder turns closed-won HubSpot deals into review-ready renewals with the right pipeline, dates, line items, and associations.";
const keywords =
  "HubSpot renewal management, HubSpot renewal automation, renewal deal builder, automate renewal deals in HubSpot";

// Schema URLs are derived from the page's own URL rather than hardcoded, so they stay
// correct if this page is ever moved or promoted to a different path (e.g. the homepage).
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? "https://swotbee.com")
  .href;
const isHomepage = Astro.url.pathname === "/";

// Real client logos (greyscale). Files live in public/assets/customerLogos/.
const clientLogos = [
  { name: "Wesco", src: "/assets/customerLogos/WescologoDefence.png" },
  { name: "Big Lots", src: "/assets/customerLogos/BigLotsEcommerce.png" },
  { name: "Insteon", src: "/assets/customerLogos/Insteon.svg" },
  { name: "La Vie", src: "/assets/customerLogos/lavie.webp" },
  { name: "Mytheresa", src: "/assets/customerLogos/MytheresaEcommerce.png" },
];

// Tools we connect renewals across. Local SVGs in public/assets/integrationLogos/.
// NetSuite ships only as an icon mark, so it carries a text label to match the
// visual weight of the wordmark logos.
const integrations = [
  { name: "HubSpot", img: "/assets/integrationLogos/hubspot.svg" },
  {
    name: "NetSuite",
    img: "/assets/integrationLogos/netsuite.svg",
    label: "NetSuite",
