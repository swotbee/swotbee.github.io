  <Footer />

  <!-- <style> and <script> live INSIDE <Layout>. Outside it they render after the
       layout has already closed </body></html>, which emits stray markup past the
       document end. Keep them here. -->
  <style>
    /* ===== Motion is reserved for reading order and the renewal-system flow. ===== */
    .anim .reveal {
      opacity: 0;
      transform: translateY(12px);
      transition:
        opacity 0.35s ease-out,
        transform 0.35s ease-out;
    }
    .anim .reveal.in {
      opacity: 1;
      transform: none;
    }

    .anim .stagger > * {
      opacity: 0;
      transform: translateY(10px);
      transition:
        opacity 0.35s ease-out,
        transform 0.35s ease-out;
    }
    .anim .stagger.in > * {
      opacity: 1;
      transform: none;
    }

    /* ===== LCP guard =====
     The hero is above the fold and its H1 is the LCP element. Fading it in from
     opacity 0 means the browser cannot record LCP until the reveal script has
     parsed, run, and added .in, which pushes LCP out by the whole script-execution
     window for no design benefit. Hero content therefore animates on transform
     only: it is painted at first paint and still slides into place. Everything
     below the fold keeps the opacity fade, where it costs nothing. */
    .anim #hero .reveal,
    .anim #hero .stagger > * {
      opacity: 1;
    }
    h1.stagger.in > *:nth-child(2) {
      transition-delay: 0.06s;
    }
    h1.stagger.in > *:nth-child(3) {
      transition-delay: 0.12s;
    }
    h1.stagger.in > *:nth-child(4) {
      transition-delay: 0.18s;
    }
    .anim .flow-build > * {
      transform: translateY(8px);
    }
    .anim .flow-build.in > * {
      transform: none;
    }
    .anim .flow-build.in > *:nth-child(2) {
      transition-delay: 0.08s;
    }
    .anim .flow-build.in > *:nth-child(3) {
      transition-delay: 0.16s;
    }
    .anim .flow-build.in > *:nth-child(4) {
      transition-delay: 0.24s;
    }
    .anim .flow-build.in > *:nth-child(5) {
      transition-delay: 0.32s;
    }
    .anim .flow-build.in > *:nth-child(6) {
      transition-delay: 0.4s;
    }
    .anim .flow-build.in > *:nth-child(7) {
      transition-delay: 0.48s;
    }

    .anim-card {
      transition:
        transform 0.25s ease-out,
        box-shadow 0.25s ease-out;
    }
    .anim-card:hover {
      transform: translateY(-4px);
    }
    .anim-emoji {
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .anim-card:hover .anim-emoji {
      transform: translateY(-2px) scale(1.12) rotate(-4deg);
    }

    /* Capability card icons: a plain inline-block (not a fixed-size flex box like
     .anim-emoji elsewhere), so it must transform-scale from its own glyph
     center, not translate/rotate, or the hover motion visibly shifts it. */
    .cap-icon {
      display: inline-block;
      transform-origin: center;
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .anim-card:hover .cap-icon {
      transform: scale(1.22);
    }

    .bolt-pulse {
      animation: boltPulse 2.2s ease-in-out infinite;
    }
    @keyframes boltPulse {
      0%,
      100% {
        transform: scale(1);
        opacity: 1;
      }
      50% {
        transform: scale(1.25);
        opacity: 0.65;
      }
    }

    /* ===== CTA hover/focus micro-reveal ===== */
    .cta-pop {
      opacity: 0;
      transform: translate(-50%, 6px);
      transition:
        opacity 0.25s ease-out,
        transform 0.25s ease-out;
      pointer-events: none;
    }
    .cta-group:hover .cta-pop,
    .cta-group:focus-within .cta-pop {
      opacity: 1;
      transform: translate(-50%, 0);
    }

    /* ===== Scroll progress bar ===== */
    #scroll-progress {
      transform: scaleX(0);
      transition: transform 0.1s linear;
    }

    /* ===== FAQ ===== */
    details summary::-webkit-details-marker {
      display: none;
    }

    /* ===== Reduced motion ===== */
    @media (prefers-reduced-motion: reduce) {
      .anim .reveal,
      .anim .stagger > * {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
      .bee-bob,
      .bee-wings,
      .bee-point,
      .bolt-pulse {
        animation: none !important;
      }
      #bee {
        transform: none !important;
      }
      .anim-card,
      .anim-emoji,
      .cta-pop,
      #scroll-progress {
        transition: none !important;
      }
    }
  </style>

  <script>
    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    // .anim is added synchronously by the inline head script (FOUC fix), gated on
    // reduced-motion. Here we only wire the observers.

    // --- Scroll reveals ---
    const revealEls = Array.from(
      document.querySelectorAll(".reveal, .stagger"),
    );
    if (reduce) {
      revealEls.forEach((el) => el.classList.add("in"));
    } else {
      const inView = (el: Element) => {
        const r = el.getBoundingClientRect();
        return r.top < window.innerHeight * 0.9 && r.bottom > 0;
      };
      revealEls.forEach((el) => {
        if (inView(el)) el.classList.add("in");
      });
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("in");
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: "0px 0px -8% 0px" },
      );
      revealEls.forEach((el) => {
        if (!el.classList.contains("in")) io.observe(el);
      });
    }

    // --- Smooth in-page anchor scrolling (reduced-motion aware) ---
    // Makes the "Watch the 2-minute demo" / "Estimate your leakage" CTAs glide to
    // their section instead of hard-jumping, reinforcing the guided path to the CTA.
    document.querySelectorAll('a[href^="#"]').forEach((a) => {
      a.addEventListener("click", (e) => {
        const id = (a as HTMLAnchorElement).getAttribute("href");
        if (!id || id === "#") return;
        const target = document.querySelector(id);
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({
          behavior: reduce ? "auto" : "smooth",
          block: "start",
        });
        history.replaceState(null, "", id);
      });
    });

    // --- Scroll progress bar ---
    const bar = document.getElementById("scroll-progress");
    if (bar && !reduce) {
      const onScroll = () => {
        const h = document.documentElement;
        const max = h.scrollHeight - h.clientHeight;
        const p = max > 0 ? h.scrollTop / max : 0;
        bar.style.transform = `scaleX(${p})`;
      };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    } else if (bar) {
      bar.style.opacity = "0";
    }

    // --- Stat band count-up ---
    // Each .stat-value renders its real value server-side and repeats it in
    // data-stat-value, so crawlers, screen readers and no-JS visitors always read the
    // true figure. We only parse the leading number and re-attach whatever suffix it
    // had, which lets a non-numeric value ("2 wks") animate the digits and keep its
    // unit. Anything that does not parse is simply left alone.
    const parseStat = (el: HTMLElement) => {
      const raw = (el.dataset.statValue ?? el.textContent ?? "").trim();
      const match = raw.match(/^(\D*?)(\d+(?:\.\d+)?)(.*)$/);
      if (!match) return null;
      const [, prefix, numText, suffix] = match;
      return {
        raw,
        prefix,
        suffix,
        target: parseFloat(numText),
        decimals: (numText.split(".")[1] || "").length,
      };
    };

    const statEls = Array.from(
      document.querySelectorAll<HTMLElement>(".stat-value"),
    );

    // Reduced motion keeps the server-rendered numbers exactly as they are.
    if (statEls.length && !reduce) {
      const statsRoot = statEls[0].closest("section") ?? statEls[0];
      const parsed = statEls
        .map((el) => {
          const p = parseStat(el);
          return p ? { el, ...p } : null;
        })
        .filter((s): s is NonNullable<typeof s> => s !== null);

      const DURATION = 900;
      const start = performance.now();
      const tick = (now: number) => {
        const p = Math.min((now - start) / DURATION, 1);
        // easeOutCubic: quick climb, gentle settle, so the final figure is readable
        const eased = 1 - Math.pow(1 - p, 3);
        parsed.forEach((s) => {
          s.el.textContent =
            p < 1
              ? s.prefix + (s.target * eased).toFixed(s.decimals) + s.suffix
              : s.raw; // restore the exact source string, never a rounded rebuild
        });
        if (p < 1) requestAnimationFrame(tick);
      };

      // rootMargin starts the run a screen early, while the band is still behind the
      // stagger fade. That matters for more than smoothness: the real figures stay in
      // the DOM until the instant the animation begins and are written back the frame
      // it ends, so a crawler, screenshot or reader that never scrolls here can never
      // capture a zeroed "0%" in place of the actual claim.
      const statsObserver = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            observer.disconnect();
            requestAnimationFrame(tick);
          });
        },
        { rootMargin: "100% 0px 0px 0px" },
      );
      statsObserver.observe(statsRoot);
    }
  </script>
</Layout>
