// AGITATION: renewal leakage modes and the operational pains they create.
const pains = [
  {
    title: "Re-keyed line items",
    desc: "Rebuilding one renewal deal by hand means re-keying every line item, recalculating uplifts, and resetting dates.",
    icon: CommandLineIcon,
    color: "text-v6-copper",
    bg: "bg-v6-copper-50",
  },
  {
    title: "Missed escalation clauses",
    desc: "Escalation clauses that never make it into the renewal are pure margin left unbilled, quarter after quarter.",
    icon: DocumentTextIcon,
    color: "text-v6-amber",
    bg: "bg-v6-amber-50",
  },
  {
    title: "Ownerless accounts",
    desc: "Accounts nobody owns don't get renewed in time. That is revenue lost to churn, quietly.",
    icon: UserMinusIcon,
    color: "text-v6-teal",
    bg: "bg-v6-teal-50",
  },
  {
    title: "Sales Reps Stuck In Admin",
    desc: "Sales reps spend precious selling time on data entry, rebuilding deals, and chasing down renewal details.",
    icon: ClipboardDocumentListIcon,
    color: "text-v6-copper",
    bg: "bg-v6-copper-50",
  },
  {
    title: "Last-Minute Fire Drills",
    desc: "Renewal risks surface too late, turning preventable work into urgent escalation.",
    icon: BellAlertIcon,
    color: "text-v6-amber",
    bg: "bg-v6-amber-50",
  },
  {
    title: "Workflows That Quietly Break",
    desc: "DIY automation looks fine—until renewal loops, exceptions, or contract changes cause it to fail without warning.",
    icon: ArrowPathIcon,
    color: "text-v6-teal",
    bg: "bg-v6-teal-50",
  },
  {
    title: "Frantic Forecasts",
    desc: "Forecasts that go out of sync even as you present them because deal data is outdated and no one has a clear picture of upcoming renewals, expansion opportunities, and contract changes.",
    icon: ChartBarIcon,
    color: "text-v6-copper",
    bg: "bg-v6-copper-50",
  },
  {
    title: "Rules Trapped In People's Heads",
    desc: "Every rep follows different rules for discounts, escalations, approvals, or notice periods because the rules that matter never made it into the system.",
    icon: AdjustmentsHorizontalIcon,
    color: "text-v6-amber",
    bg: "bg-v6-amber-50",
  },
];

// HOW WE WORK: 3 numbered steps (from the approved "first month" FAQ).
const steps = [
  {
    n: "1",
    title: "Discovery & Audit",
    when: "Week 1 to 2",
    desc: "We map your workflows, data, and business rules, then show you exactly where renewal revenue is leaking today.",
  },
  {
    n: "2",
