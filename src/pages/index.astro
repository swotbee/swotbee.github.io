const toneMap: Record<string, string> = {
  copper: "bg-v6-copper-50 text-v6-copper",
  teal: "bg-v6-teal-50 text-v6-teal",
  blue: "bg-v6-blue-50 text-v6-blue",
  // amber-800, not amber: base amber on amber-50 is 2.4:1 and fails WCAG AA.
  amber: "bg-v6-amber-50 text-v6-amber-800",
