---

{
  /* No robots override: this is the homepage and must be indexable. It carried
    robots="noindex, follow" for its whole life as /renewal-operations-animated-v3/, which
    is what kept it out of the index and made it a clean measurement surface. Removing that
    line IS the swap. */
}
<Layout title={title} description={description} keywords={keywords}>
  <StructuredData
    type="softwareApplication"
    data={{
      name: "Renewal Builder",
      description: description,
      url: pageUrl,
      applicationCategory: "BusinessApplication",
      applicationSubCategory: "Customer renewal management",
      operatingSystem: "Web",
      browserRequirements: "Requires a supported web browser and a HubSpot account",
      featureList: [
        "Create renewal deals from HubSpot deal records",
        "Carry configured deal properties, line items, and associations forward",
        "Preview renewal recipes before activation",
        "Support manual and automated renewal creation",
      ],
    }}
  />
  <!-- The page's own FAQ block, exposed for FAQ rich results. Same source array as
       the rendered accordion, so the two can never drift apart. -->
  <StructuredData type="faq" data={{ faqs }} />
  {
    /* A breadcrumb that starts at Home is meaningless when this page IS Home,
       so it is emitted only when the page sits at a sub-path. */
    !isHomepage && (
      <StructuredData
        type="breadcrumb"
        data={{
          breadcrumbs: [
            { name: "Home", url: "https://swotbee.com" },
            { name: "Renewal Operations", url: pageUrl },
          ],
        }}
      />
    )
  }

  <!-- Motion gate: add .anim synchronously BEFORE first paint so scroll-reveal
       elements start hidden and never flash visible-then-hidden (FOUC fix).
       No-JS users never get .anim, so they see all content normally. -->
  <script is:inline>
    (function () {
      try {
        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document.documentElement.classList.add("anim");
        }
      } catch (e) {}
    })();
  </script>

  <!-- Scroll progress bar -->
  <div
    id="scroll-progress"
    class="fixed top-0 left-0 right-0 h-1 z-50 origin-left bg-v6-copper"
    aria-hidden="true"
  >
  </div>

  <Navbar />

  <!-- ============ HERO ============ -->
  <!-- id is load-bearing: the LCP guard in the stylesheet targets #hero to keep
       above-the-fold content painted at first paint. See ".anim #hero" below. -->
  <section
    id="hero"
    class="relative overflow-hidden bg-gradient-to-b from-v6-bg to-white px-4 sm:px-6 lg:px-8 pt-16 sm:pt-20 pb-12 sm:pb-16"
  >
    <div
      class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-10 lg:gap-12 items-center relative"
    >
      <!-- Left: copy -->
      <div class="text-center lg:text-left">
        <!-- Partner status is a confirmed, checkable fact and the strongest
             above-the-fold trust signal this page has. It is deliberately ON. -->
        <div
          class="reveal flex flex-wrap justify-center lg:justify-start gap-3 mb-6"
        >
          <span
            class="bg-v6-teal-50 text-v6-teal text-xs font-semibold px-3 py-1 rounded-full"
            >HubSpot Solutions Partner</span
          >
          <span
            class="bg-v6-copper-50 text-v6-copper text-xs font-semibold px-3 py-1 rounded-full"
            >Renewal Builder for HubSpot</span
          >
        </div>
        <p
          class="reveal text-sm font-semibold tracking-[0.1em] text-v6-copper mb-3"
        >
          HubSpot renewal management, built around your deals
        </p>
        <h1
          class="stagger text-3xl sm:text-5xl lg:text-[3.75rem] font-bold text-v6-dark leading-tight mb-5 text-balance"
        >
          Build every renewal from the deal your team already trusts.
        </h1>
        <p
          class="reveal text-base sm:text-lg text-v6-text-muted max-w-xl mx-auto lg:mx-0 mb-5 leading-relaxed"
        >
          Renewal Builder is a HubSpot app that turns closed-won deals into
          review-ready renewals in your chosen pipeline.
        </p>
        <p
          class="reveal text-base sm:text-lg text-v6-text-muted max-w-xl mx-auto lg:mx-0 mb-4 leading-relaxed"
        >
          Carry forward the configured dates, line items, companies, contacts,
          and ownership. Start manually, preview the result, and automate only
          when your recipe is ready.
        </p>

        <div
          class="reveal flex flex-col sm:flex-row gap-3 justify-center lg:justify-start mt-8 mb-4 items-center"
        >
          <div class="relative inline-block">
            <a
              href="/renewal-audit-call/"
              data-ga-cta="renewal_hero_book_alignment"
              class="bg-v6-copper text-white px-8 py-3.5 rounded-xl text-base font-semibold hover:bg-v6-copper-600 transition-colors text-center inline-flex items-center gap-2"
            >
              Book an alignment call with our founders <ArrowRightIcon aria-hidden="true" className="h-4 w-4" />
            </a>
          </div>
          <div class="relative inline-block">
            <a
              href="#demo"
              data-renewal-demo-trigger
              aria-haspopup="dialog"
              aria-controls="renewal-demo-modal"
              class="border border-gray-300 text-v6-dark px-8 py-3.5 rounded-xl text-base font-medium hover:bg-gray-50 transition-colors text-center inline-flex items-center gap-2"
            >
              Watch the 2-minute demo
            </a>
          </div>
        </div>
        <p class="reveal text-sm text-v6-text-muted">
          Assisted installation today. No automation is activated without your review.
        </p>
      </div>

      <!-- Right: Renewal Command Center dashboard mock (show, don't tell) -->
      <div class="reveal hero-dashboard">
        <div
          class="rounded-2xl border border-v6-border bg-white shadow-xl overflow-hidden"
        >
          <div
            class="flex items-center gap-2 px-4 py-3 border-b border-v6-border bg-v6-bg"
          >
            <span class="w-2.5 h-2.5 rounded-full bg-v6-copper/60"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-v6-amber/60"></span>
            <span class="live-dot w-2.5 h-2.5 rounded-full bg-v6-teal"></span>
            <span class="ml-2 text-xs font-semibold text-v6-text-muted"
              >Renewal Command Center</span
            >
            <span
              class="ml-auto text-[10px] font-semibold uppercase tracking-wider text-v6-teal"
              >Live</span
            >
          </div>
          <div class="p-5">
            <div class="grid grid-cols-3 gap-3 mb-5">
              <div class="hero-metric rounded-lg bg-v6-copper-50 p-3">
                <p
                  class="text-[10px] uppercase tracking-wider text-v6-copper font-semibold"
                >
                  At Risk
                </p>
                <p class="text-xl font-bold text-v6-dark">$1.2M</p>
              </div>
              <div class="hero-metric rounded-lg bg-v6-teal-50 p-3">
                <p
                  class="text-[10px] uppercase tracking-wider text-v6-teal font-semibold"
                >
                  Expansion
                </p>
                <p class="text-xl font-bold text-v6-dark">$840K</p>
              </div>
              <div class="hero-metric rounded-lg bg-v6-blue-50 p-3">
                <p
                  class="text-[10px] uppercase tracking-wider text-v6-blue font-semibold"
                >
                  Due 30d
                </p>
                <p class="text-xl font-bold text-v6-dark">37</p>
              </div>
            </div>
            <div class="space-y-2">
              {
                cockpit.map((row) => (
                  <div class="flex items-center justify-between rounded-lg border border-v6-border px-3 py-2.5">
                    <div class="min-w-0">
                      <p class="text-sm font-semibold text-v6-dark truncate">
                        {row.account}
                      </p>
                      <p class="text-xs text-v6-text-muted truncate">
                        {row.detail}
                      </p>
                    </div>
                    <span
                      class={`text-[11px] font-semibold px-2.5 py-1 rounded-full whitespace-nowrap ${toneMap[row.tone]}`}
                    >
                      {row.status}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
        <!-- Audience line moved into the hero microcopy; caption keeps the honesty note. -->
        <p class="text-center text-xs text-v6-text-muted mt-3">
          Illustrative. Your live HubSpot data, surfaced the moment it matters.
        </p>
      </div>
    </div>
  </section>
  <section>
    <div class="max-w-6xl mx-auto text-center mt-8 sm:mt-12">
      <p
        class="reveal text-base text-v6-text-muted mx-auto lg:mx-0 mb-3 leading-relaxed"
      >
        Built for Energy, MSP, Manufacturing, Construction, and SaaS teams managing
        hundreds to thousands of renewals a year.
      </p>
      <!-- <p class="reveal text-base text-gray-500 leading-relaxed">
          No commitment, no sales pitch. No long-term contracts, ever. We earn
          your trust month by month.
        </p> -->
    </div>
  </section>

  <!-- ============ TRUST BAR ============ -->
  <section class="mt-6 sm:mt-8 bg-v6-bg border-y border-v6-border py-6 px-4">
    <div class="max-w-5xl mx-auto">
      <!-- The 5 approved client logos, same set the service-page template uses.
           Explicit width/height so the row reserves its space before the images
           decode (no layout shift). -->
      <div
        class="reveal flex flex-wrap justify-center items-center gap-x-8 gap-y-3 pt-3"
      >
        <span class="text-xs text-gray-600 font-medium uppercase tracking-wider"
          >Works with</span
        >
        {
          integrations.map((t) => (
            <span class="flex items-center gap-1.5">
              <img
                src={t.img}
                alt={t.name}
                width="120"
                height="32"
                class="flex-none h-8 w-auto max-w-[120px] object-contain grayscale opacity-70 hover:grayscale-0 hover:opacity-100 transition"
                loading="lazy"
                decoding="async"
              />
              {t.label && (
                <span class="text-sm font-semibold text-v6-text-muted">
                  {t.label}
                </span>
              )}
            </span>
          ))
        }
