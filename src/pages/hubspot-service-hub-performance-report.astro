---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/astro/Footer.astro";
import LogoHoneycomb from "../components/astro/LogoHoneycomb.astro";
import ClientLogoStrip from "../components/astro/ClientLogoStrip.astro";
import ReportSignup from "../components/astro/ReportSignup.astro";
import ReportBenefitCards from "../components/astro/ReportBenefitCards.astro";
import ReportRelatedLinks from "../components/astro/ReportRelatedLinks.astro";

const title = "Recurring HubSpot Service Hub Analytics Report";
const description = "Turn HubSpot Service Hub analytics into a weekly or monthly performance report with ticket snapshots, editable Excel output, and PowerPoint preparation.";

const exceptionRows = [
  { ticket: "Billing access blocked", company: "Acme Platform", owner: "Maya Chen", channel: "Email", waiting: "6h 42m", status: "Breached", reason: "First response SLA overdue by 1h 42m", action: "Reassign and reply now" },
  { ticket: "API export timing out", company: "Northstar Labs", owner: "Liam Ross", channel: "Chat", waiting: "2h 18m", status: "Due soon", reason: "42 minutes remain before the next-response SLA", action: "Confirm engineering update" },
  { ticket: "Renewal user provisioning", company: "Quarry Systems", owner: "Elena Park", channel: "Form", waiting: "18h 05m", status: "Waiting on us", reason: "Customer supplied the requested details yesterday", action: "Complete provisioning review" },
];

const benefits = [
  { title: "See workload before it becomes a backlog", description: "Review open tickets, tickets created and closed, and the queues or owners where work is accumulating.", icon: "owners", tone: "copper" },
  { title: "Measure response and resolution speed", description: "Keep first response, customer wait time, and time to close visible with the calculation basis clearly labelled.", icon: "clock", tone: "blue" },
  { title: "Find SLA exceptions requiring action", description: "Separate on-track, due-soon, breached, and SLA-not-configured tickets instead of hiding missing data inside an average.", icon: "warning", tone: "amber" },
  { title: "Prepare the weekly service review", description: "Bring ticket volume, response time, satisfaction, owners, and exceptions into one repeatable operating view.", icon: "present", tone: "teal" },
  { title: "Review service before a customer renewal", description: "Inspect cases resolved, response and close time, open issues, and satisfaction for a selected company when associations are complete.", icon: "conversation", tone: "copper" },
  { title: "Act from the named evidence", description: "Move from aggregate metrics to the tickets, companies, channels, and owners behind the result, with a practical next action.", icon: "inspect", tone: "blue" },
] as const;

const faqs = [
  { q: "What does the Service Hub performance report include?", a: "The report combines ticket backlog and flow, first response and close time, SLA performance, customer satisfaction, and a named exception list. Missing SLA, satisfaction, history, or association data remains visibly unavailable rather than becoming a zero." },
  { q: "Can HubSpot already schedule and export service reports?", a: "Yes. HubSpot supports recurring report and dashboard emails plus CSV, XLS, and XLSX attachments for eligible report types. The SWOTBee value is a reusable management pack with governed definitions, editable workbook and presentation outputs, selected highlights, and stored snapshots from the point collection begins." },
  { q: "Which HubSpot portals are eligible?", a: "Ticket workload and timing depend on the ticket properties available in the portal. SLA sections require eligible Service Hub and Help Desk configuration with populated SLA properties. Customer satisfaction and account sections require eligible survey responses and ticket associations." },
  { q: "Does the report use calendar hours or business hours?", a: "The time basis must remain explicit. When stored HubSpot SLA-hour properties are available, the report can use them. Otherwise, it must label calendar-time calculations and must not present them as SLA-hour results." },
  { q: "How do weekly or monthly ticket snapshots work?", a: "After setup, the workflow stores a dated weekly or monthly snapshot so later reports can compare the backlog and service position at each cutoff. It cannot recreate a past snapshot that HubSpot data does not support and SWOTBee did not previously capture." },
  { q: "What do the Excel and PowerPoint outputs contain?", a: "The Excel workbook includes a summary, trends, exceptions, calculation notes, and supporting ticket rows. The PowerPoint output uses selected highlights and editable, evidence-linked talking points. Workbook edits do not change HubSpot records." },
  { q: "Does AI write the management summary automatically?", a: "AI drafts highlights and talking points grounded in the selected metrics, period, and ticket evidence. Each statement links to its supporting evidence and remains a draft until a named report owner reviews, edits, and approves it." },
  { q: "Will signing up connect my HubSpot account?", a: "No. Signing up uses your work email for the SWOTBee app. It does not connect to or access your HubSpot portal. HubSpot connection and read-only permissions are handled separately." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Layout
  title={title}
  description={description}
  ogImage="/assets/home-images/service-hub-performance-report-og.png"
  keywords="hubspot service hub performance report, hubspot customer service analytics report, hubspot ticket performance report, hubspot sla compliance report, hubspot ticket response time report, hubspot weekly ticket backlog report"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <header class="border-b border-v6-border bg-white">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
      <a href="/" class="flex min-h-11 items-center gap-2 rounded-md focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2" aria-label="SWOTbee home">
        <LogoHoneycomb width={32} height={30} />
        <span class="text-lg font-bold text-v6-dark">SWOT<span class="text-v6-teal-700">bee</span></span>
      </a>
      <a href="#report-signup" data-ga-cta="service_report_header_signup" class="inline-flex min-h-11 items-center justify-center rounded-lg border border-v6-copper px-4 py-2 text-sm font-semibold text-v6-copper transition-colors hover:bg-v6-copper-50 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">
        Sign up to the app
      </a>
    </div>
  </header>

  <main>
    <section class="overflow-hidden bg-gradient-to-b from-v6-bg to-white px-4 pb-16 pt-14 sm:px-6 sm:pb-20 sm:pt-20 lg:px-8">
      <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div>
          <span class="mb-5 inline-flex rounded-full bg-v6-copper-50 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-v6-copper-700">HubSpot Service Hub reporting</span>
          <h1 class="max-w-3xl text-balance text-4xl font-bold leading-[1.08] text-v6-dark sm:text-5xl lg:text-[3.45rem]">A Repeatable HubSpot Service Hub Performance Report for Every Week or Month</h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-v6-text-muted">Turn HubSpot ticket data into the same weekly or monthly service review, with historical comparisons, the tickets behind every result, an editable Excel workbook, and management-ready PowerPoint slides.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#sample-report" data-ga-cta="service_report_hero_sample" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-v6-copper px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-v6-copper-600 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">View the sample report</a>
            <a href="#report-signup" data-ga-cta="service_report_hero_signup" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-v6-border bg-white px-7 py-3.5 text-base font-semibold text-v6-dark transition-colors hover:border-v6-copper hover:bg-v6-copper-50 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">Sign up to the app</a>
          </div>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-v6-text-muted">Sign up to the SWOTBee app with your work email. No card is required.</p>
        </div>

        <div class="relative lg:pt-5" aria-label="Example weekly HubSpot Service Hub report with historical comparison and shareable outputs">
          <div class="absolute -inset-6 -z-10 rounded-full bg-v6-teal-100/70 blur-3xl"></div>
          <div class="overflow-hidden rounded-2xl border border-v6-border bg-white shadow-xl shadow-v6-dark/10">
            <div class="flex items-center justify-between gap-4 border-b border-v6-border px-5 py-4">
              <div><p class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-copper">Weekly service review</p><p class="mt-1 font-semibold text-v6-dark">Week ending 31 August</p></div>
              <span class="rounded-full bg-v6-blue-50 px-3 py-1 text-xs font-semibold text-v6-blue-800">Example data</span>
            </div>
            <div class="grid grid-cols-2 border-b border-v6-border sm:grid-cols-4">
              <div class="border-b border-r border-v6-border p-4 sm:border-b-0 sm:p-5"><p class="text-xs text-v6-text-muted">Open backlog</p><p class="mt-1 text-xl font-bold text-v6-dark">42</p><p class="mt-1 text-xs font-semibold text-v6-teal-800">Down 8</p></div>
              <div class="border-b border-v6-border p-4 sm:border-b-0 sm:border-r sm:p-5"><p class="text-xs text-v6-text-muted">Tickets closed</p><p class="mt-1 text-xl font-bold text-v6-dark">21</p><p class="mt-1 text-xs font-semibold text-v6-teal-800">Up 4</p></div>
              <div class="border-r border-v6-border bg-v6-copper-50 p-4 sm:p-5"><p class="text-xs text-v6-copper-800">SLA compliance</p><p class="mt-1 text-xl font-bold text-v6-copper-800">87%</p><p class="mt-1 text-xs font-semibold text-v6-teal-800">Up 6 points</p></div>
              <div class="p-4 sm:p-5"><p class="text-xs text-v6-text-muted">CSAT coverage</p><p class="mt-1 text-xl font-bold text-v6-dark">20 / 22</p><p class="mt-1 text-xs font-semibold text-v6-text-muted">91% positive</p></div>
            </div>
            <div class="grid gap-5 p-5 sm:grid-cols-[0.9fr_1.1fr]">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.12em] text-v6-text-muted">Four-week backlog</p>
                <div class="mt-4 flex h-24 items-end gap-3" aria-label="Backlog fell from 55 to 42 over four weekly snapshots">
                  <div class="flex flex-1 flex-col items-center gap-1"><span class="text-[10px] font-semibold text-v6-text-muted">55</span><div class="h-16 w-full rounded-t bg-v6-blue-200"></div><span class="text-[10px] text-v6-text-muted">10 Aug</span></div>
                  <div class="flex flex-1 flex-col items-center gap-1"><span class="text-[10px] font-semibold text-v6-text-muted">51</span><div class="h-14 w-full rounded-t bg-v6-blue-300"></div><span class="text-[10px] text-v6-text-muted">17 Aug</span></div>
                  <div class="flex flex-1 flex-col items-center gap-1"><span class="text-[10px] font-semibold text-v6-text-muted">50</span><div class="h-12 w-full rounded-t bg-v6-blue-400"></div><span class="text-[10px] text-v6-text-muted">24 Aug</span></div>
                  <div class="flex flex-1 flex-col items-center gap-1"><span class="text-[10px] font-semibold text-v6-dark">42</span><div class="h-9 w-full rounded-t bg-v6-teal"></div><span class="text-[10px] text-v6-text-muted">31 Aug</span></div>
                </div>
              </div>
              <div class="rounded-xl bg-v6-bg-warm p-4">
                <p class="text-xs font-semibold uppercase tracking-[0.12em] text-v6-copper-800">Management highlight</p>
                <p class="mt-2 text-sm font-semibold leading-relaxed text-v6-dark">Backlog fell by 8 tickets and SLA improved by 6 points. Email Support still owns 3 of 4 breaches.</p>
                <a href="#sample-report" class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-v6-copper-800 underline decoration-v6-copper-300 underline-offset-4 focus:outline-none focus:ring-2 focus:ring-v6-copper">View the tickets requiring action</a>
              </div>
            </div>
            <div class="grid grid-cols-3 border-t border-v6-border bg-v6-bg px-5 py-3 text-center text-xs font-semibold text-v6-text-muted"><span>Excel ready</span><span>PowerPoint ready</span><span>Summary reviewed</span></div>
          </div>
        </div>
      </div>
    </section>

    <ClientLogoStrip caption="HubSpot and revenue operations work trusted by teams at" />

    <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8" aria-labelledby="repeatable-output-heading">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">Recurring management-report workflow</p>
          <h2 id="repeatable-output-heading" class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">Turn Service Hub analytics into the same customer service report every week or month.</h2>
          <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">Build a reusable customer service reporting workflow with versioned definitions and three connected deliverables: dated snapshots, an editable workbook, and an editable presentation.</p>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
          <article class="rounded-2xl border border-v6-border bg-white p-6"><p class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-copper">Prepared review</p><h3 class="mt-3 text-xl font-bold text-v6-dark">The same service measures</h3><p class="mt-3 leading-relaxed text-v6-text-muted">Version the source fields, filters, time basis, coverage rules, and definitions behind backlog, response and close time, resolution rate, SLA, satisfaction, and team performance.</p></article>
          <article class="rounded-2xl border border-v6-border bg-white p-6"><p class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-copper">Output</p><h3 class="mt-3 text-xl font-bold text-v6-dark">Editable Excel workbook</h3><p class="mt-3 leading-relaxed text-v6-text-muted">Inspect prepared summaries, trends, exceptions, formulas, and supporting ticket rows without changing HubSpot records.</p></article>
          <article class="rounded-2xl border border-v6-border bg-white p-6"><p class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-copper">Output</p><h3 class="mt-3 text-xl font-bold text-v6-dark">Presentation-ready PowerPoint</h3><p class="mt-3 leading-relaxed text-v6-text-muted">Prepare editable charts and slides in a reusable PowerPoint structure, then choose the results your audience needs.</p></article>
          <article class="rounded-2xl border border-v6-border bg-white p-6"><p class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-copper">History</p><h3 class="mt-3 text-xl font-bold text-v6-dark">Weekly or monthly snapshots</h3><p class="mt-3 leading-relaxed text-v6-text-muted">Preserve each future cutoff after collection is configured, with cutoff time, extraction time, snapshot-recorded time, timezone, and definition version kept separate.</p></article>
        </div>
      </div>
    </section>

    <section class="bg-v6-bg px-4 py-16 sm:px-6 sm:py-20 lg:px-8" aria-labelledby="service-report-audience-heading">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">The same service report every week or month</p>
          <h2 id="service-report-audience-heading" class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">For the people responsible for support performance and customer follow-through</h2>
          <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">Use the same report for the weekly queue review, the monthly service review, and account-level preparation before an important customer conversation.</p>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          <article class="rounded-2xl border border-v6-border bg-white p-6"><h3 class="text-xl font-bold text-v6-dark">Support leadership</h3><p class="mt-3 leading-relaxed text-v6-text-muted">See workload, response and close time, SLA exceptions, satisfaction, and the teams needing attention.</p></article>
          <article class="rounded-2xl border border-v6-border bg-white p-6"><h3 class="text-xl font-bold text-v6-dark">Service Operations</h3><p class="mt-3 leading-relaxed text-v6-text-muted">Keep definitions stable, expose missing fields, and trace each metric to the tickets behind it.</p></article>
          <article class="rounded-2xl border border-v6-border bg-white p-6"><h3 class="text-xl font-bold text-v6-dark">Customer Success</h3><p class="mt-3 leading-relaxed text-v6-text-muted">Review open issues and service history by company before a renewal or account review when associations are complete.</p></article>
        </div>

        <div class="mx-auto mt-16 max-w-3xl border-t border-v6-border pt-16 text-center sm:mt-20 sm:pt-20">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">What the report helps you do</p>
          <h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">Understand service performance, then act on the exceptions behind it.</h2>
          <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">Start with the operating picture, then inspect the queues, tickets, companies, and owners that explain it.</p>
        </div>
        <ReportBenefitCards benefits={benefits} />
      </div>
    </section>

    <section id="sample-report" class="scroll-mt-8 bg-v6-bg px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-3xl">
            <div class="flex flex-wrap items-center gap-3"><p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">Report preview</p><span class="rounded-full border border-v6-copper-200 bg-v6-copper-50 px-2.5 py-1 text-xs font-semibold text-v6-copper-800">Example data</span></div>
            <h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">See the service picture and the named exceptions together</h2>
            <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">This example shows how the recurring management pack connects current results, historical change, tickets requiring action, Excel detail, and presentation-ready highlights.</p>
          </div>
          <a href="#report-signup" data-ga-cta="service_report_sample_signup" class="inline-flex min-h-11 items-center justify-center self-start rounded-xl border border-v6-copper px-5 py-3 text-sm font-semibold text-v6-copper transition-colors hover:bg-v6-copper-50 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2 lg:self-auto">Sign up to the app</a>
        </div>

        <div class="mt-10 overflow-hidden rounded-2xl border border-v6-border bg-white shadow-sm">
          <div class="flex flex-col gap-4 border-b border-v6-border px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-7">
            <div><p class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-text-muted">Service Hub performance report</p><h3 class="mt-1 text-xl font-bold text-v6-dark">Weekly service review</h3><p class="mt-1 text-sm text-v6-text-muted">Week ending 31 August 2026, compared with the 24 August snapshot</p></div>
            <div class="flex flex-wrap items-center gap-2"><span class="rounded-full bg-v6-copper-50 px-3 py-1.5 text-xs font-semibold text-v6-copper-800">4 breaches</span><span class="rounded-full bg-v6-teal-50 px-3 py-1.5 text-xs font-semibold text-v6-teal-800">Backlog down 8</span><span class="rounded-full bg-v6-blue-50 px-3 py-1.5 text-xs font-semibold text-v6-blue-800">Example data</span></div>
          </div>

          <div class="grid gap-px bg-v6-border sm:grid-cols-2 lg:grid-cols-4">
            <div class="bg-white p-5 sm:p-6"><p class="text-sm text-v6-text-muted">Open backlog</p><div class="mt-2 flex items-end justify-between gap-3"><p class="text-2xl font-bold text-v6-dark">42</p><span class="text-sm font-semibold text-v6-teal-800">Down 8</span></div></div>
            <div class="bg-white p-5 sm:p-6"><p class="text-sm text-v6-text-muted">Tickets closed</p><div class="mt-2 flex items-end justify-between gap-3"><p class="text-2xl font-bold text-v6-dark">21</p><span class="text-sm font-semibold text-v6-teal-800">Up 4</span></div></div>
            <div class="bg-v6-copper-50 p-5 sm:p-6"><p class="text-sm text-v6-copper-800">First-response SLA</p><div class="mt-2 flex items-end justify-between gap-3"><p class="text-2xl font-bold text-v6-copper-800">87%</p><span class="text-sm font-semibold text-v6-teal-800">Up 6 pts</span></div></div>
            <div class="bg-v6-bg-warm p-5 sm:p-6"><p class="text-sm text-v6-text-muted">CSAT</p><div class="mt-2 flex items-end justify-between gap-3"><p class="text-2xl font-bold text-v6-dark">91%</p><span class="text-sm font-semibold text-v6-text-muted">20 of 22</span></div></div>
          </div>

          <div class="grid gap-6 border-t border-v6-border p-5 sm:p-7 lg:grid-cols-[1.05fr_0.95fr]">
            <article class="rounded-xl border border-v6-border p-5">
              <div class="flex items-center justify-between gap-4"><div><p class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-copper">Historical snapshots</p><h4 class="mt-1 font-bold text-v6-dark">Backlog and SLA over four weeks</h4></div><span class="text-xs text-v6-text-muted">Weekly cutoff</span></div>
              <div class="mt-6 flex h-36 items-end gap-4 border-b border-v6-border px-2" aria-label="Backlog declined from 55 to 42 and SLA improved from 76 to 87 percent">
                <div class="flex flex-1 flex-col items-center gap-2"><span class="text-xs font-semibold text-v6-dark">55</span><div class="h-24 w-full max-w-16 rounded-t bg-v6-blue-200"></div><span class="pb-2 text-[11px] text-v6-text-muted">76% SLA</span></div>
                <div class="flex flex-1 flex-col items-center gap-2"><span class="text-xs font-semibold text-v6-dark">51</span><div class="h-20 w-full max-w-16 rounded-t bg-v6-blue-300"></div><span class="pb-2 text-[11px] text-v6-text-muted">80% SLA</span></div>
                <div class="flex flex-1 flex-col items-center gap-2"><span class="text-xs font-semibold text-v6-dark">50</span><div class="h-[4.5rem] w-full max-w-16 rounded-t bg-v6-blue-400"></div><span class="pb-2 text-[11px] text-v6-text-muted">81% SLA</span></div>
                <div class="flex flex-1 flex-col items-center gap-2"><span class="text-xs font-semibold text-v6-dark">42</span><div class="h-14 w-full max-w-16 rounded-t bg-v6-teal"></div><span class="pb-2 text-[11px] font-semibold text-v6-teal-800">87% SLA</span></div>
              </div>
              <div class="mt-3 grid grid-cols-4 text-center text-[11px] text-v6-text-muted"><span>10 Aug</span><span>17 Aug</span><span>24 Aug</span><span>31 Aug</span></div>
            </article>
            <article class="rounded-xl border border-v6-copper-200 bg-v6-copper-50 p-5">
              <div class="flex items-center justify-between gap-4"><p class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-copper-800">Reviewed management summary</p><span class="rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-v6-teal-800">Approved</span></div>
              <p class="mt-4 text-lg font-bold leading-relaxed text-v6-dark">Backlog fell by 16% and first-response SLA improved by 6 points.</p>
              <p class="mt-3 text-sm leading-relaxed text-v6-text-muted">Email Support remains the priority because it owns 19 open tickets and 3 of the 4 current breaches.</p>
              <div class="mt-5 space-y-2 text-sm"><p class="rounded-lg bg-white px-3 py-2 text-v6-text-muted"><strong class="text-v6-dark">Evidence:</strong> 24 and 31 August snapshots</p><p class="rounded-lg bg-white px-3 py-2 text-v6-text-muted"><strong class="text-v6-dark">Next action:</strong> Reassign two breached tickets today</p></div>
            </article>
          </div>

          <div class="border-t border-v6-border p-5 sm:p-7">
