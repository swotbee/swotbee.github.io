---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/astro/Footer.astro";
import LogoHoneycomb from "../components/astro/LogoHoneycomb.astro";
import ClientLogoStrip from "../components/astro/ClientLogoStrip.astro";
import ReportSignup from "../components/astro/ReportSignup.astro";

const title = "HubSpot Service Hub Reporting | Service Performance Reports";
const description = "Turn HubSpot Service Hub data into a repeatable management report with ticket, backlog, SLA, response-time and satisfaction KPIs in editable Excel and PowerPoint.";

const exceptionRows = [
  { ticket: "Billing access blocked", company: "Acme Platform", owner: "Maya Chen", channel: "Email", waiting: "6h 42m", status: "Breached", reason: "First response SLA overdue by 1h 42m", action: "Reassign and reply now" },
  { ticket: "API export timing out", company: "Northstar Labs", owner: "Liam Ross", channel: "Chat", waiting: "2h 18m", status: "Due soon", reason: "42 minutes remain before the next-response SLA", action: "Confirm engineering update" },
  { ticket: "Renewal user provisioning", company: "Quarry Systems", owner: "Elena Park", channel: "Form", waiting: "18h 05m", status: "Waiting on us", reason: "Customer supplied the requested details yesterday", action: "Complete provisioning review" },
];

const reportAreas = [
  { title: "Ticket volume", description: "Tickets created and closed, net movement, and volume by pipeline, channel, category, priority, team, or owner." },
  { title: "Backlog and aging", description: "Open backlog, movement since the previous period, aging bands, overdue work, and the oldest tickets still waiting." },
  { title: "Response and resolution", description: "First-response and resolution times, performance against target, and differences across teams, channels, priorities, or categories." },
  { title: "SLA performance", description: "Tickets met, missed, due, or at risk, with enough detail to see where misses are coming from." },
  { title: "Customer satisfaction", description: "Available CSAT measures, response rates, movement over time, and results across the segments your data supports." },
  { title: "Knowledge-base performance", description: "Available usage and engagement measures, the content customers use most, and changes across comparable periods." },
];

const faqs = [
  { q: "What is a HubSpot Service Hub performance report?", a: "It is a recurring management report built from selected Service Hub data. It brings KPIs, targets, period comparisons, supporting records, and commentary into one editable report for a Service, executive, board, or client review." },
  { q: "Which Service Hub KPIs can I include?", a: "Depending on the data available in your HubSpot account, the report can include tickets created and closed, backlog and aging, first-response and resolution times, SLA attainment, customer-satisfaction measures, and selected knowledge-base analytics. Results can also be broken down by supported fields such as team, channel, priority, category, pipeline, region, or customer." },
  { q: "Can I compare this month with last month?", a: "Yes, when HubSpot provides comparable period data or SWOTBee has a stored snapshot. The same agreed definition and scope are used on both sides of the comparison." },
  { q: "Can I export the report to Excel?", a: "Yes. The workbook combines the management view with charts, definitions, calculations, and supporting data, so you can check the result and continue working with it." },
  { q: "Can I create a PowerPoint for a management or board meeting?", a: "Yes. The PowerPoint turns the selected KPIs, changes, reasons, risks, and actions into an editable presentation rather than a collection of dashboard screenshots." },
  { q: "Can I share the report as a live dashboard?", a: "Yes, when a live view suits the audience. The dashboard uses the same reporting setup as the Excel workbook and PowerPoint deck, so its scope, definitions, and figures stay aligned." },
  { q: "Do people viewing the report need a HubSpot login?", a: "People can review an exported Excel or PowerPoint file without using the HubSpot reporting interface. Access and sharing still follow your organisation's own security requirements." },
  { q: "Does SWOTBee replace HubSpot reporting?", a: "No. HubSpot remains the operational data source. SWOTBee turns selected data into a repeatable management report with consistent definitions, comparisons, evidence, and editable outputs." },
  { q: "Can SWOTBee recover earlier backlog or SLA figures?", a: "Only when those earlier values are available from HubSpot or were previously saved. If they are unavailable, SWOTBee can start recording them now for future reports." },
  { q: "Will signing up connect my HubSpot account?", a: "No. Signing up uses your work email for the SWOTBee app. It does not connect to or access your HubSpot portal. HubSpot connection and read-only permissions are handled separately." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Layout
  title={title}
  description={description}
  ogImage="/assets/home-images/service-hub-performance-report-og.png"
  keywords="hubspot service hub reporting, hubspot customer service analytics reports, hubspot ticket performance reporting, hubspot sla reporting, hubspot customer satisfaction reports, export hubspot reports to excel"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <header class="border-b border-v6-border bg-white">
    <div class="mx-auto flex min-h-16 max-w-6xl items-center justify-between gap-6 px-4 py-2 sm:px-6 lg:px-8">
      <a href="/" class="flex min-h-11 shrink-0 items-center gap-2 rounded-md focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2" aria-label="SWOTbee home">
        <LogoHoneycomb width={32} height={30} />
        <span class="text-lg font-bold text-v6-dark">SWOT<span class="text-v6-teal-700">bee</span></span>
      </a>
      <nav class="hidden items-center gap-6 text-sm font-semibold text-v6-text-muted lg:flex" aria-label="Page navigation">
        <a href="#how-it-works" class="rounded-md py-2 hover:text-v6-dark focus:outline-none focus:ring-2 focus:ring-v6-copper">How it works</a>
        <a href="#sample-report" class="rounded-md py-2 hover:text-v6-dark focus:outline-none focus:ring-2 focus:ring-v6-copper">Sample report</a>
        <a href="#report-contents" class="rounded-md py-2 hover:text-v6-dark focus:outline-none focus:ring-2 focus:ring-v6-copper">What's included</a>
        <a href="#questions" class="rounded-md py-2 hover:text-v6-dark focus:outline-none focus:ring-2 focus:ring-v6-copper">FAQs</a>
      </nav>
      <a href="#report-signup" data-ga-cta="service_report_header_signup" class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-lg border border-v6-copper px-4 py-2 text-sm font-semibold text-v6-copper transition-colors hover:bg-v6-copper-50 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">
        Get your first Service Report
      </a>
    </div>
  </header>

  <main>
    <section class="overflow-hidden bg-gradient-to-b from-v6-bg to-white px-4 pb-16 pt-14 sm:px-6 sm:pb-20 sm:pt-20 lg:px-8">
      <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[0.88fr_1.12fr] lg:items-center">
        <div>
          <span class="mb-5 inline-flex rounded-full bg-v6-copper-50 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-v6-copper-700">HubSpot executive Service reporting</span>
          <h1 class="max-w-3xl text-balance text-4xl font-bold leading-[1.08] text-v6-dark sm:text-5xl lg:text-[3.45rem]">Your HubSpot Service report, ready in 3 clicks</h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-v6-text-muted">Bring ticket volume, backlog, SLA, response time, resolution, and customer satisfaction into one clear report—without rebuilding it in spreadsheets and slides every month.</p>
          <p class="mt-5 font-semibold text-v6-dark">No report-by-report recap. No rebuilt spreadsheet. No screenshot deck.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#report-signup" data-ga-cta="service_report_hero_signup" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-v6-copper px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-v6-copper-600 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">Get your first Service Report</a>
            <a href="#sample-report" data-ga-cta="service_report_hero_sample" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-v6-border bg-white px-7 py-3.5 text-base font-semibold text-v6-dark transition-colors hover:border-v6-copper hover:bg-v6-copper-50 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">See a sample report</a>
          </div>
          <p class="mx-auto mt-4 max-w-xl text-center text-sm font-semibold leading-relaxed text-v6-dark">No credit card required.</p>
        </div>

        <div class="relative" aria-label="Example HubSpot Service Hub report with weekly metrics and management summary">
          <div class="absolute -inset-6 -z-10 rounded-full bg-v6-teal-100/70 blur-3xl"></div>
          <div class="overflow-hidden rounded-2xl border border-v6-border bg-white shadow-xl shadow-v6-dark/10">
            <div class="flex items-center justify-between gap-4 border-b border-v6-border px-5 py-4">
              <div><p class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-copper">Weekly service review</p><p class="mt-1 font-semibold text-v6-dark">Week ending 31 August</p></div>
              <span class="rounded-full bg-v6-blue-50 px-3 py-1 text-xs font-semibold text-v6-blue-800">Weekly or monthly</span>
            </div>
            <div class="grid grid-cols-2 border-b border-v6-border sm:grid-cols-4">
              <div class="border-b border-r border-v6-border p-4 sm:border-b-0 sm:p-5"><p class="text-xs text-v6-text-muted">Open backlog</p><p class="mt-1 text-xl font-bold text-v6-dark">42</p><p class="mt-1 text-xs font-semibold text-v6-teal-800">Down 8</p></div>
              <div class="border-b border-v6-border p-4 sm:border-b-0 sm:border-r sm:p-5"><p class="text-xs text-v6-text-muted">Tickets closed</p><p class="mt-1 text-xl font-bold text-v6-dark">21</p><p class="mt-1 text-xs font-semibold text-v6-teal-800">Up 4</p></div>
              <div class="border-r border-v6-border bg-v6-copper-50 p-4 sm:p-5"><p class="text-xs text-v6-copper-800">First-response SLA</p><p class="mt-1 text-xl font-bold text-v6-copper-800">87%</p><p class="mt-1 text-xs font-semibold text-v6-teal-800">Up 6 points</p></div>
              <div class="p-4 sm:p-5"><p class="text-xs text-v6-text-muted">CSAT</p><p class="mt-1 text-xl font-bold text-v6-dark">91%</p><p class="mt-1 text-xs font-semibold text-v6-text-muted">20 of 22</p></div>
            </div>
            <div class="grid gap-5 p-5 sm:grid-cols-[0.9fr_1.1fr]">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.12em] text-v6-text-muted">Four-week backlog</p>
                <div class="mt-4 flex h-24 items-end gap-3" aria-label="Backlog fell from 55 to 42 over four weekly snapshots">
                  <div class="flex flex-1 flex-col items-center gap-1"><span class="text-[10px] font-semibold text-v6-text-muted">55</span><div class="h-16 w-full rounded-t bg-v6-blue-200"></div><span class="text-[10px] text-v6-text-muted">10 Aug</span></div>
                  <div class="flex flex-1 flex-col items-center gap-1"><span class="text-[10px] font-semibold text-v6-text-muted">51</span><div class="h-14 w-full rounded-t bg-v6-blue-300"></div><span class="text-[10px] text-v6-text-muted">17 Aug</span></div>
                  <div class="flex flex-1 flex-col items-center gap-1"><span class="text-[10px] font-semibold text-v6-text-muted">50</span><div class="h-12 w-full rounded-t bg-v6-blue-400"></div><span class="text-[10px] text-v6-text-muted">24 Aug</span></div>
                  <div class="flex flex-1 flex-col items-center gap-1"><span class="text-[10px] font-semibold text-v6-dark">42</span><div class="h-9 w-full rounded-t bg-v6-teal"></div><span class="text-[10px] text-v6-text-muted">31 Aug</span></div>
                </div>
              </div>
              <div class="rounded-xl bg-v6-bg-warm p-4">
                <p class="text-xs font-semibold uppercase tracking-[0.12em] text-v6-copper-800">Management summary</p>
                <p class="mt-2 text-sm font-semibold leading-relaxed text-v6-dark">Backlog fell by 8 tickets and SLA improved by 6 points. Email Support still owns 3 of 4 breaches.</p>
                <a href="#sample-report" class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-v6-copper-800 underline decoration-v6-copper-300 underline-offset-4 focus:outline-none focus:ring-2 focus:ring-v6-copper">See the tickets behind it</a>
              </div>
            </div>
            <div class="grid grid-cols-3 divide-x divide-v6-border border-t border-v6-border bg-v6-bg text-center text-xs font-semibold text-v6-text-muted"><span class="px-2 py-3">Excel report</span><span class="px-2 py-3">PowerPoint deck</span><span class="px-2 py-3">Live dashboard</span></div>
          </div>
        </div>
      </div>
    </section>

    <ClientLogoStrip caption="HubSpot and revenue operations work trusted by teams at" />

    <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">The monthly rebuild</p>
          <h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">Stop rebuilding the same Service report every month</h2>
        </div>
        <div class="space-y-5 text-lg leading-relaxed text-v6-text-muted">
          <p>The data may already be in HubSpot, but getting it into the meeting is another job entirely.</p>
          <p>There is an export for one number, a different report for another, last month's spreadsheet to update, and a slide deck waiting at the end. Filters need checking again. Calculations and charts drift out of sync. A simple monthly report turns into hours of copying, pasting, cleaning, and reformatting.</p>
          <p class="font-semibold text-v6-dark">SWOTBee keeps the scope, definitions, evidence, and presentation together, so the next review starts with current Service performance—not a blank spreadsheet.</p>
        </div>
      </div>
    </section>

    <section id="how-it-works" class="scroll-mt-8 bg-v6-bg px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">A reusable reporting setup</p>
          <h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">Set the report once. Run it again next week or next month.</h2>
          <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">Agree the scope, measures, targets, and comparisons once, then bring in the latest Service data for the next review.</p>
        </div>
        <ol class="mt-10 grid gap-6 md:grid-cols-3">
          <li class="rounded-2xl border border-v6-border bg-white p-6 sm:p-7"><span class="flex h-9 w-9 items-center justify-center rounded-full bg-v6-copper-50 text-sm font-bold text-v6-copper-800">1</span><h3 class="mt-5 text-xl font-bold text-v6-dark">Choose the scope</h3><p class="mt-3 leading-relaxed text-v6-text-muted">Pick the period and the ticket pipelines, teams, channels, categories, regions, or customers that belong in the report.</p></li>
          <li class="rounded-2xl border border-v6-border bg-white p-6 sm:p-7"><span class="flex h-9 w-9 items-center justify-center rounded-full bg-v6-copper-50 text-sm font-bold text-v6-copper-800">2</span><h3 class="mt-5 text-xl font-bold text-v6-dark">Choose your KPIs</h3><p class="mt-3 leading-relaxed text-v6-text-muted">Select the measures you already use, along with their targets and comparison periods.</p><p class="mt-4 text-sm font-semibold text-v6-dark">Backlog by region · SLA against target · Tickets open over 48 hours</p></li>
          <li class="rounded-2xl border border-v6-border bg-white p-6 sm:p-7"><span class="flex h-9 w-9 items-center justify-center rounded-full bg-v6-copper-50 text-sm font-bold text-v6-copper-800">3</span><h3 class="mt-5 text-xl font-bold text-v6-dark">Get the report</h3><p class="mt-3 leading-relaxed text-v6-text-muted">Review the figures, add the context only your team knows, and use the finished report in Excel, PowerPoint, or a live dashboard.</p></li>
        </ol>
        <div class="mt-8"><a href="#report-signup" data-ga-cta="service_report_steps_signup" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-v6-copper px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-v6-copper-600 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">Get your first Service Report</a></div>
      </div>
    </section>

    <section id="report-outputs" class="scroll-mt-8 px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-4xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">One reporting setup</p>
          <h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">One Service report—ready in Excel, PowerPoint, or a live dashboard.</h2>
          <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">Present the story in PowerPoint. Check the detail in Excel. Share a live view when people need to explore it themselves. Update the report, and all three versions stay aligned.</p>
        </div>
        <div class="mt-10 grid gap-6 lg:grid-cols-3">
          <article class="overflow-hidden rounded-2xl border border-v6-border bg-white">
            <div class="border-b border-v6-border p-6 sm:p-8"><p class="text-sm font-semibold uppercase tracking-[0.14em] text-v6-teal-700">Excel workbook</p><h3 class="mt-3 text-2xl font-bold text-v6-dark">Every KPI, definition, target, and ticket—already organised</h3><p class="mt-4 leading-relaxed text-v6-text-muted">The workbook arrives with the KPI summary, charts, calculations, definitions, and ticket-level records already in place. You can still check a total, add a Finance figure, or answer an unexpected question when needed.</p></div>
            <div class="bg-v6-bg p-5 sm:p-7"><div class="overflow-hidden rounded-xl border border-v6-border bg-white text-sm"><div class="flex gap-1 border-b border-v6-border bg-v6-bg p-2"><span class="rounded bg-white px-3 py-2 font-semibold text-v6-dark shadow-sm">Summary</span><span class="px-3 py-2 text-v6-text-muted">Trends</span><span class="px-3 py-2 text-v6-text-muted">Tickets</span><span class="px-3 py-2 text-v6-text-muted">Definitions</span></div><div class="grid grid-cols-3 gap-px bg-v6-border text-v6-text-muted"><span class="bg-white p-3 font-semibold">Ticket</span><span class="bg-white p-3 font-semibold">Owner</span><span class="bg-white p-3 font-semibold">SLA state</span><span class="bg-white p-3">Billing access</span><span class="bg-white p-3">Maya</span><span class="bg-white p-3 font-semibold text-v6-copper-800">Breached</span></div></div></div>
          </article>
          <article class="overflow-hidden rounded-2xl border border-v6-border bg-white">
            <div class="border-b border-v6-border p-6 sm:p-8"><p class="text-sm font-semibold uppercase tracking-[0.14em] text-v6-blue">PowerPoint deck</p><h3 class="mt-3 text-2xl font-bold text-v6-dark">The executive Service story, ready to present and edit</h3><p class="mt-4 leading-relaxed text-v6-text-muted">Remove a slide, change the emphasis, or add context that should never live in HubSpot. The charts, tables, and wording remain editable.</p></div>
            <div class="bg-v6-bg p-5 sm:p-7"><div class="mx-auto max-w-md rounded-xl border border-v6-border bg-white p-5 shadow-sm"><p class="text-xs font-semibold uppercase tracking-wide text-v6-copper">Weekly service review</p><p class="mt-2 text-xl font-bold text-v6-dark">Backlog down. SLA improving.</p><p class="mt-2 text-sm text-v6-text-muted">Email Support remains the priority this week.</p><div class="mt-5 flex h-20 items-end gap-3"><span class="h-20 flex-1 rounded-t bg-v6-blue-200"></span><span class="h-16 flex-1 rounded-t bg-v6-blue-300"></span><span class="h-14 flex-1 rounded-t bg-v6-blue-400"></span><span class="h-10 flex-1 rounded-t bg-v6-teal"></span></div></div></div>
          </article>
          <article class="overflow-hidden rounded-2xl border border-v6-border bg-white">
            <div class="border-b border-v6-border p-6 sm:p-8"><p class="text-sm font-semibold uppercase tracking-[0.14em] text-v6-copper">Live dashboard</p><h3 class="mt-3 text-2xl font-bold text-v6-dark">The live Service dashboard, ready to share</h3><p class="mt-4 leading-relaxed text-v6-text-muted">Give a team, executive, or client access to the approved metrics and drill-downs without sending a new file each time.</p></div>
            <div class="bg-v6-bg p-5 sm:p-7"><div class="mx-auto max-w-md overflow-hidden rounded-xl border border-v6-border bg-white shadow-sm"><div class="flex items-center justify-between border-b border-v6-border px-4 py-3"><div><p class="text-xs font-semibold uppercase tracking-wide text-v6-copper">Shared Service view</p><p class="mt-1 text-sm font-bold text-v6-dark">Current performance</p></div><span class="rounded-full bg-v6-teal-50 px-2.5 py-1 text-xs font-semibold text-v6-teal-800">Live</span></div><div class="grid grid-cols-2 gap-px bg-v6-border"><div class="bg-white p-4"><p class="text-xs text-v6-text-muted">Open backlog</p><p class="mt-1 text-xl font-bold text-v6-dark">42</p></div><div class="bg-white p-4"><p class="text-xs text-v6-text-muted">SLA</p><p class="mt-1 text-xl font-bold text-v6-dark">87%</p></div></div><p class="px-4 py-3 text-xs text-v6-text-muted">Updated from the same reporting setup</p></div></div>
          </article>
        </div>
      </div>
    </section>

    <section id="sample-report" class="scroll-mt-8 px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <div class="flex flex-wrap items-center gap-3"><p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">Inside your Service report</p><span class="rounded-full border border-v6-copper-200 bg-v6-copper-50 px-2.5 py-1 text-xs font-semibold text-v6-copper-800">Sample data</span></div>
          <h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">Show the headline first. Then let your executives drill down if needed.</h2>
          <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">The first view shows the current results, the change from the previous period, and the items that need attention. Below it, you can see the teams, channels, and individual tickets driving those changes.</p>
        </div>

        <div class="mt-10 overflow-hidden rounded-2xl border border-v6-border bg-white shadow-lg shadow-v6-dark/5">
          <div class="flex flex-col gap-4 border-b border-v6-border px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-7">
            <div><p class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-text-muted">Service Hub performance report</p><h3 class="mt-1 text-xl font-bold text-v6-dark">Weekly service review</h3><p class="mt-1 text-sm text-v6-text-muted">Week ending 31 August 2026, compared with the 24 August snapshot</p></div>
            <div class="flex flex-wrap items-center gap-2"><span class="rounded-full bg-v6-copper-50 px-3 py-1.5 text-xs font-semibold text-v6-copper-800">4 breaches</span><span class="rounded-full bg-v6-teal-50 px-3 py-1.5 text-xs font-semibold text-v6-teal-800">Backlog down 8</span><span class="rounded-full bg-v6-blue-50 px-3 py-1.5 text-xs font-semibold text-v6-blue-800">Example data</span></div>
          </div>

          <div class="grid gap-px bg-v6-border sm:grid-cols-2 lg:grid-cols-4">
