---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/astro/Footer.astro";
import LogoHoneycomb from "../components/astro/LogoHoneycomb.astro";
import ClientLogoStrip from "../components/astro/ClientLogoStrip.astro";
import ReportSignupDialog from "../components/astro/ReportSignupDialog.astro";

const title = "Turn HubSpot AEO Data Into Excel and PowerPoint";
const description = "Turn HubSpot AEO prompts, AI responses, citations, competitor mentions, and recommendations into Excel, PowerPoint, or a live dashboard.";

const promptRows = [
  {
    prompt: "Which CRM is best for a growing B2B service company?",
    engine: "ChatGPT",
    brandResult: "Mentioned",
    citations: "4",
    finding: "Your comparison guide was cited",
    nextAction: "Refresh the guide with current integrations",
  },
  {
    prompt: "How should a RevOps team report pipeline changes?",
    engine: "Gemini",
    brandResult: "Not mentioned",
    citations: "6",
    finding: "Two competitor articles cited",
    nextAction: "Create a worked pipeline-change example",
  },
  {
    prompt: "What should an executive HubSpot report include?",
    engine: "Claude",
    brandResult: "Mentioned",
    citations: "3",
    finding: "Service page cited without the brand name",
    nextAction: "Make the brand and author clearer on the cited page",
  },
];

const reportAreas = [
  { title: "Questions and AI answers", description: "The prompts selected for the report, every AI platform checked, the dated answers, and anything HubSpot could not return." },
  { title: "Brand visibility", description: "Questions that mention your brand, where it appears in the answer, and the gains or losses that matter for the review." },
  { title: "Competitor visibility", description: "Questions where competitors appear, where your brand is missing, and the pages or claims helping them earn that place." },
  { title: "Citations and source pages", description: "The websites and individual pages cited in AI answers, including your own citations and sources worth investigating." },
  { title: "Results by platform and question", description: "Clear breakdowns by AI platform, buying question, topic, business unit, or another grouping selected for the report." },
  { title: "Recommended work and owners", description: "The content or outreach work supported by the evidence, why it matters, who owns it, and when it will be reviewed." },
];

const faqs = [
  { q: "What will I get in the finished AEO report?", a: "You will get an editable workbook for the detailed work and a PowerPoint for the meeting. Depending on the data available, they can show the questions tracked, AI answers checked, results by AI platform, mentions of your brand and competitors, cited sources, recommended work, and agreed actions." },
  { q: "Can I export HubSpot AEO prompts to Excel?", a: "Yes. The workbook can include the questions you track, dated AI answers, cited sources, search queries, brand and competitor mentions, recommendations, and notes about what was included." },
  { q: "Can I use it for a client or executive meeting?", a: "Yes. The presentation is editable, and you decide which changes, missing brand mentions, useful sources, and next actions the audience needs to see. The workbook stays available when someone wants the detail behind a slide." },
  { q: "Can I share a live AEO dashboard?", a: "Yes. A live dashboard can show the latest approved AEO measures and let colleagues or clients inspect the prompts and evidence behind them. It uses the same report setup as the Excel workbook and PowerPoint." },
  { q: "Will the original AI answers and citations be included?", a: "They can be when HubSpot returns them for the period you selected. The report can include the question, AI platform, full answer, cited URLs and titles, and the search queries used." },
  { q: "What happens when a metric is not available through the API?", a: "The report says it is unavailable. It does not turn missing data into zero or present an independently calculated value as a native HubSpot metric. HubSpot currently documents the AEO API as a public beta, so fields and availability may change." },
  { q: "How far back can the report compare?", a: "It can use prompt runs that HubSpot has already collected and preserve future reporting cutoffs. It cannot recreate an AI response that was never captured, so comparisons become more useful as consistent runs accumulate." },
  { q: "Will signing up connect my HubSpot account?", a: "No. Signing up uses your work email for the SWOTBee app. HubSpot connection and read-only permissions are handled separately." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Layout
  title={title}
  description={description}
  keywords="HubSpot AEO reporting export, export HubSpot AEO prompts to Excel, HubSpot AEO report, HubSpot AI visibility report, HubSpot AEO prompts CSV, AEO client reporting, ChatGPT visibility report, HubSpot AEO PowerPoint report, recurring AEO reporting"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <header class="border-b border-v6-border bg-white">
    <div class="mx-auto flex min-h-16 max-w-6xl items-center justify-between gap-6 px-4 py-2 sm:px-6 lg:px-8">
      <a href="/" class="flex min-h-11 shrink-0 items-center gap-2 rounded-md focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2" aria-label="SWOTbee home">
        <LogoHoneycomb width={32} height={30} />
        <span class="text-lg font-bold text-v6-dark">SWOT<span class="text-v6-teal-700">bee</span></span>
      </a>
      <nav class="hidden items-center gap-6 text-sm font-semibold text-v6-text-muted lg:flex" aria-label="Page navigation">
        <a href="#how-it-works" class="rounded-md py-2 hover:text-v6-dark focus:outline-none focus:ring-2 focus:ring-v6-copper">How it works</a>
        <a href="#sample-report" class="rounded-md py-2 hover:text-v6-dark focus:outline-none focus:ring-2 focus:ring-v6-copper">Sample report</a>
        <a href="#report-contents" class="rounded-md py-2 hover:text-v6-dark focus:outline-none focus:ring-2 focus:ring-v6-copper">What's included</a>
        <a href="#questions" class="rounded-md py-2 hover:text-v6-dark focus:outline-none focus:ring-2 focus:ring-v6-copper">FAQs</a>
      </nav>
      <a href="#report-signup" data-ga-cta="aeo_report_header_signup" class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-lg border border-v6-copper px-4 py-2 text-sm font-semibold text-v6-copper transition-colors hover:bg-v6-copper-50 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">
        Build your AEO Report
      </a>
    </div>
  </header>

  <main>
    <section class="overflow-hidden bg-gradient-to-b from-v6-bg to-white px-4 pb-16 pt-14 sm:px-6 sm:pb-20 sm:pt-20 lg:px-8">
      <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div>
          <span class="mb-5 inline-flex rounded-full bg-v6-copper-50 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-v6-copper-700">HubSpot AEO executive reporting</span>
          <h1 class="max-w-3xl text-balance text-4xl font-bold leading-[1.08] text-v6-dark sm:text-5xl lg:text-[3.45rem]">Turn HubSpot AEO Data Into a Report ready for Review</h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-v6-text-muted">Build a complete HubSpot AEO report in 3 clicks. Choose the prompts and period, then get the result in Excel, PowerPoint, or a live dashboard—with every finding tied to the original answer and citation.</p>
          <p class="mt-5 font-semibold text-v6-dark">Run it weekly or monthly. No prompt copying. No screenshot decks.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#report-signup" data-ga-cta="aeo_report_hero_signup" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-v6-copper px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-v6-copper-600 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">Build your AEO Report</a>
            <a href="#sample-report" data-ga-cta="aeo_report_hero_sample" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-v6-border bg-white px-7 py-3.5 text-base font-semibold text-v6-dark transition-colors hover:border-v6-copper hover:bg-v6-copper-50 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">View the sample AEO report</a>
          </div>
          <p class="mx-auto mt-4 max-w-xl text-center text-sm font-semibold leading-relaxed text-v6-dark">No credit card required. Your first month is on us.</p>
        </div>

        <div class="relative lg:pt-5" aria-label="Example AEO performance report for an August client review">
          <div class="absolute -inset-6 -z-10 rounded-full bg-v6-teal-100/70 blur-3xl"></div>
          <div class="overflow-hidden rounded-2xl border border-v6-border bg-white shadow-xl shadow-v6-dark/10">
            <div class="flex items-center justify-between gap-4 border-b border-v6-border px-5 py-4">
              <div><p class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-copper">AEO performance report</p><p class="mt-1 font-semibold text-v6-dark">August client review</p></div>
              <span class="rounded-full bg-v6-blue-50 px-3 py-1 text-xs font-semibold text-v6-blue-800">Example data</span>
            </div>
            <div class="grid grid-cols-2 border-b border-v6-border sm:grid-cols-4">
              <div class="border-b border-r border-v6-border p-4 sm:border-b-0 sm:p-5"><p class="text-xs text-v6-text-muted">Tracked prompts</p><p class="mt-1 text-xl font-bold text-v6-dark">24</p></div>
              <div class="border-b border-v6-border p-4 sm:border-b-0 sm:border-r sm:p-5"><p class="text-xs text-v6-text-muted">AI answers checked</p><p class="mt-1 text-xl font-bold text-v6-dark">72</p></div>
              <div class="border-r border-v6-border bg-v6-copper-50 p-4 sm:p-5"><p class="text-xs text-v6-copper-800">Answers that mention your brand</p><p class="mt-1 text-xl font-bold text-v6-copper-800">42%</p></div>
              <div class="p-4 sm:p-5"><p class="text-xs text-v6-text-muted">Total citations</p><p class="mt-1 text-xl font-bold text-v6-dark">86</p></div>
            </div>
            <div class="p-5">
              <div class="rounded-xl bg-v6-bg-warm p-4">
                <p class="text-xs font-semibold uppercase tracking-[0.12em] text-v6-copper-800">Important finding</p>
                <p class="mt-2 text-sm font-semibold leading-relaxed text-v6-dark">Your brand appeared more often in research questions. Seven buying-decision answers mentioned competitors but not you.</p>
              </div>
            </div>
            <div class="grid grid-cols-1 gap-px border-t border-v6-border bg-v6-border text-center text-xs font-semibold text-v6-text-muted sm:grid-cols-3"><span class="bg-v6-bg px-4 py-3">Excel workbook</span><span class="bg-v6-bg px-4 py-3">PowerPoint deck</span><span class="bg-v6-bg px-4 py-3">Live dashboard</span></div>
          </div>
        </div>
      </div>
    </section>

    <ClientLogoStrip caption="HubSpot and revenue operations work trusted by teams at" />

    <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8" aria-labelledby="aeo-problem-heading">
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">The recurring rebuild</p>
          <h2 id="aeo-problem-heading" class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">The AEO data is in HubSpot. The executive report is still built by hand.</h2>
        </div>
        <div class="space-y-5 text-lg leading-relaxed text-v6-text-muted">
          <p>The prompts, AI answers, citations, competitor mentions, and recommendations may already be in HubSpot. The report still has to be assembled for the people who need to understand what changed and decide what happens next.</p>
          <p>Someone exports the rows, groups the questions, checks the answers, copies examples into slides, and tries to keep the client deck tied to the source material. Then the same work starts again for the next period.</p>
          <p class="font-semibold text-v6-dark">SWOTBee keeps the working file, meeting deck, and live view together, so the next report starts with fresh AEO data—not another blank presentation.</p>
        </div>
      </div>
    </section>

    <section id="how-it-works" class="scroll-mt-8 bg-v6-bg px-4 py-16 sm:px-6 sm:py-20 lg:px-8" aria-labelledby="three-click-heading">
      <div class="mx-auto max-w-5xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">A reusable AEO review</p>
          <h2 id="three-click-heading" class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">Set up the report once. Run it again next week or next month.</h2>
          <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">Build the first report in 3 steps. Choose the scope. Choose your KPIs. Get your report.</p>
        </div>
        <ol class="mt-10 grid gap-6 md:grid-cols-3">
          <li class="rounded-2xl border border-v6-border bg-white p-6"><span class="text-sm font-bold text-v6-copper">01</span><h3 class="mt-3 text-xl font-bold text-v6-dark">Choose the scope</h3><p class="mt-2 leading-relaxed text-v6-text-muted">Select the business unit, reporting period, comparison, AI engines, buying stages, and prompts that belong in the review.</p></li>
          <li class="rounded-2xl border border-v6-border bg-white p-6"><span class="text-sm font-bold text-v6-copper">02</span><h3 class="mt-3 text-xl font-bold text-v6-dark">Pick the questions to answer</h3><p class="mt-2 leading-relaxed text-v6-text-muted">Pick the KPIs for the review: coverage, brand and competitor mentions, citations, engine results, and recommendations.</p></li>
          <li class="rounded-2xl border border-v6-border bg-white p-6"><span class="text-sm font-bold text-v6-copper">03</span><h3 class="mt-3 text-xl font-bold text-v6-dark">Get your reporting pack</h3><p class="mt-2 leading-relaxed text-v6-text-muted">Get the Excel workbook, editable PowerPoint, and live dashboard from the current AEO data.</p></li>
        </ol>
        <p class="mx-auto mt-8 max-w-3xl text-center text-lg font-semibold leading-relaxed text-v6-dark">No digging through fields. No rebuilding filters. No hours copying and pasting.</p>
        <div class="mt-8 text-center"><a href="#report-signup" data-ga-cta="aeo_report_steps_signup" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-v6-copper px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-v6-copper-600 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">Build your AEO Report</a></div>
      </div>
    </section>

    <section id="report-outputs" class="scroll-mt-8 px-4 py-16 sm:px-6 sm:py-20 lg:px-8" aria-labelledby="outputs-heading">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-4xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">One reporting setup</p>
          <h2 id="outputs-heading" class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">One AEO report—ready in Excel, PowerPoint, or a live dashboard.</h2>
          <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">Inspect the prompts and citations in Excel. Present the decisions in PowerPoint. Share the live dashboard when people want to explore the evidence.</p>
        </div>
        <div class="mt-10 grid gap-6 lg:grid-cols-3">
          <article class="overflow-hidden rounded-2xl border border-v6-border bg-white"><div class="border-b border-v6-border p-6 sm:p-8"><p class="text-sm font-semibold uppercase tracking-[0.14em] text-v6-teal-700">Excel workbook</p><h3 class="mt-3 text-2xl font-bold text-v6-dark">Every prompt, answer, and citation—already organised</h3><p class="mt-4 leading-relaxed text-v6-text-muted">Open a clean workbook with the scorecard, prompt-level evidence, citation sources, recommendations, owners, and data notes already in place.</p></div><div class="bg-v6-bg p-5 sm:p-7"><div class="overflow-hidden rounded-xl border border-v6-border bg-white text-sm"><div class="flex gap-1 border-b border-v6-border bg-v6-bg p-2"><span class="rounded bg-white px-3 py-2 font-semibold text-v6-dark shadow-sm">Summary</span><span class="px-3 py-2 text-v6-text-muted">Prompts</span><span class="px-3 py-2 text-v6-text-muted">Sources</span></div><div class="grid grid-cols-3 gap-px bg-v6-border text-v6-text-muted"><span class="bg-white p-3 font-semibold">Platform</span><span class="bg-white p-3 font-semibold">Answers</span><span class="bg-white p-3 font-semibold">Brand</span><span class="bg-white p-3">ChatGPT</span><span class="bg-white p-3">24</span><span class="bg-white p-3 font-semibold text-v6-dark">46%</span></div></div></div></article>
          <article class="overflow-hidden rounded-2xl border border-v6-border bg-white"><div class="border-b border-v6-border p-6 sm:p-8"><p class="text-sm font-semibold uppercase tracking-[0.14em] text-v6-blue">PowerPoint deck</p><h3 class="mt-3 text-2xl font-bold text-v6-dark">The executive story, ready to present and edit</h3><p class="mt-4 leading-relaxed text-v6-text-muted">Edit the language, remove detail, or add client context while keeping each slide connected to the underlying answers.</p></div><div class="bg-v6-bg p-5 sm:p-7"><div class="mx-auto max-w-md rounded-xl border border-v6-border bg-white p-5 shadow-sm"><p class="text-xs font-semibold uppercase tracking-wide text-v6-copper">August AEO review</p><p class="mt-2 text-xl font-bold text-v6-dark">Brand mentions rose by 6 points.</p><p class="mt-2 text-sm text-v6-text-muted">Seven buying-decision answers still named competitors but not you.</p><div class="mt-5 flex h-16 items-end gap-3"><span class="h-8 flex-1 rounded-t bg-v6-blue-200"></span><span class="h-11 flex-1 rounded-t bg-v6-blue-300"></span><span class="h-14 flex-1 rounded-t bg-v6-teal"></span></div></div></div></article>
          <article class="overflow-hidden rounded-2xl border border-v6-border bg-white"><div class="border-b border-v6-border p-6 sm:p-8"><p class="text-sm font-semibold uppercase tracking-[0.14em] text-v6-copper">Live dashboard</p><h3 class="mt-3 text-2xl font-bold text-v6-dark">The latest approved view, ready to share</h3><p class="mt-4 leading-relaxed text-v6-text-muted">Give clients or leadership a current view of the approved measures, with the ability to drill down if required.</p></div><div class="bg-v6-bg p-5 sm:p-7"><div class="mx-auto max-w-md overflow-hidden rounded-xl border border-v6-border bg-white shadow-sm"><div class="flex items-center justify-between border-b border-v6-border px-4 py-3"><div><p class="text-xs font-semibold uppercase tracking-wide text-v6-copper">Shared AEO view</p><p class="mt-1 text-sm font-bold text-v6-dark">Current results</p></div><span class="rounded-full bg-v6-teal-50 px-2.5 py-1 text-xs font-semibold text-v6-teal-800">Live</span></div><div class="grid grid-cols-2 gap-px bg-v6-border"><div class="bg-white p-4"><p class="text-xs text-v6-text-muted">Brand mentioned</p><p class="mt-1 text-xl font-bold text-v6-dark">42%</p></div><div class="bg-white p-4"><p class="text-xs text-v6-text-muted">Citations</p><p class="mt-1 text-xl font-bold text-v6-dark">86</p></div></div><p class="px-4 py-3 text-xs text-v6-text-muted">Open any result to see the supporting answer</p></div></div></article>
        </div>
      </div>
    </section>

    <section id="sample-report" class="scroll-mt-8 bg-v6-bg px-4 py-16 sm:px-6 sm:py-20 lg:px-8" aria-labelledby="sample-report-heading">
      <div class="mx-auto max-w-6xl">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-3xl">
            <div class="flex flex-wrap items-center gap-3"><p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">Sample AEO report</p><span class="rounded-full border border-v6-copper-200 bg-v6-copper-50 px-2.5 py-1 text-xs font-semibold text-v6-copper-800">Example data</span></div>
            <h2 id="sample-report-heading" class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">Start with the headline. Open the prompt when someone asks why.</h2>
            <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">The summary, original AI answers, citations, and recommended work stay connected. The figures below are sample data.</p>
          </div>
          <a href="#report-signup" data-ga-cta="aeo_report_sample_signup" class="inline-flex min-h-11 items-center justify-center self-start rounded-xl border border-v6-copper px-5 py-3 text-sm font-semibold text-v6-copper transition-colors hover:bg-v6-copper-50 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2 lg:self-auto">Build your AEO Report</a>
        </div>

        <div class="mt-10 overflow-hidden rounded-2xl border border-v6-border bg-white shadow-sm">
          <div class="flex flex-col gap-4 border-b border-v6-border px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-7">
            <div><p class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-text-muted">AEO client report</p><h3 class="mt-1 text-xl font-bold text-v6-dark">August 2026</h3><p class="mt-1 text-sm text-v6-text-muted">Compared with July 2026</p></div>
            <span class="self-start rounded-full bg-v6-blue-50 px-3 py-1.5 text-xs font-semibold text-v6-blue-800 sm:self-auto">Example data</span>
          </div>

          <div class="grid gap-px bg-v6-border sm:grid-cols-2 lg:grid-cols-4">
            <div class="bg-white p-5 sm:p-6"><p class="text-sm text-v6-text-muted">Tracked prompts</p><p class="mt-2 text-2xl font-bold text-v6-dark">24</p></div>
            <div class="bg-white p-5 sm:p-6"><p class="text-sm text-v6-text-muted">AI answers checked</p><p class="mt-2 text-2xl font-bold text-v6-dark">72 of 72</p></div>
            <div class="bg-v6-copper-50 p-5 sm:p-6"><p class="text-sm text-v6-copper-800">Answers that mention your brand</p><div class="mt-2 flex items-end justify-between gap-3"><p class="text-2xl font-bold text-v6-copper-800">42%</p><span class="text-sm font-semibold text-v6-teal-800">Up 6 points</span></div></div>
            <div class="bg-white p-5 sm:p-6"><p class="text-sm text-v6-text-muted">Citations</p><div class="mt-2 flex items-end justify-between gap-3"><p class="text-2xl font-bold text-v6-dark">86</p><span class="text-sm font-semibold text-v6-text-muted">23 owned</span></div></div>
          </div>

          <div class="border-t border-v6-border p-5 sm:p-7">
            <article class="rounded-xl border border-v6-copper-200 bg-v6-copper-50 p-5">
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-copper-800">Sample insight</p>
              <p class="mt-3 text-lg font-bold leading-relaxed text-v6-dark">Your brand appeared more often in research questions. It was still missing from several buying-decision answers, particularly in ChatGPT and Gemini.</p>
            </article>
          </div>

          <div class="border-t border-v6-border p-5 sm:p-7">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"><h4 class="text-lg font-bold text-v6-dark">Prompt evidence</h4><span class="text-xs font-semibold uppercase tracking-[0.12em] text-v6-text-muted">Sample data</span></div>
            <div class="mt-4 hidden overflow-x-auto rounded-xl border border-v6-border lg:block">
              <table class="w-full min-w-[1040px] border-collapse text-left text-sm">
                <thead class="bg-v6-bg text-xs uppercase tracking-wide text-v6-text-muted"><tr><th class="px-4 py-3 font-semibold">Prompt</th><th class="px-4 py-3 font-semibold">Engine</th><th class="px-4 py-3 font-semibold">Brand result</th><th class="px-4 py-3 font-semibold">Citations</th><th class="px-4 py-3 font-semibold">Finding</th><th class="px-4 py-3 font-semibold">Next action</th></tr></thead>
                <tbody class="divide-y divide-v6-border">
                  {promptRows.map((row) => (
                    <tr><td class="max-w-xs px-4 py-4 font-semibold text-v6-dark">{row.prompt}</td><td class="px-4 py-4 text-v6-text-muted">{row.engine}</td><td class="px-4 py-4 text-v6-dark">{row.brandResult}</td><td class="px-4 py-4 font-semibold text-v6-dark">{row.citations}</td><td class="max-w-xs px-4 py-4 text-v6-text-muted">{row.finding}</td><td class="max-w-xs px-4 py-4 text-v6-dark">{row.nextAction}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
            <div class="mt-4 space-y-3 lg:hidden">
              {promptRows.map((row) => (
                <article class="rounded-xl border border-v6-border p-4">
                  <div class="flex items-start justify-between gap-4"><h5 class="font-semibold leading-relaxed text-v6-dark">{row.prompt}</h5><span class="rounded-full bg-v6-blue-50 px-2.5 py-1 text-xs font-semibold text-v6-blue-800">{row.engine}</span></div>
                  <dl class="mt-4 space-y-3 text-sm">
                    <div><dt class="font-semibold text-v6-dark">Brand result</dt><dd class="mt-1 text-v6-text-muted">{row.brandResult}</dd></div>
                    <div><dt class="font-semibold text-v6-dark">Citations</dt><dd class="mt-1 text-v6-text-muted">{row.citations}</dd></div>
                    <div><dt class="font-semibold text-v6-dark">Finding</dt><dd class="mt-1 text-v6-text-muted">{row.finding}</dd></div>
                    <div><dt class="font-semibold text-v6-dark">Next action</dt><dd class="mt-1 text-v6-text-muted">{row.nextAction}</dd></div>
                  </dl>
                </article>
              ))}
            </div>
          </div>

          <div class="border-t border-v6-border bg-v6-bg p-5 sm:p-7">
            <article class="rounded-2xl border border-v6-copper-200 bg-white p-5 sm:p-6">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"><div><p class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-copper">Sample recommendation</p><h4 class="mt-1 text-xl font-bold text-v6-dark">Action: Update content</h4></div><span class="self-start rounded-full bg-v6-copper-50 px-3 py-1.5 text-xs font-semibold text-v6-copper-800 sm:self-auto">Priority: High</span></div>
              <dl class="mt-5 grid gap-4 text-sm sm:grid-cols-2 lg:grid-cols-3">
                <div><dt class="font-semibold text-v6-dark">Channel</dt><dd class="mt-1 text-v6-text-muted">Owned content</dd></div>
                <div><dt class="font-semibold text-v6-dark">Questions affected</dt><dd class="mt-1 text-v6-text-muted">7 buying-decision questions</dd></div>
                <div class="sm:col-span-2 lg:col-span-1"><dt class="font-semibold text-v6-dark">Recommendation</dt><dd class="mt-1 text-v6-text-muted">Add a current comparison section with named use cases, implementation detail, and evidence.</dd></div>
              </dl>
              <p class="mt-5 rounded-xl bg-v6-bg-warm p-4 text-sm leading-relaxed text-v6-text-muted"><strong class="text-v6-dark">Reason:</strong> AI answers cited competitor comparison pages 11 times and your comparison page 3 times.</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section id="report-contents" class="scroll-mt-8 px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">Built around the AEO review</p>
          <h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">Bring the result, the evidence, and the next steps into one report</h2>
          <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">See where the brand appears, where competitors have the advantage, which sources are being cited, and what the team should do next.</p>
        </div>
        <div class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-v6-border bg-v6-border md:grid-cols-2 lg:grid-cols-3">
          {reportAreas.map((area, index) => (
            <article class="bg-white p-6 sm:p-7"><span class="text-sm font-bold text-v6-copper">{String(index + 1).padStart(2, "0")}</span><h3 class="mt-3 text-xl font-bold text-v6-dark">{area.title}</h3><p class="mt-3 leading-relaxed text-v6-text-muted">{area.description}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8" aria-label="AEO comparisons and history">
      <div class="mx-auto grid max-w-6xl overflow-hidden rounded-2xl border border-v6-border bg-v6-border lg:grid-cols-2">
        <article class="bg-white p-7 sm:p-9">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">Consistent comparisons</p>
          <h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark">Compare this month's AEO performance with:</h2>
          <ul class="mt-6 space-y-2 rounded-xl bg-v6-bg-warm px-5 py-4 text-lg font-semibold text-v6-dark" aria-label="Available comparison periods">
            <li><span class="mr-2 text-v6-copper-800">1.</span>Last month</li>
            <li><span class="mr-2 text-v6-copper-800">2.</span>The same month last year</li>
            <li><span class="mr-2 text-v6-copper-800">3.</span>Any period you choose</li>
          </ul>
        </article>
        <article class="border-t border-v6-border bg-white p-7 sm:p-9 lg:border-l lg:border-t-0">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">Point-in-time history</p>
          <h2 class="mt-3 text-balance text-3xl font-bold text-v6-dark">Keep the AEO history you will need next quarter.</h2>
          <p class="mt-6 rounded-xl bg-v6-bg-warm px-5 py-4 text-lg font-semibold leading-relaxed text-v6-dark">SWOTBee saves each reporting cutoff, so you can compare AEO performance over time.</p>
        </article>
      </div>
    </section>

    <section class="bg-v6-dark px-4 py-16 text-white sm:px-6 sm:py-20 lg:px-8" aria-labelledby="reporting-benefits-heading">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper-200">Built for the people who get things done</p>
          <h2 id="reporting-benefits-heading" class="mt-3 text-balance text-3xl font-bold sm:text-4xl">Spend less time building the report. Make more of the review.</h2>
        </div>
        <div class="mt-10 grid overflow-hidden rounded-2xl border border-white/10 sm:grid-cols-2">
          <article class="p-7 sm:p-8">
            <p class="text-sm font-bold uppercase tracking-[0.14em] text-v6-copper-200">01 · Time back</p>
            <h3 class="mt-4 text-balance text-2xl font-bold leading-snug">Get hours of copy-and-paste time back. Every week.</h3>
          </article>
          <article class="border-t border-white/10 p-7 sm:border-l sm:border-t-0 sm:p-8">
            <p class="text-sm font-bold uppercase tracking-[0.14em] text-v6-copper-200">02 · A reliable rhythm</p>
            <h3 class="mt-4 text-balance text-2xl font-bold leading-snug">Stop rebuilding the report. We run it for you every week.</h3>
          </article>
          <article class="border-t border-white/10 p-7 sm:p-8">
            <p class="text-sm font-bold uppercase tracking-[0.14em] text-v6-copper-200">03 · Less HubSpot admin</p>
            <h3 class="mt-4 text-balance text-2xl font-bold leading-snug">Get the report without wrestling with HubSpot fields, filters, and settings.</h3>
          </article>
          <article class="border-t border-white/10 p-7 sm:border-l sm:p-8">
            <p class="text-sm font-bold uppercase tracking-[0.14em] text-v6-copper-200">04 · Clearer decisions</p>
            <h3 class="mt-4 text-balance text-2xl font-bold leading-snug">Turn findings into clear decisions and next steps.</h3>
          </article>
        </div>
      </div>
    </section>

    <section id="questions" class="scroll-mt-8 px-4 py-16 sm:px-6 sm:py-20 lg:px-8" aria-labelledby="aeo-faq-heading">
      <div class="mx-auto max-w-3xl">
        <div class="text-center"><p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">Questions about the report</p><h2 id="aeo-faq-heading" class="mt-3 text-3xl font-bold text-v6-dark sm:text-4xl">HubSpot AEO reporting questions</h2></div>
        <div class="mt-10 divide-y divide-v6-border border-y border-v6-border">
          {faqs.map((item) => (
            <details class="group py-5"><summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-5 rounded-md font-semibold text-v6-dark focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2"><span>{item.q}</span><span class="text-xl font-normal text-v6-copper transition-transform group-open:rotate-45" aria-hidden="true">+</span></summary><p class="max-w-2xl pb-1 pr-8 pt-3 leading-relaxed text-v6-text-muted">{item.a}</p></details>
          ))}
        </div>
      </div>
    </section>

    <section id="report-signup" class="scroll-mt-8 bg-gradient-to-br from-v6-copper to-v6-copper-600 px-4 py-16 sm:px-6 sm:py-20 lg:px-8" aria-labelledby="aeo-signup-heading">
      <div class="mx-auto max-w-2xl text-center text-white">
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-white/70">App signup</p>
        <h2 id="aeo-signup-heading" class="text-balance text-2xl font-bold sm:text-3xl">Have the AEO report ready before the meeting starts</h2>
        <p class="mx-auto mb-4 mt-4 max-w-2xl text-balance text-base leading-relaxed text-v6-copper-50 sm:text-lg">Use your work email to create your SWOTBee account and start building the report.</p>
        <ReportSignupDialog
          offerCode="hubspot_aeo_reporting_export"
          reportName="HubSpot AEO reporting export"
          sourcePage="hubspot-aeo-reporting-export"
          ctaLabel="aeo_report_signup"
          buttonLabel="Build your AEO Report"
        />
        <p class="mt-4 text-xs text-v6-copper-50">No card required. Signing up does not connect to or access your HubSpot portal.</p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
