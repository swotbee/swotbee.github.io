---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/astro/Footer.astro";
import LogoHoneycomb from "../components/astro/LogoHoneycomb.astro";
import ClientLogoStrip from "../components/astro/ClientLogoStrip.astro";
import ReportSignup from "../components/astro/ReportSignup.astro";
import ReportOutputIcon from "../components/astro/ReportOutputIcon.astro";
import EditableReportHero from "../components/astro/EditableReportHero.astro";

const title = "Turn HubSpot AEO Data Into Excel and PowerPoint";
const description = "Turn HubSpot AEO prompts, AI responses, citations, competitor mentions, and recommendations into Excel, PowerPoint, or a live dashboard.";

const promptRows = [
  {
    prompt: "Which CRM is best for a growing B2B service company?",
    engine: "ChatGPT",
    brandResult: "Mentioned",
    citations: "4",
    finding: "Your comparison guide was cited",
    nextAction: "Refresh the guide with current integrations",
  },
  {
    prompt: "How should a RevOps team report pipeline changes?",
    engine: "Gemini",
    brandResult: "Not mentioned",
    citations: "6",
    finding: "Two competitor articles cited",
    nextAction: "Create a worked pipeline-change example",
  },
  {
    prompt: "What should an executive HubSpot report include?",
    engine: "Claude",
    brandResult: "Mentioned",
    citations: "3",
    finding: "Service page cited without the brand name",
    nextAction: "Make the brand and author clearer on the cited page",
  },
];

const reportAreas = [
  { title: "Questions and AI answers", description: "The prompts selected for the report, every AI platform checked, the dated answers, and anything HubSpot could not return." },
  { title: "Brand visibility", description: "Questions that mention your brand, where it appears in the answer, and the gains or losses that matter for the review." },
  { title: "Competitor visibility", description: "Questions where competitors appear, where your brand is missing, and the pages or claims helping them earn that place." },
  { title: "Citations and source pages", description: "The websites and individual pages cited in AI answers, including your own citations and sources worth investigating." },
  { title: "Results by platform and question", description: "Clear breakdowns by AI platform, buying question, topic, business unit, or another grouping selected for the report." },
  { title: "Recommended work and owners", description: "The content or outreach work supported by the evidence, why it matters, who owns it, and when it will be reviewed." },
];

const faqs = [
  { q: "What will I get in the finished AEO report?", a: "You will get an editable workbook for the detailed work and a PowerPoint for the meeting. Depending on the data available, they can show the questions tracked, AI answers checked, results by AI platform, mentions of your brand and competitors, cited sources, recommended work, and agreed actions." },
  { q: "Can I export HubSpot AEO prompts to Excel?", a: "Yes. The workbook can include the questions you track, dated AI answers, cited sources, search queries, brand and competitor mentions, recommendations, and notes about what was included." },
  { q: "Can I use it for a client or executive meeting?", a: "Yes. The presentation is editable, and you decide which changes, missing brand mentions, useful sources, and next actions the audience needs to see. The workbook stays available when someone wants the detail behind a slide." },
  { q: "Can I share a live AEO dashboard?", a: "Yes. A live dashboard can show the latest approved AEO measures and let colleagues or clients inspect the prompts and evidence behind them. It uses the same report setup as the Excel workbook and PowerPoint." },
  { q: "Will the original AI answers and citations be included?", a: "They can be when HubSpot returns them for the period you selected. The report can include the question, AI platform, full answer, cited URLs and titles, and the search queries used." },
  { q: "What happens when a metric is not available through the API?", a: "The report says it is unavailable. It does not turn missing data into zero or present an independently calculated value as a native HubSpot metric. HubSpot currently documents the AEO API as a public beta, so fields and availability may change." },
  { q: "How far back can the report compare?", a: "It can use prompt runs that HubSpot has already collected and preserve future reporting cutoffs. It cannot recreate an AI response that was never captured, so comparisons become more useful as consistent runs accumulate." },
  { q: "Will signing up connect my HubSpot account?", a: "No. This signup records your work email and requested report so we can contact you about access. It does not create an app account or connect to your HubSpot portal." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Layout
  title={title}
  description={description}
  keywords="HubSpot AEO reporting export, export HubSpot AEO prompts to Excel, HubSpot AEO report, HubSpot AI visibility report, HubSpot AEO prompts CSV, AEO client reporting, ChatGPT visibility report, HubSpot AEO PowerPoint report, recurring AEO reporting"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <header class="border-b border-v6-border bg-white">
    <div class="mx-auto flex min-h-16 max-w-6xl items-center justify-between gap-6 px-4 py-2 sm:px-6 lg:px-8">
      <a href="/" class="flex min-h-11 shrink-0 items-center gap-2 rounded-md focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2" aria-label="SWOTbee home">
        <LogoHoneycomb width={32} height={30} />
        <span class="text-lg font-bold text-v6-dark">SWOT<span class="text-v6-teal-700">bee</span></span>
      </a>
      <nav class="hidden items-center gap-6 text-sm font-semibold text-v6-text-muted lg:flex" aria-label="Page navigation">
        <a href="#how-it-works" class="rounded-md py-2 hover:text-v6-dark focus:outline-none focus:ring-2 focus:ring-v6-copper">How it works</a>
        <a href="#sample-report" class="rounded-md py-2 hover:text-v6-dark focus:outline-none focus:ring-2 focus:ring-v6-copper">Sample report</a>
        <a href="#report-contents" class="rounded-md py-2 hover:text-v6-dark focus:outline-none focus:ring-2 focus:ring-v6-copper">What's included</a>
        <a href="#questions" class="rounded-md py-2 hover:text-v6-dark focus:outline-none focus:ring-2 focus:ring-v6-copper">FAQs</a>
      </nav>
      <a href="#report-signup" data-ga-cta="aeo_report_header_signup" class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-lg border border-v6-copper px-4 py-2 text-sm font-semibold text-v6-copper transition-colors hover:bg-v6-copper-50 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">
        Get your first AEO Report
      </a>
    </div>
  </header>

  <main>
    <section class="relative isolate overflow-hidden bg-white pb-8 pt-14 sm:pb-12 sm:pt-20">
      <div class="relative z-10 mx-auto w-full max-w-7xl px-4 text-center sm:px-6 lg:px-8">
        <div class="mx-auto flex w-full max-w-5xl flex-col items-center">
          <span class="mb-5 inline-flex rounded-full bg-v6-copper-50 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-v6-copper-700">HubSpot AEO executive reporting</span>
          <h1 class="relative isolate max-w-5xl text-balance text-4xl leading-[1.12] tracking-tight text-v6-dark sm:text-6xl" style="font-family: 'Rokkitt Variable', 'Vollkorn', serif; font-weight: 800;">
            <span aria-hidden="true" class="pointer-events-none absolute -inset-x-12 -inset-y-8 -z-10 rounded-[50%] bg-[radial-gradient(ellipse_at_center,rgba(226,177,148,0.34),rgba(244,221,207,0.18)_48%,transparent_72%)] blur-xl sm:-inset-x-24"></span>
            Turn HubSpot AEO Data Into <br class="hidden sm:inline" />
            <span class="relative mt-1 inline-block">
              <span class="bg-gradient-to-r from-v6-copper-700 via-[#b47a1b] to-[#c8644a] bg-clip-text text-transparent drop-shadow-[0_2px_10px_rgba(200,100,74,0.14)]">your Report in 3 Clicks</span>
              <svg class="absolute -bottom-2 left-0 h-3 w-full text-[#c8644a]/45" viewBox="0 0 300 12" fill="none" preserveAspectRatio="none" aria-hidden="true">
                <path d="M 5,9 C 80,2 220,2 295,9" stroke="currentColor" stroke-width="4" stroke-linecap="round"></path>
              </svg>
            </span>
          </h1>
          <p class="mt-6 max-w-4xl text-balance text-lg leading-relaxed text-v6-text-muted">Build a complete HubSpot AEO report ready for that executive review. Choose the prompts and period, then get the result in Excel, PowerPoint, or a live dashboard—with every finding tied to the original answer and citation.</p>
          <div class="mt-6 flex w-full flex-col items-center justify-center gap-3 sm:w-auto sm:flex-row">
            <a href="#report-signup" data-ga-cta="aeo_report_hero_signup" class="group inline-flex min-h-12 w-full items-center justify-center gap-2.5 rounded-2xl bg-gradient-to-r from-[#a94f1d] via-[#994418] to-[#873914] px-7 py-3.5 text-base font-extrabold text-white shadow-[0_12px_28px_-10px_rgba(169,79,29,0.58)] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_0_32px_rgba(169,79,29,0.32)] focus:outline-none focus:ring-2 focus:ring-[#a94f1d] focus:ring-offset-2 active:translate-y-0 active:scale-[0.98] motion-reduce:transition-colors motion-reduce:hover:translate-y-0 sm:w-auto">
              <span>Get your first AEO Report</span>
              <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M4.167 10h11.666m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
            {/* <a href="#sample-report" data-ga-cta="aeo_report_hero_sample" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-v6-border bg-white px-7 py-3.5 text-base font-semibold text-v6-dark transition-colors hover:border-v6-copper hover:bg-v6-copper-50 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">View the sample AEO report</a> */}
          </div>
          <p class="mt-5 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-xs font-semibold text-v6-text-muted">
            <span class="inline-flex items-center gap-2">Run it weekly or monthly.<span class="h-1 w-1 rounded-full bg-v6-border" aria-hidden="true"></span></span>
            <span class="inline-flex items-center gap-2">No prompt copying.<span class="h-1 w-1 rounded-full bg-v6-border" aria-hidden="true"></span></span>
            <span>No screenshot decks.</span>
          </p>
        </div>
      </div>

      <div class="relative mx-auto mt-0 w-3/4 max-w-[78rem] sm:-mt-2 lg:-mt-6" aria-label="HubSpot reporting workspace connected to PowerPoint and Excel outputs">
        <EditableReportHero
          class="relative z-10 mx-auto h-auto w-4/5 drop-shadow-[0_24px_28px_rgba(169,79,29,0.14)]"
        />
      </div>

      <div class="relative z-10 mx-auto mt-2 grid w-[calc(100%-2rem)] max-w-xl grid-cols-3 divide-x divide-v6-border/70 rounded-2xl border border-white/80 bg-white/60 p-2 shadow-sm shadow-v6-dark/5 backdrop-blur-md" aria-label="Report outputs">
        <div class="flex min-w-0 flex-col items-center gap-2 px-2 py-2 text-center sm:flex-row sm:gap-3 sm:px-4 sm:text-left">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-v6-blue-50/80 text-v6-blue">
            <ReportOutputIcon type="dashboard" class="h-8 w-8" />
          </span>
          <span class="text-xs font-medium leading-tight text-v6-text-muted sm:text-sm">Live dashboard</span>
        </div>
        <div class="flex min-w-0 flex-col items-center gap-2 px-2 py-2 text-center sm:flex-row sm:gap-3 sm:px-4 sm:text-left">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-[#edf6f1]">
            <ReportOutputIcon type="excel" class="h-8 w-8" />
          </span>
          <span class="text-xs font-medium leading-tight text-v6-text-muted sm:text-sm">Excel workbook</span>
        </div>
        <div class="flex min-w-0 flex-col items-center gap-2 px-2 py-2 text-center sm:flex-row sm:gap-3 sm:px-4 sm:text-left">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-[#fff3ef]">
            <ReportOutputIcon type="powerpoint" class="h-8 w-8" />
          </span>
          <span class="text-xs font-medium leading-tight text-v6-text-muted sm:text-sm">PowerPoint deck</span>
        </div>
      </div>
    </section>

    <ClientLogoStrip caption="HubSpot and revenue operations work trusted by teams at" />

    <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8" aria-labelledby="aeo-problem-heading">
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">The recurring rebuild</p>
          <h2 id="aeo-problem-heading" class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">The AEO data is in HubSpot. The executive report is still built by hand.</h2>
        </div>
        <div class="space-y-5 text-lg leading-relaxed text-v6-text-muted">
          <p>The prompts, AI answers, citations, competitor mentions, and recommendations may already be in HubSpot. The report still has to be assembled for the people who need to understand what changed and decide what happens next.</p>
          <p>Someone exports the rows, groups the questions, checks the answers, copies examples into slides, and tries to keep the client deck tied to the source material. Then the same work starts again for the next period.</p>
          <p class="font-semibold text-v6-dark">SWOTBee keeps the working file, meeting deck, and live view together, so the next report starts with fresh AEO data—not another blank presentation.</p>
        </div>
      </div>
    </section>

    <section id="how-it-works" class="scroll-mt-8 bg-v6-bg px-4 py-16 sm:px-6 sm:py-20 lg:px-8" aria-labelledby="three-click-heading">
      <div class="mx-auto max-w-5xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">A reusable AEO review</p>
          <h2 id="three-click-heading" class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">Set up the report once. Run it again next week or next month.</h2>
          <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">Build the first report in 3 steps. Choose the scope. Choose your KPIs. Get your report.</p>
        </div>
        <ol class="mt-10 grid gap-6 md:grid-cols-3">
          <li class="rounded-2xl border border-v6-border bg-white p-6"><span class="text-sm font-bold text-v6-copper">01</span><h3 class="mt-3 text-xl font-bold text-v6-dark">Choose the scope</h3><p class="mt-2 leading-relaxed text-v6-text-muted">Select the business unit, reporting period, comparison, AI engines, buying stages, and prompts that belong in the review.</p></li>
          <li class="rounded-2xl border border-v6-border bg-white p-6"><span class="text-sm font-bold text-v6-copper">02</span><h3 class="mt-3 text-xl font-bold text-v6-dark">Pick the questions to answer</h3><p class="mt-2 leading-relaxed text-v6-text-muted">Pick the KPIs for the review: coverage, brand and competitor mentions, citations, engine results, and recommendations.</p></li>
          <li class="rounded-2xl border border-v6-border bg-white p-6"><span class="text-sm font-bold text-v6-copper">03</span><h3 class="mt-3 text-xl font-bold text-v6-dark">Get your reporting pack</h3><p class="mt-2 leading-relaxed text-v6-text-muted">Get the Excel workbook, editable PowerPoint, and live dashboard from the current AEO data.</p></li>
        </ol>
        <p class="mx-auto mt-8 max-w-3xl text-center text-lg font-semibold leading-relaxed text-v6-dark">No digging through fields. No rebuilding filters. No hours copying and pasting.</p>
        <div class="mt-8 text-center"><a href="#report-signup" data-ga-cta="aeo_report_steps_signup" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-v6-copper px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-v6-copper-600 focus:outline-none focus:ring-2 focus:ring-v6-copper focus:ring-offset-2">Get your first AEO Report</a></div>
      </div>
    </section>

    <section id="report-outputs" class="scroll-mt-8 px-4 py-16 sm:px-6 sm:py-20 lg:px-8" aria-labelledby="outputs-heading">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-4xl text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">One connected reporting system</p>
          <h2 id="outputs-heading" class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">One report. Three connected ways to use it.</h2>
          <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">Inspect the evidence in Excel, present the story in PowerPoint, and share the live dashboard. Every view stays tied to the same approved AEO data.</p>
        </div>

        <div class="mx-auto mt-10 flex max-w-3xl flex-col gap-4 rounded-2xl bg-v6-dark px-5 py-5 text-white shadow-lg shadow-v6-dark/10 sm:flex-row sm:items-center sm:justify-between sm:px-6">
          <div class="flex items-center gap-4">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-white/10" aria-hidden="true">
              <svg viewBox="0 0 48 48" class="h-8 w-8" fill="none">
                <circle cx="12" cy="24" r="5" fill="#5AAB9D"></circle>
                <circle cx="36" cy="12" r="5" fill="#6DB8D5"></circle>
                <circle cx="36" cy="36" r="5" fill="#E8A850"></circle>
                <path d="M17 22.5 31 14M17 25.5 31 34" stroke="white" stroke-width="2.5" stroke-linecap="round"></path>
              </svg>
            </span>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-v6-copper-200">Shared reporting layer</p>
              <h3 class="mt-1 text-xl font-bold">One approved AEO dataset</h3>
            </div>
          </div>
          <p class="max-w-sm text-sm leading-relaxed text-white/75 sm:text-right">The same measures and charts flow into every output.</p>
        </div>

        <div class="relative mt-10">
          <div class="pointer-events-none absolute -top-10 left-1/2 hidden h-10 border-l border-dashed border-v6-copper-300 lg:block" aria-hidden="true">
            <span class="absolute -left-1 bottom-0 h-2 w-2 rounded-full bg-v6-copper-300"></span>
          </div>

          <div class="relative grid gap-6 lg:grid-cols-2">
            <article class="overflow-hidden rounded-2xl border border-t-4 border-v6-border border-t-v6-teal bg-[#fbf9f5] shadow-lg shadow-v6-dark/5 lg:col-span-2 lg:grid lg:grid-cols-[0.72fr_1.28fr]">
              <div class="flex items-center px-5 py-6 sm:px-7 lg:py-8">
                <div class="flex items-start gap-4">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-v6-teal-50 text-sm font-bold text-v6-teal-800">1</span>
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-teal-700">Verify and Customize</p>
                    <h3 class="mt-2 flex items-center gap-3 text-2xl font-bold text-v6-dark sm:text-[1.75rem]">
                      <svg viewBox="0 0 18 18" class="h-9 w-9 shrink-0" aria-hidden="true">
                        <path d="M15.336 1C15.5119 1.00053 15.6805 1.07065 15.8049 1.19506C15.9293 1.31947 15.9995 1.48806 16 1.664V14.336C15.9995 14.5119 15.9293 14.6805 15.8049 14.8049C15.6805 14.9293 15.5119 14.9995 15.336 15H4.664C4.48806 14.9995 4.31947 14.9293 4.19506 14.8049C4.07065 14.6805 4.00052 14.5119 4 14.336V12H0.663997C0.576281 12.0006 0.489373 11.9832 0.408686 11.9488C0.327998 11.9144 0.255258 11.8637 0.194997 11.8C0.132822 11.7399 0.0834866 11.6677 0.0499707 11.588C0.0164548 11.5082 -0.000545359 11.4225 -2.66361e-06 11.336V4.664C0.000100276 4.57713 0.0178854 4.4912 0.0522695 4.41143C0.0866535 4.33166 0.136917 4.25972 0.199997 4.2C0.259681 4.13687 0.331611 4.08658 0.41139 4.05219C0.491169 4.0178 0.577122 4.00004 0.663997 4H4V1.664C4.00052 1.48806 4.07065 1.31947 4.19506 1.19506C4.31947 1.07065 4.48806 1.00053 4.664 1H15.336ZM4 8.852L4.945 10.625H6.375L4.789 8.047L6.344 5.516H4.977L4.1 7.117C4.08836 7.13263 4.07894 7.14979 4.072 7.168L4.045 7.227C3.90433 6.93967 3.761 6.65433 3.615 6.371C3.469 6.08767 3.324 5.80267 3.18 5.516H1.727L3.242 8.063L1.586 10.625H3.023L4 8.852ZM9.5 4V2H5V4H9.5ZM9.5 14V12H5V14H9.5ZM9.5 7.5V5H8V7.5H9.5ZM9.5 11V8.5H8V11H9.5ZM15 4V2H10.5V4H15ZM15 7.5V5H10.5V7.5H15ZM15 11V8.5H10.5V11H15ZM15 14V12H10.5V14H15Z" fill="#217346"></path>
                      </svg>
                      <span>Excel workbook</span>
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-v6-text-muted">Work through every prompt, answer, citation, and recommendation in a familiar spreadsheet.</p>
                  </div>
                </div>
              </div>
              <div class="overflow-hidden bg-white lg:border-l lg:border-v6-border">
                <img
                  src="/assets/reporting/aeo/workbook-preview.webp"
                  width="1200"
                  height="800"
                  loading="lazy"
                  decoding="async"
                  alt="Spreadsheet workbook with ribbon controls, formula bar, cell grid, sheet tabs, and report charts"
                  class="h-full min-h-72 w-full object-cover"
                />
              </div>
            </article>

            <article class="flex flex-col overflow-hidden rounded-2xl border border-l-4 border-v6-border border-l-v6-blue bg-[#fbf9f5] shadow-lg shadow-v6-dark/5">
              <div class="px-5 py-5 sm:px-6">
                <div class="flex items-start gap-4">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-v6-blue-50 text-sm font-bold text-v6-blue-700">2</span>
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-v6-blue">Present</p>
                    <h3 class="mt-2 flex items-center gap-3 text-2xl font-bold text-v6-dark sm:text-[1.75rem]">
                      <svg viewBox="0 0 18 18" class="h-9 w-9 shrink-0" aria-hidden="true">
