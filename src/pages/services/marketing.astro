---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/astro/Navbar.astro";
import Footer from "../../components/astro/Footer.astro";
import StructuredData from "../../components/astro/StructuredData.astro";
import LogoHoneycomb from "../../components/astro/LogoHoneycomb.astro";

// Images
import OptimizeFormsAndLandingPages from "../../assets/service_features/Optimize Forms & Landing Pages.png";
import AutomateEmailMarketingThatConverts from "../../assets/service_features/Automate Email Marketing That Converts2.png";
import AutomateMarketingAttribution from "../../assets/service_features/Automate Marketing Attribution.png";
import VisualizeYourBusinessImpact from "../../assets/service_features/Visualize Your Business Impact1.png";
import SuperchargeYourHubSpotData from "../../assets/service_features/Supercharge Your HubSpot Data2.png";
import { Picture } from "astro:assets";

const title = "HubSpot Marketing Consulting | Campaigns, Webinars & Automation";
const description = "Get your HubSpot Marketing Hub actually generating pipeline. Email sequences that convert, event workflows that run themselves, and attribution you can trust.";

const painPoints = [
  "Your email open rates are declining and you don't know why",
  "You can't tell which campaign actually drove that closed deal",
  "Your landing pages have high traffic but low conversion — forms get abandoned",
  "You have 30% duplicate contacts inflating your costs and killing segmentation",
  "Marketing says they're sending leads but sales says they're junk",
  "You're manually building reports every month instead of having dashboards that just work",
];

const processSteps = [
  { num: "1", title: "Audit", desc: "We map your current campaigns, data quality, and attribution gaps — and deliver quick wins in the first 2 weeks." },
  { num: "2", title: "Fix & Optimize", desc: "We rebuild email sequences, optimize forms, clean your data, and set up automation that runs itself." },
  { num: "3", title: "Measure & Scale", desc: "Custom dashboards show exactly what's working. We iterate and scale what drives pipeline." },
];

const services = [
  {
    title: "Email Marketing That Actually Converts",
    desc: "Multi-touch nurture sequences driven by behavioral triggers. Dynamic content personalization. Deliverability tuning (DKIM/DMARC). A/B testing that runs automatically.",
    metric: "505% return on email marketing investment",
    icon: "📧",
  },
  {
    title: "Forms & Landing Pages That Don't Leak Leads",
    desc: "Progressive profiling to shorten forms. Mobile-first responsive design. Smart content that adapts by referral source. Real-time heatmaps to find friction.",
    metric: "2× conversion improvement in 30 days",
    icon: "📝",
  },
  {
    title: "Marketing Attribution You Can Trust",
    desc: "Multi-touch models that credit every touchpoint. Server-side tracking that works despite cookie deprecation. Offline events (webinars, trade shows) included.",
    metric: "45% faster reporting, 2× more accurate forecasting",
    icon: "📊",
  },
  {
    title: "Webinar & Event Automation",
    desc: "End-to-end event workflows — from registration forms to follow-up sequences. Automated reminders, attendance tracking, and post-event nurture campaigns that run without manual effort.",
    metric: "Events that drive pipeline, not just attendance",
    icon: "🎤",
  },
  {
    title: "Dashboards & Reporting That Drive Decisions",
    desc: "Cross-object reports linking deals, contacts, and revenue. Role-specific views for executives, managers, and reps. Auto-refreshed every 15 minutes. Mobile-optimized.",
    metric: "Leaders access up-to-date KPIs instantly",
    icon: "📈",
  },
];

const faqs = [
  {
    q: "How long until we see measurable improvement?",
    a: "Most clients see quick wins in the first 2 weeks — deliverability fixes, form optimizations, and automation that starts running immediately. Larger improvements like attribution clarity and full dashboard rollout typically happen within 30-60 days.",
  },
  {
    q: "What if our HubSpot data is full of duplicates and bad records?",
    a: "That's one of the first things we tackle. We audit your database, deduplicate contacts, standardize formats, and set up ongoing hygiene automation so it stays clean. Clean data is the foundation of everything else.",
  },
  {
    q: "Do you handle campaign execution or just setup?",
    a: "Both, depending on what you need. We can set up the automation framework and train your team to run it, or we can manage execution as part of a retainer engagement. Most clients start with setup and transition to self-service.",
  },
  {
    q: "We've been burned by a marketing agency before — how are you different?",
    a: "We're not a marketing agency — we're HubSpot specialists. We don't write your blog posts or manage your ad spend. We make your Marketing Hub work properly: automation that runs, data that's clean, attribution that's accurate, and dashboards that tell the truth.",
  },
  {
    q: "How much does this cost?",
    a: "Every business is different, so we tailor our approach to your needs. We offer project-based, retainer, and hourly consulting models. Book a free 30-minute discovery call and we'll give you an honest recommendation on what makes sense for your situation.",
  },
  {
    q: "Do you work alongside our existing marketing team?",
    a: "Absolutely — we work as an extension of your team. Our goal is to make your people more effective by building the automations, dashboards, and processes they need. We provide hands-on training and documentation so your team owns everything we build.",
  },
  {
    q: "What HubSpot tiers do you work with?",
    a: "All of them — Starter, Professional, and Enterprise across Marketing, Sales, and Service Hubs. Most of our marketing clients are on Professional or Enterprise.",
  },
];

const clientLogos = ["Wesco", "Big Lots", "Insteon", "La Vie", "Mytheresa"];
---

<Layout title={title} description={description}>
  <StructuredData
    type="service"
    data={{
      name: "HubSpot Marketing Consulting Services",
      description: description,
      serviceType: "Marketing Automation Consulting",
      url: "https://swotbee.com/services/marketing",
    }}
  />
  <StructuredData type="faq" data={{ faqs }} />
  <StructuredData
    type="breadcrumb"
    data={{ breadcrumbs: [
      { name: "Home", url: "https://swotbee.com" },
      { name: "Services", url: "https://swotbee.com/services" },
      { name: "Marketing", url: "https://swotbee.com/services/marketing" },
    ]}}
  />

  <Navbar />

  <!-- ============ HERO ============ -->
  <section class="bg-gradient-to-b from-v6-bg to-white px-4 sm:px-6 lg:px-8 pt-16 sm:pt-20 pb-10 sm:pb-14">
    <div class="max-w-3xl mx-auto text-center">
      <div class="flex justify-center gap-3 mb-6">
        <span class="bg-v6-teal-50 text-v6-teal text-xs font-semibold px-3 py-1 rounded-full">HubSpot Solutions Partner</span>
        <span class="bg-v6-copper-50 text-v6-copper text-xs font-semibold px-3 py-1 rounded-full">Marketing Hub Specialists</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-v6-dark leading-tight mb-5 text-balance">
        Campaigns, Webinars, Events — All Running from <span class="text-v6-copper">One Hub</span>
      </h1>
      <p class="text-base sm:text-lg text-v6-text-muted max-w-xl mx-auto mb-8 leading-relaxed">
        Email sequences that convert. Event workflows that run themselves. Attribution you can trust. Zero wasted budget.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center mb-4">
        <a href="/contactus" class="bg-v6-copper text-white px-8 py-3.5 rounded-xl text-base font-semibold hover:bg-v6-copper-600 transition-colors text-center">
          Get a Free Marketing Audit
        </a>
        <a href="#how-we-work" class="border border-gray-300 text-v6-dark px-8 py-3.5 rounded-xl text-base font-medium hover:bg-gray-50 transition-colors text-center">
          See How We Work ↓
        </a>
      </div>
      <p class="text-xs text-gray-500">Free 30-minute consultation. No commitment. No sales pitch.</p>
    </div>
  </section>


  <!-- ============ TRUST BAR ============ -->
  <section class="bg-white border-y border-v6-border py-4 px-4">
    <div class="max-w-4xl mx-auto flex flex-wrap justify-center gap-8 items-center">
      <span class="text-xs text-gray-500 font-medium uppercase tracking-wider">Trusted by</span>
      {clientLogos.map(name => (
        <span class="text-sm text-v6-text-muted font-semibold opacity-50">{name}</span>
      ))}
    </div>
  </section>


  <!-- ============ "IS THIS YOU?" ============ -->
  <section class="bg-v6-bg py-14 sm:py-18 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-3 text-center">Sound Familiar?</h2>
      <p class="text-v6-text-muted text-center mb-8 max-w-lg mx-auto">If any of these describe your marketing team right now, we can help.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {painPoints.map(point => (
          <div class="flex gap-3 items-start bg-white rounded-lg p-4 border border-v6-border">
            <span class="text-v6-copper text-lg flex-shrink-0 mt-0.5">→</span>
            <p class="text-sm text-v6-text-muted leading-relaxed">{point}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ============ BEFORE / AFTER ============ -->
  <section class="bg-white py-14 sm:py-18 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-10 text-center">The Gap We Close</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Before -->
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
          <p class="text-sm font-semibold text-v6-text-muted uppercase tracking-wider mb-4 opacity-60">Before SWOTBee</p>
          <ul class="space-y-3">
            <li class="flex gap-2 text-sm text-v6-text-muted"><span class="text-red-400">✗</span> Emails landing in spam, open rates declining</li>
            <li class="flex gap-2 text-sm text-v6-text-muted"><span class="text-red-400">✗</span> "Which campaign drove that deal?" — nobody knows</li>
            <li class="flex gap-2 text-sm text-v6-text-muted"><span class="text-red-400">✗</span> Forms with 40% abandonment, no testing</li>
            <li class="flex gap-2 text-sm text-v6-text-muted"><span class="text-red-400">✗</span> Monthly reports built manually in spreadsheets</li>
            <li class="flex gap-2 text-sm text-v6-text-muted"><span class="text-red-400">✗</span> Webinar follow-ups done by hand, days later</li>
          </ul>
        </div>
        <!-- After -->
        <div class="bg-v6-teal-50 rounded-xl p-6 border border-v6-teal-100">
          <p class="text-sm font-semibold text-v6-teal uppercase tracking-wider mb-4">After SWOTBee</p>
          <ul class="space-y-3">
            <li class="flex gap-2 text-sm text-v6-dark"><span class="text-v6-teal">✓</span> Deliverability tuned, open rates climbing</li>
            <li class="flex gap-2 text-sm text-v6-dark"><span class="text-v6-teal">✓</span> Multi-touch attribution across every channel</li>
            <li class="flex gap-2 text-sm text-v6-dark"><span class="text-v6-teal">✓</span> Progressive profiling, mobile-first, A/B tested</li>
            <li class="flex gap-2 text-sm text-v6-dark"><span class="text-v6-teal">✓</span> Auto-refreshed dashboards for every role</li>
            <li class="flex gap-2 text-sm text-v6-dark"><span class="text-v6-teal">✓</span> Event workflows from registration to follow-up — automated</li>
          </ul>
        </div>
      </div>
    </div>
  </section>


  <!-- ============ HOW WE WORK (3 Steps) ============ -->
  <section id="how-we-work" class="bg-v6-bg py-14 sm:py-18 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-10 text-center">How We Work</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {processSteps.map(step => (
          <div class="bg-white rounded-xl p-6 border border-v6-border text-center">
            <div class="w-12 h-12 rounded-full bg-v6-copper text-white text-xl font-bold flex items-center justify-center mx-auto mb-4">{step.num}</div>
            <h3 class="text-lg font-semibold text-v6-dark mb-2">{step.title}</h3>
            <p class="text-sm text-v6-text-muted leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
      <p class="text-center text-sm text-v6-text-muted mt-6">Typical engagement: 3–6 months. Results start in the first 2 weeks.</p>
    </div>
  </section>


  <!-- ============ SERVICES ============ -->
  <section class="bg-white py-14 sm:py-18 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-3 text-center">What We Set Up for You</h2>
      <p class="text-v6-text-muted text-center mb-10 max-w-lg mx-auto">Everything your Marketing Hub needs to actually generate pipeline.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map(s => (
          <div class="bg-v6-bg rounded-xl p-6 border border-v6-border hover:shadow-lg transition-shadow">
            <div class="text-2xl mb-3">{s.icon}</div>
            <h3 class="text-base font-semibold text-v6-dark mb-2">{s.title}</h3>
            <p class="text-sm text-v6-text-muted leading-relaxed mb-3">{s.desc}</p>
            <p class="text-xs font-semibold text-v6-teal">{s.metric}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ============ TESTIMONIAL ============ -->
  <section class="bg-v6-bg py-14 sm:py-18 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-8 text-center">What Our Clients Say</h2>
      <div class="bg-white rounded-xl p-8 border border-v6-border">
        <blockquote class="text-base sm:text-lg text-v6-dark leading-relaxed italic mb-6">
          "We needed to connect our new ecommerce site to HubSpot, automate lead qualification for our distributor network, and create deal pipelines for OEM quotes that trigger production notifications on close-won. SWOTBee set up Marketing Hub sequences that send targeted content to segmented lists of specialty distributors, tracking engagement to prioritize upsells. Within two months, online quote response time dropped by 65%, and distributor satisfaction scores improved by 30%."
        </blockquote>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-v6-teal-100 flex items-center justify-center text-v6-teal font-bold text-sm">SM</div>
          <div>
            <p class="text-sm font-semibold text-v6-dark">Sales Operations Manager</p>
            <p class="text-xs text-v6-text-muted">Manufacturing Company</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ============ WHY SWOTBEE ============ -->
  <section class="bg-white py-14 sm:py-18 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-8 text-center">Why Clients Choose SWOTBee</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="flex gap-4 items-start">
          <div class="w-10 h-10 rounded-lg bg-v6-blue-50 flex items-center justify-center flex-shrink-0 text-v6-blue text-lg font-bold">1</div>
          <div>
            <h3 class="text-base font-semibold text-v6-dark mb-1">Workflow-First Approach</h3>
            <p class="text-sm text-v6-text-muted leading-relaxed">We adapt HubSpot to how your team works, so adoption is natural and changes are minimal.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <div class="w-10 h-10 rounded-lg bg-v6-copper-50 flex items-center justify-center flex-shrink-0 text-v6-copper text-lg font-bold">2</div>
          <div>
            <h3 class="text-base font-semibold text-v6-dark mb-1">Day-One Results</h3>
            <p class="text-sm text-v6-text-muted leading-relaxed">High-impact changes that show immediate ROI — not a 6-month wait for a strategy deck.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <div class="w-10 h-10 rounded-lg bg-v6-teal-50 flex items-center justify-center flex-shrink-0 text-v6-teal text-lg font-bold">3</div>
          <div>
            <h3 class="text-base font-semibold text-v6-dark mb-1">Data Quality Obsession</h3>
            <p class="text-sm text-v6-text-muted leading-relaxed">Clean data, accurate forecasts, zero missed renewals. We don't build on a bad foundation.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <div class="w-10 h-10 rounded-lg bg-v6-amber-50 flex items-center justify-center flex-shrink-0 text-v6-amber text-lg font-bold">4</div>
          <div>
            <h3 class="text-base font-semibold text-v6-dark mb-1">Built for Your Industry</h3>
            <p class="text-sm text-v6-text-muted leading-relaxed">Tools and integrations built for Energy, Manufacturing, Construction, and SaaS — not generic templates.</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ============ FAQ ============ -->
  <section class="bg-v6-bg py-14 sm:py-18 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-8 text-center">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map(faq => (
          <details class="bg-white rounded-xl border border-v6-border group">
            <summary class="flex items-center justify-between cursor-pointer px-6 py-4 text-base font-semibold text-v6-dark">
              {faq.q}
              <svg class="w-5 h-5 text-v6-text-muted flex-shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-5 text-sm text-v6-text-muted leading-relaxed">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>


  <!-- ============ RISK REVERSAL + CTA ============ -->
  <section class="bg-gradient-to-br from-v6-copper to-v6-copper-600 py-16 sm:py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">Zero Risk to Get Started</h2>
      <p class="text-v6-copper-50 text-base sm:text-lg mb-3">
        Book a free 30-minute discovery call. No commitment, no sales pitch — just an honest conversation about whether we can help.
      </p>
      <p class="text-v6-copper-100 text-sm mb-8 opacity-80">
        No long-term contracts. Month-to-month engagement. 30-day satisfaction checkpoint.
      </p>
      <a href="/contactus" class="bg-white text-v6-copper px-8 py-3.5 rounded-xl text-base font-semibold hover:bg-gray-50 transition-colors inline-block">
        Book Your Free Marketing Audit
      </a>
    </div>
  </section>

  <Footer />
</Layout>
