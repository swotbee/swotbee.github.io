---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/astro/Navbar.astro";
import Footer from "../../components/astro/Footer.astro";
import StructuredData from "../../components/astro/StructuredData.astro";

const title = "HubSpot Onboarding & Implementation | Get Your Team Actually Using It";
const description = "Get your team on HubSpot with an adoption plan that actually works.";

const painPoints = [
  "Your team went through a one-time HubSpot training — and forgot everything by Monday",
  "You're 3 months in but only using contacts, deals, and maybe email",
  "Your old CRM data is still in spreadsheets because the migration feels too risky",
  "Sales reps complain HubSpot 'takes too many clicks' and quietly go back to their own methods",
  "You're paying for Pro or Enterprise features your team doesn't know exist",
  "Basic functions are hard to find — reps waste time navigating instead of selling",
];

const processSteps = [
  { num: "1", title: "Audit & Quick Wins", desc: "We map your current setup, identify what's working and what isn't, and deliver quick wins in the first 2 weeks — before we change anything else." },
  { num: "2", title: "Configure & Migrate", desc: "We configure HubSpot to match your team's workflow, migrate your data cleanly, and set up automation that runs without manual effort." },
  { num: "3", title: "Train & Launch", desc: "Role-specific training, documentation, and a go-live plan. Your team adopts because HubSpot feels familiar, not foreign." },
];

const services = [
  {
    title: "CRM Migration Done Right",
    desc: "Migrate from any CRM with complete field mapping, deduplication, and data validation. Test migration before go-live so nothing is lost.",
    metric: "Zero data loss, zero duplicate records",
    icon: "🔄",
  },
  {
    title: "Team Adoption That Actually Sticks",
    desc: "We shape HubSpot to fit how your team already works. Role-specific training, hands-on workshops, and documentation they'll actually reference.",
    metric: "Adoption jumps from 23% to 90% in 4 months",
    icon: "👥",
  },
  {
    title: "Pipeline & Deal Stage Configuration",
    desc: "Custom pipelines built around your actual sales process. Required fields, automated stage progression, and deal scoring that keeps your data clean.",
    metric: "Less admin, more selling",
    icon: "📊",
  },
  {
    title: "Workflow Automation Setup",
    desc: "Lead routing, task assignment, follow-up sequences, and lifecycle automation configured to your process — not a generic template.",
    metric: "Hours of weekly manual work eliminated",
    icon: "⚡",
  },
  {
    title: "Custom Reporting & Dashboards",
    desc: "Role-specific dashboards for executives, managers, and reps. Cross-object reports, auto-refresh every 15 minutes, mobile-optimized.",
    metric: "Leaders access KPIs instantly",
    icon: "📈",
  },
];

const faqs = [
  {
    q: "How long does HubSpot onboarding take?",
    a: "Most onboardings run 2–4 months end-to-end. But you don't wait that long to see results — we deliver quick wins in the first 2 weeks, including immediate automation fixes and cleanup that shows up right away.",
  },
  {
    q: "What if we've already started setting up HubSpot ourselves?",
    a: "That's fine — and actually common. We audit what you've built, keep everything that works, and fix what doesn't. You won't be starting from scratch.",
  },
  {
    q: "How do you handle data migration?",
    a: "We map every field from your source system to HubSpot, deduplicate records, validate data types, and run a test migration before the real cutover. Go-live only happens when the data is clean and confirmed.",
  },
  {
    q: "What if our team resists changing tools?",
    a: "We adapt HubSpot to match how your team already works — so adoption feels like an upgrade, not a disruption. We train on their actual workflow, not generic slides.",
  },
  {
    q: "Can't we just use HubSpot Academy for training?",
    a: "HubSpot Academy is excellent for general knowledge. But it teaches generic features, not your business processes. We train your team on the exact pipelines, properties, and workflows you'll use every day.",
  },
  {
    q: "How much does HubSpot onboarding cost?",
    a: "It depends on your tier, the scope of your data migration, and how many teams are involved. We tailor the engagement to your situation — book a free 30-minute call and we'll give you an honest estimate.",
  },
  {
    q: "Do you provide ongoing support after onboarding?",
    a: "Yes — we offer an optional retainer for ongoing support, new feature rollouts, and continuous optimization. But everything we build is documented and self-sustaining so your team can run it independently.",
  },
];

const clientLogos = ["Wesco", "Big Lots", "Insteon", "La Vie", "Mytheresa"];
---

<Layout title={title} description={description}>
  <StructuredData
    type="service"
    data={{
      name: "HubSpot Onboarding & Implementation Services",
      description: description,
      serviceType: "CRM Implementation Consulting",
      url: "https://swotbee.com/services/hubspot-onboarding",
    }}
  />
  <StructuredData type="faq" data={{ faqs }} />
  <StructuredData
    type="breadcrumb"
    data={{ breadcrumbs: [
      { name: "Home", url: "https://swotbee.com" },
      { name: "Services", url: "https://swotbee.com/services" },
      { name: "HubSpot Onboarding", url: "https://swotbee.com/services/hubspot-onboarding" },
    ]}}
  />

  <Navbar />

  <!-- ============ HERO ============ -->
  <section class="bg-gradient-to-b from-v6-bg to-white px-4 sm:px-6 lg:px-8 pt-16 sm:pt-20 pb-10 sm:pb-14">
    <div class="max-w-3xl mx-auto text-center">
      <div class="flex justify-center gap-3 mb-6">
        <span class="bg-v6-teal-50 text-v6-teal text-xs font-semibold px-3 py-1 rounded-full">HubSpot Solutions Partner</span>
        <span class="bg-v6-copper-50 text-v6-copper text-xs font-semibold px-3 py-1 rounded-full">All Tiers: Starter → Enterprise</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-v6-dark leading-tight mb-5 text-balance">
        Get Your Team Actually Using HubSpot — <span class="text-v6-copper">Not Just Logging In</span>
      </h1>
      <p class="text-base sm:text-lg text-v6-text-muted max-w-xl mx-auto mb-8 leading-relaxed">
        Your team adopts faster when the tool fits their workflow, not the other way around.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center mb-4">
        <a href="/contactus" class="bg-v6-copper text-white px-8 py-3.5 rounded-xl text-base font-semibold hover:bg-v6-copper-600 transition-colors text-center">
          Get a Free Onboarding Assessment
        </a>
        <a href="#how-we-work" class="border border-gray-300 text-v6-dark px-8 py-3.5 rounded-xl text-base font-medium hover:bg-gray-50 transition-colors text-center">
          See How We Work ↓
        </a>
      </div>
      <p class="text-xs text-gray-500">Free 30-minute consultation. No commitment. No sales pitch.</p>
    </div>
  </section>


  <!-- ============ TRUST BAR ============ -->
  <section class="bg-white border-y border-v6-border py-4 px-4">
    <div class="max-w-4xl mx-auto flex flex-wrap justify-center gap-8 items-center">
      <span class="text-xs text-gray-500 font-medium uppercase tracking-wider">Trusted by</span>
      {clientLogos.map(name => (
        <span class="text-sm text-v6-text-muted font-semibold opacity-50">{name}</span>
      ))}
    </div>
  </section>


  <!-- ============ "IS THIS YOU?" ============ -->
  <section class="bg-v6-bg py-14 sm:py-18 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-3 text-center">Sound Familiar?</h2>
      <p class="text-v6-text-muted text-center mb-8 max-w-lg mx-auto">If any of these describe your HubSpot rollout right now, we can help.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {painPoints.map(point => (
          <div class="flex gap-3 items-start bg-white rounded-lg p-4 border border-v6-border">
            <span class="text-v6-copper text-lg flex-shrink-0 mt-0.5">→</span>
            <p class="text-sm text-v6-text-muted leading-relaxed">{point}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ============ BEFORE / AFTER ============ -->
  <section class="bg-white py-14 sm:py-18 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-10 text-center">The Gap We Close</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Before -->
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
          <p class="text-sm font-semibold text-v6-text-muted uppercase tracking-wider mb-4 opacity-60">Before SWOTBee</p>
          <ul class="space-y-3">
            <li class="flex gap-2 text-sm text-v6-text-muted"><span class="text-red-400">✗</span> Team using 10% of features — paying for the rest</li>
            <li class="flex gap-2 text-sm text-v6-text-muted"><span class="text-red-400">✗</span> Data still in spreadsheets, migration feels too risky</li>
            <li class="flex gap-2 text-sm text-v6-text-muted"><span class="text-red-400">✗</span> Reps complain about too many clicks, revert to old habits</li>
            <li class="flex gap-2 text-sm text-v6-text-muted"><span class="text-red-400">✗</span> No automation — every task done manually</li>
            <li class="flex gap-2 text-sm text-v6-text-muted"><span class="text-red-400">✗</span> Training was a one-time event nobody remembers</li>
          </ul>
        </div>
        <!-- After -->
        <div class="bg-v6-teal-50 rounded-xl p-6 border border-v6-teal-100">
          <p class="text-sm font-semibold text-v6-teal uppercase tracking-wider mb-4">After SWOTBee</p>
          <ul class="space-y-3">
            <li class="flex gap-2 text-sm text-v6-dark"><span class="text-v6-teal">✓</span> 90% adoption daily — team logs in because it helps them</li>
            <li class="flex gap-2 text-sm text-v6-dark"><span class="text-v6-teal">✓</span> Clean single source of truth, migration complete</li>
            <li class="flex gap-2 text-sm text-v6-dark"><span class="text-v6-teal">✓</span> HubSpot matches their workflow — familiar, not foreign</li>
            <li class="flex gap-2 text-sm text-v6-dark"><span class="text-v6-teal">✓</span> Automations handle routing, tasks, and follow-ups</li>
            <li class="flex gap-2 text-sm text-v6-dark"><span class="text-v6-teal">✓</span> Role-specific training with docs they actually reference</li>
          </ul>
        </div>
      </div>
    </div>
  </section>


  <!-- ============ HOW WE WORK (3 Steps) ============ -->
  <section id="how-we-work" class="bg-v6-bg py-14 sm:py-18 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-10 text-center">How We Work</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {processSteps.map(step => (
          <div class="bg-white rounded-xl p-6 border border-v6-border text-center">
            <div class="w-12 h-12 rounded-full bg-v6-copper text-white text-xl font-bold flex items-center justify-center mx-auto mb-4">{step.num}</div>
            <h3 class="text-lg font-semibold text-v6-dark mb-2">{step.title}</h3>
            <p class="text-sm text-v6-text-muted leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
      <p class="text-center text-sm text-v6-text-muted mt-6">Typical onboarding: 2–4 months. Quick wins in the first 2 weeks.</p>
    </div>
  </section>


  <!-- ============ SERVICES ============ -->
  <section class="bg-white py-14 sm:py-18 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-3 text-center">What We Set Up for You</h2>
      <p class="text-v6-text-muted text-center mb-10 max-w-lg mx-auto">Everything your team needs to get on HubSpot and stay on HubSpot.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map(s => (
          <div class="bg-v6-bg rounded-xl p-6 border border-v6-border hover:shadow-lg transition-shadow">
            <div class="text-2xl mb-3">{s.icon}</div>
            <h3 class="text-base font-semibold text-v6-dark mb-2">{s.title}</h3>
            <p class="text-sm text-v6-text-muted leading-relaxed mb-3">{s.desc}</p>
            <p class="text-xs font-semibold text-v6-teal">{s.metric}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ============ TESTIMONIAL ============ -->
  <section class="bg-v6-bg py-14 sm:py-18 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-8 text-center">What Our Clients Say</h2>
      <div class="bg-white rounded-xl p-8 border border-v6-border">
        <blockquote class="text-base sm:text-lg text-v6-dark leading-relaxed italic mb-6">
          "Before SWOTBee, our sales team couldn't tell which building they were selling to — we have multiple contracts per company across different sites. Renewals were completely manual and things slipped through. SWOTBee automated our renewal pipeline and integrated HubSpot with NetSuite and Monday.com. Renewal accuracy jumped by nearly 50%, and our sales team now focuses on growth instead of admin work."
        </blockquote>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-v6-teal-100 flex items-center justify-center text-v6-teal font-bold text-sm">VP</div>
          <div>
            <p class="text-sm font-semibold text-v6-dark">VP Sales</p>
            <p class="text-xs text-v6-text-muted">Energy Sector Company</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ============ WHY SWOTBEE ============ -->
  <section class="bg-white py-14 sm:py-18 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-8 text-center">Why Clients Choose SWOTBee</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="flex gap-4 items-start">
          <div class="w-10 h-10 rounded-lg bg-v6-blue-50 flex items-center justify-center flex-shrink-0 text-v6-blue text-lg font-bold">1</div>
          <div>
            <h3 class="text-base font-semibold text-v6-dark mb-1">Workflow-First Approach</h3>
            <p class="text-sm text-v6-text-muted leading-relaxed">We adapt HubSpot to how your team works, so adoption is natural and changes are minimal.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <div class="w-10 h-10 rounded-lg bg-v6-copper-50 flex items-center justify-center flex-shrink-0 text-v6-copper text-lg font-bold">2</div>
          <div>
            <h3 class="text-base font-semibold text-v6-dark mb-1">Day-One Results</h3>
            <p class="text-sm text-v6-text-muted leading-relaxed">High-impact changes that show immediate ROI — not a 6-month wait for a strategy deck.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <div class="w-10 h-10 rounded-lg bg-v6-teal-50 flex items-center justify-center flex-shrink-0 text-v6-teal text-lg font-bold">3</div>
          <div>
            <h3 class="text-base font-semibold text-v6-dark mb-1">Data Quality Obsession</h3>
            <p class="text-sm text-v6-text-muted leading-relaxed">Clean data, accurate forecasts, zero missed renewals. We don't build on a bad foundation.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <div class="w-10 h-10 rounded-lg bg-v6-amber-50 flex items-center justify-center flex-shrink-0 text-v6-amber text-lg font-bold">4</div>
          <div>
            <h3 class="text-base font-semibold text-v6-dark mb-1">Built for Your Industry</h3>
            <p class="text-sm text-v6-text-muted leading-relaxed">Tools and integrations built for Energy, Manufacturing, Construction, and SaaS — not generic templates.</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ============ FAQ ============ -->
  <section class="bg-v6-bg py-14 sm:py-18 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-8 text-center">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map(faq => (
          <details class="bg-white rounded-xl border border-v6-border group">
            <summary class="flex items-center justify-between cursor-pointer px-6 py-4 text-base font-semibold text-v6-dark">
              {faq.q}
              <svg class="w-5 h-5 text-v6-text-muted flex-shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-5 text-sm text-v6-text-muted leading-relaxed">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>


  <!-- ============ RISK REVERSAL + CTA ============ -->
  <section class="bg-gradient-to-br from-v6-copper to-v6-copper-600 py-16 sm:py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">Zero Risk to Get Started</h2>
      <p class="text-v6-copper-50 text-base sm:text-lg mb-3">
        Book a free 30-minute discovery call. No commitment, no sales pitch — just an honest conversation about whether we can help.
      </p>
      <p class="text-v6-copper-100 text-sm mb-8 opacity-80">
        No long-term contracts. Month-to-month engagement. 30-day satisfaction checkpoint.
      </p>
      <a href="/contactus" class="bg-white text-v6-copper px-8 py-3.5 rounded-xl text-base font-semibold hover:bg-gray-50 transition-colors inline-block">
        Book Your Free Onboarding Assessment
      </a>
    </div>
  </section>

  <Footer />
</Layout>
