---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/astro/Navbar.astro";
import Footer from "../../components/astro/Footer.astro";
import StructuredData from "../../components/astro/StructuredData.astro";

const title = "HubSpot Integrations | Quotes, Invoices & Data Flowing Automatically";
const description = "Connect HubSpot to DocuSign, NetSuite, Xero, Zoom, and everything else. One connected workflow from quote to cash.";

const painPoints = [
  "Your HubSpot contacts don't match what's in NetSuite or Xero",
  "You're copy-pasting deal data between HubSpot and your invoicing system daily",
  "A sync broke last month and nobody noticed for two weeks — duplicate records everywhere",
  "Your team uses 5+ tools but none share data automatically",
  "Generating a cross-system report requires pulling from 3 different dashboards",
  "Production or shipping updates never make it back to the sales team who closed the deal",
];

const processSteps = [
  { num: "1", title: "Integration Audit", desc: "We map your current tool stack, identify every manual handoff and broken sync, and deliver a prioritized fix plan in the first 2 weeks." },
  { num: "2", title: "Build & Test Connections", desc: "We build the integrations, map every field, handle edge cases, and run extensive testing before anything touches your live data." },
  { num: "3", title: "Monitor & Maintain", desc: "Real-time error monitoring, retry logic, and documentation so you know when something breaks — and it gets fixed before anyone notices." },
];

const services = [
  {
    title: "Quote-to-Cash Automation",
    desc: "HubSpot deals flow into DocuSign contracts, then into NetSuite or Xero invoices automatically. Line items, pricing, and terms follow the deal — no copy-pasting.",
    metric: "Manual quote creation reduced by 90%",
    icon: "🔗",
  },
  {
    title: "Data Sync & Enrichment",
    desc: "Bidirectional sync between HubSpot and your ERP, accounting, and support tools. ZoomInfo and Clearbit enrichment keeps contact and company records accurate.",
    metric: "Data accuracy from 72% to 99%",
    icon: "📊",
  },
  {
    title: "Workflow Automation Across Tools",
    desc: "Deal stage changes trigger actions in other systems — production alerts, shipping notifications, approval workflows — without anyone lifting a finger.",
    metric: "Cross-system workflows that run without human intervention",
    icon: "⚡",
  },
  {
    title: "Unified Reporting",
    desc: "Combine data from HubSpot, ERP, accounting, and support into single dashboards. One source of truth — no more pulling from 3 systems to answer one question.",
    metric: "One source of truth across your entire stack",
    icon: "📈",
  },
  {
    title: "Error Monitoring & Maintenance",
    desc: "Real-time alerts for sync failures, retry logic, field mapping validation, and documentation so your team can diagnose issues independently.",
    metric: "Zero unnoticed sync failures",
    icon: "🛡️",
  },
];

const platforms = [
  "DocuSign", "NetSuite", "Xero", "Zoom", "Monday.com", "Shopify",
  "Salesforce", "Zapier", "Slack", "QuickBooks", "Stripe", "Custom APIs",
];

const faqs = [
  {
    q: "Which platforms do you integrate with HubSpot?",
    a: "NetSuite, Xero, DocuSign, Zoom, Monday.com, Shopify, Salesforce, Zapier, Slack, QuickBooks, Stripe, and any tool with a REST API. If your tool has an API, we can connect it.",
  },
  {
    q: "Can you build custom integrations for tools not on your list?",
    a: "Yes. If a tool has an API, we can build a custom integration. We've done this for ERP systems, Django-based applications, legacy databases, and industry-specific platforms. Bring us your stack and we'll scope it.",
  },
  {
    q: "What happens if an integration breaks after setup?",
    a: "We set up real-time monitoring and alert systems so failures are caught immediately — not two weeks later. We also offer an optional maintenance retainer for ongoing monitoring, proactive updates, and support.",
  },
  {
    q: "How do you handle data mapping between different systems?",
    a: "We document every field, validate data types, handle edge cases, and test extensively with real data before anything goes live. Field mapping documentation is delivered as part of every project.",
  },
  {
    q: "Do you provide ongoing monitoring and maintenance?",
    a: "Yes — as a retainer add-on. This includes monitoring dashboards, alert routing, proactive maintenance when APIs change, and a dedicated contact for integration support.",
  },
  {
    q: "How long does a typical integration project take?",
    a: "A single-tool integration — like HubSpot to Xero — typically takes 4–8 weeks from audit to go-live. Multi-tool or complex integrations (multiple bidirectional syncs, custom APIs) run 3–6 months.",
  },
  {
    q: "What about data security during integration?",
    a: "We follow industry best practices for credential management and data handling. We support GDPR and HIPAA requirements and can implement encrypted data flows where needed. We never store credentials in plaintext.",
  },
];

const clientLogos = ["Wesco", "Big Lots", "Insteon", "La Vie", "Mytheresa"];
---

<Layout title={title} description={description}>
  <StructuredData
    type="service"
    data={{
      name: "HubSpot Integration Services",
      description: description,
      serviceType: "CRM Integration Consulting",
      url: "https://swotbee.github.io/services/integrations",
    }}
  />

  <Navbar />

  <!-- ============ HERO ============ -->
  <section class="bg-gradient-to-b from-v6-bg to-white px-4 sm:px-6 lg:px-8 pt-16 sm:pt-20 pb-10 sm:pb-14">
    <div class="max-w-3xl mx-auto text-center">
      <div class="flex justify-center gap-3 mb-6">
        <span class="bg-v6-teal-50 text-v6-teal text-xs font-semibold px-3 py-1 rounded-full">HubSpot Solutions Partner</span>
        <span class="bg-v6-copper-50 text-v6-copper text-xs font-semibold px-3 py-1 rounded-full">50+ Integration Projects</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-v6-dark leading-tight mb-5 text-balance">
        Quotes, Line Items, Invoices — <span class="text-v6-copper">Flowing Automatically</span> Between Your Tools
      </h1>
      <p class="text-base sm:text-lg text-v6-text-muted max-w-xl mx-auto mb-8 leading-relaxed">
        HubSpot + DocuSign + NetSuite + Xero + Zoom — one connected workflow from quote to cash.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center mb-4">
        <a href="/contactus" class="bg-v6-copper text-white px-8 py-3.5 rounded-xl text-base font-semibold hover:bg-v6-copper-600 transition-colors text-center">
          Get a Free Integration Audit
        </a>
        <a href="#how-we-work" class="border border-gray-300 text-v6-dark px-8 py-3.5 rounded-xl text-base font-medium hover:bg-gray-50 transition-colors text-center">
          See How We Work ↓
        </a>
      </div>
      <p class="text-xs text-gray-400">Free 30-minute consultation. No commitment. No sales pitch.</p>
    </div>
  </section>


  <!-- ============ TRUST BAR ============ -->
  <section class="bg-white border-y border-v6-border py-4 px-4">
    <div class="max-w-4xl mx-auto flex flex-wrap justify-center gap-8 items-center">
      <span class="text-xs text-gray-400 font-medium uppercase tracking-wider">Trusted by</span>
      {clientLogos.map(name => (
        <span class="text-sm text-v6-text-muted font-semibold opacity-50">{name}</span>
      ))}
    </div>
  </section>


  <!-- ============ "IS THIS YOU?" ============ -->
  <section class="bg-v6-bg py-14 sm:py-18 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-3 text-center">Sound Familiar?</h2>
      <p class="text-v6-text-muted text-center mb-8 max-w-lg mx-auto">If any of these describe your current tool stack, we can help.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {painPoints.map(point => (
          <div class="flex gap-3 items-start bg-white rounded-lg p-4 border border-v6-border">
            <span class="text-v6-copper text-lg flex-shrink-0 mt-0.5">→</span>
            <p class="text-sm text-v6-text-muted leading-relaxed">{point}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ============ BEFORE / AFTER ============ -->
  <section class="bg-white py-14 sm:py-18 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-10 text-center">The Gap We Close</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Before -->
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
          <p class="text-sm font-semibold text-v6-text-muted uppercase tracking-wider mb-4 opacity-60">Before SWOTBee</p>
          <ul class="space-y-3">
            <li class="flex gap-2 text-sm text-v6-text-muted"><span class="text-red-400">✗</span> Manual data entry between tools eating 4+ hours per day</li>
            <li class="flex gap-2 text-sm text-v6-text-muted"><span class="text-red-400">✗</span> Sync errors go unnoticed for weeks</li>
            <li class="flex gap-2 text-sm text-v6-text-muted"><span class="text-red-400">✗</span> Quotes generated manually from deal data</li>
            <li class="flex gap-2 text-sm text-v6-text-muted"><span class="text-red-400">✗</span> Invoices don't match deal line items</li>
            <li class="flex gap-2 text-sm text-v6-text-muted"><span class="text-red-400">✗</span> No visibility across systems without pulling 3 reports</li>
          </ul>
        </div>
        <!-- After -->
        <div class="bg-v6-teal-50 rounded-xl p-6 border border-v6-teal-100">
          <p class="text-sm font-semibold text-v6-teal uppercase tracking-wider mb-4">After SWOTBee</p>
          <ul class="space-y-3">
            <li class="flex gap-2 text-sm text-v6-dark"><span class="text-v6-teal">✓</span> Data flows automatically between all tools</li>
            <li class="flex gap-2 text-sm text-v6-dark"><span class="text-v6-teal">✓</span> Real-time monitoring catches errors instantly</li>
            <li class="flex gap-2 text-sm text-v6-dark"><span class="text-v6-teal">✓</span> Quotes auto-generated from deal data</li>
            <li class="flex gap-2 text-sm text-v6-dark"><span class="text-v6-teal">✓</span> Invoices match line items perfectly</li>
            <li class="flex gap-2 text-sm text-v6-dark"><span class="text-v6-teal">✓</span> Single dashboard shows everything across systems</li>
          </ul>
        </div>
      </div>
    </div>
  </section>


  <!-- ============ HOW WE WORK (3 Steps) ============ -->
  <section id="how-we-work" class="bg-v6-bg py-14 sm:py-18 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-10 text-center">How We Work</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {processSteps.map(step => (
          <div class="bg-white rounded-xl p-6 border border-v6-border text-center">
            <div class="w-12 h-12 rounded-full bg-v6-copper text-white text-xl font-bold flex items-center justify-center mx-auto mb-4">{step.num}</div>
            <h3 class="text-lg font-semibold text-v6-dark mb-2">{step.title}</h3>
            <p class="text-sm text-v6-text-muted leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
      <p class="text-center text-sm text-v6-text-muted mt-6">Typical project: 4–8 weeks per integration. Complex multi-tool: 3–6 months.</p>
    </div>
  </section>


  <!-- ============ SERVICES ============ -->
  <section class="bg-white py-14 sm:py-18 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-3 text-center">What We Connect for You</h2>
      <p class="text-v6-text-muted text-center mb-10 max-w-lg mx-auto">Every integration your business needs to stop copying data between tools.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map(s => (
          <div class="bg-v6-bg rounded-xl p-6 border border-v6-border hover:shadow-lg transition-shadow">
            <div class="text-2xl mb-3">{s.icon}</div>
            <h3 class="text-base font-semibold text-v6-dark mb-2">{s.title}</h3>
            <p class="text-sm text-v6-text-muted leading-relaxed mb-3">{s.desc}</p>
            <p class="text-xs font-semibold text-v6-teal">{s.metric}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ============ PLATFORMS WE CONNECT ============ -->
  <section class="bg-v6-bg py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-xl sm:text-2xl font-bold text-v6-dark mb-6 text-center">Platforms We Connect</h2>
      <div class="flex flex-wrap justify-center gap-3">
        {platforms.map(platform => (
          <span class="bg-white border border-v6-border text-v6-dark text-sm font-medium px-4 py-2 rounded-lg">
            {platform}
          </span>
        ))}
      </div>
    </div>
  </section>


  <!-- ============ TESTIMONIAL ============ -->
  <section class="bg-white py-14 sm:py-18 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-8 text-center">What Our Clients Say</h2>
      <div class="bg-v6-bg rounded-xl p-8 border border-v6-border">
        <blockquote class="text-base sm:text-lg text-v6-dark leading-relaxed italic mb-6">
          "Each university contract has unique approval workflows and variables that feed into invoicing. Before SWOTBee, this was a manual nightmare — especially during peak admission months. They built a custom integration between HubSpot, Xero, and our Django application that automates the entire flow. Xero automation cut our approval cycles by more than half and improved billing accuracy by 40% — a game-changer during peak admission months."
        </blockquote>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-v6-teal-100 flex items-center justify-center text-v6-teal font-bold text-sm">OD</div>
          <div>
            <p class="text-sm font-semibold text-v6-dark">Operations Director</p>
            <p class="text-xs text-v6-text-muted">Education Sector</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ============ WHY SWOTBEE ============ -->
  <section class="bg-v6-bg py-14 sm:py-18 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-8 text-center">Why Clients Choose SWOTBee</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="flex gap-4 items-start">
          <div class="w-10 h-10 rounded-lg bg-v6-blue-50 flex items-center justify-center flex-shrink-0 text-v6-blue text-lg font-bold">1</div>
          <div>
            <h3 class="text-base font-semibold text-v6-dark mb-1">Workflow-First Approach</h3>
            <p class="text-sm text-v6-text-muted leading-relaxed">We adapt HubSpot to how your team works, so adoption is natural and changes are minimal.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <div class="w-10 h-10 rounded-lg bg-v6-copper-50 flex items-center justify-center flex-shrink-0 text-v6-copper text-lg font-bold">2</div>
          <div>
            <h3 class="text-base font-semibold text-v6-dark mb-1">Day-One Results</h3>
            <p class="text-sm text-v6-text-muted leading-relaxed">High-impact changes that show immediate ROI — not a 6-month wait for a strategy deck.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <div class="w-10 h-10 rounded-lg bg-v6-teal-50 flex items-center justify-center flex-shrink-0 text-v6-teal text-lg font-bold">3</div>
          <div>
            <h3 class="text-base font-semibold text-v6-dark mb-1">Data Quality Obsession</h3>
            <p class="text-sm text-v6-text-muted leading-relaxed">Clean data, accurate forecasts, zero missed renewals. We don't build on a bad foundation.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <div class="w-10 h-10 rounded-lg bg-v6-amber-50 flex items-center justify-center flex-shrink-0 text-v6-amber text-lg font-bold">4</div>
          <div>
            <h3 class="text-base font-semibold text-v6-dark mb-1">Built for Your Industry</h3>
            <p class="text-sm text-v6-text-muted leading-relaxed">Tools and integrations built for Energy, Manufacturing, Construction, and SaaS — not generic templates.</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ============ FAQ ============ -->
  <section class="bg-white py-14 sm:py-18 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-v6-dark mb-8 text-center">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map(faq => (
          <details class="bg-v6-bg rounded-xl border border-v6-border group">
            <summary class="flex items-center justify-between cursor-pointer px-6 py-4 text-base font-semibold text-v6-dark">
              {faq.q}
              <svg class="w-5 h-5 text-v6-text-muted flex-shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-5 text-sm text-v6-text-muted leading-relaxed">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>


  <!-- ============ RISK REVERSAL + CTA ============ -->
  <section class="bg-gradient-to-br from-v6-copper to-v6-copper-600 py-16 sm:py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">Zero Risk to Get Started</h2>
      <p class="text-v6-copper-50 text-base sm:text-lg mb-3">
        Book a free 30-minute discovery call. No commitment, no sales pitch — just an honest conversation about whether we can help.
      </p>
      <p class="text-v6-copper-100 text-sm mb-8 opacity-80">
        No long-term contracts. Month-to-month engagement. 30-day satisfaction checkpoint.
      </p>
      <a href="/contactus" class="bg-white text-v6-copper px-8 py-3.5 rounded-xl text-base font-semibold hover:bg-gray-50 transition-colors inline-block">
        Book Your Free Integration Audit
      </a>
    </div>
  </section>

  <Footer />
</Layout>
