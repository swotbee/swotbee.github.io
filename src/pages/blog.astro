---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/astro/Navbar.astro";
import Footer from "../components/astro/Footer.astro";
import StructuredData from "../components/astro/StructuredData.astro";
import NewsletterForm from "../components/astro/NewsletterForm.astro";
import { Picture } from 'astro:assets';

interface BlogPost {
  title: string;
  description: string;
  pubDate: string;
  image?: string;
  url: string;
  draft?: boolean;
  category?: { title: string; href: string };
  author?: { name: string; imageUrl?: string };
  tags?: string[];
}

const isExternalUrl = (url: string) => {
  try { new URL(url); return url.startsWith('http://') || url.startsWith('https://'); } catch { return false; }
};

const BLOG_IMAGE_DIMENSIONS = { width: 800, height: 450 };

const isValidDate = (dateString: string) => {
  const date = new Date(dateString);
  return date instanceof Date && !isNaN(date.getTime());
};

const posts = await Promise.all(
  Object.entries(import.meta.glob<{ frontmatter: BlogPost }>("./posts/*.md")).map(
    async ([path, resolver]) => {
      const { frontmatter } = await resolver();
      return { ...frontmatter, url: path.replace("./posts", "/posts").replace(".md", "") };
    }
  )
).then(posts =>
  posts.filter(post => !post.draft).sort((a, b) => {
    if (!isValidDate(a.pubDate)) return 1;
    if (!isValidDate(b.pubDate)) return -1;
    return new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime();
  })
);

const formatDate = (dateString: string) => {
  if (!isValidDate(dateString)) return "Invalid Date";
  return new Date(dateString).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
};

const MAX_VISIBLE_TAGS = 3;
---

<Layout
  title="HubSpot & Revenue Operations Blog"
  description="Expert insights on HubSpot optimization, revenue operations, CRM automation, and growth strategies for mid-sized companies."
>
  <StructuredData
    type="breadcrumb"
    data={{ breadcrumbs: [
      { name: "Home", url: "https://swotbee.com" },
      { name: "Blog", url: "https://swotbee.com/blog" }
    ]}}
  />

  <Navbar />

  <!-- Hero -->
  <section class="bg-gradient-to-b from-v6-bg to-white px-4 sm:px-6 lg:px-8 pt-16 sm:pt-20 pb-10">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-3xl sm:text-4xl font-bold text-v6-dark mb-4">Insights & Strategies</h1>
      <p class="text-base sm:text-lg text-v6-text-muted max-w-xl mx-auto leading-relaxed">
        Expert advice on HubSpot optimization, revenue operations, and growth strategies for Energy, Manufacturing, and SaaS companies.
      </p>
    </div>
  </section>

  <!-- Blog Grid -->
  <section class="bg-white px-4 sm:px-6 lg:px-8 pb-16">
    <div class="max-w-6xl mx-auto">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <article class="bg-v6-bg rounded-xl border border-v6-border overflow-hidden hover:shadow-lg transition-shadow">
            {post.image && (
              <a href={post.url}>
                <div class="aspect-video overflow-hidden">
                  {isExternalUrl(post.image) ? (
                    <img
                      src={post.image}
                      alt={post.title}
                      width={BLOG_IMAGE_DIMENSIONS.width}
                      height={BLOG_IMAGE_DIMENSIONS.height}
                      class="w-full h-full object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <Picture
                      src={post.image}
                      alt={post.title}
                      width={BLOG_IMAGE_DIMENSIONS.width}
                      height={BLOG_IMAGE_DIMENSIONS.height}
                      widths={[400, 800]}
                      formats={['webp', 'avif', 'jpg']}
                      inferSize
                      class="w-full h-full object-cover"
                    />
                  )}
                </div>
              </a>
            )}

            <div class="p-5">
              {post.category && post.category.href?.startsWith('/categories/') ? (
                <a
                  href={post.category.href}
                  class="inline-block bg-v6-teal-50 text-v6-teal text-xs font-semibold px-2.5 py-0.5 rounded-full hover:bg-v6-teal-100 transition-colors"
                >
                  {post.category.title}
                </a>
              ) : post.category && (
                <span class="inline-block text-v6-text-muted text-xs font-semibold px-2.5 py-0.5">
                  {post.category.title}
                </span>
              )}

              <h2 class="mt-3 mb-2 text-lg font-bold text-v6-dark leading-snug">
                <a href={post.url} class="hover:text-v6-copper transition-colors">{post.title}</a>
              </h2>

              <p class="text-sm text-v6-text-muted leading-relaxed line-clamp-3 mb-4">
                {post.description}
              </p>

              {post.tags && post.tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mb-4">
                  {post.tags.slice(0, MAX_VISIBLE_TAGS).map((tag) => (
                    <span class="px-2 py-0.5 text-xs bg-v6-blue-50 text-v6-blue rounded-full">
                      #{tag}
                    </span>
                  ))}
                  {post.tags.length > MAX_VISIBLE_TAGS && (
                    <span class="px-2 py-0.5 text-xs text-v6-text-muted">
                      +{post.tags.length - MAX_VISIBLE_TAGS} more
                    </span>
                  )}
                </div>
              )}

              <div class="flex items-center justify-between pt-3 border-t border-v6-border">
                <div class="flex items-center gap-2">
                  {post.author?.name && (
                    <span class="text-xs font-medium text-v6-dark">{post.author.name}</span>
                  )}
                </div>
                <span class="text-xs text-v6-text-muted">{formatDate(post.pubDate)}</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      {posts.length === 0 && (
        <div class="text-center py-16">
          <p class="text-v6-text-muted text-lg">No posts yet. Check back soon!</p>
        </div>
      )}
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="bg-gradient-to-br from-v6-blue to-v6-blue-600 py-14 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3">Stay in the Loop</h2>
      <p class="text-v6-blue-100 text-base mb-6">HubSpot tips, RevOps strategies, and growth insights, delivered to your inbox.</p>
      <NewsletterForm variant="onColor" />
    </div>
  </section>

  <Footer />
</Layout>
