---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/astro/Navbar.astro";
import Footer from "../components/astro/Footer.astro";
import ClientLogoStrip from "../components/astro/ClientLogoStrip.astro";
// Scheduler destination for the renewal-audit funnel (deal-cloning posts, renewal-ops
// posts, the leakage-estimate lead-magnet sequence). Distinct from the generic /contactus
// page per marketing/gtm/pipeline-build/25-renewal-audit-funnel-launch-package.md D1: the
// $600 audit is never framed as free. This call is free; it is the step that leads to the
// paid audit, not the audit itself. Embeds Cal.com (swotbee/your-renewal-audit) inline.
---
<Layout
  title="Book Your Renewal Audit Call"
  description="Free 30-minute call to walk through your renewal leakage estimate and scope the paid renewal audit. No pressure, no generic sales pitch."
>
  <Navbar />

  <section class="bg-gradient-to-b from-v6-bg to-white px-4 sm:px-6 lg:px-8 pt-8 sm:pt-10 pb-10">
    <div class="max-w-4xl mx-auto text-center">
        <span class="bg-v6-teal-50 text-v6-teal text-sm font-semibold px-4 py-1.5 rounded-full inline-block mb-6">Free 30-minute call</span>
        <h1 class="text-4xl sm:text-5xl font-bold text-v6-dark mb-5 text-balance">Book Your Renewal Audit Call</h1>
        <p class="text-lg sm:text-xl text-v6-text-muted max-w-2xl mx-auto leading-relaxed">
          We'll walk through your leakage estimate, answer what it does and doesn't tell you, and scope whether the paid renewal audit ($600, credited in full toward any build) is worth doing on your actual HubSpot data.
        </p>
        <!-- <div class="mt-7">
          <a href="#book-a-time" class="inline-block bg-v6-copper text-white rounded-xl px-8 py-4 text-lg font-semibold hover:bg-v6-copper-600 transition-colors shadow-sm">Choose a time for your free call →</a>
        </div> -->
      <!-- Role-tailored pitch (#6): revealed client-side from ?role= or the sb_role cookie. -->
      <div id="role-pitch" class="hidden mt-5 max-w-xl mx-auto bg-white border border-v6-border rounded-xl p-4 text-left">
        <p id="role-pitch-title" class="text-sm font-semibold text-v6-dark mb-1"></p>
        <p id="role-pitch-body" class="text-sm text-v6-text-muted leading-relaxed"></p>
      </div>
      <script is:inline>
        (function () {
          var el = document.getElementById("role-pitch");
          if (!el) return;
          var p = new URLSearchParams(location.search).get("role");
          var role = "";
          if (p) { role = decodeURIComponent(p); }
          else { var m = document.cookie.match(/(?:^|; )sb_role=([^;]*)/); role = m ? decodeURIComponent(m[1]) : ""; }
          role = role.toLowerCase();
          var v = null;
          if (role.indexOf("decision maker") >= 0) {
            v = { t: "You own the number, so here is what you walk away with", b: "A quantified figure for the revenue leaking out of your renewals, and what recovering it is worth, in terms you can take to the board. A revenue conversation, not a tools one." };
          } else if (role.indexOf("revops") >= 0 || role.indexOf("ops practitioner") >= 0) {
            v = { t: "You run renewals, so here is what you walk away with", b: "The exact mechanics: which deals are missing line items, which workflows break at year 3, which renewals have no date, named, with a scored fix roadmap you can act on." };
          }
          if (v) {
            document.getElementById("role-pitch-title").textContent = v.t;
            document.getElementById("role-pitch-body").textContent = v.b;
            el.classList.remove("hidden");
          }
        })();
      </script>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-6">
    <div class="grid sm:grid-cols-3 gap-4 text-center">
      <div class="bg-white border border-v6-teal-100 rounded-xl p-5 shadow-sm">
        <div class="font-bold text-v6-teal text-xl">First call</div>
        <div class="mt-1 text-base text-v6-dark">Free. 30 minutes. We’ll tell you whether the audit is worth doing.</div>
      </div>
      <div class="bg-white border border-v6-border rounded-xl p-5 shadow-sm">
        <div class="font-bold text-v6-teal text-xl">Your decision</div>
        <div class="mt-1 text-base text-v6-dark">You choose after the call. No pressure either way.</div>
      </div>
      <div class="bg-white border border-v6-border rounded-xl p-5 shadow-sm">
        <div class="font-bold text-v6-teal text-xl">The audit</div>
        <div class="mt-1 text-base text-v6-dark">$600, credited in full toward any build.</div>
      </div>
    </div>
  </section>

  <section class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 pb-6">
    <p class="flex items-center justify-center gap-2 text-center text-sm text-v6-text-muted">
      <svg aria-hidden="true" class="w-4 h-4 shrink-0 text-v6-teal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>
      View-only access. Nothing leaves your portal. NDA available on request.
    </p>
  </section>

  <section id="book-a-time" class="scroll-mt-24 bg-v6-bg py-8 sm:py-10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl bg-white p-4 sm:p-6">
        <div class="text-center mb-6">
          <span class="inline-block text-sm font-semibold uppercase tracking-[0.14em] text-v6-copper mb-2">Book your free 30-minute renewal audit</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-v6-dark text-balance">Choose a time that works for you</h2>
        </div>
        <div id="renewal-audit-cal-inline" style="width:100%;min-height:600px;"></div>
      </div>
    </div>
  </section>

  <ClientLogoStrip caption="Trusted by revenue and operations teams at" />

  <section class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-10">
    <h2 class="text-2xl font-bold text-v6-dark text-center mb-6">Before you book, the honest answers</h2>
    <div class="space-y-3">
      <details class="bg-v6-bg rounded-xl border border-v6-border p-4">
        <summary class="cursor-pointer font-semibold text-v6-dark">Is the audit really $600, with nothing hidden?</summary>
        <p class="mt-3 text-sm text-v6-text-muted leading-relaxed">Yes. A flat $600, credited in full toward any build you do with us afterward. So if you go ahead, the audit effectively costs nothing. This call is free either way.</p>
      </details>
      <details class="bg-v6-bg rounded-xl border border-v6-border p-4">
        <summary class="cursor-pointer font-semibold text-v6-dark">What do you need access to?</summary>
        <p class="mt-3 text-sm text-v6-text-muted leading-relaxed">For this call, nothing. For the audit, view-only access to your HubSpot portal. Nothing leaves your portal, and access is revoked the moment the audit ends. NDA on request.</p>
      </details>
      <details class="bg-v6-bg rounded-xl border border-v6-border p-4">
        <summary class="cursor-pointer font-semibold text-v6-dark">What will I actually walk away with?</summary>
        <p class="mt-3 text-sm text-v6-text-muted leading-relaxed">From this call, a straight read on whether the audit is worth doing for your situation, with no pressure. From the audit, three lists built against your real portal: the renewals at risk in the next 90 days, the unbilled uplift sitting in your contracts, and the workflows that break at year 3, with names and numbers.</p>
      </details>
      <details class="bg-v6-bg rounded-xl border border-v6-border p-4">
        <summary class="cursor-pointer font-semibold text-v6-dark">How long does it take?</summary>
        <p class="mt-3 text-sm text-v6-text-muted leading-relaxed">The call is 30 minutes. On it we scope the audit and agree a timeline that works for you.</p>
      </details>
      <details class="bg-v6-bg rounded-xl border border-v6-border p-4">
        <summary class="cursor-pointer font-semibold text-v6-dark">What if we turn out not to be a fit?</summary>
        <p class="mt-3 text-sm text-v6-text-muted leading-relaxed">Then we will tell you. The call is free, and if the audit would not pay for itself for you, we would rather say so than sell you one.</p>
      </details>
    </div>
  </section>

  <section class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-xl font-bold text-v6-dark text-center mb-1">Your three options</h2>
    <p class="text-center text-sm text-v6-text-muted mb-6">Only one of them is us, and it is fine if the answer is one of the others.</p>
    <div class="grid sm:grid-cols-3 gap-4">
      <div class="bg-white border border-v6-border rounded-xl p-4">
        <div class="font-semibold text-v6-dark mb-1">Do nothing</div>
        <p class="text-sm text-v6-text-muted leading-relaxed">The leakage keeps compounding quietly. You usually find out at renewal or at year 3, when it is hardest to fix.</p>
      </div>
      <div class="bg-white border border-v6-border rounded-xl p-4">
        <div class="font-semibold text-v6-dark mb-1">Do it yourself</div>
        <p class="text-sm text-v6-text-muted leading-relaxed">You can rebuild these checks in HubSpot. It is doable, but fiddly and slow, and a self-check still cannot easily show which specific deals are exposed right now.</p>
      </div>
      <div class="bg-v6-bg border border-v6-teal rounded-xl p-4">
        <div class="font-semibold text-v6-teal mb-1">The renewal audit</div>
        <p class="text-sm text-v6-text-muted leading-relaxed">We run the checks against your actual portal and hand you the named lists, for $600 credited toward any build.</p>
      </div>
    </div>
  </section>

  <Footer />

  <script is:inline>
    (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
    Cal("init", { origin: "https://cal.com" });
    Cal("inline", {
      elementOrSelector: "#renewal-audit-cal-inline",
      calLink: "swotbee/your-renewal-audit",
      config: { theme: "light" },
    });
    Cal("ui", { styles: { branding: { brandColor: "#C47A2A" } }, hideEventTypeDetails: false, layout: "month_view" });

    // GA4 call_booked event, the S4 "lead -> discovery call attended" conversion per the
    // CRO framework's KPI tree. bookingSuccessfulV2 is Cal.com's current documented
    // success event (bookingSuccessful is deprecated).
    Cal("on", {
      action: "bookingSuccessfulV2",
      callback: (e) => {
        if (window.gtag) {
          window.gtag("event", "call_booked", {
            booking_uid: e.detail?.data?.uid,
            event_type_id: e.detail?.data?.eventTypeId,
          });
        }
      },
    });
  </script>
</Layout>
