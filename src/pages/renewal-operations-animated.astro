<style>
  /* ===== Scroll-reveal primitives =====
     Hidden initial states are gated behind `.anim` (added by JS only when it can
     run). With no JS, the .anim class is never set, so ALL content stays fully
     visible and the page is never blank. */
  .anim .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    will-change: opacity, transform;
  }
  .anim .reveal.in {
    opacity: 1;
    transform: none;
  }

  /* Staggered children (cards, pills, words, flow steps) */
  .anim .stagger > * {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.55s ease-out, transform 0.55s ease-out;
    will-change: opacity, transform;
  }
  .anim .stagger.in > * { opacity: 1; transform: none; }
  .anim .stagger.in > *:nth-child(1) { transition-delay: 0.04s; }
  .anim .stagger.in > *:nth-child(2) { transition-delay: 0.10s; }
  .anim .stagger.in > *:nth-child(3) { transition-delay: 0.16s; }
  .anim .stagger.in > *:nth-child(4) { transition-delay: 0.22s; }
  .anim .stagger.in > *:nth-child(5) { transition-delay: 0.28s; }
  .anim .stagger.in > *:nth-child(6) { transition-delay: 0.34s; }
  .anim .stagger.in > *:nth-child(7) { transition-delay: 0.40s; }
  .anim .stagger.in > *:nth-child(8) { transition-delay: 0.46s; }
  .anim .stagger.in > *:nth-child(9) { transition-delay: 0.52s; }
  .anim .stagger.in > *:nth-child(n+10) { transition-delay: 0.58s; }

  /* The "With" flow column gets a slightly springier entrance */
  .anim .flow-build > * { transform: translateY(10px) scale(0.98); }
  .anim .flow-build.in > * { transform: none; }

  /* Card + emoji micro-interactions on hover */
  .anim-card { transition: transform 0.25s ease-out, box-shadow 0.25s ease-out; }
  .anim-card:hover { transform: translateY(-4px); }
  .anim-emoji { transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .anim-card:hover .anim-emoji { transform: translateY(-2px) scale(1.12) rotate(-4deg); }

  /* ===== Bee character ===== */
  #bee {
    --tx: 0px;
    --ty: 0px;
    transform: translate(var(--tx), var(--ty));
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .bee-bob { animation: beeBob 4s ease-in-out infinite; }
  @keyframes beeBob {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-8px) rotate(2deg); }
  }
  .bee-wings { animation: beeFlutter 0.18s ease-in-out infinite alternate; }
  @keyframes beeFlutter {
    from { transform: scaleY(1) rotate(0deg); }
    to { transform: scaleY(0.78) rotate(-6deg); }
  }
  .bee-pupil {
    transition: transform 0.25s ease-out;
    transform: translate(var(--px, 0px), var(--py, 0px));
  }

  /* Lightning bolt pulse in the "With" header */
  .bolt-pulse { animation: boltPulse 2.2s ease-in-out infinite; }
  @keyframes boltPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.25); opacity: 0.65; }
  }

  /* ===== CTA hover/focus micro-reveal ===== */
  .cta-pop {
    opacity: 0;
    transform: translate(-50%, 6px);
    transition: opacity 0.25s ease-out, transform 0.25s ease-out;
    pointer-events: none;
  }
  .cta-group:hover .cta-pop,
  .cta-group:focus-within .cta-pop {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  /* ===== Scroll progress bar ===== */
  #scroll-progress {
    transform: scaleX(0);
    transition: transform 0.1s linear;
  }

  /* ===== Reduced motion: show everything, kill motion ===== */
  @media (prefers-reduced-motion: reduce) {
    .anim .reveal, .anim .stagger > * { opacity: 1 !important; transform: none !important; transition: none !important; }
    .bee-bob, .bee-wings, .bolt-pulse { animation: none !important; }
    #bee { transform: none !important; }
    .anim-card, .anim-emoji, .cta-pop, #scroll-progress { transition: none !important; }
  }
</style>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // .anim is added synchronously by the inline head script (FOUC fix), gated on
  // reduced-motion. If neither script runs, .anim is absent and content stays visible.

  // --- Scroll reveals (reveal + stagger containers) ---
  const revealEls = Array.from(document.querySelectorAll(".reveal, .stagger"));
  if (reduce) {
    revealEls.forEach((el) => el.classList.add("in"));
  } else {
    // Reveal anything already in view on load (e.g. the hero) without waiting
    // on IntersectionObserver delivery timing.
    const inView = (el) => {
      const r = el.getBoundingClientRect();
      return r.top < window.innerHeight * 0.9 && r.bottom > 0;
    };
    revealEls.forEach((el) => { if (inView(el)) el.classList.add("in"); });

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("in");
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -8% 0px" }
    );
    revealEls.forEach((el) => { if (!el.classList.contains("in")) io.observe(el); });
  }

  // --- Scroll progress bar ---
  const bar = document.getElementById("scroll-progress");
  if (bar && !reduce) {
    const onScroll = () => {
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      const p = max > 0 ? h.scrollTop / max : 0;
      bar.style.transform = `scaleX(${p})`;
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  } else if (bar) {
    bar.style.opacity = "0";
  }

  // --- Bee cursor reactivity (subtle tilt + pupil tracking) ---
  const bee = document.getElementById("bee");
  if (bee && !reduce) {
    const pupils = bee.querySelectorAll(".bee-pupil");
    let raf = 0;
    const onMove = (e) => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        const r = bee.getBoundingClientRect();
        const cx = r.left + r.width / 2;
        const cy = r.top + r.height / 2;
        const dx = (e.clientX - cx) / window.innerWidth; // -0.5..0.5
        const dy = (e.clientY - cy) / window.innerHeight;
        const clamp = (v, m) => Math.max(-m, Math.min(m, v));
        // whole-body lean (small)
        bee.style.setProperty("--tx", `${clamp(dx * 40, 10)}px`);
        bee.style.setProperty("--ty", `${clamp(dy * 40, 8)}px`);
        // pupils track a touch further
        const px = clamp(dx * 8, 2.2);
        const py = clamp(dy * 8, 2.2);
        pupils.forEach((p) => {
          p.style.setProperty("--px", `${px}px`);
          p.style.setProperty("--py", `${py}px`);
        });
      });
    };
    window.addEventListener("mousemove", onMove, { passive: true });
  }
</script>
