---
// Cookie consent banner + the client half of Google Consent Mode v2.
//
// The defaults ("denied" before any choice) are set in BaseLayout's <head>, BEFORE
// gtag.js loads, because Consent Mode only works if the default arrives before the tag.
// This component is the UI that upgrades that default, plus the loader for Clarity,
// which is held back entirely until consent because session recording is the most
// invasive thing the site does.
//
// Deliberate choices, do not "simplify" these away:
//   - Accept and Reject are the same size, weight and shape. A reject button that is
//     smaller, greyer or hidden behind "Manage options" is the exact dark pattern EU
//     regulators have been fining, and it is also just dishonest.
//   - No pre-ticked anything, and no "by continuing to browse you agree". Continuing to
//     browse is not consent under GDPR/PECR.
//   - Dismissing without choosing is not possible: there is no X. Closing without a
//     choice would leave consent ambiguous, and ambiguous defaults to denied anyway, so
//     the X would only mislead.
//   - The choice is stored in localStorage, not a cookie, so that storing the decision
//     does not itself require consent.
//
// CHANGED 2026-08-11, deliberately, on Siva's decision: the LinkedIn Insight Tag fires on
// All Pages in GTM and is NOT gated on consent. Everything else here still is. The banner
// and the cookie policy were rewritten in the same change so the site does not claim
// otherwise, which is the only part of this that was not optional: the previous copy said
// "Analytics cookies are off until you say yes", and leaving that in place while an
// advertising tag fired regardless would have made a public statement on our own site
// false. Note this means "Reject" is now partial: it stops Google and Microsoft, and does
// not stop LinkedIn. Both the banner text and section 1 of /cookie/ say so plainly.
---

<div
  id="sb-consent"
  role="dialog"
  aria-modal="false"
  aria-labelledby="sb-consent-title"
  aria-describedby="sb-consent-body"
  hidden
  {/* Full-width sheet on phones (a 320px corner card on a 375px screen is just a
      cramped sheet), a right-hand corner card from sm up. left-auto rather than
      inset-x-auto so this never depends on Tailwind's utility ordering. */}
  class="fixed left-0 right-0 bottom-0 z-[60] p-3 sm:left-auto sm:right-4 sm:bottom-4 sm:p-0"
>
  <div
    class="mx-auto w-full rounded-xl border border-v6-border bg-white p-4 shadow-2xl sm:w-80"
  >
    <h2 id="sb-consent-title" class="text-sm font-semibold text-v6-dark">
      Cookies on swotbee.com
    </h2>
    <p id="sb-consent-body" class="mt-1 text-[13px] leading-relaxed text-v6-text">
      LinkedIn advertising cookies are set on every visit. Analytics cookies are off until
      you say yes, and the essential ones that make the site work are always on. See our <a
        href="/cookie/"
        class="text-v6-copper underline underline-offset-2 hover:text-v6-copper-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-v6-copper rounded-sm"
        >Cookie Policy</a
      >.
    </p>
    {/* grid-cols-2, not flex, so the two buttons are exactly equal width at any card size.
        Visible labels are short to keep the card small; the aria-labels carry the full
        meaning, and each contains its visible label so WCAG 2.5.3 still holds. */}
    <div class="mt-3 grid grid-cols-2 gap-2">
      <button
        type="button"
        id="sb-consent-accept"
        aria-label="Accept analytics cookies"
        class="min-h-[44px] rounded-lg bg-v6-copper px-3 py-2 text-sm font-semibold text-white transition-colors hover:bg-v6-copper-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-v6-copper"
      >
        Accept
      </button>
      <button
        type="button"
        id="sb-consent-reject"
        aria-label="Reject analytics cookies"
        class="min-h-[44px] rounded-lg border-2 border-v6-dark bg-white px-3 py-2 text-sm font-semibold text-v6-dark transition-colors hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-v6-dark"
      >
        Reject
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = "sb_consent";
    var el = document.getElementById("sb-consent");
    if (!el) return;

    function read() {
      try {
        return localStorage.getItem(KEY);
      } catch (e) {
        // Private mode or storage disabled. Treat as undecided and re-ask; we cannot
        // remember the answer, but we must not silently assume consent.
        return null;
      }
    }

    function write(v) {
      try {
        localStorage.setItem(KEY, v);
      } catch (e) {}
    }

    function apply(granted) {
      if (typeof window.gtag === "function") {
        window.gtag("consent", "update", {
          ad_storage: granted ? "granted" : "denied",
          analytics_storage: granted ? "granted" : "denied",
          ad_user_data: granted ? "granted" : "denied",
          ad_personalization: granted ? "granted" : "denied",
        });
      }
      // Tell Google Tag Manager, in the one language a tag's own trigger understands.
      // The gtag consent update above is what GTM's built-in consent checks read, but a
      // tag still needs a trigger to fire on, and triggers listen to the dataLayer. Without
      // this push, a consent-gated tag in the container would have to poll localStorage to
      // discover the answer, or worse, be left on All Pages and fire before the visitor
      // ever chose. Fires on denial too, so a tag can react to withdrawal rather than only
      // to consent.
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: granted ? "sb_consent_granted" : "sb_consent_denied" });

      // Clarity is never loaded on a denied or undecided visit.
      if (granted && typeof window.__sbLoadClarity === "function") {
        window.__sbLoadClarity();
      }
    }

    // Withdrawal has to actually withdraw. Clarity cannot be unloaded once it is running,
    // so going from granted to denied clears the tracking cookies and reloads: after the
    // reload the script is simply never injected. Without this, "Reject" would leave
    // session recording running for the rest of the visit, which is worse than useless.
    function clearTrackingCookies() {
      var host = location.hostname;
      var domains = ["", host, "." + host];
      var parts = host.split(".");
      if (parts.length > 2) domains.push("." + parts.slice(-2).join("."));
      document.cookie.split(";").forEach(function (c) {
        var name = c.trim().split("=")[0];
        // Keep this in step with TRACKING_COOKIE in scripts/verify-consent-gating.mjs.
        // The LinkedIn and Meta names are listed before those tags ship, so the sweep is
        // never the thing that was forgotten. Harmless while the cookies do not exist.
        //
        // Honest limit: LinkedIn's bcookie/lidc/UserMatchHistory live on .linkedin.com and
        // CANNOT be deleted by this site's JavaScript, because a page cannot write a
        // cookie for another domain. Only the first-party ones actually clear. The cookie
        // policy must not promise otherwise.
        if (!/^(_ga|_gid|_gcl|_clck|_clsk|_uetsid|_uetvid|_fbp|_fbc|li_sugr|li_gc|bcookie|bscookie|lidc|UserMatchHistory|AnalyticsSyncHistory)/.test(name)) return;
        domains.forEach(function (d) {
          document.cookie =
            name + "=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/" +
            (d ? "; domain=" + d : "");
        });
      });
    }

    var accept = document.getElementById("sb-consent-accept");
    var reject = document.getElementById("sb-consent-reject");
    if (!accept || !reject) return;

    function choose(granted) {
      var wasGranted = read() === "granted";
      write(granted ? "granted" : "denied");
      el.hidden = true;
      if (!granted && wasGranted) {
        clearTrackingCookies();
        location.reload();
        return;
      }
      apply(granted);
    }

    accept.addEventListener("click", function () { choose(true); });
    reject.addEventListener("click", function () { choose(false); });

    // Registered for EVERY visitor, including those who already chose. They are precisely
    // the people who need it: this listener used to sit below the early returns below, so
    // the footer control was dead for anyone with a stored choice, i.e. everyone who could
    // ever want to withdraw. Caught by the end-to-end test, not by reading the code.
    var reopened = false;
    document.addEventListener("click", function (e) {
      var t = e.target.closest ? e.target.closest("[data-consent-reopen]") : null;
      if (!t) return;
      e.preventDefault();
      reopened = true;
      el.hidden = false;
      accept.focus();
    });

    // Escape dismisses only a banner reopened from the footer, where a choice already
    // exists and leaving it unchanged is a valid outcome. A first-time visitor cannot
    // dismiss it, because "undecided" must not look like an answer.
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && reopened && !el.hidden) el.hidden = true;
    });

    var stored = read();
    if (stored === "granted") {
      apply(true);
      return; // decided: apply it, but do not ask again
    }
    if (stored === "denied") {
      apply(false);
      // Swept on every load, not just at the moment of withdrawal. GA4 rewrites its
      // cookie during unload, so a cookie cleared immediately before location.reload()
      // comes back on the next page; the e2e test caught _ga_* surviving a rejection.
      // Doing it here is idempotent and also cleans up visitors who were tracked before
      // this banner existed.
      clearTrackingCookies();
      return;
    }

    el.hidden = false;
  })();
</script>
