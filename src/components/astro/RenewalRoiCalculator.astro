      acvLabel: "Average contract value",
      leak: "expansion revenue left on the table",
      vig: "SaaS",
      slip: { nothing: 0.15, spreadsheets: 0.11, system: 0.08, custom: 0.05 },
      recovery: 0.7,
    },
    proptech: {
      renewals: 300,
      acv: 20000,
      noun: "platform contracts",
      acvLabel: "Average contract value",
      leak: "renewal dates tracked off-CRM",
      vig: "proptech",
      slip: { nothing: 0.18, spreadsheets: 0.13, system: 0.09, custom: 0.05 },
      recovery: 0.5,
    },
  };
  const DEFAULT_TRACKING = "spreadsheets";
  // Illustrative dramatization, not a sourced figure: how far into its current-churn
  // ceiling today's actual renewal volume is assumed to already be. This is what makes
  // the "if nothing changes" path visibly rise before it stalls (matching the video's
  // elephant-curve shape) instead of being flat from year 0. There's no way to source
  // "how far along its own growth curve is a typical company today" the way churn/ACV
  // were researched, so this stays one shared constant, not a per-industry claim.
  // Kept high (close to 1) so the stall reads clearly within 5 years even for
  // low-churn industries, where convergence toward the ceiling is naturally slow: the
  // "if you fix the leak" path always has a lower effective churn rate by construction
  // (recovery% > 0), so it keeps climbing visibly even once "if nothing changes" has
  // flattened out.
  const START_FRACTION_OF_CEILING = 0.8;
  const TRACKING = {
    // Tracking maturity changes both the amount that leaks (industry.slip above)
    // and how much of that leak a renewal-operations intervention can recover.
    // The multiplier preserves the vertical evidence base while making the selector
    // meaningfully change the "if fixed" path as well as the current path.
    nothing: { vig: "on memory and calendars", recoveryMultiplier: 1.0, escalationMiss: 0.5 },
    spreadsheets: { vig: "in spreadsheets", recoveryMultiplier: 0.8, escalationMiss: 0.4 },
    system: { vig: "in a partial system", recoveryMultiplier: 0.55, escalationMiss: 0.25 },
    custom: {
      vig: "with custom-built workflows",
      recoveryMultiplier: 0.35,
      escalationMiss: 0.1,
      leakAppend:
        ", and the year-3 cliff when HubSpot loop protection stops creating deals",
    },
  };

  const byId = (id) => document.getElementById(id);

  const industryGroup = byId("roi-industry");
  const trackSel = byId("roi-track");

  const renewalsEl = byId("roi-renewals");
  const acvEl = byId("roi-acv");
  const slipEl = byId("roi-slip");
  const eligibleEl = byId("roi-eligible");
  const upliftEl = byId("roi-uplift");
  const hoursEl = byId("roi-hours");
  const ownerCostEl = byId("roi-owner-cost");
  const renewalsOut = byId("roi-renewals-out");
  const acvOut = byId("roi-acv-out");
  const slipOut = byId("roi-slip-out");
  const eligibleOut = byId("roi-eligible-out");
  const upliftOut = byId("roi-uplift-out");
  const hoursOut = byId("roi-hours-out");
  const ownerCostOut = byId("roi-owner-cost-out");
  const renewalsLabel = byId("roi-renewals-label");
  const acvLabel = byId("roi-acv-label");

  const ceilingCurrentOut = byId("roi-ceiling-current");
  const ceilingRecoveredOut = byId("roi-ceiling-recovered");
  const ceilingCurrentLabel = byId("roi-ceiling-current-label");
  const ceilingRecoveredLabel = byId("roi-ceiling-recovered-label");
  const growthLeftOut = byId("roi-growth-left");
  const ctaGapOut = byId("roi-cta-gap");
  const ctaButton = byId("roi-cta");
  const extraHoursEl = byId("roi-extra-hours");
  const extraRetentionEl = byId("roi-extra-retention");
  const vignetteEl = byId("roi-vignette");
  const leakEl = byId("roi-leak");

  const chart = byId("roi-chart");
  const lineCurrent = byId("roi-line-current");
  const lineRecovered = byId("roi-line-recovered");
  const areaEl = byId("roi-area");
  const dotCurrent = byId("roi-dot-current");
  const dotRecovered = byId("roi-dot-recovered");
  const gapCalloutGroup = byId("roi-gap-callout");

  // Only wire up if the calculator markup is actually on the page.
  if (industryGroup && renewalsEl && acvEl && slipEl && chart) {
    const SVG_NS = "http://www.w3.org/2000/svg";
    const X0 = 14,
      X1 = 676,
      Y0 = 14,
      Y1 = 245,
      YEARS = 5;

    const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);
    const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
    const roundTo = (v, step) => Math.round(v / step) * step;
    const yearX = (i) => X0 + (i / YEARS) * (X1 - X0);
    const getIndustry = () => industryGroup.dataset.value || "energy"; // active pill

    // ACV slider runs on a logarithmic position (0..1000) so the common
    // mid-market band ($1k..$100k) gets most of the travel while the long tail
    // up to $5M still fits. posToAcv/acvToPos convert position <-> dollars, and
    // niceAcv snaps to readable increments that scale with magnitude.
    const ACV_MIN = 1000,
      ACV_MAX = 5000000,
      ACV_STEPS = 1000;
    const ACV_RATIO = Math.log(ACV_MAX / ACV_MIN);
    const niceAcv = (v) => {
      if (v < 10000) return Math.round(v / 500) * 500;
      if (v < 100000) return Math.round(v / 1000) * 1000;
      if (v < 1000000) return Math.round(v / 5000) * 5000;
      return Math.round(v / 50000) * 50000;
    };
    const posToAcv = (pos) =>
      niceAcv(ACV_MIN * Math.exp((pos / ACV_STEPS) * ACV_RATIO));
    const acvToPos = (acv) =>
      Math.round(
        (Math.log(clamp(acv, ACV_MIN, ACV_MAX) / ACV_MIN) / ACV_RATIO) *
          ACV_STEPS,
      );

    // Static chart furniture: X-axis year ticks only. Gridlines and Y-axis dollar
    // labels depend on the live inputs (the ceiling scale differs by industry and
    // slider position) so they're redrawn on every calc() inside drawChart().
    (function initChart() {
      const xl = byId("roi-xlabels");
      for (let i = 0; i <= YEARS; i++) {
        const t = document.createElementNS(SVG_NS, "text");
        t.setAttribute("x", String(yearX(i)));
        t.setAttribute("y", String(Y1 + 18));
        t.setAttribute("fill", "#5a6a78");
        t.setAttribute("font-size", "11");
        t.setAttribute("text-anchor", i === 0 ? "start" : "middle");
        t.textContent = i === 0 ? "Now" : "Yr " + i;
        xl.appendChild(t);
      }
    })();

    // Growth-ceiling model: given today's renewals, ACV, slip%, and the industry's
    // recovery rate, project the book's value for each of the next 5 years under two
    // paths, both starting from today's actual renewals. Today's book is illustrated as
    // partway (START_FRACTION_OF_CEILING) to the ceiling its current churn implies, so
    // the "current" path genuinely rises before it visibly decelerates into that ceiling
    // ("cancellation always wins", the video's elephant-curve stall), instead of being
    // flat from year 0. "Recovered" shares the same starting point and new-business
    // rate, but lowers the effective churn rate by the recoverable share, so it climbs
    // past the stall toward a higher ceiling instead of flattening there.
    const projectCeilings = (renewals, acv, slipPct, recoveryFrac, expansionRate) => {
      const slip = slipPct / 100;
      const ceilingCurrentUnits = renewals / START_FRACTION_OF_CEILING;
      const newBusiness = ceilingCurrentUnits * slip;
      const effectiveSlip = Math.max(0.001, slip * (1 - recoveryFrac) - expansionRate);
      const current = [renewals];
      const recovered = [renewals];
      for (let i = 1; i <= YEARS; i++) {
        current.push(current[i - 1] * (1 - slip) + newBusiness);
        recovered.push(recovered[i - 1] * (1 - effectiveSlip) + newBusiness);
      }
      return {
        currentBook: current.map((v) => v * acv),
        recoveredBook: recovered.map((v) => v * acv),
        ceilingCurrent: ceilingCurrentUnits * acv,
        ceilingRecovered:
          effectiveSlip > 0
            ? (newBusiness / effectiveSlip) * acv
            : ceilingCurrentUnits * acv,
      };
    };

    const prefersReducedMotion = () =>
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let hasPlayedIntroDraw = false;

    // "Fly to CTA" micro-interaction: a clone of the headline number lifts off the
    // gradient card and flies down into the CTA button, landing with a small pulse.
    // Reads the number fresh at fire-time (not captured earlier) in case the visitor
    // changed something during the delay before this fires.
    const flyNumberToButton = () => {
      const sourceRect = growthLeftOut.getBoundingClientRect();
      const targetRect = ctaButton.getBoundingClientRect();
      const flyer = document.createElement("div");
      flyer.className = "roi-flyer";
      flyer.textContent = ctaGapOut.textContent;
      flyer.style.left = sourceRect.left + sourceRect.width / 2 + "px";
      flyer.style.top = sourceRect.top + sourceRect.height / 2 + "px";
      flyer.style.transform = "translate(-50%, -50%) scale(1)";
      flyer.style.opacity = "1";
      document.body.appendChild(flyer);

      let landed = false;
      const land = () => {
        if (landed) return; // transitionend and the safety-net timeout can both fire
        landed = true;
        flyer.remove();
        ctaButton.classList.add("roi-cta-land");
        setTimeout(() => ctaButton.classList.remove("roi-cta-land"), 450);
      };
      flyer.addEventListener("transitionend", land, { once: true });
      setTimeout(land, 1000); // safety net: guarantees cleanup even if transitionend never fires

      // A newly-inserted element needs a full paint with its "from" styles before the
      // "to" styles are set, or the browser can skip straight to the end state without
      // running the transition at all (and transitionend then never fires). A single
      // forced reflow isn't reliably enough for a just-appended element; double rAF is
      // the standard fix, guaranteeing a paint has happened in between.
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          flyer.style.left = targetRect.left + targetRect.width / 2 + "px";
          flyer.style.top = targetRect.top + targetRect.height / 2 + "px";
          flyer.style.transform = "translate(-50%, -50%) scale(0.35)";
          flyer.style.opacity = "0";
        });
      });
    };

    // Fires the fly-to-CTA flourish relative to when the CTA is actually on screen, not
    // just relative to when the chart above it was revealed: on a tall page those can be
    // two different scroll positions, and firing it while the CTA is off-screen means
    // the visitor never sees it happen at all. introDuration is the line-draw's own
    // ~1.6s: if the CTA is already visible, still wait for that to finish first, or the
    // number would fly into the button before the chart has finished revealing itself.
    const scheduleFlyToButton = (introDuration) => {
      const ctaRect = ctaButton.getBoundingClientRect();
      const ctaAlreadyVisible =
        ctaRect.top < window.innerHeight && ctaRect.bottom > 0;
      if (ctaAlreadyVisible) {
        setTimeout(flyNumberToButton, introDuration + 700);
        return;
      }
      if (!("IntersectionObserver" in window)) return;
      const ctaObserver = new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting) {
            ctaObserver.disconnect();
            setTimeout(flyNumberToButton, 400);
          }
        },
        { threshold: 0.6 },
      );
      ctaObserver.observe(ctaButton);
    };

    // Animates the two lines "drawing in" left to right via stroke-dashoffset (the
    // standard technique for this effect, no charting library needed for a 2-line
    // chart this small). The full ~1.6s sweep plays once, the first time the chart is
    // revealed, so both lines visibly rise together before the copper one decelerates
    // into its stall while the teal one keeps climbing past it. Every change after that
    // (a visitor clicking through industries to compare) gets a fast ~300ms crossfade
    // instead: re-running the full slow sweep on every click would mean a quick explorer
    // never sees a settled chart before triggering the next one.
    const revealChart = (animate) => {
      if (prefersReducedMotion()) animate = false;
      const isIntroDraw = animate && !hasPlayedIntroDraw;
      const duration = isIntroDraw ? 1600 : 300;
      if (animate) hasPlayedIntroDraw = true;

      [lineCurrent, lineRecovered].forEach((line) => {
        line.style.transition = "none";
        if (!animate) {
          line.style.strokeDasharray = "none";
          line.style.strokeDashoffset = "0";
          void line.getBoundingClientRect();
          line.style.transition = "";
          return;
        }
        const len = line.getTotalLength();
        line.style.strokeDasharray = String(len);
        line.style.strokeDashoffset = String(len);
        void line.getBoundingClientRect(); // force reflow so the "hidden" state registers before animating
        line.style.transition =
          "stroke-dashoffset " + duration + "ms cubic-bezier(0.22,1,0.36,1)";
        line.style.strokeDashoffset = "0";
      });

      const fadeDelay = animate ? Math.max(duration - 250, 0) : 0;
      [dotCurrent, dotRecovered, areaEl, gapCalloutGroup].forEach((el) => {
        el.style.transition = "none";
        if (!animate) {
          el.style.opacity = "1";
          void el.getBoundingClientRect();
          el.style.transition = "";
          return;
        }
        el.style.opacity = "0";
        void el.getBoundingClientRect();
        el.style.transition = "opacity 250ms ease-out " + fadeDelay + "ms";
        el.style.opacity = "1";
      });

      // Grand-finale flourish: once per session (isIntroDraw only), not on every
      // subsequent industry/dropdown change, for the same reason the full line-draw
      // doesn't replay on every click either. Scheduling (not firing directly) because
      // on a tall page the CTA may not be on screen yet when the chart itself is.
      if (isIntroDraw) {
        scheduleFlyToButton(duration);
      }
    };

    const drawChart = (currentBook, recoveredBook, animate, growthLeft) => {
      const grid = byId("roi-grid");
      const ylabels = byId("roi-ylabels");
      grid.replaceChildren();
      ylabels.replaceChildren();

      // Zoom the axis to the range the two lines actually occupy, instead of forcing
      // it down to $0. The gap this chart exists to show is often a small slice of the
      // book's total value (e.g. a few % for a low-recovery industry), so a 0-based
      // axis squeezes it into a sliver at the top. Padding both ends keeps the lines
      // off the plot edges; axis labels stay honestly numbered either way.
      const allValues = [...currentBook, ...recoveredBook];
      const rawMin = Math.min(...allValues);
      const rawMax = Math.max(...allValues);
      const pad = (rawMax - rawMin) * 0.15 || rawMax * 0.1 || 1;
      const minV = Math.max(0, rawMin - pad);
      const maxV = rawMax + pad;

      for (let k = 0; k <= 4; k++) {
        const y = Y0 + (k * (Y1 - Y0)) / 4;
        const ln = document.createElementNS(SVG_NS, "line");
        ln.setAttribute("x1", String(X0));
        ln.setAttribute("x2", String(X1));
        ln.setAttribute("y1", String(y));
        ln.setAttribute("y2", String(y));
        ln.setAttribute("stroke", k === 4 ? "#cfcabd" : "#E5E2DA");
        ln.setAttribute("stroke-width", k === 4 ? "1.5" : "1");
        grid.appendChild(ln);

        const label = document.createElementNS(SVG_NS, "text");
        label.setAttribute("x", String(X0 - 4));
        label.setAttribute("y", String(y - 3));
        label.setAttribute("fill", "#5a6a78");
        label.setAttribute("font-size", "9.5");
        label.setAttribute("text-anchor", "start");
        // White halo so the label stays legible where a data line crosses right behind it.
        label.setAttribute("stroke", "#fff");
        label.setAttribute("stroke-width", "3");
        label.setAttribute("paint-order", "stroke");
        label.textContent = fmtCompact.format(maxV - (k / 4) * (maxV - minV));
        ylabels.appendChild(label);
      }

      const toPts = (arr) =>
        arr.map(
          (v, i) =>
            yearX(i).toFixed(1) +
            "," +
            (Y1 - ((v - minV) / (maxV - minV)) * (Y1 - Y0)).toFixed(1),
        );
      const currentPts = toPts(currentBook);
      const recoveredPts = toPts(recoveredBook);

      lineCurrent.setAttribute("points", currentPts.join(" "));
      lineRecovered.setAttribute("points", recoveredPts.join(" "));

      // Shaded band = the growth the leak is currently costing: the gap that opens up
      // between the flat "if nothing changes" line and the rising "if fixed" line.
      areaEl.setAttribute(
        "d",
        "M " +
          recoveredPts.join(" L ") +
          " L " +
          currentPts.slice().reverse().join(" L ") +
          " Z",
      );

      const endCurrent = currentPts[YEARS].split(",");
      const endRecovered = recoveredPts[YEARS].split(",");
      dotCurrent.setAttribute("cx", endCurrent[0]);
      dotCurrent.setAttribute("cy", endCurrent[1]);
      dotRecovered.setAttribute("cx", endRecovered[0]);
      dotRecovered.setAttribute("cy", endRecovered[1]);

      // Badge calling out the $ gap directly on the chart, anchored at Year 3 (clear of
      // the year-5 dots) at the vertical midpoint between the two lines there. Shows the
      // same headline "growth left on the table" figure as the card and CTA below, not a
      // separate year-3 snapshot value, so the number is consistent everywhere it appears
      // rather than looking like a second, contradictory claim. Solid dark fill behind the
      // text, not a tint or outline, so it stays legible regardless of which line or
      // shading happens to sit behind it at that point.
      gapCalloutGroup.replaceChildren();
      const calloutIdx = 3;
      if (growthLeft > 0) {
        const calloutX = currentPts[calloutIdx].split(",")[0];
        const calloutCurrentY = parseFloat(
          currentPts[calloutIdx].split(",")[1],
        );
        const calloutRecoveredY = parseFloat(
          recoveredPts[calloutIdx].split(",")[1],
        );
        const calloutY = (calloutCurrentY + calloutRecoveredY) / 2;

        const text = document.createElementNS(SVG_NS, "text");
        text.setAttribute("x", calloutX);
        text.setAttribute("y", String(calloutY + 4));
        text.setAttribute("text-anchor", "middle");
        text.setAttribute("font-size", "11");
        text.setAttribute("font-weight", "700");
        text.setAttribute("fill", "#ffffff");
        text.textContent =
          fmtCompact.format(growthLeft) + "/yr left on the table";
        gapCalloutGroup.appendChild(text);

        const bbox = text.getBBox();
        const padX = 8,
          padY = 4;
        const rect = document.createElementNS(SVG_NS, "rect");
        rect.setAttribute("x", String(bbox.x - padX));
        rect.setAttribute("y", String(bbox.y - padY));
        rect.setAttribute("width", String(bbox.width + padX * 2));
        rect.setAttribute("height", String(bbox.height + padY * 2));
        rect.setAttribute("rx", "6");
        rect.setAttribute("fill", "#1a2530");
        gapCalloutGroup.insertBefore(rect, text);
      }

      revealChart(animate);
    };

    // Industry sets editable renewal-volume and contract-value defaults and labels.
    const applyDefaults = () => {
      const ind = INDUSTRY[getIndustry()];
      renewalsEl.value = String(
        clamp(
          roundTo(ind.renewals, 50),
          Number(renewalsEl.min),
          Number(renewalsEl.max),
        ),
      );
      acvEl.value = String(acvToPos(niceAcv(ind.acv))); // acvToPos clamps to $1k..$5M
      renewalsLabel.textContent = cap(ind.noun) + " per year";
      acvLabel.textContent = ind.acvLabel;
    };

    // Slip% comes from the ACTIVE industry's own slip-by-tracking-method table, not a
    // shared ladder: research showed this varies too much by vertical to share.
    const applyTrackingSlip = () => {
      const pct = INDUSTRY[getIndustry()].slip[trackSel.value] * 100;
      slipEl.value = String(Math.round(pct));
    };

    const updateVignette = () => {
      if (!vignetteEl) return; // vignette markup is commented out
      const ind = INDUSTRY[getIndustry()];
      vignetteEl.textContent =
        "Sounds like a " +
        ind.vig +
        " ops team tracking renewals " +
        TRACKING[trackSel.value].vig +
        ".";
    };

    const updateLeak = () => {
      let leak = INDUSTRY[getIndustry()].leak;
      if (trackSel.value === "custom") leak += TRACKING.custom.leakAppend;
      leakEl.textContent = leak + ".";
    };

    const updateReadouts = (renewals, slipPct, recovery, hoursPerRenewal, ownerHourlyCost) => {
      if (extraHoursEl) {
        const hours = Math.round(renewals * hoursPerRenewal);
        const manualCost = hours * ownerHourlyCost;
        extraHoursEl.textContent =
          "~ " +
          hours.toLocaleString("en-US") +
          " hrs/year · " + fmtCompact.format(manualCost) + "/year in manual renewal work";
      }
      if (extraRetentionEl) {
        const recoverablePoints = Math.max(1, Math.round(slipPct * recovery));
        extraRetentionEl.textContent =
          "~ " +
          recoverablePoints +
          " pts of gross retention potentially recoverable";
      }
    };

    // animate=true for discrete "new scenario" actions (pill click, dropdown change);
    // false for continuous slider dragging, which should stay instant/responsive and
    // never fight an in-flight animation on every pixel of the drag.
    const calc = (animate = false) => {
      const ind = INDUSTRY[getIndustry()];
      const renewals = Number(renewalsEl.value);
      const acv = posToAcv(Number(acvEl.value));
      const slipPct = Number(slipEl.value);
      const eligiblePct = Number(eligibleEl.value);
      const upliftPct = Number(upliftEl.value);
      const hoursPerRenewal = Number(hoursEl.value);
      const ownerHourlyCost = Number(ownerCostEl.value);
      const recovery =
        ind.recovery * TRACKING[trackSel.value].recoveryMultiplier;
      const escalationRecoveryRate = (eligiblePct / 100) * (upliftPct / 100) * TRACKING[trackSel.value].escalationMiss * recovery;

      renewalsOut.textContent = renewals.toLocaleString("en-US");
      acvOut.textContent = fmt.format(acv);
      slipOut.textContent = slipPct + "%";
      eligibleOut.textContent = eligiblePct + "%";
      upliftOut.textContent = upliftPct + "%";
      hoursOut.textContent = hoursPerRenewal + " hrs";
      ownerCostOut.textContent = fmt.format(ownerHourlyCost);

      const { currentBook, recoveredBook, ceilingCurrent, ceilingRecovered } =
        projectCeilings(renewals, acv, slipPct, recovery, escalationRecoveryRate);

      // Compact formatting to fit the smaller, consolidated card row (full precision
      // stayed too wide once these went from 2 large cards + 1 below to one tight row).
      ceilingCurrentOut.textContent = fmtCompact.format(ceilingCurrent);
      ceilingRecoveredOut.textContent = fmtCompact.format(ceilingRecovered);
      ceilingCurrentLabel.textContent = fmt.format(currentBook[YEARS]);
      ceilingRecoveredLabel.textContent = fmt.format(recoveredBook[YEARS]);

      const growthLeft = ceilingRecovered - ceilingCurrent;
      growthLeftOut.textContent = fmtCompact.format(growthLeft);
      ctaGapOut.textContent = fmtCompact.format(growthLeft);

      updateReadouts(renewals, slipPct, recovery, hoursPerRenewal, ownerHourlyCost);
      updateVignette();
      updateLeak();
      drawChart(currentBook, recoveredBook, animate, growthLeft);
    };

    const pills = Array.from(industryGroup.querySelectorAll(".roi-pill"));
    pills.forEach((btn) =>
      btn.addEventListener("click", () => {
        industryGroup.dataset.value = btn.dataset.value;
        pills.forEach((b) => {
          const on = b === btn;
          b.classList.toggle("is-active", on);
          b.setAttribute("aria-pressed", on ? "true" : "false");
        });
        trackSel.value = DEFAULT_TRACKING;
        applyDefaults();
        applyTrackingSlip();
        calc(true);
      }),
    );
    trackSel.addEventListener("change", () => {
      applyTrackingSlip();
      calc(true);
    });
    [renewalsEl, acvEl, slipEl, eligibleEl, upliftEl, hoursEl, ownerCostEl].forEach((el) =>
      el.addEventListener("input", () => calc(false)),
    );

    // Initial cascade so the visitor sees realistic numbers without touching anything.
    // Instant, not animated: this usually runs off-screen before the visitor has
    // scrolled anywhere near the calculator, so an animation here would just be wasted.
    trackSel.value = DEFAULT_TRACKING;
    applyDefaults();
    applyTrackingSlip();
    calc(false);

    // Play the signature "line draws in" moment once, the first time the calculator
    // actually scrolls into view. Reads whatever the visitor has already set at that
    // point (not the page-load defaults), in case they changed something first.
    const section = chart.closest("section");
    if (section && "IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting) {
            calc(true);
            io.disconnect();
          }
        },
        { threshold: 0.3 },
      );
      io.observe(section);
    }
  }
</script>
