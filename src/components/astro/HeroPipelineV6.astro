        <linearGradient id="hpbg-light" x1="0" y1="0" x2="0.5" y2="1">
          <stop offset="0%" stop-color="#f7f5f1" />
          <stop offset="100%" stop-color="#f5f3ef" />
        </linearGradient>
        <filter id="hps-dark" x="-5%" y="-5%" width="110%" height="115%">
          <feDropShadow dx="0" dy="1" stdDeviation="2" flood-color="#000" flood-opacity="0.3" />
        </filter>
        <filter id="hps-light" x="-5%" y="-5%" width="110%" height="115%">
          <feDropShadow dx="0" dy="1" stdDeviation="3" flood-color="#5a8a9f" flood-opacity="0.2" />
        </filter>
      </defs>

      <style>
        /* SVG theme using CSS custom properties */
        /* Dark = default */
        .hp-svg {
          --hp-bg: url(#hpbg-dark);
          --hp-card: #152535;
          --hp-card-deal: #1a3248;
          --hp-card-ren: #1a2a20;
          --hp-card-filter: url(#hps-dark);
          --hp-border-muted: #2a5070;
          --hp-border-accent: #3d7a9a;
          --hp-text-primary: #ffffff;
          --hp-text-muted: #5a8a9f;
          --hp-text-muted-strong: #3d7a9a;
          --hp-divider: #ffffff;
          --hp-sub-text: #ffffff;
          --hp-yellow: #D4960A;
          --hp-yellow-border: #D4960A;
        }

        /* Light mode override */
        @media (prefers-color-scheme: light) {
          .hp-svg {
            --hp-bg: url(#hpbg-light);
            --hp-card: #ffffff;
            --hp-card-deal: #f5f3ef;
            --hp-card-ren: #f5f0e8;
            --hp-card-filter: url(#hps-light);
            --hp-border-muted: #d4c5a9;
            --hp-border-accent: #5a8a9f;
            --hp-text-primary: #0f2a3d;
            --hp-text-muted: #3d7a9a;
            --hp-text-muted-strong: #2a5070;
            --hp-divider: #d4c5a9;
            --hp-sub-text: #2a5070;
            --hp-yellow: #A86520;
            --hp-yellow-border: #A86520;
          }
        }

        .hp-bg { fill: var(--hp-bg); }
        .hp-card { fill: var(--hp-card); stroke: var(--hp-border-muted); }
        .hp-card-accent { fill: var(--hp-card); stroke: var(--hp-border-accent); }
        .hp-card-deal { fill: var(--hp-card-deal); stroke: var(--hp-border-accent); filter: var(--hp-card-filter); }
        .hp-card-ren { fill: var(--hp-card-ren); stroke: #5AAB9D; filter: var(--hp-card-filter); }
        .hp-text-primary { fill: var(--hp-text-primary); }
        .hp-text-muted { fill: var(--hp-text-muted); }
        .hp-text-muted-strong { fill: var(--hp-text-muted-strong); }
        .hp-border-muted { fill: var(--hp-border-muted); }
        .hp-border-accent { fill: var(--hp-border-accent); }
        .hp-divider { stroke: var(--hp-divider); }
        .hp-sub-text { fill: var(--hp-sub-text); }
        .hp-stat-card { fill: var(--hp-card); stroke: var(--hp-border-muted); }
        .hp-stat-card-right { fill: var(--hp-card); stroke: #5AAB9D; }
        .hp-yellow { fill: var(--hp-yellow); }
        .hp-yellow-stroke { stroke: var(--hp-yellow-border); }
      </style>

      <!-- Background -->
      <rect width="1100" height="530" class="hp-bg" rx="14" />


      <!-- =============== LEFT HALF: WITHOUT AUTOMATION (muted) =============== -->

      <text x="260" y="36" text-anchor="middle" fill="#3d7a9a" font-size="17" font-weight="700" letter-spacing="1.5" font-family="sans-serif" opacity="0.7">WITHOUT AUTOMATION</text>

      <text x="35" y="65" class="hp-text-muted" opacity="0.5" font-size="14" font-weight="600" font-family="sans-serif">Sales Pipeline</text>

      <!-- Muted stage boxes -->
      <rect x="35" y="78" width="110" height="44" rx="7" class="hp-card hp-border-muted" stroke-width="1" opacity="0.7" />
      <text x="90" y="105" text-anchor="middle" class="hp-text-muted" font-size="16" font-family="sans-serif">Discovery</text>
      <polygon points="149,100 156,95 156,105" class="hp-border-muted" fill="currentColor" opacity="0.5" />

      <rect x="162" y="78" width="110" height="44" rx="7" class="hp-card hp-border-muted" stroke-width="1" opacity="0.7" />
