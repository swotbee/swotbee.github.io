<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  var svg = document.querySelector('.hp-svg-mobile');
  if (!svg) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  var stagesX = [40, 165, 290, 415];
  var sY = 87;
  var renX = [40, 205, 370];
  var renY = 203;

  var d1 = svg.querySelector('.m-deal1');
  var d2 = svg.querySelector('.m-deal2');
  var r1 = svg.querySelector('.m-ren1');
  var r2 = svg.querySelector('.m-ren2');
  var bolts = svg.querySelectorAll('.m-bolt');
  var arr = svg.querySelector('.m-arr');
  var arrG = svg.querySelector('.m-arr-growth');

  function pos(el, x, y) { if (el) el.setAttribute('transform', 'translate(' + x + ',' + y + ')'); }
  function show(el, o) { if (el) el.setAttribute('opacity', String(o)); }

  function animDeal(el, fx, fy, tx, ty, dur, cb) {
    if (!el) return;
    var st = null;
    function step(ts) {
      if (!st) st = ts;
      var p = Math.min((ts - st) / dur, 1);
      var e = 1 - Math.pow(1 - p, 3);
      pos(el, fx + (tx - fx) * e, fy + (ty - fy) * e);
      if (p < 1) requestAnimationFrame(step); else if (cb) cb();
    }
    show(el, 1);
    requestAnimationFrame(step);
  }

  function flashBolts(cb) {
    bolts.forEach(function(b) { show(b, 1); });
    setTimeout(cb, 300);
  }

  function updateARR(val) {
    if (arr) { arr.textContent = val; arr.setAttribute('fill', '#D4960A'); setTimeout(function() { arr.setAttribute('fill', '#C47A2A'); }, 700); }
  }

  function resetAll() {
    [d1, d2, r1, r2].forEach(function(el) { show(el, 0); pos(el, -300, -300); });
    bolts.forEach(function(b) { show(b, 0); });
    show(arrG, 0);
    if (arr) { arr.textContent = '$1.2M'; arr.setAttribute('fill', '#C47A2A'); }
  }

  function run() {
    resetAll();
    // Deal 1
    setTimeout(function() { animDeal(d1, stagesX[0], sY - 40, stagesX[0], sY, 500, null); }, 800);
    setTimeout(function() { animDeal(d1, stagesX[0], sY, stagesX[1], sY, 700, null); }, 2000);
    setTimeout(function() { animDeal(d1, stagesX[1], sY, stagesX[2], sY, 700, null); }, 3200);
    setTimeout(function() {
      animDeal(d1, stagesX[2], sY, stagesX[3], sY, 700, function() {
        flashBolts(function() { animDeal(r1, renX[0], renY - 30, renX[0], renY, 400, null); });
      });
    }, 4400);
    setTimeout(function() { animDeal(r1, renX[0], renY, renX[1], renY, 600, null); }, 6200);
    setTimeout(function() { animDeal(r1, renX[1], renY, renX[2], renY, 600, function() { updateARR('$1.8M'); show(arrG, 1); }); }, 7200);

    // Deal 2
    setTimeout(function() { animDeal(d2, stagesX[0], sY - 40, stagesX[0], sY, 500, null); }, 9000);
    setTimeout(function() { animDeal(d2, stagesX[0], sY, stagesX[1], sY, 600, null); }, 10000);
    setTimeout(function() { animDeal(d2, stagesX[1], sY, stagesX[2], sY, 600, null); }, 11000);
    setTimeout(function() {
      animDeal(d2, stagesX[2], sY, stagesX[3], sY, 600, function() {
        flashBolts(function() { animDeal(r2, renX[0], renY - 30, renX[0], renY, 400, null); });
      });
    }, 12000);
    setTimeout(function() { animDeal(r2, renX[0], renY, renX[1], renY, 600, null); }, 13800);
    setTimeout(function() { animDeal(r2, renX[1], renY, renX[2], renY, 600, function() { updateARR('$2.4M'); }); }, 14800);

    setTimeout(run, 18000);
  }

  setTimeout(run, 500);
});
</script>

<!-- ============ DESKTOP: Animated SVG ============ -->
<section class="hp-section hidden md:block">
  <div class="hp-wrap">
    <svg
