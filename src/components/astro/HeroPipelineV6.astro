<script is:inline>
document.addEventListener('DOMContentLoaded', function () {
  var svg = document.querySelector('.hp-svg');
  if (!svg) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  var lStagesX = [40, 167, 294, 421];
  var lY = 83;
  var rStagesX = [580, 707, 834, 961];
  var rY = 83;
  var renStagesX = [580, 750, 920];
  var renY = 193;

  var lDeals = [svg.querySelector('.l-deal1'), svg.querySelector('.l-deal2'), svg.querySelector('.l-deal3'), svg.querySelector('.l-deal4')];
  var rDeals = [svg.querySelector('.r-deal1'), svg.querySelector('.r-deal2'), svg.querySelector('.r-deal3'), svg.querySelector('.r-deal4')];
  var rens = [svg.querySelector('.ren1'), svg.querySelector('.ren2'), svg.querySelector('.ren3')];
  var boltConn = svg.querySelector('.bolt-connector');
  var boltFlash = null;
  var arrText = svg.querySelector('.r-arr-text');
  var arrGrowth = svg.querySelector('.arr-growth');
  var confetti = svg.querySelector('.confetti');
  var confParticles = svg.querySelectorAll('.conf-p');
  var flowDot = svg.querySelector('.flow-dot');
  var stageHls = [
    svg.querySelector('.stage-hl-0'),
    svg.querySelector('.stage-hl-1'),
    svg.querySelector('.stage-hl-2'),
    svg.querySelector('.stage-hl-3')
  ];

  function pos(el, x, y) {
    if (el) el.setAttribute('transform', 'translate(' + x + ',' + y + ')');
  }
  function show(el, o) {
    if (el) el.setAttribute('opacity', String(o));
  }

  function animateDeal(el, fx, fy, tx, ty, dur, cb) {
    if (!el) return;
    var start = null;
    function step(ts) {
      if (!start) start = ts;
      var p = Math.min((ts - start) / dur, 1);
      var ease = 1 - Math.pow(1 - p, 3);
      pos(el, fx + (tx - fx) * ease, fy + (ty - fy) * ease);
      if (p < 1) requestAnimationFrame(step);
      else if (cb) cb();
    }
    show(el, 1);
    requestAnimationFrame(step);
  }

  // Highlight a right-side stage box briefly
  function highlightStage(idx) {
    var hl = stageHls[idx];
    if (!hl) return;
    show(hl, 0.15);
    setTimeout(function() { show(hl, 0.08); }, 300);
    setTimeout(function() { show(hl, 0); }, 800);
  }

  // Confetti burst at Closed Won
  function fireConfetti(cb) {
    show(confetti, 1);
    // Scatter particles outward
    var origins = [];
    confParticles.forEach(function(p) {
      var cx = parseFloat(p.getAttribute('cx') || p.getAttribute('x') || 1011);
      var cy = parseFloat(p.getAttribute('cy') || p.getAttribute('y') || 85);
      origins.push({cx: cx, cy: cy});
    });
    var start = null;
    function step(ts) {
      if (!start) start = ts;
      var p = Math.min((ts - start) / 800, 1);
      confParticles.forEach(function(el, i) {
        var ox = origins[i].cx;
        var oy = origins[i].cy;
        // Scatter outward from center (1011,100) + gravity
        var dx = (ox - 1011) * 4 * p;
        var dy = (oy - 90) * 4 * p + 40 * p * p; // gravity
        el.setAttribute('transform', 'translate(' + dx + ',' + dy + ')');
        el.setAttribute('opacity', String(1 - p));
      });
      if (p < 1) requestAnimationFrame(step);
      else {
        show(confetti, 0);
        confParticles.forEach(function(el) {
          el.setAttribute('transform', 'translate(0,0)');
          el.setAttribute('opacity', '1');
        });
        if (cb) cb();
      }
    }
    requestAnimationFrame(step);
  }

  // Animate flow dot along the path: Closed Won → down → left → down → Renewal
  function animateFlowDot(cb) {
    show(flowDot, 1);
    // Path waypoints: (1011,124) → (1011,155) → (651,155) → (651,193)
    var waypoints = [
      {x:1011, y:124},
      {x:1011, y:155},
      {x:651,  y:155},
      {x:651,  y:193}
    ];
    var segDur = 250; // ms per segment
    var seg = 0;

    function runSeg() {
      if (seg >= waypoints.length - 1) {
        show(flowDot, 0);
        if (cb) cb();
        return;
      }
      var from = waypoints[seg];
      var to = waypoints[seg + 1];
      var start = null;
      function step(ts) {
        if (!start) start = ts;
        var p = Math.min((ts - start) / segDur, 1);
        var ease = p; // linear for smooth travel
        flowDot.setAttribute('cx', from.x + (to.x - from.x) * ease);
        flowDot.setAttribute('cy', from.y + (to.y - from.y) * ease);
        if (p < 1) requestAnimationFrame(step);
        else {
          seg++;
          runSeg();
        }
      }
      requestAnimationFrame(step);
    }
    runSeg();
  }

  function flashBolt(cb) {
    show(boltConn, 1);
    if (boltFlash) {
      boltFlash.setAttribute('r', '16');
      boltFlash.setAttribute('opacity', '0.5');
      setTimeout(function() {
        boltFlash.setAttribute('r', '0');
        boltFlash.setAttribute('opacity', '0');
      }, 400);
    }
    // Animate the flow dot along the path, then create renewal
    animateFlowDot(function() {
      if (cb) cb();
    });
  }

  function updateARR(val) {
    if (!arrText) return;
    arrText.textContent = val;
    var yellowColor = getComputedStyle(svg).getPropertyValue('--hp-yellow').trim() || '#D4960A';
    arrText.setAttribute('fill', yellowColor);
    setTimeout(function() { arrText.setAttribute('fill', '#C47A2A'); }, 700);
  }

  function resetAll() {
    rDeals.concat(rens).forEach(function(el) {
      show(el, 0);
      pos(el, -300, -300);
    });
    show(boltConn, 0);
    show(arrGrowth, 0);
    show(confetti, 0);
    show(flowDot, 0);
    stageHls.forEach(function(hl) { show(hl, 0); });
    if (arrText) { arrText.textContent = '$1.2M'; arrText.setAttribute('fill', '#C47A2A'); }
  }

  function runSequence() {
    resetAll();

    // === DEAL 1 (right side only — left side is static) ===
    // Drop into Discovery
    setTimeout(function() {
      animateDeal(rDeals[0], rStagesX[0], rY - 40, rStagesX[0], rY, 500, function() { highlightStage(0); });
    }, 800);

    // Discovery → Qualified
    setTimeout(function() {
      animateDeal(rDeals[0], rStagesX[0], rY, rStagesX[1], rY, 700, function() { highlightStage(1); });
    }, 2000);

    // Qualified → Proposal
    setTimeout(function() {
      animateDeal(rDeals[0], rStagesX[1], rY, rStagesX[2], rY, 700, function() { highlightStage(2); });
    }, 3200);

    // Proposal → Closed Won → confetti → bolt → renewal
    setTimeout(function() {
      animateDeal(rDeals[0], rStagesX[2], rY, rStagesX[3], rY, 700, function() {
        highlightStage(3);
        fireConfetti(null);
        flashBolt(function() {
          animateDeal(rens[0], renStagesX[0], renY - 30, renStagesX[0], renY, 400, null);
        });
      });
    }, 4400);

    // Renewal 1: Upcoming → In Review
    setTimeout(function() {
      animateDeal(rens[0], renStagesX[0], renY, renStagesX[1], renY, 600, null);
    }, 6200);

    // Renewal 1: In Review → Renewed → ARR tick
    setTimeout(function() {
      animateDeal(rens[0], renStagesX[1], renY, renStagesX[2], renY, 600, function() {
        updateARR('$1.8M');
        show(arrGrowth, 1);
      });
    }, 7200);

    // === DEAL 2 (right side only) ===
    setTimeout(function() {
      animateDeal(rDeals[1], rStagesX[0], rY - 40, rStagesX[0], rY, 500, function() { highlightStage(0); });
    }, 9000);

    setTimeout(function() {
      animateDeal(rDeals[1], rStagesX[0], rY, rStagesX[1], rY, 600, function() { highlightStage(1); });
    }, 10000);

    setTimeout(function() {
      animateDeal(rDeals[1], rStagesX[1], rY, rStagesX[2], rY, 600, function() { highlightStage(2); });
    }, 11000);

    setTimeout(function() {
      animateDeal(rDeals[1], rStagesX[2], rY, rStagesX[3], rY, 600, function() {
        highlightStage(3);
        fireConfetti(null);
        flashBolt(function() {
          animateDeal(rens[1], renStagesX[0], renY - 30, renStagesX[0], renY, 400, null);
        });
      });
    }, 12000);

    // Renewal 2: flows through → ARR $2.4M
    setTimeout(function() {
      animateDeal(rens[1], renStagesX[0], renY, renStagesX[1], renY, 600, null);
    }, 13800);
    setTimeout(function() {
      animateDeal(rens[1], renStagesX[1], renY, renStagesX[2], renY, 600, function() {
        updateARR('$2.4M');
      });
    }, 14800);

    // Loop
    setTimeout(runSequence, 18000);
  }

  setTimeout(runSequence, 500);
});
</script>

