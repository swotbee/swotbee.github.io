---
import { Picture } from 'astro:assets';
import JosephImage from '/public/assets/people/Joseph.png';
import SherlinImage from '/public/assets/people/Sherlin.png';
import PriyaNairImage from '/public/assets/people/Priya Nair.png';
// import RavikumarImage from '/public/assets/people/Ravikumar.png';
import SandeepImage from '/public/assets/people/Sandeep Sharma.png';
import sharmilaImage from '/public/assets/team/sharmilago.png';
import sivakumarImage from '/public/assets/team/siva.jpeg';
import RajkumarImage from '/public/assets/team/rajkumar.jpeg';
import RajImage from '/public/assets/team/raj.png';
import YoganandImage from '/public/assets/team/yoga.jpeg';
import RavikumarImage from '/public/assets/team/ravikumar.png';
import ParthibanImage from '/public/assets/team/parthiban.jpeg';



const teamMembers = [
  {
    name: "Sharmila",
    role: "Hubspot Solutions",
    imageUrl: sharmilaImage,
    country: "India",
    countryCode: "IN",
  },
  {
    name: "Sivakumar",
    role: "Hubspot Solutions",
    imageUrl: sivakumarImage,
    country: "India",
    countryCode: "IN",
  },
  {
    name: "Rajkumar",
    role: "UX & Visual Design ",
    imageUrl: RajkumarImage,
    country: "India",
    countryCode: "IN",
  },
  {
    name: "Raj",
    role: "Global Partner Relations",
    imageUrl: RajImage,
    country: "Canada",
    countryCode: "CA",
  },
  {
    name: "Yoganand",
    role: "Solutions Engineering",
    imageUrl: YoganandImage,
    country: "India",
    countryCode: "IN",
  },
  {
    name: "Ravikumar",
    role: "Marketing Solutions",
    imageUrl: RavikumarImage,
    country: "India",
    countryCode: "IN",
  },
  {
    name: "Parthiban",
    role: "Compliance & Security",
    imageUrl: ParthibanImage,
    country: "Canada",
    countryCode: "CA",
  }
];
---
  <div class="px-6 mx-auto mt-8 max-w-7xl sm:mt-16 lg:px-8">
          <div class="max-w-2xl mx-auto lg:mx-0">
            <h2 class="text-4xl font-semibold tracking-tight text-gray-900 text-pretty sm:text-5xl">Our Global team</h2>
            <p class="mt-6 text-gray-600 text-lg/8">
              We're a dynamic group of individuals who are passionate about what we do and dedicated to delivering the
              best results for our clients.
            </p>
          </div>
          <ul
            role="list"
            class="grid max-w-2xl grid-cols-2 mx-auto mt-20 text-center gap-x-8 gap-y-16 sm:grid-cols-3 md:grid-cols-4 lg:mx-0 lg:max-w-none lg:grid-cols-5 xl:grid-cols-6"
          >
            {teamMembers.map((person) => (
              <li>
                <Picture
                  src={person.imageUrl}
                  alt={`${person.name}'s profile picture`}
                  widths={[96, 192]}
                  formats={['webp', 'avif', 'png']}
                  class="mx-auto rounded-full size-24"
                />
                <div class="flex items-center justify-center mt-2 gap-1">
                  <img
                    src={`https://flagcdn.com/16x12/${person.countryCode.toLowerCase()}.png`}
                    alt={`${person.country} flag`}
                    width="16"
                    height="12"
                  />
                  <span class="text-gray-500 text-xs">{person.country}</span>
                </div>
                <h3 class="mt-6 font-semibold tracking-tight text-gray-900 text-base/7">{person.name}</h3>
                <p class="text-gray-600 text-sm/6">{person.role}</p>
              </li>
            ))}
          </ul>
        </div>

