---
import { Picture } from "astro:assets";
import heroImage from "../../../../public/assets/workflow/CRM_consulting_workflow.v1.png";
// public/assets/workflow/CRM_consulting_workflow.v1.png
// src/components/astro/Hero.astro
---

<section class="hero">
  <div class="bg-highlight-25">
    <div class="px-6 pt-24 pb-4 sm:px-6 sm:pt-32 sm:pb-8 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1
          class="text-4xl italic font-bold tracking-tight text-gray-900 text-balance sm:text-5xl"
        >
          See the Path to Growth Inside Every Account
        </h1>

        <p class="max-w-xl mx-auto mt-6 text-gray-600 text-2xl/8 text-pretty">
          Turn disconnected contacts into clear org maps. Identify
          decision-makers, champions, and blockers.
        </p>

        <p class="max-w-xl mx-auto mt-6 text-gray-600 text-lg/8 text-pretty">
          Discover untapped whitespace, increase Share of Wallet, and drive
          bigger deals with stronger, strategic relationships, all without
          leaving HubSpot.
        </p>
        <div class="flex items-center justify-center mt-10 gap-x-6">
          <a
            href="https://cal.com/swotbee/free-customer-insights-audit?overlayCalendar=true"
            class="rounded-md bg-highlight-500 px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-highlight-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-highlight-600"
            title="Claim Your Free 30-Minute AI Marketing & Sales Automation Session"
            aria-label="Claim Your Free 30-Minute AI Marketing & Sales Automation Session"
          >
            Book a quick walkthrough
          </a>
          <a
            href="https://cal.com/swotbee/free-customer-insights-audit?overlayCalendar=true"
            class="font-semibold text-gray-900 text-sm/6"
          >
            Learn more <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
    <div class="relative pt-8 overflow-hidden">
      <!-- <div class="px-6 mx-auto max-w-7xl lg:px-8">
        <Picture
          src={heroImage}
          alt="CRM Consulting Workflow"
          widths={[768, 1024, 1536, 2048]}
          formats={["webp", "avif", "png"]}
          class="w-full"
        />
        <div aria-hidden="true" class="relative">
          <div
            class="absolute -inset-x-20 bottom-0 bg-linear-to-t from-white pt-[7%]"
          >
          </div>
        </div>
      </div> -->
    </div>
  </div>
</section>
