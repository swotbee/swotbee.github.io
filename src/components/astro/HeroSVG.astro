---
// HeroSVG.astro — Before/After Pipeline Transformation Hero
// Animated SVG showing pipeline chaos → clarity
---

<section class="hero-svg-section">
  <div class="hero-svg-wrapper">
    <svg
      viewBox="0 0 960 540"
      xmlns="http://www.w3.org/2000/svg"
      class="hero-svg"
      role="img"
      aria-label="Pipeline transformation: from chaos to clarity with SWOTBee's HubSpot tools"
    >
      <defs>
        <!-- Background gradient -->
        <linearGradient id="bg-grad" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#1b2a37" />
          <stop offset="100%" stop-color="#141f29" />
        </linearGradient>

        <!-- Reveal mask for right side -->
        <clipPath id="reveal-clip">
          <rect class="reveal-rect" x="480" y="0" width="480" height="540" />
        </clipPath>

        <!-- Glow filters -->
        <filter id="red-glow" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="3" result="blur" />
          <feFlood flood-color="#ff5c35" flood-opacity="0.3" />
          <feComposite in2="blur" operator="in" />
          <feMerge>
            <feMergeNode />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
        <filter id="green-glow" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="3" result="blur" />
          <feFlood flood-color="#70c1b3" flood-opacity="0.3" />
          <feComposite in2="blur" operator="in" />
          <feMerge>
            <feMergeNode />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>

        <!-- Card shadow -->
        <filter id="card-shadow" x="-5%" y="-5%" width="110%" height="120%">
          <feDropShadow dx="0" dy="2" stdDeviation="4" flood-color="#000" flood-opacity="0.2" />
        </filter>
      </defs>

      <!-- ==================== BACKGROUND ==================== -->
      <rect width="960" height="540" fill="url(#bg-grad)" rx="16" />

      <!-- Subtle grid pattern -->
      <g opacity="0.04">
        {Array.from({length: 24}, (_, i) => i).map(i => (
          <line x1={i * 40} y1="0" x2={i * 40} y2="540" stroke="white" stroke-width="0.5" />
        ))}
        {Array.from({length: 14}, (_, i) => i).map(i => (
          <line x1="0" y1={i * 40} x2="960" y2={i * 40} stroke="white" stroke-width="0.5" />
        ))}
      </g>

      <!-- ==================== LABELS ==================== -->
      <!-- "Before" label -->
      <g class="anim-fade-in" style="animation-delay: 0.2s">
        <text x="240" y="52" text-anchor="middle" fill="#ff5c35" font-size="11" font-weight="600" letter-spacing="2" font-family="'Hanken Grotesk Variable', sans-serif" opacity="0.8">BEFORE SWOTBEE</text>
      </g>

      <!-- "After" label -->
      <g class="anim-fade-in" style="animation-delay: 1.8s">
        <text x="720" y="52" text-anchor="middle" fill="#70c1b3" font-size="11" font-weight="600" letter-spacing="2" font-family="'Hanken Grotesk Variable', sans-serif" opacity="0.8">AFTER SWOTBEE</text>
      </g>

      <!-- ==================== LEFT SIDE: BEFORE (chaos) ==================== -->
      <g class="before-side anim-fade-in" style="animation-delay: 0.1s">

        <!-- Pipeline columns (tilted, messy) -->
        <g transform="translate(40, 75)">
          <!-- Column headers -->
          <text x="50" y="15" fill="#ffffff" opacity="0.3" font-size="10" font-weight="500" font-family="'Hanken Grotesk Variable', sans-serif" text-anchor="middle">Discovery</text>
          <text x="160" y="15" fill="#ffffff" opacity="0.3" font-size="10" font-weight="500" font-family="'Hanken Grotesk Variable', sans-serif" text-anchor="middle">Qualified</text>
          <text x="270" y="15" fill="#ffffff" opacity="0.3" font-size="10" font-weight="500" font-family="'Hanken Grotesk Variable', sans-serif" text-anchor="middle">Proposal</text>
          <text x="380" y="15" fill="#ffffff" opacity="0.3" font-size="10" font-weight="500" font-family="'Hanken Grotesk Variable', sans-serif" text-anchor="middle">Closed</text>

          <!-- Column dividers -->
          <line x1="105" y1="5" x2="105" y2="170" stroke="#ffffff" stroke-width="0.5" opacity="0.08" />
          <line x1="215" y1="5" x2="215" y2="170" stroke="#ffffff" stroke-width="0.5" opacity="0.08" />
          <line x1="325" y1="5" x2="325" y2="170" stroke="#ffffff" stroke-width="0.5" opacity="0.08" />

          <!-- Deal cards — BEFORE (tilted, warning badges) -->
          <!-- Card 1: missing fields -->
          <g class="anim-fade-in" style="animation-delay: 0.3s" transform="rotate(-2, 50, 55)">
            <rect x="10" y="30" width="80" height="52" rx="6" fill="#1e3244" stroke="#ff5c35" stroke-width="1" opacity="0.9" />
            <text x="20" y="48" fill="#ffffff" opacity="0.7" font-size="9" font-family="'Hanken Grotesk Variable', sans-serif">Acme Corp</text>
            <text x="20" y="60" fill="#ffffff" opacity="0.4" font-size="7" font-family="'Hanken Grotesk Variable', sans-serif">$120K · Stage 1</text>
            <!-- Red warning badge -->
            <circle cx="78" cy="40" r="8" fill="#ff5c35" class="pulse-red" />
            <text x="78" y="43" text-anchor="middle" fill="white" font-size="7" font-weight="700">!</text>
            <!-- Missing fields indicator -->
            <text x="20" y="74" fill="#ff5c35" font-size="6" opacity="0.7" font-family="'Hanken Grotesk Variable', sans-serif">3 fields missing</text>
          </g>

          <!-- Card 2: stale deal -->
          <g class="anim-fade-in" style="animation-delay: 0.4s" transform="rotate(1.5, 160, 75)">
            <rect x="120" y="30" width="80" height="52" rx="6" fill="#1e3244" stroke="#F5C400" stroke-width="1" opacity="0.9" />
            <text x="130" y="48" fill="#ffffff" opacity="0.7" font-size="9" font-family="'Hanken Grotesk Variable', sans-serif">Beta Inc</text>
            <text x="130" y="60" fill="#ffffff" opacity="0.4" font-size="7" font-family="'Hanken Grotesk Variable', sans-serif">$85K · Stage 2</text>
            <!-- Yellow warning -->
            <circle cx="188" cy="40" r="8" fill="#F5C400" />
            <text x="188" y="43" text-anchor="middle" fill="#1b2a37" font-size="7" font-weight="700">!</text>
            <text x="130" y="74" fill="#F5C400" font-size="6" opacity="0.7" font-family="'Hanken Grotesk Variable', sans-serif">Stale 45 days</text>
          </g>

          <!-- Card 3: no decision maker -->
          <g class="anim-fade-in" style="animation-delay: 0.5s" transform="rotate(-1, 270, 55)">
            <rect x="230" y="30" width="80" height="52" rx="6" fill="#1e3244" stroke="#ff5c35" stroke-width="1" opacity="0.9" />
            <text x="240" y="48" fill="#ffffff" opacity="0.7" font-size="9" font-family="'Hanken Grotesk Variable', sans-serif">Gamma Ltd</text>
            <text x="240" y="60" fill="#ffffff" opacity="0.4" font-size="7" font-family="'Hanken Grotesk Variable', sans-serif">$200K · Stage 3</text>
            <circle cx="298" cy="40" r="8" fill="#ff5c35" class="pulse-red" />
            <text x="298" y="43" text-anchor="middle" fill="white" font-size="7" font-weight="700">!</text>
            <text x="240" y="74" fill="#ff5c35" font-size="6" opacity="0.7" font-family="'Hanken Grotesk Variable', sans-serif">No decision maker</text>
          </g>

          <!-- Card 4: empty closed column -->
          <g class="anim-fade-in" style="animation-delay: 0.5s">
            <rect x="340" y="30" width="80" height="52" rx="6" fill="#1e3244" stroke="#ffffff" stroke-width="0.5" opacity="0.2" stroke-dasharray="4 4" />
            <text x="380" y="60" text-anchor="middle" fill="#ffffff" opacity="0.15" font-size="20" font-family="'Hanken Grotesk Variable', sans-serif">?</text>
          </g>

          <!-- Second row of messy cards -->
          <g class="anim-fade-in" style="animation-delay: 0.6s" transform="rotate(2, 50, 130)">
            <rect x="10" y="92" width="80" height="42" rx="6" fill="#1e3244" stroke="#F5C400" stroke-width="1" opacity="0.7" />
            <text x="20" y="108" fill="#ffffff" opacity="0.5" font-size="8" font-family="'Hanken Grotesk Variable', sans-serif">Delta Corp</text>
            <text x="20" y="120" fill="#ffffff" opacity="0.3" font-size="7" font-family="'Hanken Grotesk Variable', sans-serif">$50K · Stage 1</text>
            <circle cx="78" cy="102" r="7" fill="#F5C400" />
            <text x="78" y="105" text-anchor="middle" fill="#1b2a37" font-size="6" font-weight="700">!</text>
          </g>

          <g class="anim-fade-in" style="animation-delay: 0.6s" transform="rotate(-1.5, 160, 130)">
            <rect x="120" y="92" width="80" height="42" rx="6" fill="#1e3244" stroke="#ff5c35" stroke-width="1" opacity="0.7" />
            <text x="130" y="108" fill="#ffffff" opacity="0.5" font-size="8" font-family="'Hanken Grotesk Variable', sans-serif">Epsilon SA</text>
            <text x="130" y="120" fill="#ffffff" opacity="0.3" font-size="7" font-family="'Hanken Grotesk Variable', sans-serif">$300K · Stage 2</text>
            <circle cx="188" cy="102" r="7" fill="#ff5c35" class="pulse-red" />
            <text x="188" y="105" text-anchor="middle" fill="white" font-size="6" font-weight="700">!</text>
          </g>
        </g>

        <!-- Wrong company associations -->
        <g class="anim-fade-in" style="animation-delay: 0.7s" transform="translate(40, 270)">
          <text x="0" y="0" fill="#ffffff" opacity="0.3" font-size="9" font-weight="500" font-family="'Hanken Grotesk Variable', sans-serif">Company Associations</text>

          <!-- Contact → wrong company (red crossed line) -->
          <g transform="translate(0, 15)">
            <!-- Contact -->
            <rect x="0" y="0" width="70" height="28" rx="5" fill="#1e3244" stroke="#ffffff" stroke-width="0.5" opacity="0.5" />
            <circle cx="16" cy="14" r="7" fill="#3d5e7b" />
            <text x="15" y="17" text-anchor="middle" fill="white" font-size="7">👤</text>
            <text x="30" y="17" fill="#ffffff" opacity="0.6" font-size="7" font-family="'Hanken Grotesk Variable', sans-serif">J. Smith</text>

            <!-- Wrong company -->
            <rect x="180" y="0" width="90" height="28" rx="5" fill="#1e3244" stroke="#ff5c35" stroke-width="1" opacity="0.7" />
            <text x="195" y="17" fill="#ffffff" opacity="0.6" font-size="7" font-family="'Hanken Grotesk Variable', sans-serif">CBRE - NYC</text>
            <text x="258" y="17" fill="#ff5c35" font-size="8">✗</text>

            <!-- Red dashed connection -->
            <line x1="70" y1="14" x2="180" y2="14" stroke="#ff5c35" stroke-width="1.5" stroke-dasharray="4 3" opacity="0.6" class="dash-animate-red" />
          </g>

          <!-- Another wrong match -->
          <g transform="translate(0, 52)">
            <rect x="0" y="0" width="70" height="28" rx="5" fill="#1e3244" stroke="#ffffff" stroke-width="0.5" opacity="0.5" />
            <circle cx="16" cy="14" r="7" fill="#3d5e7b" />
            <text x="15" y="17" text-anchor="middle" fill="white" font-size="7">👤</text>
            <text x="30" y="17" fill="#ffffff" opacity="0.6" font-size="7" font-family="'Hanken Grotesk Variable', sans-serif">M. Chen</text>

            <rect x="180" y="0" width="90" height="28" rx="5" fill="#1e3244" stroke="#ffffff" stroke-width="0.5" opacity="0.3" stroke-dasharray="3 3" />
            <text x="195" y="17" fill="#ffffff" opacity="0.3" font-size="7" font-family="'Hanken Grotesk Variable', sans-serif">??? Unknown</text>

            <line x1="70" y1="14" x2="180" y2="14" stroke="#ffffff" stroke-width="1" stroke-dasharray="4 3" opacity="0.15" />
          </g>
        </g>

        <!-- Revenue metrics (broken) -->
        <g class="anim-fade-in" style="animation-delay: 0.8s" transform="translate(40, 420)">
          <text x="0" y="0" fill="#ffffff" opacity="0.3" font-size="9" font-weight="500" font-family="'Hanken Grotesk Variable', sans-serif">Revenue Tracking</text>

          <g transform="translate(0, 18)">
            <rect x="0" y="0" width="180" height="65" rx="8" fill="#1e3244" stroke="#ffffff" stroke-width="0.5" opacity="0.3" />
            <text x="15" y="22" fill="#ffffff" opacity="0.3" font-size="9" font-family="'Hanken Grotesk Variable', sans-serif">ARR</text>
            <text x="15" y="42" fill="#ff5c35" font-size="18" font-weight="700" font-family="'Hanken Grotesk Variable', sans-serif" class="pulse-red">$ ???</text>
            <text x="15" y="56" fill="#ff5c35" font-size="7" opacity="0.7" font-family="'Hanken Grotesk Variable', sans-serif">3 renewals missed this quarter</text>
          </g>
        </g>
      </g>


      <!-- ==================== CENTER DIVIDER ==================== -->
      <g class="anim-scale-in" style="animation-delay: 1.2s">
        <!-- Vertical divider line -->
        <line x1="480" y1="30" x2="480" y2="510" stroke="#ffffff" stroke-width="0.5" opacity="0.1" class="divider-draw" />

        <!-- Bee icon at center -->
        <g transform="translate(480, 270)">
          <circle cx="0" cy="0" r="22" fill="#ff5c35" class="bee-pulse" />
          <circle cx="0" cy="0" r="18" fill="#1b2a37" />
          <!-- Simple bee icon -->
          <text x="0" y="6" text-anchor="middle" fill="#F5C400" font-size="18">🐝</text>
        </g>

        <!-- Arrow -->
        <g class="anim-fade-in" style="animation-delay: 1.5s">
          <path d="M456 270 L440 262 L440 278 Z" fill="#ffffff" opacity="0.15" />
          <path d="M504 270 L520 262 L520 278 Z" fill="#70c1b3" opacity="0.4" />
        </g>
      </g>


      <!-- ==================== RIGHT SIDE: AFTER (clarity) ==================== -->
      <g class="after-side">

        <!-- Pipeline columns (clean, aligned) -->
        <g transform="translate(500, 75)">
          <!-- Column headers -->
          <text x="50" y="15" fill="#ffffff" opacity="0.7" font-size="10" font-weight="600" font-family="'Hanken Grotesk Variable', sans-serif" text-anchor="middle" class="anim-fade-in" style="animation-delay: 1.6s">Discovery</text>
          <text x="160" y="15" fill="#ffffff" opacity="0.7" font-size="10" font-weight="600" font-family="'Hanken Grotesk Variable', sans-serif" text-anchor="middle" class="anim-fade-in" style="animation-delay: 1.7s">Qualified</text>
          <text x="270" y="15" fill="#ffffff" opacity="0.7" font-size="10" font-weight="600" font-family="'Hanken Grotesk Variable', sans-serif" text-anchor="middle" class="anim-fade-in" style="animation-delay: 1.8s">Proposal</text>
          <text x="380" y="15" fill="#ffffff" opacity="0.7" font-size="10" font-weight="600" font-family="'Hanken Grotesk Variable', sans-serif" text-anchor="middle" class="anim-fade-in" style="animation-delay: 1.9s">Closed Won</text>

          <!-- Column dividers -->
          <line x1="105" y1="5" x2="105" y2="170" stroke="#ffffff" stroke-width="0.5" opacity="0.1" />
          <line x1="215" y1="5" x2="215" y2="170" stroke="#ffffff" stroke-width="0.5" opacity="0.1" />
          <line x1="325" y1="5" x2="325" y2="170" stroke="#ffffff" stroke-width="0.5" opacity="0.1" />

          <!-- Deal cards — AFTER (clean, green badges) -->
          <!-- Card 1: verified -->
          <g class="anim-slide-up" style="animation-delay: 1.8s" filter="url(#card-shadow)">
            <rect x="10" y="30" width="80" height="52" rx="6" fill="#1e3244" stroke="#70c1b3" stroke-width="1" />
            <text x="20" y="48" fill="#ffffff" opacity="0.9" font-size="9" font-family="'Hanken Grotesk Variable', sans-serif">Acme Corp</text>
            <text x="20" y="60" fill="#ffffff" opacity="0.5" font-size="7" font-family="'Hanken Grotesk Variable', sans-serif">$120K · Stage 1</text>
            <!-- Green quality badge -->
            <rect x="58" y="64" width="28" height="14" rx="7" fill="#70c1b3" />
            <text x="72" y="73" text-anchor="middle" fill="#1b2a37" font-size="7" font-weight="700" font-family="'Hanken Grotesk Variable', sans-serif">92%</text>
            <!-- Checkmark -->
            <circle cx="78" cy="40" r="8" fill="#70c1b3" />
            <text x="78" y="44" text-anchor="middle" fill="#1b2a37" font-size="9">✓</text>
          </g>

          <!-- Card 2: healthy -->
          <g class="anim-slide-up" style="animation-delay: 2.0s" filter="url(#card-shadow)">
            <rect x="120" y="30" width="80" height="52" rx="6" fill="#1e3244" stroke="#70c1b3" stroke-width="1" />
            <text x="130" y="48" fill="#ffffff" opacity="0.9" font-size="9" font-family="'Hanken Grotesk Variable', sans-serif">Beta Inc</text>
            <text x="130" y="60" fill="#ffffff" opacity="0.5" font-size="7" font-family="'Hanken Grotesk Variable', sans-serif">$85K · Stage 2</text>
            <rect x="168" y="64" width="28" height="14" rx="7" fill="#70c1b3" />
            <text x="182" y="73" text-anchor="middle" fill="#1b2a37" font-size="7" font-weight="700" font-family="'Hanken Grotesk Variable', sans-serif">87%</text>
            <circle cx="188" cy="40" r="8" fill="#70c1b3" />
            <text x="188" y="44" text-anchor="middle" fill="#1b2a37" font-size="9">✓</text>
          </g>

          <!-- Card 3: proposal stage -->
          <g class="anim-slide-up" style="animation-delay: 2.2s" filter="url(#card-shadow)">
            <rect x="230" y="30" width="80" height="52" rx="6" fill="#1e3244" stroke="#70c1b3" stroke-width="1" />
            <text x="240" y="48" fill="#ffffff" opacity="0.9" font-size="9" font-family="'Hanken Grotesk Variable', sans-serif">Gamma Ltd</text>
            <text x="240" y="60" fill="#ffffff" opacity="0.5" font-size="7" font-family="'Hanken Grotesk Variable', sans-serif">$200K · Stage 3</text>
            <rect x="278" y="64" width="28" height="14" rx="7" fill="#70c1b3" />
            <text x="292" y="73" text-anchor="middle" fill="#1b2a37" font-size="7" font-weight="700" font-family="'Hanken Grotesk Variable', sans-serif">95%</text>
            <circle cx="298" cy="40" r="8" fill="#70c1b3" />
            <text x="298" y="44" text-anchor="middle" fill="#1b2a37" font-size="9">✓</text>
          </g>

          <!-- Card 4: CLOSED WON (gold highlight) -->
          <g class="anim-slide-up" style="animation-delay: 2.4s" filter="url(#card-shadow)">
            <rect x="340" y="30" width="80" height="52" rx="6" fill="#1e3244" stroke="#F5C400" stroke-width="1.5" />
            <text x="350" y="48" fill="#F5C400" opacity="0.9" font-size="9" font-weight="600" font-family="'Hanken Grotesk Variable', sans-serif">Delta Corp</text>
            <text x="350" y="60" fill="#ffffff" opacity="0.5" font-size="7" font-family="'Hanken Grotesk Variable', sans-serif">$50K · Won!</text>
            <circle cx="408" cy="40" r="8" fill="#F5C400" />
            <text x="408" y="44" text-anchor="middle" fill="#1b2a37" font-size="9">★</text>
          </g>

          <!-- Second row -->
          <g class="anim-slide-up" style="animation-delay: 2.1s" filter="url(#card-shadow)">
            <rect x="120" y="92" width="80" height="42" rx="6" fill="#1e3244" stroke="#70c1b3" stroke-width="1" />
            <text x="130" y="108" fill="#ffffff" opacity="0.8" font-size="8" font-family="'Hanken Grotesk Variable', sans-serif">Epsilon SA</text>
            <text x="130" y="120" fill="#ffffff" opacity="0.4" font-size="7" font-family="'Hanken Grotesk Variable', sans-serif">$300K · Stage 2</text>
            <circle cx="188" cy="102" r="7" fill="#70c1b3" />
            <text x="188" y="106" text-anchor="middle" fill="#1b2a37" font-size="8">✓</text>
          </g>

          <g class="anim-slide-up" style="animation-delay: 2.5s" filter="url(#card-shadow)">
            <rect x="340" y="92" width="80" height="42" rx="6" fill="#1e3244" stroke="#F5C400" stroke-width="1.5" />
            <text x="350" y="108" fill="#F5C400" opacity="0.9" font-size="8" font-weight="600" font-family="'Hanken Grotesk Variable', sans-serif">Zeta LLC</text>
            <text x="350" y="120" fill="#ffffff" opacity="0.4" font-size="7" font-family="'Hanken Grotesk Variable', sans-serif">$175K · Won!</text>
            <circle cx="408" cy="102" r="7" fill="#F5C400" />
            <text x="408" y="106" text-anchor="middle" fill="#1b2a37" font-size="8">★</text>
          </g>
        </g>

        <!-- Correct company associations -->
        <g transform="translate(500, 270)">
          <text x="0" y="0" fill="#ffffff" opacity="0.7" font-size="9" font-weight="500" font-family="'Hanken Grotesk Variable', sans-serif" class="anim-fade-in" style="animation-delay: 2.3s">Company Associations</text>

          <!-- Contact → correct company (green solid line) -->
          <g transform="translate(0, 15)" class="anim-fade-in" style="animation-delay: 2.4s">
            <rect x="0" y="0" width="70" height="28" rx="5" fill="#1e3244" stroke="#70c1b3" stroke-width="1" />
            <circle cx="16" cy="14" r="7" fill="#3d5e7b" />
            <text x="15" y="17" text-anchor="middle" fill="white" font-size="7">👤</text>
            <text x="30" y="17" fill="#ffffff" opacity="0.8" font-size="7" font-family="'Hanken Grotesk Variable', sans-serif">J. Smith</text>

            <rect x="180" y="0" width="120" height="28" rx="5" fill="#1e3244" stroke="#70c1b3" stroke-width="1" />
            <text x="195" y="12" fill="#ffffff" opacity="0.8" font-size="7" font-family="'Hanken Grotesk Variable', sans-serif">CBRE - San Francisco</text>
            <text x="195" y="23" fill="#70c1b3" font-size="6" font-family="'Hanken Grotesk Variable', sans-serif">✓ Verified · 98% match</text>

            <!-- Green solid connection -->
            <line x1="70" y1="14" x2="180" y2="14" stroke="#70c1b3" stroke-width="1.5" opacity="0.8" class="line-draw-green" />
          </g>

          <!-- Another correct match -->
          <g transform="translate(0, 52)" class="anim-fade-in" style="animation-delay: 2.6s">
            <rect x="0" y="0" width="70" height="28" rx="5" fill="#1e3244" stroke="#70c1b3" stroke-width="1" />
            <circle cx="16" cy="14" r="7" fill="#3d5e7b" />
            <text x="15" y="17" text-anchor="middle" fill="white" font-size="7">👤</text>
            <text x="30" y="17" fill="#ffffff" opacity="0.8" font-size="7" font-family="'Hanken Grotesk Variable', sans-serif">M. Chen</text>

            <rect x="180" y="0" width="120" height="28" rx="5" fill="#1e3244" stroke="#70c1b3" stroke-width="1" />
