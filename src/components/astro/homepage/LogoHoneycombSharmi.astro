---
interface Props {
  width?: number;
  height?: number;
}

const { width = 32, height = 30 } = Astro.props;
---

<svg data-logo-variant="sharmi-coral-aqua" viewBox="0 0 120 110" width={width} height={height} xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <polygon points="38,8 54,18 54,36 38,46 22,36 22,18" fill="var(--color-aqua-600)"/>
  <polygon points="72,8 88,18 88,36 72,46 56,36 56,18" fill="var(--color-coral-600)"/>
  <polygon points="21,40 37,50 37,68 21,78 5,68 5,50" fill="var(--color-aqua-400)"/>
  <polygon points="55,40 71,50 71,68 55,78 39,68 39,50" fill="var(--color-coral-600)"/>
  <polygon points="89,40 105,50 105,68 89,78 73,68 73,50" fill="var(--color-v6-blue-300)"/>
  <polygon points="38,72 54,82 54,100 38,110 22,100 22,82" fill="var(--color-coral-600)"/>
  <polygon points="72,72 88,82 88,100 72,110 56,100 56,82" fill="var(--color-v6-blue)"/>
</svg>
