---
type Audience = {
  role: string;
  need: string;
};

type WorkflowStep = {
  title: string;
  description: string;
};

interface Props {
  dashboardName: string;
  audienceIntro: string;
  audiences: ReadonlyArray<Audience>;
  workflowSteps: readonly [WorkflowStep, WorkflowStep, WorkflowStep];
  dashboardUse: string;
  spreadsheetUse: string;
  presentationUse: string;
  storyExample: string;
}

const {
  dashboardName,
  audienceIntro,
  audiences,
  workflowSteps,
  dashboardUse,
  spreadsheetUse,
  presentationUse,
  storyExample,
} = Astro.props;
---

<section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8" aria-labelledby="dashboard-audience-heading">
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">Who it is for</p>
      <h2 id="dashboard-audience-heading" class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">Built for the people who prepare and explain the numbers</h2>
      <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">{audienceIntro}</p>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {audiences.map((audience) => (
        <article class="rounded-2xl border border-v6-border bg-white p-6">
          <h3 class="text-xl font-bold text-v6-dark">{audience.role}</h3>
          <p class="mt-3 leading-relaxed text-v6-text-muted">{audience.need}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="bg-v6-dark px-4 py-16 text-white sm:px-6 sm:py-20 lg:px-8" aria-labelledby="dashboard-workflow-heading">
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper-300">Three-click workflow</p>
      <h2 id="dashboard-workflow-heading" class="mt-3 text-balance text-3xl font-bold sm:text-4xl">From HubSpot to a repeatable {dashboardName} in 3 clicks</h2>
      <p class="mt-4 text-lg leading-relaxed text-white/75">Set the reporting rules once, then regenerate the same management-ready view every week or month without learning HubSpot tables or rebuilding the presentation.</p>
    </div>
    <ol class="mt-10 grid gap-5 md:grid-cols-3">
      {workflowSteps.map((step, index) => (
        <li class="rounded-2xl border border-white/15 bg-white/5 p-6">
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-v6-copper text-sm font-bold text-white">{index + 1}</span>
          <h3 class="mt-5 text-xl font-bold">{step.title}</h3>
          <p class="mt-3 leading-relaxed text-white/70">{step.description}</p>
        </li>
      ))}
    </ol>
    <p class="mx-auto mt-8 max-w-3xl text-center text-sm leading-relaxed text-white/60">Choose the reporting scope once, then rebuild the same dashboard, Excel-ready detail, and PowerPoint story for every review cycle.</p>
  </div>
</section>

<section class="bg-v6-bg px-4 py-16 sm:px-6 sm:py-20 lg:px-8" aria-labelledby="dashboard-output-heading">
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-v6-copper">One source, three useful outputs</p>
      <h2 id="dashboard-output-heading" class="mt-3 text-balance text-3xl font-bold text-v6-dark sm:text-4xl">Review the dashboard, inspect the spreadsheet, then tell the story</h2>
      <p class="mt-4 text-lg leading-relaxed text-v6-text-muted">Choose the charts, rows, and AI-assisted talking points that belong in the management update. Keep the underlying data available when someone asks what is behind a number.</p>
    </div>
    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      <article class="rounded-2xl border border-v6-border bg-white p-6">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-v6-teal-800">Dashboard</p>
        <h3 class="mt-3 text-xl font-bold text-v6-dark">See the reporting rhythm</h3>
        <p class="mt-3 leading-relaxed text-v6-text-muted">{dashboardUse}</p>
      </article>
      <article class="rounded-2xl border border-v6-border bg-white p-6">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-v6-blue-800">Excel-ready data</p>
        <h3 class="mt-3 text-xl font-bold text-v6-dark">Inspect and tune the detail</h3>
        <p class="mt-3 leading-relaxed text-v6-text-muted">{spreadsheetUse}</p>
      </article>
      <article class="rounded-2xl border border-v6-border bg-white p-6">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-v6-copper-800">PowerPoint story</p>
        <h3 class="mt-3 text-xl font-bold text-v6-dark">Choose what management sees</h3>
        <p class="mt-3 leading-relaxed text-v6-text-muted">{presentationUse}</p>
      </article>
    </div>
    <div class="mx-auto mt-6 max-w-4xl rounded-2xl border border-v6-copper-200 bg-v6-copper-50 p-6 sm:p-8">
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-v6-copper-800">AI-assisted talking point example</p>
      <p class="mt-3 text-balance text-xl font-bold leading-relaxed text-v6-dark">“{storyExample}”</p>
      <p class="mt-3 text-sm leading-relaxed text-v6-text-muted">The user chooses what to keep, edits the wording, and can apply an approved PowerPoint template. The underlying figures remain available for review.</p>
    </div>
  </div>
</section>
