---
import { Picture } from "astro:assets";
import logo from "../../../public/assets/ico/swotbee_logo.png";
import "@fortawesome/fontawesome-free/css/all.min.css";

const navLinks = [
  { href: "/about", label: "About", current: false },
  { href: "/blog", label: "Blog", current: false },
  { href: "/contactus", label: "Contact", current: false },
];

const servicesLinks = [
  { href: "/services/hubspot-onboarding", label: "HubSpot Onboarding" },
  { href: "/services/marketing", label: "Marketing" },
  { href: "/services/sales-revops", label: "Sales & RevOps" },
  { href: "/services/integrations", label: "Integrations" },
]

---

<!-- Add this script tag to your layout or include via npm -->
<script
   src="https://cdn.jsdelivr.net/npm/@tailwindplus/elements@1" type="module"></script>



<!-- TOP BAR -->
<div class="w-full bg-[#FCEEDF] border-b border-gray-300">
  <div class="max-w-7xl mx-auto flex justify-between items-center py-2 px-4 text-sm">
    
    <!-- Left Icons -->
    <div class="flex items-center gap-3">
      <a href="https://www.linkedin.com/company/swotbee" target="_blank" class="text-black text-xs">
     <i class="fa-brands fa-linkedin-in"></i>
      </a>
      <a href="https://x.com/SWOTBee" target="_blank" class="text-black text-xs">
       <i class="fa-brands fa-x-twitter"></i>
      </a>
    </div>

    <!-- Right Contact Info -->
    <div class="flex items-center gap-6 text-black">
      <p class="text-xs">talktohumans@swtbee.com</p>
    </div>
  </div>
</div>


<!-- MAIN NAVBAR -->
<nav class="bg-[#0A3048]">
  <div class="max-w-7xl mx-auto px-8 lg:px-10 flex justify-between items-center h-16">
    
    <!-- Logo -->
    <a href="/" class="flex items-center">
      <Picture src={logo} alt="SwotBee Logo" class="h-9 w-auto" />
    </a>

    <!-- Desktop Menu -->
    <div class="hidden lg:flex items-center space-x-10">
      <a
            href="/"
            class="text-[#FFFFFF] text-sm font-medium hover:text-[#FF764D] hover:border-b-2 hover:border-[#FF764D] pb-1 transition-all"
          >
            Home
          </a>

   <!-- Services dropdown -->
        <el-dropdown class="h-full flex">

             <a
            href="/services/services-page"
            class="text-[#FFFFFF] text-sm font-medium hover:text-[#FF764D] hover:border-b-2 hover:border-[#FF764D] pb-1 transition-all"
          >
            Our Services
          </a>
          <el-menu
            anchor="bottom end"
            popover
            class="w-48 origin-top-right rounded-md bg-white py-1 shadow-lg outline-1 outline-black/5 transition transition-discrete [--anchor-gap:--spacing(2)] data-closed:scale-95 data-closed:transform data-closed:opacity-0 data-enter:duration-100 data-enter:ease-out data-leave:duration-75 data-leave:ease-in"
          > {
            servicesLinks.map((link) => (
              <a
                href={link.href}
                class="block px-4 py-2 text-sm text-[#0A3048] focus:bg-gray-100 hover:text-[#FF764D] focus:outline-hidden"
              >
                {link.label}
              </a>
            ))
          }


          </el-menu>
        </el-dropdown>
{

          navLinks.map((link) => (
              <a
                href={link.href}
                class={
                  link.current
                    ? "text-[#FFFFFF] text-sm font-medium hover:text-[#FF764D] hover:border-b-2 hover:border-[#FF764D] pb-1 transition-all"
                    : "text-[#FFFFFF] text-sm font-medium hover:text-[#FF764D] hover:border-b-2 hover:border-[#FF764D] pb-1 transition-all"
                }
              >
                {link.label}
              </a>
            ))
          }
    </div>

    <!-- Mobile Menu Button -->
      <div class="flex items-center lg:hidden">
        <button
          type="button"
          command="--toggle"
          commandfor="mobile-menu"
          class="relative inline-flex items-center justify-center rounded-md p-2 text-white hover:bg-gray-100 hover:text-gray-500 focus:outline-2 focus:-outline-offset-1 focus:outline-indigo-600 "
        >
          <span class="absolute -inset-0.5"></span>
          <span class="sr-only">Open main menu</span>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            data-slot="icon"
            aria-hidden="true"
            class="size-6 in-aria-expanded:hidden"
          >
            <path
              d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            data-slot="icon"
            aria-hidden="true"
            class="size-6 not-in-aria-expanded:hidden"
          >
            <path
              d="M6 18 18 6M6 6l12 12"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
  </div>

  <!-- Mobile Menu -->
   <el-disclosure id="mobile-menu" hidden class="block lg:hidden">
   <div class="space-y-1 pt-2">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class={
              link.current
                ? "block px-8 lg:px-10 py-2 text-base font-medium text-white hover:bg-gray-100 hover:text-[#FF764D] hover:text-gray-800 dark:text-gray-400 dark:hover:bg-white/5 dark:hover:text-white"
                : "block px-8 lg:px-10 py-2 text-base font-medium text-white hover:bg-gray-100 hover:text-[#FF764D] hover:text-gray-800 dark:text-gray-400 dark:hover:bg-white/5 dark:hover:text-white"
            }
          >
            {link.label}
          </a>
        ))
      }
    </div>

      <div class="mt-3 space-y-1">
        {  servicesLinks.map((link) => (
          <a
            href={link.href}
            class="block px-8 lg:px-10 py-2 text-base font-medium text-white hover:text-[#FF764D] hover:bg-gray-100 hover:text-gray-800 dark:text-gray-400 dark:hover:bg-white/5 dark:hover:text-white"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
    <el-disclosure
</nav>