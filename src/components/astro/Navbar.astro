---
import LogoHoneycomb from "./LogoHoneycomb.astro";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/blog", label: "Blog" },
  { href: "/resources", label: "Resources" },
  { href: "/contactus/", label: "Contact" },
];

const servicesLinks = [
  { href: "/services/hubspot-onboarding", label: "HubSpot Onboarding" },
  { href: "/services/marketing", label: "Marketing" },
  { href: "/services/sales-revops", label: "Sales & RevOps" },
  { href: "/services/integrations", label: "Integrations" },
];
---

<nav class="bg-white border-b border-gray-200 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2">
      <LogoHoneycomb width={32} height={30} />
      <span class="text-v6-dark text-lg font-bold">SWOT<span class="text-v6-teal-700">bee</span></span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-1">
      {navLinks.map(link => (
        <a href={link.href} class="text-v6-text-muted text-sm font-medium px-3 py-2 rounded-md hover:text-v6-dark hover:bg-gray-50 transition-colors">
          {link.label}
        </a>
      ))}

      <!-- Services dropdown -->
      <div class="relative group">
        <button class="text-v6-text-muted text-sm font-medium px-3 py-2 rounded-md hover:text-v6-dark hover:bg-gray-50 transition-colors flex items-center gap-1">
          Services
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </button>
        <div class="absolute left-0 top-full mt-1 w-56 bg-white rounded-lg shadow-lg border border-gray-100 py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
          {servicesLinks.map(link => (
            <a href={link.href} class="block px-4 py-2 text-sm text-v6-text-muted hover:text-v6-dark hover:bg-gray-50 transition-colors">
              {link.label}
            </a>
          ))}
        </div>
      </div>

      <a href="/contactus/" class="ml-3 bg-v6-copper text-white px-5 py-2 rounded-lg text-sm font-semibold hover:bg-v6-copper-600 transition-colors">
        Get Started
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button type="button" class="md:hidden p-2.5 rounded-md text-v6-text-muted hover:bg-gray-100" id="v6-mobile-menu-btn" aria-label="Open navigation menu" aria-expanded="false" aria-controls="v6-mobile-menu">
      <svg class="w-6 h-6 block" id="v6-menu-icon-open" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <svg class="w-6 h-6 hidden" id="v6-menu-icon-close" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="hidden md:hidden border-t border-gray-200" id="v6-mobile-menu">
    <div class="px-4 py-3 space-y-1">
      {navLinks.map(link => (
        <a href={link.href} class="block text-v6-text-muted text-sm font-medium py-3 px-3 rounded-md hover:text-v6-dark hover:bg-gray-50">
          {link.label}
        </a>
      ))}
      <div class="border-t border-gray-100 pt-2 mt-2">
        <p class="px-3 py-1 text-xs font-semibold text-gray-500 uppercase tracking-wider">Services</p>
        {servicesLinks.map(link => (
          <a href={link.href} class="block text-v6-text-muted text-sm font-medium py-2 px-3 rounded-md hover:text-v6-dark hover:bg-gray-50">
            {link.label}
          </a>
        ))}
      </div>
      <a href="/contactus/" class="block bg-v6-copper text-white text-center px-5 py-3 rounded-lg text-sm font-semibold mt-3">
        Get Started
      </a>
    </div>
  </div>
</nav>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var btn = document.getElementById('v6-mobile-menu-btn');
    var menu = document.getElementById('v6-mobile-menu');
    var iconOpen = document.getElementById('v6-menu-icon-open');
    var iconClose = document.getElementById('v6-menu-icon-close');
    if (btn && menu) {
      btn.addEventListener('click', function() {
        var isOpen = menu.classList.toggle('hidden');
        btn.setAttribute('aria-expanded', !isOpen ? 'true' : 'false');
        if (iconOpen && iconClose) {
          iconOpen.classList.toggle('hidden');
          iconOpen.classList.toggle('block');
          iconClose.classList.toggle('hidden');
          iconClose.classList.toggle('block');
        }
      });
    }
  });
</script>
