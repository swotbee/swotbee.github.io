---
import LogoHoneycomb from "./LogoHoneycomb.astro";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/blog/", label: "Blog" },
  { href: "/resources", label: "Resources" },
  { href: "/contactus/", label: "Contact" },
];

const servicesLinks = [
  { href: "/services/hubspot-onboarding", label: "HubSpot Onboarding" },
  { href: "/services/marketing", label: "Marketing" },
  { href: "/services/sales-revops", label: "Sales & RevOps" },
  { href: "/services/integrations", label: "Integrations" },
];
---

<nav class="bg-white border-b border-gray-200 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2">
      <LogoHoneycomb width={32} height={30} />
      <span class="text-v6-dark text-lg font-bold">SWOT<span class="text-v6-teal-700">bee</span></span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden lg:flex items-center gap-1">
      {navLinks.map(link => (
        <a href={link.href} class="text-v6-text-muted text-sm font-medium px-3 py-2 rounded-md hover:text-v6-dark hover:bg-gray-50 transition-colors">
          {link.label}
        </a>
      ))}

      <!-- Services dropdown -->
      <div class="relative group">
        <button class="text-v6-text-muted text-sm font-medium px-3 py-2 rounded-md hover:text-v6-dark hover:bg-gray-50 transition-colors flex items-center gap-1">
          Services
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </button>
        <div class="absolute left-0 top-full mt-1 w-56 bg-white rounded-lg shadow-lg border border-gray-100 py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
          {servicesLinks.map(link => (
            <a href={link.href} class="block px-4 py-2 text-sm text-v6-text-muted hover:text-v6-dark hover:bg-gray-50 transition-colors">
              {link.label}
            </a>
          ))}
        </div>
      </div>

      <div class="w-[260px] xl:w-[300px] ml-auto relative nav-pagefind">
        <div id="nav-search-desktop" class="w-full" data-nav-pagefind></div>
      </div>

      <!-- Routes to the renewal funnel, NOT /contactus/. This is the most prominent
           button on every page including the paid-ad landing page, so pointing it at a
           generic contact form competed with "Book Your Renewal Audit" and sent paid
           traffic out of the funnel it was bought for. /contactus/ is still reachable
           from the Contact nav link and the footer. Labelled for GA4 so the click is
           attributable rather than invisible. -->
      <a
        href="/renewal-audit-call/"
        data-ga-cta="nav_book_renewal_review"
        class="ml-3 bg-v6-copper text-white px-5 py-2 rounded-lg text-sm font-semibold hover:bg-v6-copper-600 transition-colors"
      >
        Book a renewal review
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button type="button" class="lg:hidden p-2.5 rounded-md text-v6-text-muted hover:bg-gray-100" id="v6-mobile-menu-btn" aria-label="Open navigation menu" aria-expanded="false" aria-controls="v6-mobile-menu">
      <svg class="w-6 h-6 block" id="v6-menu-icon-open" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <svg class="w-6 h-6 hidden" id="v6-menu-icon-close" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div class="lg:hidden border-t border-gray-100 px-4 py-3">
    <div id="nav-search-mobile" class="relative nav-pagefind nav-pagefind-mobile" data-nav-pagefind></div>
  </div>

  <!-- Mobile menu -->
  <div class="hidden lg:hidden border-t border-gray-200" id="v6-mobile-menu">
    <div class="px-4 py-3 space-y-1">
      {navLinks.map(link => (
        <a href={link.href} class="block text-v6-text-muted text-sm font-medium py-3 px-3 rounded-md hover:text-v6-dark hover:bg-gray-50">
          {link.label}
        </a>
      ))}
      <div class="border-t border-gray-100 pt-2 mt-2">
        <p class="px-3 py-1 text-xs font-semibold text-gray-500 uppercase tracking-wider">Services</p>
        {servicesLinks.map(link => (
          <a href={link.href} class="block text-v6-text-muted text-sm font-medium py-2 px-3 rounded-md hover:text-v6-dark hover:bg-gray-50">
            {link.label}
          </a>
        ))}
      </div>
      <!-- Mobile twin of the desktop CTA above. Keep the two in sync. -->
      <a
        href="/renewal-audit-call/"
        data-ga-cta="nav_mobile_book_renewal_review"
        class="block bg-v6-copper text-white text-center px-5 py-3 rounded-lg text-sm font-semibold mt-3"
      >
        Book a renewal review
      </a>
    </div>
  </div>
</nav>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var btn = document.getElementById('v6-mobile-menu-btn');
    var menu = document.getElementById('v6-mobile-menu');
    var iconOpen = document.getElementById('v6-menu-icon-open');
    var iconClose = document.getElementById('v6-menu-icon-close');
    if (btn && menu) {
      btn.addEventListener('click', function() {
        var isOpen = menu.classList.toggle('hidden');
        btn.setAttribute('aria-expanded', !isOpen ? 'true' : 'false');
        if (iconOpen && iconClose) {
          iconOpen.classList.toggle('hidden');
          iconOpen.classList.toggle('block');
          iconClose.classList.toggle('hidden');
          iconClose.classList.toggle('block');
        }
      });
    }
  });
</script>

  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script src="/pagefind/pagefind-ui.js" is:inline></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('[data-nav-pagefind]').forEach(function(element) {
        if (!element.id) {
          return;
        }

        new PagefindUI({
          element: "#" + element.id,
          showSubResults: true,
          showImages: false,
        });
      });
    });
  </script>
<style is:global>
  .nav-pagefind {
    --pagefind-ui-scale: 0.72;
    --pagefind-ui-primary: #C47A2A;
    --pagefind-ui-text: #1F2937;
    --pagefind-ui-background: #fff;
    --pagefind-ui-border: #e5e7eb;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: 'Hanken Grotesk Variable', 'DM Sans Variable', sans-serif;
  }

  .nav-pagefind .pagefind-ui__form {
    margin: 0;
  }

  .nav-pagefind .pagefind-ui__search-input {
    height: 40px;
    font-size: 14px;
  }

  .nav-pagefind .pagefind-ui__drawer {
    position: absolute;
    top: 100%;
    right: 0;
    transform: translateY(12px);
    width: 90vw;
    max-width: 672px;
    max-height: 72dvh;
    overflow-y: auto;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    box-shadow: 0 20px 45px rgba(15, 23, 42, 0.16);
    padding: 16px;
  }

  .nav-pagefind-mobile .pagefind-ui__drawer {
    left: 0;
    right: auto;
    width: 100%;
    max-height: 72dvh;
  }

  .nav-pagefind .pagefind-ui__results-area {
    margin-top: 0;
  }
</style>
