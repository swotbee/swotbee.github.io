---
import Button from "./Button.astro";
import { Picture } from "astro:assets";
// import logo from "../../../public/assets/ico/logo.png";
import logo from "../../../public/assets/ico/logo.svg";

const navLinks = [
  // { href: "/", label: "Home", current: true },
  { href: "/about", label: "About", current: false },
  { href: "/blog", label: "Blog", current: false },
  // { href: "/services", label: "Services", current: false },
  { href: "/contactus", label: "Contact", current: false },
];

const servicesLinks = [
  { href: "/services/hubspot-onboarding", label: "HubSpot Onboarding" },
  { href: "/services/marketing", label: "Marketing" },
  { href: "/services/sales-revops", label: "Sales & RevOps" },
  { href: "/services/integrations", label: "Integrations" },
];
---

<!-- Add this script tag to your layout or include via npm -->
<script
  src="https://cdn.jsdelivr.net/npm/@tailwindplus/elements@1"
  type="module"></script>

<nav class="relative shadow-sm">
  <div class="flex justify-between bg-highlight-25 mx-auto max-w-7xl pl-2 py-1 ">
    <div class="flex gap-x-1 py-1">
      <a
        href="https://www.linkedin.com/company/swotbee"
        class="text-gray-900"
        hover:text-icon-seablue-800
        dark:text-gray-900
        dark:hover:text-icon-seablue-900"
      >
        <span class="sr-only">in</span>
        <svg
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          class="size-4"
        >
        <path d="M6.5 8C7.32843 8 8 7.32843 8 6.5C8 5.67157 7.32843 5 6.5 5C5.67157 5 5 5.67157 5 6.5C5 7.32843 5.67157 8 6.5 8Z" fill="#0F0F0F"/>
        <path d="M5 10C5 9.44772 5.44772 9 6 9H7C7.55228 9 8 9.44771 8 10V18C8 18.5523 7.55228 19 7 19H6C5.44772 19 5 18.5523 5 18V10Z" fill="#0F0F0F"/>
        <path d="M11 19H12C12.5523 19 13 18.5523 13 18V13.5C13 12 16 11 16 13V18.0004C16 18.5527 16.4477 19 17 19H18C18.5523 19 19 18.5523 19 18V12C19 10 17.5 9 15.5 9C13.5 9 13 10.5 13 10.5V10C13 9.44771 12.5523 9 12 9H11C10.4477 9 10 9.44772 10 10V18C10 18.5523 10.4477 19 11 19Z" fill="#0F0F0F"/>
        <path fill-rule="evenodd" clip-rule="evenodd" d="M20 1C21.6569 1 23 2.34315 23 4V20C23 21.6569 21.6569 23 20 23H4C2.34315 23 1 21.6569 1 20V4C1 2.34315 2.34315 1 4 1H20ZM20 3C20.5523 3 21 3.44772 21 4V20C21 20.5523 20.5523 21 20 21H4C3.44772 21 3 20.5523 3 20V4C3 3.44772 3.44772 3 4 3H20Z" fill="#0F0F0F"/>
        </svg>
      </a>
      <a
        href="https://x.com/SWOTBee"
        class="text-gray-900"
        hover:text-icon-seablue-800
        dark:text-gray-900
        dark:hover:text-icon-seablue-900"
      >
        <span class="sr-only">X</span>
        <svg
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          class="size-4"
        >
          <path
            d="M13.6823 10.6218L20.2391 3H18.6854L12.9921 9.61788L8.44486 3H3.2002L10.0765 13.0074L3.2002 21H4.75404L10.7663 14.0113L15.5685 21H20.8131L13.6819 10.6218H13.6823ZM11.5541 13.0956L10.8574 12.0991L5.31391 4.16971H7.70053L12.1742 10.5689L12.8709 11.5655L18.6861 19.8835H16.2995L11.5541 13.096V13.0956Z"
          ></path>
        </svg>
      </a>

      <a
        href="#"
        class="text-gray-900"
        hover:text-icon-seablue-800
        dark:text-gray-900
        dark:hover:text-icon-seablue-900"
      >
        <span class="sr-only">YouTube</span>
        <svg
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          class="size-4"
        >
          <path
            d="M19.812 5.418c.861.23 1.538.907 1.768 1.768C21.998 8.746 22 12 22 12s0 3.255-.418 4.814a2.504 2.504 0 0 1-1.768 1.768c-1.56.419-7.814.419-7.814.419s-6.255 0-7.814-.419a2.505 2.505 0 0 1-1.768-1.768C2 15.255 2 12 2 12s0-3.255.417-4.814a2.507 2.507 0 0 1 1.768-1.768C5.744 5 11.998 5 11.998 5s6.255 0 7.814.418ZM15.194 12 10 15V9l5.194 3Z"
            clip-rule="evenodd"
            fill-rule="evenodd"></path>
        </svg>
      </a>
    </div>
    <div>
      <div class="text-xs text-icon-seablue-950 px-2 py-1">
        <span>info@swotbee.com</span>
      </div>
    </div>
  </div>
  <div class="flex justify-between bg-icon-seablue-950 mx-auto max-w-7xl px-2 sm:pl-2 sm:pr-1 lg:pl-8 lg:pr-2">
    <div class="flex h-12 ">
      <div class="flex px-2 lg:px-0 ">
        <div class="flex shrink-0 items-center">
          <a href="/">
            <Picture
              src={logo}
              alt="SwotBee Logo"
              class="h-10 w-auto"
              widths={[96, 120, 144]}
              formats={["webp", "avif", "png"]}
            />
          </a>
        </div>
      </div>
      <div class="lg:ml-44 lg:flex lg:space-x-8 ">
        <div class="hidden lg:ml-12 lg:flex lg:space-x-8 justify-end">
          <a
            href="/"
            class="inline-flex items-center border-b-2 border-transparent px-1 pt-1 text-xs font-medium text-white hover:border-gray-300 hover:text-gray-700"
          >
            Home
          </a>

          <!-- Services dropdown -->
          <el-dropdown class="h-full flex">
            <button
              class="inline-flex items-center border-b-2 border-transparent px-1 pt-1 text-xs font-medium text-white hover:border-gray-300 hover:text-gray-700"
            >
              Our Services
            </button>

            <el-menu
              anchor="bottom end"
              popover
              class="w-48 origin-top-right rounded-md bg-white py-1 shadow-lg outline-1 outline-black/5 transition transition-discrete [--anchor-gap:--spacing(2)] data-closed:scale-95 data-closed:transform data-closed:opacity-0 data-enter:duration-100 data-enter:ease-out data-leave:duration-75 data-leave:ease-in"
            >
              {
                servicesLinks.map((link) => (
                  <a
                    href={link.href}
                    class="block px-4 py-2 text-sm text-white focus:bg-gray-100 focus:outline-hidden"
                  >
                    {link.label}
                  </a>
                ))
              }
            </el-menu>
          </el-dropdown>
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class={
                  link.current
                    ? "inline-flex items-center border-b-2 border-indigo-600 px-1 pt-1 text-xs font-medium text-white"
                    : "inline-flex items-center border-b-2 border-transparent px-1 pt-1 text-xs font-medium text-white hover:border-gray-300 hover:text-gray-700"
                }
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
      </div>

      <div class="flex items-center lg:hidden">
        <!-- Mobile menu button -->
        <button
          type="button"
          command="--toggle"
          commandfor="mobile-menu"
          class="relative inline-flex items-center justify-center rounded-md p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-500 focus:outline-2 focus:-outline-offset-1 focus:outline-indigo-600"
        >
          <span class="absolute -inset-0.5"></span>
          <span class="sr-only">Open main menu</span>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            data-slot="icon"
            aria-hidden="true"
            class="size-6 in-aria-expanded:hidden"
          >
            <path
              d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            data-slot="icon"
            aria-hidden="true"
            class="size-6 not-in-aria-expanded:hidden"
          >
            <path
              d="M6 18 18 6M6 6l12 12"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
      <!-- <div class="hidden lg:ml-4 lg:flex lg:items-center">
        <button
          type="button"
          class="relative shrink-0 rounded-full p-1 text-gray-400 hover:text-gray-500 focus:outline-2 focus:outline-offset-2 focus:outline-indigo-600"
