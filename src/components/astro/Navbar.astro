  <div class="mt-3 space-y-1">
    {
      servicesLinks.map((link) => (
        <a
          href={link.href}
          class="block px-4 py-2 text-sm font-medium text-gray-500 hover:bg-gray-100 hover:text-gray-800 dark:text-gray-400 dark:hover:bg-white/5 dark:hover:text-white"
