<!-- --------------------------
  Slider HTML
--------------------------- -->
<section class="py-0 md:py-16 bg-[#FFF0E2]">
  <h2 class="text-2xl md:text-4xl font-bold text-center mb-10 text-[#0d476d]">
    What Our Clients Say
  </h2>

  <div class="relative max-w-7xl mx-auto px-4">

    <!-- Scroll Wrapper -->
    <div id="testimonial-wrapper"
      class="overflow-x-auto overflow-y-hidden whitespace-nowrap no-scrollbar cursor-grab scroll-smooth">

       {
        testimonials.map((testimonials) => (
      <!-- CARD -->
      <div class="inline-block shrink-0 px-4 w-[85%] md:w-[50%] lg:w-[33%]">
        <article class="bg-white rounded-2xl p-6 shadow-sm h-full whitespace-normal">
          <div class="flex items-start gap-3 mb-3">
            <div class="h-12 w-12 rounded-full border border-black"></div>
            <div class="whitespace-normal">
              <p class="font-semibold text-[16px]"> {testimonials.name}</p>
              <p class="text-gray-500 text-[14px]">{testimonials.role}</p>
            </div>
          </div>
          <p class="text-gray-600 text-[15px] leading-relaxed whitespace-normal">
           {testimonials.text}
          </p>
        </article>
      </div>
              ))
      }

    </div>
  </div>
</section>








<script is:inline>
  const slider = document.getElementById("testimonial-wrapper");

  let isDown = false;
  let startX;
  let scrollLeft;

  // Mouse drag
  slider.addEventListener("mousedown", (e) => {
    isDown = true;
    slider.classList.add("cursor-grabbing");
    startX = e.pageX - slider.offsetLeft;
    scrollLeft = slider.scrollLeft;
  });

  slider.addEventListener("mouseleave", () => {
    isDown = false;
    slider.classList.remove("cursor-grabbing");
  });

  slider.addEventListener("mouseup", () => {
    isDown = false;
    slider.classList.remove("cursor-grabbing");
  });

  slider.addEventListener("mousemove", (e) => {
    if (!isDown) return;
    e.preventDefault();
    const x = e.pageX - slider.offsetLeft;
    const walk = (x - startX) * 1; // scroll speed
    slider.scrollLeft = scrollLeft - walk;
  });

  // Touch drag
  slider.addEventListener("touchstart", (e) => {
    startX = e.touches[0].pageX;
    scrollLeft = slider.scrollLeft;
  });

  slider.addEventListener("touchmove", (e) => {
    const x = e.touches[0].pageX;
    const walk = (x - startX) * 1;
    slider.scrollLeft = scrollLeft - walk;
  });

  // Auto scroll
  let autoScrollSpeed = 1; // pixels per frame
  function autoScroll() {
    if (!isDown) { // don't auto-scroll when dragging
      slider.scrollLeft += autoScrollSpeed;
      // Reset scroll to start for infinite loop effect
      if (slider.scrollLeft >= slider.scrollWidth - slider.clientWidth) {
        slider.scrollLeft = 0;
      }
    }
    requestAnimationFrame(autoScroll);
  }

  autoScroll();
</script>
