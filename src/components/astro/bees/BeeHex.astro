---
// BeeHex.astro — "Honeycomb Tech" bee style.
// The bee's body is built from honeycomb cells: a nod to automation / systems /
// HubSpot. The most "product + tech" flavored option. Pupils via .bee-pupil.
interface Props { id: string; class?: string; flip?: boolean; delay?: number; }
const { id, class: className = "", flip = false, delay = 0 } = Astro.props;
const cid = `hex-${id}`;
// small flat-top hexagon cell generator centered at (cx,cy), radius r
const cell = (cx: number, cy: number, r = 9) => {
  const pts = [];
  for (let i = 0; i < 6; i++) {
    const a = (Math.PI / 180) * (60 * i);
    pts.push(`${(cx + r * Math.cos(a)).toFixed(1)} ${(cy + r * Math.sin(a)).toFixed(1)}`);
  }
  return `M${pts.join(" L")} Z`;
};
const cells = [
  cell(45, 50), cell(45, 67), cell(60, 41), cell(60, 58),
  cell(60, 75), cell(75, 50), cell(75, 67),
];
---
<div class={`bee-char ${className}`} data-style="hex" aria-hidden="true"
  style={`--bee-delay:${delay}s; ${flip ? "transform: scaleX(-1);" : ""}`}>
  <div class="bee-bob">
    <svg viewBox="0 0 120 100" class="w-full h-full overflow-visible">
      <defs>
        <clipPath id={cid}><ellipse cx="60" cy="58" rx="29" ry="22" /></clipPath>
      </defs>
      <!-- stinger -->
      <path d="M31 58 L18 54 L30 64 Z" fill="#213343" opacity="0.8" />
      <!-- wings -->
      <g class="bee-wings" style="transform-origin: 53px 40px;">
        <ellipse cx="49" cy="38" rx="15" ry="10" fill="#5AAB9D" opacity="0.5" transform="rotate(-22 49 38)" />
        <ellipse cx="64" cy="36" rx="13" ry="8" fill="#5AAB9D" opacity="0.35" transform="rotate(15 64 36)" />
      </g>
      <!-- antennae -->
      <path d="M77 41 Q81 28 88 26" stroke="#213343" stroke-width="2" fill="none" stroke-linecap="round" />
      <circle cx="88" cy="26" r="2.4" fill="#C47A2A" />
      <!-- body base + honeycomb cells -->
      <g clip-path={`url(#${cid})`}>
        <rect x="28" y="32" width="68" height="52" fill="#213343" />
        {cells.map(d => <path d={d} fill="#F2B134" stroke="#213343" stroke-width="2.5" />)}
      </g>
      <ellipse cx="60" cy="58" rx="29" ry="22" fill="none" stroke="#213343" stroke-width="2" opacity="0.9" />
      <!-- eyes -->
      <circle cx="78" cy="54" r="4.6" fill="#ffffff" />
      <circle cx="88" cy="54" r="4.6" fill="#ffffff" />
      <circle class="bee-pupil" cx="79" cy="55" r="2.1" fill="#213343" />
      <circle class="bee-pupil" cx="89" cy="55" r="2.1" fill="#213343" />
    </svg>
  </div>
</div>
