---
// BeeLine.astro — "Minimal Line Art" bee style.
// Single-weight navy outline, almost no fill. The most restrained / premium /
// corporate option. Cursor-reactive pupils via .bee-pupil.
interface Props { id: string; class?: string; flip?: boolean; delay?: number; }
const { id, class: className = "", flip = false, delay = 0 } = Astro.props;
const cid = `line-${id}`;
const S = "#213343";
---
<div class={`bee-char ${className}`} data-style="line" aria-hidden="true"
  style={`--bee-delay:${delay}s; ${flip ? "transform: scaleX(-1);" : ""}`}>
  <div class="bee-bob">
    <svg viewBox="0 0 120 100" class="w-full h-full overflow-visible"
      fill="none" stroke={S} stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <defs>
        <clipPath id={cid}><ellipse cx="55" cy="58" rx="29" ry="22" /></clipPath>
      </defs>
      <!-- stinger -->
      <path d="M26 58 L13 54" />
      <!-- wings -->
      <g class="bee-wings" style="transform-origin: 48px 40px;">
        <ellipse cx="44" cy="38" rx="15" ry="10" transform="rotate(-22 44 38)" />
        <ellipse cx="59" cy="36" rx="13" ry="8" transform="rotate(15 59 36)" />
      </g>
      <!-- antennae -->
      <path d="M72 41 Q76 26 82 24" />
      <path d="M78 43 Q85 30 91 30" />
      <circle cx="82" cy="24" r="2" fill={S} stroke="none" />
      <circle cx="91" cy="30" r="2" fill={S} stroke="none" />
      <!-- body outline -->
      <ellipse cx="55" cy="58" rx="29" ry="22" />
      <!-- stripes (clipped to body) -->
      <g clip-path={`url(#${cid})`}>
        <line x1="43" y1="35" x2="43" y2="81" />
        <line x1="63" y1="35" x2="63" y2="81" />
      </g>
      <!-- eyes -->
      <circle class="bee-pupil" cx="74" cy="55" r="2.2" fill={S} stroke="none" />
      <circle class="bee-pupil" cx="84" cy="55" r="2.2" fill={S} stroke="none" />
      <!-- smile -->
      <path d="M73 62 Q79 67 85 62" />
    </svg>
  </div>
</div>
