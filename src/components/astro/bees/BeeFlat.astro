---
// BeeFlat.astro — "Flat Geometric" bee style.
// Modern, flat, no outlines. Reads as a clean corporate mark. Cursor-reactive
// pupils via .bee-pupil. Markup only; bob/lean animation comes from the page CSS.
interface Props { id: string; class?: string; flip?: boolean; delay?: number; }
const { id, class: className = "", flip = false, delay = 0 } = Astro.props;
const cid = `flat-${id}`;
---
<div class={`bee-char ${className}`} data-style="flat" aria-hidden="true"
  style={`--bee-delay:${delay}s; ${flip ? "transform: scaleX(-1);" : ""}`}>
  <div class="bee-bob">
    <svg viewBox="0 0 120 100" class="w-full h-full overflow-visible">
      <defs>
        <clipPath id={cid}><rect x="30" y="40" width="60" height="38" rx="19" /></clipPath>
      </defs>
      <!-- wings -->
      <g class="bee-wings" style="transform-origin: 50px 40px;">
        <path d="M50 42 Q30 20 24 40 Q28 52 50 47 Z" fill="#5AAB9D" opacity="0.5" />
        <path d="M55 40 Q70 22 80 35 Q76 49 58 46 Z" fill="#5AAB9D" opacity="0.32" />
      </g>
      <!-- antennae -->
      <path d="M76 42 Q80 28 88 25" stroke="#213343" stroke-width="2.4" fill="none" stroke-linecap="round" />
      <circle cx="88" cy="25" r="3" fill="#C47A2A" />
      <!-- body + stripes -->
      <g clip-path={`url(#${cid})`}>
        <rect x="30" y="40" width="60" height="38" fill="#F2B134" />
        <rect x="52" y="40" width="10" height="38" fill="#213343" />
        <rect x="70" y="40" width="10" height="38" fill="#213343" />
      </g>
      <!-- eyes -->
      <circle cx="76" cy="56" r="4.6" fill="#ffffff" />
      <circle class="bee-pupil" cx="77" cy="57" r="2.2" fill="#213343" />
      <!-- smile -->
      <path d="M73 64 Q78 68 84 64" stroke="#213343" stroke-width="1.8" fill="none" stroke-linecap="round" />
    </svg>
  </div>
</div>
