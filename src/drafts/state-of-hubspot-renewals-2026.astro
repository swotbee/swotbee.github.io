<script is:inline>
  // Progressive enhancement only. Everything above works with JS disabled; these just make
  // it harder to quote a stat without its base traveling along.
  (function () {
    var REPORT = "The State of HubSpot Renewals 2026, SwotBee";
    var base = window.location.origin + window.location.pathname;

    function flash(btn, msg) {
      var prev = btn.textContent;
      btn.textContent = msg;
      setTimeout(function () { btn.textContent = prev; }, 2000);
    }
    function copy(text, btn) {
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(function () { flash(btn, "Copied"); },
          function () { flash(btn, "Press Ctrl+C"); });
      } else {
        flash(btn, "Press Ctrl+C");
      }
    }

    document.querySelectorAll(".copy-stat").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var li = btn.closest("li");
        var p = li ? li.querySelector("p") : null;
        if (!p) return;
        copy('"' + p.innerText.trim() + '" ' + REPORT + ". " + base + btn.dataset.anchor, btn);
      });
    });

    var cite = document.querySelector("[data-copy-citation]");
    if (cite) {
      cite.addEventListener("click", function () {
        var el = document.getElementById("citation-text");
        if (el) copy(el.innerText.trim(), cite);
      });
    }

    var pr = document.querySelector("[data-print]");
    if (pr) pr.addEventListener("click", function () { window.print(); });
  })();
</script>
