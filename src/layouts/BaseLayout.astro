---
import { AstroSEO } from "astro-seo-plugin";
import {
  generateOgImage,
  generateCanonicalUrl,
  generateRobotsDirective,
} from "../utils/seo";
// Fonts: only import what's actually used
// Body: Hanken Grotesk (primary), DM Sans (fallback), Lexend Deca (fallback)
// Headings: Rokkitt Variable (custom @font-face in global.css), Vollkorn (fallback)
import "@fontsource-variable/hanken-grotesk";     // Body — variable font covers all weights
import "@fontsource-variable/dm-sans";             // Body fallback
import "@fontsource/lexend-deca";                  // Body fallback (weight 400 only)
import "@fontsource/vollkorn/400.css";             // Heading fallback (regular)
import "@fontsource/vollkorn/700.css";             // Heading fallback (bold)
// Rokkitt loaded via @font-face in global.css (variable woff2, no separate import needed)
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  keywords?: string;
  author?: string;
  robots?: string;
}

const {
  title,
  description = "SWOTBee - Your HubSpot & Shopify consulting partner for business growth and optimization",
  ogImage,
  canonicalURL,
  keywords = "HubSpot consulting, Shopify integration, CRM optimization, marketing automation, sales funnel, business growth, HubSpot experts",
  author = "SWOTBee",
  robots = "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1",
} = Astro.props;

const isNoindex = robots.includes("noindex");

// Use utility functions for consistent URL generation
const finalOgImage = ogImage || generateOgImage();
const finalCanonicalURL =
  canonicalURL || generateCanonicalUrl(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={author} />
    <meta name="robots" content={robots} />
    <meta name="language" content="English" />
    <meta name="revisit-after" content="7 days" />
    <meta name="theme-color" content="#1f2937" />

    <!-- Preload critical fonts (body + heading) -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/hanken-grotesk-latin-wght-normal.woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/rokkitt-latin-wght-normal.woff2"
      crossorigin="anonymous"
    />

    <!-- Additional SEO meta tags -->
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="SWOTBee" />
    <meta property="og:type" content="website" />
    <meta name="twitter:site" content="@swotbee" />
    <meta name="twitter:creator" content="@swotbee" />

    <AstroSEO
      title={`${title} | SWOTBee`}
      description={description}
      openGraph={{
        title: title,
        description: description,
        image: finalOgImage,
        type: "website",
        url: finalCanonicalURL,
        siteName: "SWOTBee",
        locale: "en_US",
      }}
      twitter={{
        card: "summary_large_image",
        site: "@swotbee",
        creator: "@swotbee",
        title: title,
        description: description,
        image: finalOgImage,
      }}
      jsonLd={{
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": "https://swotbee.com/#website",
            url: "https://swotbee.com",
            name: "SWOTBee - HubSpot & Shopify Consulting",
            description: description,
            inLanguage: "en-US",
            publisher: {
              "@id": "https://swotbee.com/#organization",
            },
            potentialAction: {
              "@type": "SearchAction",
              target: "https://swotbee.com/search?q={search_term_string}",
              "query-input": "required name=search_term_string",
            },
          },
          {
            "@type": "Organization",
            "@id": "https://swotbee.com/#organization",
            name: "SWOTBee",
            url: "https://swotbee.com",
            logo: {
              "@type": "ImageObject",
              url: "https://swotbee.com/assets/home-images/swotbee.png",
              width: 400,
              height: 400,
            },
            description:
              "Expert HubSpot and Shopify consulting services for business growth and optimization",
            foundingDate: "2023",
            knowsAbout: [
              "HubSpot CRM",
              "Shopify Integration",
              "Marketing Automation",
              "Sales Funnel Optimization",
              "CRM Migration",
              "Lead Qualification",
              "Email Marketing",
              "Business Consulting",
            ],
            serviceType: [
              "HubSpot Consulting",
              "Shopify Integration",
              "CRM Optimization",
              "Marketing Automation",
              "Sales Process Consulting",
            ],
            contactPoint: {
              "@type": "ContactPoint",
              contactType: "Customer Service",
              url: "https://swotbee.com/contactus/",
            },
            sameAs: [
              "https://twitter.com/swotbee",
              "https://linkedin.com/company/swotbee",
            ],
          },
        ],
      }}
      robots={{ index: !isNoindex, follow: true }}
      additionalLinkTags={[{ rel: "canonical", href: finalCanonicalURL }]}
    />
    <!-- Preconnect to external origins -->
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="dns-prefetch" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.google-analytics.com" />
    <!-- Prefetch key pages -->
    <link rel="prefetch" href="/services/hubspot-onboarding" />
    <link rel="prefetch" href="/contactus/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="SWOTBee Blog" href="/rss.xml" />
    {import.meta.env.PUBLIC_GSC_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GSC_VERIFICATION} />
    )}
    {import.meta.env.PUBLIC_GA4_ID && (
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA4_ID}`}></script>
    )}
    {import.meta.env.PUBLIC_GA4_ID && (
      <script is:inline define:vars={{ ga4Id: import.meta.env.PUBLIC_GA4_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', ga4Id);
      </script>
    )}
    {import.meta.env.PUBLIC_GA4_ID && (
      <script is:inline>
        // Site-wide GA4 event taxonomy per research/conversion-optimization/00-swotbee-cro-framework.md's
        // pre-launch instrumentation gate: scroll_depth, cta_click, outbound_click here (global,
        // delegated); form_start/form_submit/form_error and video_* events are wired per-page
        // where the relevant form/video markup lives (they need page-specific context this
        // global script doesn't have).
        (function () {
          function fire(name, params) {
            if (window.gtag) window.gtag('event', name, params || {});
          }

          // scroll_depth: 25/50/75/90, each fires once per page load.
          var scrollThresholds = [25, 50, 75, 90];
          var scrollFired = {};
          function checkScrollDepth() {
            var doc = document.documentElement;
            var scrollable = doc.scrollHeight - doc.clientHeight;
            if (scrollable <= 0) return;
            var pct = Math.round((window.scrollY / scrollable) * 100);
            scrollThresholds.forEach(function (t) {
              if (pct >= t && !scrollFired[t]) {
                scrollFired[t] = true;
                fire('scroll_depth', { percent: t });
              }
            });
          }
          window.addEventListener('scroll', checkScrollDepth, { passive: true });

          // outbound_click: any link to a different hostname.
          // cta_click: any element carrying data-ga-cta="<label>" (used for the funnel's
          // primary CTAs so clicks are labeled, not just "a link was clicked somewhere").
          document.addEventListener('click', function (e) {
            var el = e.target.closest ? e.target.closest('a[href]') : null;
            if (!el) return;
            var href = el.getAttribute('href') || '';
            var ctaLabel = el.getAttribute('data-ga-cta');
            if (ctaLabel) {
              fire('cta_click', { cta: ctaLabel, href: href });
            }
            try {
              var url = new URL(href, window.location.href);
              if (url.hostname && url.hostname !== window.location.hostname) {
                fire('outbound_click', { url: url.href });
              }
            } catch (_err) {
              // relative/invalid hrefs (e.g. "#section") are not outbound, ignore
            }
          });
        })();
      </script>
    )}
    {import.meta.env.PUBLIC_CLARITY_ID && (
      <script is:inline define:vars={{ clarityId: import.meta.env.PUBLIC_CLARITY_ID }}>
        // Microsoft Clarity session recording, per the CRO framework's pre-launch gate
        // (research/conversion-optimization/00-swotbee-cro-framework.md): "the primary
        // learning tool at low volume." Site-wide rather than scoped to individual pages,
        // Clarity's free tier has no session-volume cap, so scoping it buys nothing and
        // costs a per-page conditional; site-wide trivially covers the renewal-ops,
        // leakage-estimate, uplift-checklist, and compare pages the framework calls out
        // by name, plus everything else for free.
        (function (c, l, a, r, i, t, y) {
          c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
          t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
          y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
        })(window, document, "clarity", "script", clarityId);
      </script>
    )}
  </head>
  <body class="min-h-full bg-custom">
    <main>
      <slot />
    </main>
    <script>
      import Alpine from "alpinejs";
      window.Alpine = Alpine;
      Alpine.start();
    </script>
    <!-- Capture self-reported role on any opt-in form submit into a first-party cookie so the
         audit-call page can tailor its pitch (ROI vs how-it-works) for same-browser journeys (#6). -->
    <script is:inline>
      document.addEventListener("submit", function (e) {
        var f = e.target;
        var r = f && f.querySelector && f.querySelector('[name="self_reported_role"]');
        if (r && r.value) {
          document.cookie = "sb_role=" + encodeURIComponent(r.value) + ";path=/;max-age=7776000;samesite=lax";
        }
      }, true);
    </script>
  </body>
</html>
