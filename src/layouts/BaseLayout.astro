---
import { AstroSEO } from "astro-seo-plugin";
import {
  generateOgImage,
  generateCanonicalUrl,
  generateRobotsDirective,
} from "../utils/seo";
// Fonts: only import what's actually used
// Body: Hanken Grotesk (primary), DM Sans (fallback), Lexend Deca (fallback)
// Headings: Rokkitt Variable (custom @font-face in global.css), Vollkorn (fallback)
import "@fontsource-variable/hanken-grotesk";     // Body — variable font covers all weights
import "@fontsource-variable/dm-sans";             // Body fallback
import "@fontsource/lexend-deca";                  // Body fallback (weight 400 only)
import "@fontsource/vollkorn/400.css";             // Heading fallback (regular)
import "@fontsource/vollkorn/700.css";             // Heading fallback (bold)
// Rokkitt loaded via @font-face in global.css (variable woff2, no separate import needed)
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  keywords?: string;
  author?: string;
  robots?: string;
}

const {
  title,
  description = "SWOTBee - Your HubSpot & Shopify consulting partner for business growth and optimization",
  ogImage,
  canonicalURL,
  keywords = "HubSpot consulting, Shopify integration, CRM optimization, marketing automation, sales funnel, business growth, HubSpot experts",
  author = "SWOTBee",
  robots = "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1",
} = Astro.props;

const isNoindex = robots.includes("noindex");

// Use utility functions for consistent URL generation
const finalOgImage = ogImage || generateOgImage();
const finalCanonicalURL =
  canonicalURL || generateCanonicalUrl(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={author} />
    <meta name="robots" content={robots} />
    <meta name="language" content="English" />
    <meta name="revisit-after" content="7 days" />
    <meta name="theme-color" content="#1f2937" />

    <!-- Additional SEO meta tags -->
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="SWOTBee" />
    <meta property="og:type" content="website" />
    <meta name="twitter:site" content="@swotbee" />
    <meta name="twitter:creator" content="@swotbee" />

    <AstroSEO
      title={`${title} | SWOTBee`}
      description={description}
      openGraph={{
        title: title,
        description: description,
        image: finalOgImage,
        type: "website",
        url: finalCanonicalURL,
        siteName: "SWOTBee",
        locale: "en_US",
      }}
      twitter={{
        card: "summary_large_image",
        site: "@swotbee",
        creator: "@swotbee",
        title: title,
        description: description,
        image: finalOgImage,
      }}
      jsonLd={{
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": "https://swotbee.com/#website",
            url: "https://swotbee.com",
            name: "SWOTBee - HubSpot & Shopify Consulting",
            description: description,
            inLanguage: "en-US",
            publisher: {
              "@id": "https://swotbee.com/#organization",
            },
            potentialAction: {
              "@type": "SearchAction",
              target: "https://swotbee.com/search?q={search_term_string}",
              "query-input": "required name=search_term_string",
            },
          },
          {
            "@type": "Organization",
            "@id": "https://swotbee.com/#organization",
            name: "SWOTBee",
            url: "https://swotbee.com",
            logo: {
              "@type": "ImageObject",
              url: "https://swotbee.com/assets/home-images/swotbee.png",
              width: 400,
              height: 400,
            },
            description:
              "Expert HubSpot and Shopify consulting services for business growth and optimization",
            foundingDate: "2023",
            knowsAbout: [
              "HubSpot CRM",
              "Shopify Integration",
              "Marketing Automation",
              "Sales Funnel Optimization",
              "CRM Migration",
              "Lead Qualification",
              "Email Marketing",
              "Business Consulting",
            ],
            serviceType: [
              "HubSpot Consulting",
              "Shopify Integration",
              "CRM Optimization",
              "Marketing Automation",
              "Sales Process Consulting",
            ],
            contactPoint: {
              "@type": "ContactPoint",
              contactType: "Customer Service",
              url: "https://swotbee.com/contactus",
            },
            sameAs: [
              "https://twitter.com/swotbee",
              "https://linkedin.com/company/swotbee",
            ],
          },
        ],
      }}
      robots={{ index: !isNoindex, follow: true }}
      additionalLinkTags={[{ rel: "canonical", href: finalCanonicalURL }]}
    />
    <!-- Preconnect to external origins -->
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="dns-prefetch" href="https://images.unsplash.com" />
    <!-- Prefetch key pages -->
    <link rel="prefetch" href="/services/hubspot-onboarding" />
    <link rel="prefetch" href="/contactus" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="SWOTBee Blog" href="/rss.xml" />
    {import.meta.env.PUBLIC_GSC_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GSC_VERIFICATION} />
    )}
    {import.meta.env.PUBLIC_GA4_ID && (
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA4_ID}`}></script>
    )}
    {import.meta.env.PUBLIC_GA4_ID && (
      <script is:inline define:vars={{ ga4Id: import.meta.env.PUBLIC_GA4_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', ga4Id);
      </script>
    )}
  </head>
  <body class="min-h-full bg-custom">
    <main>
      <slot />
    </main>
    <script>
      import Alpine from "alpinejs";
      window.Alpine = Alpine;
      Alpine.start();
    </script>
  </body>
</html>
