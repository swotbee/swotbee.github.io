---
import Layout from './Layout.astro';
import Navbar from '../components/astro/Navbar.astro';
import Footer from '../components/astro/Footer.astro';
import StructuredData from '../components/astro/StructuredData.astro';
import ReviewedBy from '../components/astro/ReviewedBy.astro';
import { generateArticleStructuredData, generateCanonicalUrl } from '../utils/seo';
import { getRecentPosts } from '../utils/posts';

const { frontmatter } = Astro.props;
const { recentPosts } = await getRecentPosts();

const pageTitle = `${frontmatter.title} | SWOTBee`;
const pageDescription = frontmatter.description || 'Read our latest blog post on SWOTBee';
const canonicalURL = generateCanonicalUrl(Astro.url.pathname);

// Calculate reading time (average 230 words per minute)
const content = await Astro.slots.render('default');
const wordCount = content.replace(/<[^>]*>/g, '').split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 230));

// Format dates
const pubDate = new Date(frontmatter.pubDate).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});
const modDate = frontmatter.modifiedDate
  ? new Date(frontmatter.modifiedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;

// Find related posts (share at least 1 tag)
const currentTags = frontmatter.tags || [];
const relatedPosts = recentPosts
  .filter(p => p.slug !== Astro.url.pathname.split('/').pop())
  .filter(p => p.tags?.some(t => currentTags.includes(t)))
  .slice(0, 3);

// If not enough tag-matched posts, fill with recent
const displayPosts = relatedPosts.length >= 2
  ? relatedPosts
  : recentPosts.filter(p => p.slug !== Astro.url.pathname.split('/').pop()).slice(0, 3);
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage={frontmatter.image}
  canonicalURL={canonicalURL}
  keywords={frontmatter.tags?.join(', ')}
  author={frontmatter.author?.name}
  robots={frontmatter.noindex ? "noindex, follow" : undefined}
>
  <!-- Open Graph -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:image" content={frontmatter.image ? `https://swotbee.com${frontmatter.image}` : 'https://swotbee.com/assets/ico/logo.png'} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="SWOTBee" />
  <meta property="article:published_time" content={frontmatter.pubDate} />
  <meta property="article:author" content={frontmatter.author?.name || 'SWOTBee'} />
  {frontmatter.tags && frontmatter.tags.map((tag: string) => (
    <meta property="article:tag" content={tag} />
  ))}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@swotbee" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={frontmatter.image ? `https://swotbee.com${frontmatter.image}` : 'https://swotbee.com/assets/ico/logo.png'} />

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(generateArticleStructuredData({
    title: frontmatter.title,
    description: frontmatter.description,
    image: frontmatter.image,
    url: canonicalURL,
    publishedTime: frontmatter.pubDate,
    modifiedTime: frontmatter.modifiedDate || frontmatter.pubDate,
    author: frontmatter.author?.name || 'SWOTBee',
    tags: frontmatter.tags
  }), null, 2)}></script>

  {/* Person schema for author */}
  {frontmatter.author?.linkedin && (
    <StructuredData
      type="person"
      data={{
        name: frontmatter.author.name,
        url: frontmatter.author.url,
        linkedin: frontmatter.author.linkedin,
        jobTitle: frontmatter.author.jobTitle || "HubSpot Consultant",
        worksFor: "SWOTBee",
        knowsAbout: frontmatter.author.expertise,
        image: frontmatter.author.imageUrl,
      }}
    />
  )}

  {/* HowTo schema for step-by-step posts */}
  {frontmatter.howto && frontmatter.howtoSteps && (
    <StructuredData
      type="howto"
      data={{
        name: frontmatter.title,
        description: frontmatter.description,
        steps: frontmatter.howtoSteps,
      }}
    />
  )}

  {/* FAQPage schema for posts with a frontmatter faqs array */}
  {frontmatter.faqs && frontmatter.faqs.length > 0 && (
    <StructuredData
      type="faq"
      data={{ faqs: frontmatter.faqs }}
    />
  )}

  {/* isPartOf schema for cluster posts in a series */}
  {frontmatter.seriesName && frontmatter.pillarUrl && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "@id": canonicalURL,
      "isPartOf": {
        "@type": "Blog",
        "name": frontmatter.seriesName,
        "url": `https://swotbee.com${frontmatter.pillarUrl}`
      }
    }, null, 2)}></script>
  )}

  <Navbar />

  <!-- Reading Progress Bar -->
  <div class="fixed top-16 left-0 right-0 z-40 h-0.5 bg-gray-100">
    <div id="reading-progress" class="h-full bg-v6-copper transition-all duration-150 ease-out" style="width: 0%"></div>
  </div>

  <main class="bg-white">
    <!-- Breadcrumb -->
    <div class="max-w-[680px] mx-auto px-4 sm:px-6 pt-8 pb-2">
      <nav class="text-xs text-v6-text-muted">
        <a href="/" class="hover:text-v6-dark transition-colors">Home</a>
        <span class="mx-1.5">›</span>
        <a href="/blog" class="hover:text-v6-dark transition-colors">Blog</a>
        <span class="mx-1.5">›</span>
        <span class="text-v6-dark">{frontmatter.title.length > 50 ? frontmatter.title.slice(0, 50) + '...' : frontmatter.title}</span>
      </nav>
    </div>

    <!-- Article Header -->
    <header class="max-w-[680px] mx-auto px-4 sm:px-6 pt-4 pb-6">
      <!-- Tags -->
      {frontmatter.tags && frontmatter.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-4">
          {frontmatter.tags.slice(0, 4).map((tag: string) => (
            <span class="bg-v6-blue-50 text-v6-blue text-xs font-semibold px-2.5 py-0.5 rounded-full">
              {tag}
            </span>
          ))}
        </div>
      )}

      <!-- Title -->
      <h1 class="text-3xl sm:text-4xl font-bold text-v6-dark leading-tight mb-4">
        {frontmatter.title}
      </h1>

      <!-- Description -->
      {frontmatter.description && (
        <p class="text-lg text-v6-text-muted leading-relaxed mb-5">
          {frontmatter.description}
        </p>
      )}

      <!-- Meta line -->
      <div class="flex flex-wrap items-center gap-3 text-sm text-v6-text-muted pb-6 border-b border-v6-border">
        {frontmatter.author?.name && (
          <span class="font-medium text-v6-dark">{frontmatter.author.name}</span>
        )}
        <span>·</span>
        <time datetime={frontmatter.pubDate}>{pubDate}</time>
        {modDate && modDate !== pubDate && (
          <>
            <span>·</span>
            <span class="text-xs bg-v6-teal-50 text-v6-teal-700 px-2 py-0.5 rounded-full border border-v6-teal-100">
              Updated {modDate}
            </span>
          </>
        )}
        <span>·</span>
        <span>{readingTime} min read</span>
      </div>
    </header>

    <!-- Reviewed By -->
    {frontmatter.reviewedBy && (
      <div class="max-w-[680px] mx-auto px-4 sm:px-6 mb-4">
        <ReviewedBy
          reviewerName={frontmatter.reviewedBy.name}
          reviewerTitle={frontmatter.reviewedBy.title}
          reviewerLinkedin={frontmatter.reviewedBy.linkedin}
          reviewDate={frontmatter.reviewedBy.date}
        />
      </div>
    )}

    <!-- Featured Image -->
    {frontmatter.image && (
      <div class="max-w-4xl mx-auto px-4 sm:px-6 mb-10">
        <img
          src={frontmatter.image}
          alt={frontmatter.title}
          class="w-full rounded-xl object-cover aspect-video"
          loading="eager"
          width="800"
          height="450"
          decoding="async"
        />
      </div>
    )}

    <!-- Table of Contents -->
    <div class="max-w-[680px] mx-auto px-4 sm:px-6 mb-10">
      <details class="bg-v6-bg rounded-xl border border-v6-border group" id="toc-container" open>
        <summary class="flex items-center justify-between cursor-pointer px-6 py-4 text-base font-bold text-v6-dark tracking-wide uppercase">
          Table of Contents
          <svg class="w-5 h-5 text-v6-text-muted group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </summary>
        <nav class="px-6 pb-5 space-y-1" id="toc-nav">
          <!-- Populated by JS -->
        </nav>
      </details>
    </div>

    <!-- Article Body -->
    <article class="max-w-[680px] mx-auto px-4 sm:px-6 pb-16">
      <div class="blog-content">
        <slot />
      </div>
    </article>

    <!-- Post Footer Section -->
    <div class="max-w-[680px] mx-auto px-4 sm:px-6 pb-16">

      {frontmatter.funnelCta === 'renewal-audit' && (
        <section class="mb-10 rounded-xl border border-v6-teal-200 bg-v6-teal-50 p-6" aria-label="Renewal operations next step">
          <p class="text-xs font-semibold uppercase tracking-wide text-v6-teal-700 mb-2">Next step</p>
          <h2 class="text-xl font-bold text-v6-dark mb-2">Find the renewal leakage hiding in your HubSpot setup.</h2>
          <p class="text-sm text-v6-text-muted leading-relaxed mb-4">
            If cloning, renewal dates, line items, or NRR reporting are still manual, start with a quick leakage estimate and then review the QBR demo workflow.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/resources/renewal-leakage-estimate/" class="inline-flex items-center justify-center rounded-lg bg-v6-teal-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-v6-teal-800 transition-colors">Get the leakage estimate</a>
            <a href="/renewal-operations-animated-v3/#demo" class="inline-flex items-center justify-center rounded-lg border border-v6-teal-300 bg-white px-4 py-2.5 text-sm font-semibold text-v6-teal-800 hover:bg-v6-teal-100 transition-colors">Watch the demo</a>
          </div>
        </section>
      )}

      <!-- Tags (bottom) -->
      {frontmatter.tags && frontmatter.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 pb-6 border-b border-v6-border">
          {frontmatter.tags.map((tag: string) => (
            <span class="bg-v6-bg text-v6-text-muted text-xs font-medium px-3 py-1 rounded-full border border-v6-border">
              #{tag}
            </span>
          ))}
        </div>
      )}

      <!-- Was this helpful? -->
      <div class="flex items-center justify-center gap-4 py-6 border-b border-v6-border">
        <span class="text-sm text-v6-text-muted">Was this article helpful?</span>
        <button class="text-xl hover:scale-125 transition-transform" title="Yes, helpful" onclick="this.textContent='✅'; this.disabled=true;">👍</button>
        <button class="text-xl hover:scale-125 transition-transform" title="Not helpful" onclick="this.textContent='Noted'; this.classList.add('text-sm'); this.disabled=true;">👎</button>
      </div>

      <!-- Share -->
      <div class="flex flex-wrap items-center justify-center gap-3 py-6 border-b border-v6-border">
        <span class="text-sm text-v6-text-muted mr-2">Share:</span>
        <button
          id="copy-link-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-v6-dark bg-v6-bg border border-v6-border rounded-lg hover:bg-gray-100 transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
          Copy Link
        </button>
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://swotbee.com${Astro.url.pathname}`)}`}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-v6-dark bg-v6-bg border border-v6-border rounded-lg hover:bg-gray-100 transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn
        </a>
        <a
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(frontmatter.title)}&url=${encodeURIComponent(`https://swotbee.com${Astro.url.pathname}`)}`}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-v6-dark bg-v6-bg border border-v6-border rounded-lg hover:bg-gray-100 transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M13.6823 10.6218L20.2391 3H18.6854L12.9921 9.61788L8.44486 3H3.2002L10.0765 13.0074L3.2002 21H4.75404L10.7663 14.0113L15.5685 21H20.8131L13.6819 10.6218H13.6823ZM11.5541 13.0956L10.8574 12.0991L5.31391 4.16971H7.70053L12.1742 10.5689L12.8709 11.5655L18.6861 19.8835H16.2995L11.5541 13.096V13.0956Z"/></svg>
          Post
        </a>
      </div>

      <!-- Author Bio -->
      <div class="flex items-start gap-4 py-6 border-b border-v6-border">
        <div class="w-14 h-14 rounded-full bg-v6-teal-100 flex items-center justify-center text-v6-teal-700 font-bold text-lg flex-shrink-0">
          {(frontmatter.author?.name || 'S').charAt(0)}
        </div>
        <div>
          <p class="text-sm font-semibold text-v6-dark">{frontmatter.author?.name || 'SWOTBee Team'}</p>
          <p class="text-xs text-v6-text-muted leading-relaxed mt-0.5">
            {frontmatter.author?.bio || 'HubSpot consultants helping mid-sized companies in Energy, Manufacturing, and SaaS turn their CRM into a revenue engine.'}
          </p>
          {frontmatter.author?.linkedin && (
            <a
              href={frontmatter.author.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-xs text-v6-teal-700 hover:text-v6-teal-800 transition-colors mt-1.5"
            >
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              Connect on LinkedIn
            </a>
          )}
          {frontmatter.author?.expertise && frontmatter.author.expertise.length > 0 && (
            <div class="flex flex-wrap gap-1 mt-2">
              {frontmatter.author.expertise.map((area: string) => (
                <span class="text-xs bg-v6-bg border border-v6-border text-v6-text-muted px-2 py-0.5 rounded-full">{area}</span>
              ))}
            </div>
          )}
        </div>
      </div>

      <!-- Inline Newsletter -->
      <div class="bg-v6-bg rounded-xl border border-v6-border p-6 my-8 text-center">
        <p class="text-base font-semibold text-v6-dark mb-1">Liked this article?</p>
        <p class="text-sm text-v6-text-muted mb-4">Get HubSpot tips and RevOps insights delivered weekly.</p>
        <form class="flex flex-col sm:flex-row gap-2 max-w-md mx-auto">
          <input
            type="email"
            placeholder="Your email address"
            class="flex-1 px-4 py-2.5 rounded-lg border border-v6-border text-sm focus:ring-2 focus:ring-v6-copper focus:outline-none"
          />
          <button type="submit" class="bg-v6-copper text-white px-5 py-2.5 rounded-lg text-sm font-semibold hover:bg-v6-copper-600 transition-colors">
            Subscribe
          </button>
        </form>
      </div>

      <!-- Related Posts -->
      {displayPosts.length > 0 && (
        <div class="mt-12">
          <h2 class="text-xl font-bold text-v6-dark mb-6">You Might Also Like</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {displayPosts.map((post) => (
              <a href={`/posts/${post.slug}`} class="group block bg-v6-bg rounded-xl border border-v6-border overflow-hidden hover:shadow-md transition-shadow">
                {post.image && (
                  <div class="aspect-video overflow-hidden">
                    <img src={post.image} alt={post.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                  </div>
                )}
                <div class="p-4">
                  <h3 class="text-sm font-semibold text-v6-dark leading-snug line-clamp-2 group-hover:text-v6-copper transition-colors">{post.title}</h3>
                  <p class="text-xs text-v6-text-muted mt-1">
                    {new Date(post.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </main>

  <!-- Floating ToC Pill (mobile + desktop) -->
  <button
    id="toc-float-btn"
    class="fixed bottom-6 right-6 z-50 bg-v6-dark text-white px-4 py-2.5 rounded-full shadow-lg text-sm font-medium flex items-center gap-2 hover:bg-v6-blue-800 transition-colors opacity-0 pointer-events-none"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /></svg>
    Contents
  </button>

  <!-- Floating ToC Panel -->
  <div id="toc-float-panel" class="fixed bottom-20 right-6 z-50 bg-white rounded-xl shadow-2xl border border-v6-border p-4 w-72 max-h-80 overflow-y-auto hidden">
    <div class="flex justify-between items-center mb-3">
      <span class="text-sm font-semibold text-v6-dark">In This Article</span>
      <button id="toc-float-close" class="text-v6-text-muted hover:text-v6-dark">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <nav id="toc-float-nav" class="space-y-1.5">
      <!-- Populated by JS -->
    </nav>
  </div>

  <!-- Scroll to Top -->
  <button
    id="scroll-top-btn"
    aria-label="Scroll to top"
    class="fixed bottom-6 left-6 z-50 bg-white border border-v6-border text-v6-text-muted w-10 h-10 rounded-full shadow-md flex items-center justify-center hover:bg-v6-bg hover:text-v6-dark transition-colors opacity-0 pointer-events-none"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
    </svg>
  </button>

  <Footer />

  <script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    // === Reading Progress Bar ===
    var progressBar = document.getElementById('reading-progress');
    if (progressBar) {
      window.addEventListener('scroll', function() {
        var scrollTop = window.scrollY;
        var docHeight = document.documentElement.scrollHeight - window.innerHeight;
        var progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        progressBar.style.width = Math.min(progress, 100) + '%';
      });
    }

    // === Build Table of Contents ===
    var article = document.querySelector('article');
    var tocNav = document.getElementById('toc-nav');
    var tocFloatNav = document.getElementById('toc-float-nav');

    if (article && (tocNav || tocFloatNav)) {
      var headings = article.querySelectorAll('h2, h3');
      var tocHtml = '';

      headings.forEach(function(heading, i) {
        var id = heading.id || 'section-' + i;
        heading.id = id;
        var isH3 = heading.tagName === 'H3';
        var text = heading.textContent.trim();
        if (text.length > 60) text = text.slice(0, 57) + '...';

        tocHtml += '<a href="#' + id + '" class="block text-sm ' +
          (isH3 ? 'pl-4 ' : '') +
          'text-v6-text-muted hover:text-v6-copper py-1.5 leading-snug transition-colors">' +
          text + '</a>';
      });

      if (tocNav) tocNav.innerHTML = tocHtml;
      if (tocFloatNav) tocFloatNav.innerHTML = tocHtml;

      // Hide inline ToC if no headings
      if (headings.length === 0) {
        var tocContainer = document.getElementById('toc-container');
        if (tocContainer) tocContainer.style.display = 'none';
      }
    }

    // === Floating ToC Button ===
    var floatBtn = document.getElementById('toc-float-btn');
    var floatPanel = document.getElementById('toc-float-panel');
    var floatClose = document.getElementById('toc-float-close');

    if (floatBtn && floatPanel) {
      // Show button after scrolling past the inline ToC
      window.addEventListener('scroll', function() {
        if (window.scrollY > 600) {
          floatBtn.classList.remove('opacity-0', 'pointer-events-none');
          floatBtn.classList.add('opacity-100');
        } else {
          floatBtn.classList.add('opacity-0', 'pointer-events-none');
          floatBtn.classList.remove('opacity-100');
          floatPanel.classList.add('hidden');
        }
      });

      floatBtn.addEventListener('click', function() {
        floatPanel.classList.toggle('hidden');
      });

      if (floatClose) {
        floatClose.addEventListener('click', function() {
          floatPanel.classList.add('hidden');
        });
      }

      // Close panel when clicking a link
      floatPanel.addEventListener('click', function(e) {
        if (e.target.tagName === 'A') {
          floatPanel.classList.add('hidden');
        }
      });
    }

    // === Scroll to Top Button ===
    var scrollTopBtn = document.getElementById('scroll-top-btn');
    if (scrollTopBtn) {
      window.addEventListener('scroll', function() {
        if (window.scrollY > 600) {
          scrollTopBtn.classList.remove('opacity-0', 'pointer-events-none');
          scrollTopBtn.classList.add('opacity-100');
        } else {
          scrollTopBtn.classList.add('opacity-0', 'pointer-events-none');
          scrollTopBtn.classList.remove('opacity-100');
        }
      });
      scrollTopBtn.addEventListener('click', function() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // === Copy Link Button ===
    var copyBtn = document.getElementById('copy-link-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', function() {
        navigator.clipboard.writeText(window.location.href).then(function() {
          copyBtn.textContent = '✓ Copied!';
          setTimeout(function() { copyBtn.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg> Copy Link'; }, 2000);
        });
      });
    }
  });
  </script>
</Layout>
